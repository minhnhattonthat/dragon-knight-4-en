[
 {
  "id": "2E8000_0087.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、ここで解散っ！！",
  "en": ""
 },
 {
  "id": "2E8000_009A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれれ……エト、だれか倒れてるよ。",
  "en": ""
 },
 {
  "id": "2E8000_00B7.0",
  "speaker": "エルフの女の子",
  "form": "dlg",
  "nlines": 1,
  "jp": "うっうう……た、助けて。",
  "en": ""
 },
 {
  "id": "2E8000_00C9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ど、どうしたの！？",
  "en": ""
 },
 {
  "id": "2E8000_00D8.0",
  "speaker": "エルフの女の子",
  "form": "dlg",
  "nlines": 2,
  "jp": "私の名前はマルレーネ…… / ルシフォンの軍隊が私たちにひどいことを……。",
  "en": ""
 },
 {
  "id": "2E8000_00D8.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "み、みんな殺されてしまった……",
  "en": ""
 },
 {
  "id": "2E8000_010F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "誇り高きエルフ一族は…… / やつらの味方にはならないと言ったせいで……。",
  "en": ""
 },
 {
  "id": "2E8000_0139.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "もうしゃべらない方がいい。 / ……エト、彼女をベッドに運ばうよ。",
  "en": ""
 },
 {
  "id": "2E8000_0139.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2E8000_0169.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしたの、エト？",
  "en": ""
 },
 {
  "id": "2E8000_0178.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ！？　……ああ……なにか言ったか？",
  "en": ""
 },
 {
  "id": "2E8000_018E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だからあ、彼女をベッドに運ばうって。",
  "en": ""
 },
 {
  "id": "2E8000_01A9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうか……うん、そうだな。",
  "en": ""
 },
 {
  "id": "2E8000_01BB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "変だよ、エト……どうかしたの？",
  "en": ""
 },
 {
  "id": "2E8000_01D0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "わ、私が彼女をベッドに運ばう。 / ……みんなは闘いの疲れを十分にいやしてくれ。",
  "en": ""
 },
 {
  "id": "2E8000_0225.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "カ、カケルう、 / ドラゴンが空を飛んでるよ……恐いなあ。",
  "en": ""
 },
 {
  "id": "2E8000_0225.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "なんだい、セイルはドラゴンナイトなんだろう… / 恐がることはないじゃないか？",
  "en": ""
 },
 {
  "id": "2E8000_0225.2",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ドラゴンナイトはパパだよ…… / 僕はただの人間だい。",
  "en": ""
 },
 {
  "id": "2E8000_0287.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ねえ、さっき倒れてた女の人…… / すごくきれいだったね。",
  "en": ""
 },
 {
  "id": "2E8000_0287.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、そうだね。",
  "en": ""
 },
 {
  "id": "2E8000_02B5.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルはナターシャがいるじゃないか…… / だめだよ、浮気をしたら。",
  "en": ""
 },
 {
  "id": "2E8000_02D5.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕って……デリケートなんだよ。",
  "en": ""
 },
 {
  "id": "2E8000_02F1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、もう大丈夫だ……心配するな。",
  "en": ""
 },
 {
  "id": "2E8000_0308.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトがこの人の側にいることが心配なんだ。",
  "en": ""
 },
 {
  "id": "2E8000_0324.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "わっはっはっ！！ / お前も言うようになったな！！",
  "en": ""
 },
 {
  "id": "2E8000_0324.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "本気で言ってるんだよ……エト。",
  "en": ""
 },
 {
  "id": "2E8000_0356.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……そう。",
  "en": ""
 },
 {
  "id": "2E8000_0362.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの軍隊め、ひどいことをしやがる。 / エルフ一族を皆殺しにするなんて。",
  "en": ""
 },
 {
  "id": "2E8000_0362.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……許せないよ、僕。",
  "en": ""
 },
 {
  "id": "2E8000_039E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、いっしょにがんばろうな……",
  "en": ""
 },
 {
  "id": "2E8000_03B4.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "闘い続ければきっと / ライムリンの国にたどり着くさ。",
  "en": ""
 },
 {
  "id": "2E8000_03D0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2E8000_03D8.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうした、カケル？",
  "en": ""
 },
 {
  "id": "2E8000_03E9.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャとのことを聞きますか？",
  "en": ""
 },
 {
  "id": "2E8000_03F8.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "聞く",
  "en": "",
  "dup": "2FB86E_01B4.0"
 },
 {
  "id": "2E8000_03FF.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "聞かない",
  "en": "",
  "dup": "2FB86E_01BB.0"
 },
 {
  "id": "2E8000_0410.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "あのさ、ナターシャと…… / 昨日の夜、いっしょにいたでしょ？",
  "en": ""
 },
 {
  "id": "2E8000_0410.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャと私が？",
  "en": ""
 },
 {
  "id": "2E8000_043C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、干し草が置いてある場所で。",
  "en": ""
 },
 {
  "id": "2E8000_0456.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ああ、あれはだな…… / たまたま眠れなかったから、散歩してただけだ。",
  "en": ""
 },
 {
  "id": "2E8000_0456.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあ、ナターシャと散歩をしてたの？",
  "en": ""
 },
 {
  "id": "2E8000_0497.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、そんなことより / 身体をちゃんと休めてるのか？",
  "en": ""
 },
 {
  "id": "2E8000_0497.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "話を変えないでよ、エト。",
  "en": ""
 },
 {
  "id": "2E8000_04C6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん、なんでもない……",
  "en": ""
 },
 {
  "id": "2E8000_04D4.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "なんかノドがかわいちゃった、 / 水でも飲んでくるよ。",
  "en": ""
 },
 {
  "id": "2E8000_04F1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "変なやつだな……。",
  "en": ""
 },
 {
  "id": "2E8000_04FF.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、疲れは十分にとっておけよ。 / これからの闘いは、ますます激しくなるぜ。",
  "en": ""
 },
 {
  "id": "2E8000_04FF.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……わかったよ、エト。",
  "en": ""
 },
 {
  "id": "2E8000_053E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ……。",
  "en": "",
  "dup": "2F9C88_1329.0"
 },
 {
  "id": "2E8000_0548.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすうすう……。",
  "en": ""
 },
 {
  "id": "2E8000_0551.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "疲れてるんだな……そっとしておこう。",
  "en": ""
 },
 {
  "id": "2E8000_056A.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん、ひどすぎると思いません？",
  "en": ""
 },
 {
  "id": "2E8000_0581.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、みな殺しにすることはないと思う……。",
  "en": ""
 },
 {
  "id": "2E8000_059B.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "私、本気で怒ったの…… / こんな気持ちになったの、生まれて初めて。",
  "en": ""
 },
 {
  "id": "2E8000_059B.1",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 4,
  "jp": "カケルさん、 / ルシフォンを許しちゃいけないと思う…… / 早くライムリン王国に行かないと、 / 同じ目にあう人がいっぱいでてきちゃう。",
  "en": ""
 },
 {
  "id": "2E8000_0601.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさん、この村の東には / シーボーズの港街があるそうです。",
  "en": ""
 },
 {
  "id": "2E8000_061D.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "よう、カケル…… / 一戦交えたあとの風呂はまた格別だぜ。",
  "en": ""
 },
 {
  "id": "2E8000_061D.1",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "それにしても、ひどいことになっちまった…… / せっかく弓使いの仲間ができると思ったのにな。",
  "en": ""
 },
 {
  "id": "2E8000_0674.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺は闘うために生まれてきたのさ…… / と、自分では思ってるんだ。",
  "en": ""
 },
 {
  "id": "2E8000_069A.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル殿、若いのにりっぱな闘いをするな…… / さすがあの方の息子だ。",
  "en": ""
 },
 {
  "id": "2E8000_069A.1",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2E8000_06C9.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "むう、一戦ごとに目の色が変わってきておる。 / こりゃあ、将来が楽しみだな、わっはっはっ！！",
  "en": ""
 },
 {
  "id": "2E8000_06FE.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿、ここにきていっしょに涼まんか？",
  "en": ""
 },
 {
  "id": "2E8000_0718.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いや、いいよ。遠庫しておくよ。",
  "en": ""
 },
 {
  "id": "2E8000_072F.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "なによ、あの男ったら……",
  "en": ""
 },
 {
  "id": "2E8000_0741.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちょっときれいな人だと、 / すぐにでれでれするんだから。",
  "en": ""
 },
 {
  "id": "2E8000_075C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、ネプチューン……なにを怒ってるの？",
  "en": ""
 },
 {
  "id": "2E8000_0772.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんでもないわよっ！！",
  "en": ""
 },
 {
  "id": "2E8000_077F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネプチューンって、怒った顔もきれいだね。",
  "en": ""
 },
 {
  "id": "2E8000_0795.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうかしら？",
  "en": ""
 },
 {
  "id": "2E8000_07A2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん、ウソ。",
  "en": ""
 },
 {
  "id": "2E8000_07AF.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2E8000_07B7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……本気で怒った。",
  "en": ""
 },
 {
  "id": "2E8000_07C8.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……カケル。",
  "en": ""
 },
 {
  "id": "2E8000_07D3.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私をからかうヒマがあったら…… / ベッドでおねんねしたらどう？",
  "en": ""
 },
 {
  "id": "2E8000_07F8.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もぐもぐもぐ…… / カケル、バナナを食べるか？",
  "en": ""
 },
 {
  "id": "2E8000_07F8.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ううん、僕はいいよ。 / バナナ売りのおぢさん。",
  "en": ""
 },
 {
  "id": "2E8000_07F8.2",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 4,
  "jp": "カケル、 / 俺はバナナ売りのおぢさんではないぞ…… / 騎馬隊の隊長、 / ゴロンゴン様だ。",
  "en": ""
 },
 {
  "id": "2E8000_085C.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "しかしひどい村だなあ……",
  "en": ""
 },
 {
  "id": "2E8000_086E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "これじゃあバナナ台を作っても、 / だれも買ってくれないな。",
  "en": ""
 },
 {
  "id": "2E8000_088F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ゴロンゴンって、 / 命よりもバナナの方が大事なんだね。",
  "en": ""
 },
 {
  "id": "2E8000_08AB.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 3,
  "jp": "そりゃあ言いすぎだ…… / バナナよりも、命の方が…… / あれ、どっちかな？",
  "en": ""
 },
 {
  "id": "2E8000_08D5.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん、うーん、うーん……。",
  "en": ""
 },
 {
  "id": "2E8000_08E2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "あれれ……冗談で言ったのに、 / 本気で考え込んじゃったよ。",
  "en": ""
 },
 {
  "id": "2E8000_0904.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "バナナがおいしいなあ…… / 健康な証拠だなあ。",
  "en": ""
 },
 {
  "id": "2E8000_0923.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、ライナス……今度も無事だったんだね。",
  "en": ""
 },
 {
  "id": "2E8000_093C.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ひいひい、ぜいぜい……",
  "en": ""
 },
 {
  "id": "2E8000_094D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの軍隊に追っかけられて、 / やっとのことで逃げてきたんだ。",
  "en": ""
 },
 {
  "id": "2E8000_096E.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2E8000_0976.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 4,
  "jp": "ふ、ふんっ！！ / そんなことより自分の心配をしたらどうだ！？ / ……お前のまわりには、 / かわいい女の子がいるじゃないか！！",
  "en": ""
 },
 {
  "id": "2E8000_09B8.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 3,
  "jp": "さあてと、あのナターシャとかいう女から / いぢめてやるかな…… / 楽しみにしてろよおっ！！",
  "en": ""
 },
 {
  "id": "2E8000_09F6.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……こんにちは。",
  "en": "",
  "dup": "2FB86E_0599.0"
 },
 {
  "id": "2E8000_09FE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "こんにちは、おにーさん。",
  "en": "",
  "dup": "2FB86E_05A1.0"
 },
 {
  "id": "2E8000_0A05.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "僕は冒険小説家を目指してる、 / ロイドンっていうんだ…… / レイモンド大陸で起こったことを / 忘れないようにメモしてたのさ。",
  "en": ""
 },
 {
  "id": "2E8000_0A1E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふーん……。",
  "en": "",
  "dup": "2FB86E_061B.0"
 },
 {
  "id": "2E8000_0A25.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "君は……どこからきたんだい？",
  "en": "",
  "dup": "2FB86E_0622.0"
 },
 {
  "id": "2E8000_0A2C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "僕はレイモンド王国を出て、 / ルシフォンの軍隊と闘い続けて…… / それでこの街にきたんだ。",
  "en": ""
 },
 {
  "id": "2E8000_0A39.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 3,
  "jp": "驚いたな、この街を解放したのは / 君たちだったのか？ / ……強いんだな、君は。",
  "en": ""
 },
 {
  "id": "2E8000_0A68.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん、僕は強いよ…… / でも、もっと強くなりたいんだ。",
  "en": "",
  "dup": "2F9C88_1808.0"
 },
 {
  "id": "2E8000_0A68.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "君の顔、どこかで見たことがあるな。",
  "en": ""
 },
 {
  "id": "2E8000_0A8F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "たしかソニアの街にあった / タケル様とバーン様の肖像画！？",
  "en": ""
 },
 {
  "id": "2E8000_0A96.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "も、もしかして君は…… / カケルって名前なんじゃないか！？",
  "en": "",
  "dup": "2FB86E_06DA.0"
 },
 {
  "id": "2E8000_0A96.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだよ、どうして僕の名前を知ってるの？",
  "en": "",
  "dup": "2FB86E_06DA.1"
 },
 {
  "id": "2E8000_0AA6.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうか！！　君がカケル君か！！",
  "en": ""
 },
 {
  "id": "2E8000_0AB9.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……いやあかの有名なタケル様の / 息子に会えるとは光栄だ！！",
  "en": ""
 },
 {
  "id": "2E8000_0ACF.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "レイモンド王国にいた商人に聞いたんだよ……",
  "en": "",
  "dup": "2EBA5F_0C9A.0"
 },
 {
  "id": "2E8000_0AD6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "タケル様とバーン様の息子が、レイモンド国王に / 呼ばれてこの大陸にきてるってね。",
  "en": "",
  "dup": "2F9C88_18AC.0"
 },
 {
  "id": "2E8000_0ADD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふーん……お父さんって、有名なんだなあ。",
  "en": "",
  "dup": "2FB86E_071D.0"
 },
 {
  "id": "2E8000_0AE4.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "ねえ、もしよかったら今までのことを / 話してくれないか？ / レイモンド大陸に渡ってきて…… / 君が今までどんな冒険をしてきたかってことを。",
  "en": ""
 },
 {
  "id": "2E8000_0B29.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいよ、まだ出発しないみたいだし。",
  "en": "",
  "dup": "2F9C88_18E0.1"
 },
 {
  "id": "2E8000_0B30.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうか……うれしいな。",
  "en": "",
  "dup": "2FB86E_0787.0"
 },
 {
  "id": "2E8000_0B37.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2E8000_0B47.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、また会ったね……",
  "en": ""
 },
 {
  "id": "2E8000_0B57.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕も君たちのあとを追って / トリアノンの村にきたんだ。",
  "en": ""
 },
 {
  "id": "2E8000_0B6F.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "またルシフォンの軍隊をやっつけたみたいだね… / よかったら、また僕に話をしてくれないか？",
  "en": "",
  "dup": "2EBA5F_0D2D.0"
 },
 {
  "id": "2E8000_0B6F.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度は何色のノートに書くかなあ。",
  "en": ""
 },
 {
  "id": "2E8000_0BC3.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……今度こそ僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_079C.0"
 },
 {
  "id": "2E8000_0BD9.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2E8000_0BE3.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "2E8000_0BF7.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度はどのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07D0.0"
 },
 {
  "id": "2E8000_0C11.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "君は何色が好きなんだい？ / 青色のノート",
  "en": "",
  "dup": "2FB86E_07EA.0"
 },
 {
  "id": "2E8000_0C26.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "赤色のノート / 緑色のノート | 次の機会にする",
  "en": "",
  "dup": "2FB86E_07FF.0"
 },
 {
  "id": "2E8000_0C57.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、青色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0830.0"
 },
 {
  "id": "2E8000_0C76.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 青色のノート",
  "en": "",
  "dup": "2FB86E_084F.0"
 },
 {
  "id": "2E8000_0C8B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、赤色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0864.0"
 },
 {
  "id": "2E8000_0CAA.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 赤色のノート",
  "en": "",
  "dup": "2FB86E_0883.0"
 },
 {
  "id": "2E8000_0CBF.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、緑色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0898.0"
 },
 {
  "id": "2E8000_0CDF.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 緑色のノート",
  "en": "",
  "dup": "2FB86E_08B8.0"
 },
 {
  "id": "2E8000_0CF0.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "に君の冒険を書き込もう。",
  "en": "",
  "dup": "2FB86E_08C9.0"
 },
 {
  "id": "2E8000_0CF0.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやあ、とても楽しかったよ…… / よかったらまた話を聞かせてくれ。",
  "en": "",
  "dup": "2FB86E_08C9.1"
 },
 {
  "id": "2E8000_0D26.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ごめん、やっぱり話をするのはやめるよ。",
  "en": "",
  "dup": "2FB86E_08FF.0"
 },
 {
  "id": "2E8000_0D3F.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか・・・また今度話を聞かせてくれよ。",
  "en": "",
  "dup": "2FB86E_0918.0"
 },
 {
  "id": "2E8000_0D6A.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ひえぇぇぇっ！！　た、大変だあっ！！ / 西の空から、黒い霧が迫ってくるぞお！！",
  "en": ""
 },
 {
  "id": "2E8000_0D6A.1",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 3,
  "jp": "私は見たんだ、 / ユリシーズの街が黒い霧に包まれるのを…… / そりゃあ、恐ろしい光景だった。",
  "en": ""
 },
 {
  "id": "2E8000_0DCC.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 3,
  "jp": "仲間のフルトンも、長老のシドも…… / みーんな石になってしまった、 / ぶるぶるぶるぶる！！",
  "en": ""
 },
 {
  "id": "2E8000_0E01.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 4,
  "jp": "ルシフォンが、あの黒い霧を / 操ってるにちがいないんだ…… / あの黒い霧は闇の世界から / 流れ出してきたってうわさだぜ！！",
  "en": ""
 },
 {
  "id": "2E8000_0E42.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "お、俺はどうすりゃいい…… / だれか、俺の進む道を教えてくれえ！！",
  "en": ""
 },
 {
  "id": "2E8000_0E6C.0",
  "speaker": "エルフ一族ララミナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "わ、私たちの村をこんなにしたのは……。",
  "en": ""
 },
 {
  "id": "2E8000_0E84.0",
  "speaker": "エルフ一族ニイナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンがくる……恐い……恐い……。",
  "en": ""
 },
 {
  "id": "2E8000_0E99.0",
  "speaker": "エルフ一族ムウ",
  "form": "dlg",
  "nlines": 2,
  "jp": "メ、メイフェア…… / 私のかわいい娘を……だれか助けてあげて……。",
  "en": ""
 },
 {
  "id": "2E8000_0EBE.0",
  "speaker": "エルフ一族サラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "か、彼女は……何者なの……。",
  "en": ""
 },
 {
  "id": "2E8000_0ED1.0",
  "speaker": "エルフ一族ターノン",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、あいつは……何者なんだ……。",
  "en": ""
 },
 {
  "id": "2E8000_0EE4.0",
  "speaker": "エルフ一族ロデオ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの軍隊が去ったあとに…… / ああ、恐ろしいことが……。",
  "en": ""
 },
 {
  "id": "2E8000_0F07.0",
  "speaker": "エルフ一族マハト",
  "form": "dlg",
  "nlines": 1,
  "jp": "魔法なんか使って……ずるいや……。",
  "en": ""
 },
 {
  "id": "2E8000_0F1E.0",
  "speaker": "エルフ一族チクリノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "や、やつには気をつけろ……やつは……。",
  "en": ""
 },
 {
  "id": "2E8000_0F34.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうもありがとう……もう平気です。",
  "en": ""
 },
 {
  "id": "2E8000_0F4B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "よかったね、元気になって。",
  "en": ""
 },
 {
  "id": "2E8000_0F5E.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ええ、この方がずっと看病してくれたから。",
  "en": ""
 },
 {
  "id": "2E8000_0F7A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、用がないならあっちに行けよ。",
  "en": ""
 },
 {
  "id": "2E8000_0F92.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトだって、用があるわけじゃないでしょ？",
  "en": ""
 },
 {
  "id": "2E8000_0FA9.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの、私……もう平気ですから。",
  "en": ""
 },
 {
  "id": "2E8000_0FBE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ほら、マルレーネだって / 平気って言ってるじゃないか。",
  "en": ""
 },
 {
  "id": "2E8000_0FBE.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 3,
  "jp": "エトさん、カケルさん…… / 私、お願いがあるんです。 / ……私を、仲間に加えてもらえませんか？",
  "en": ""
 },
 {
  "id": "2E8000_100A.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私、弓を使うことができます……",
  "en": ""
 },
 {
  "id": "2E8000_1020.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "それに、死んでいった仲間のためにも / 闘いたいんです。",
  "en": ""
 },
 {
  "id": "2E8000_103E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そりゃあ願ってもないことだ。",
  "en": ""
 },
 {
  "id": "2E8000_1052.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "実は私たちも、エルフ一族で / 仲間になってくれる人を捜しにきたんですよ。",
  "en": ""
 },
 {
  "id": "2E8000_1079.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "弓があれば、離れたところから攻撃できるね。",
  "en": ""
 },
 {
  "id": "2E8000_1097.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "それに、空を飛ぶドラゴンにだって / ダメージを与えられるぜ。",
  "en": ""
 },
 {
  "id": "2E8000_1097.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあ……仲間にしてもらえるんですね？",
  "en": ""
 },
 {
  "id": "2E8000_10D7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "もちろん…… / 君がいっしょに闘ってくれないと困るのだ。",
  "en": ""
 },
 {
  "id": "2E8000_10D7.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "？　なんか……ふくみのある言い方だなあ。",
  "en": ""
 },
 {
  "id": "2E8000_1115.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネが仲間に加わった！！",
  "en": ""
 },
 {
  "id": "2E8000_111F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うれしいなあ…… / こんなきれいな人といっしょに闘えるんだ。",
  "en": ""
 },
 {
  "id": "2E8000_111F.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの……さっきから気になってたんですけど、",
  "en": ""
 },
 {
  "id": "2E8000_115D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさんって、もしかして…… / あの「ヤマト・タケル」様の？",
  "en": ""
 },
 {
  "id": "2E8000_1180.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、パパの名前はタケルだよ。",
  "en": ""
 },
 {
  "id": "2E8000_1195.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "や、やはりカケルさんって / ……あのタケル様の息子なんですね！？",
  "en": ""
 },
 {
  "id": "2E8000_1195.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "あの……お父様のタケル様は / いっしょではないのですか？",
  "en": ""
 },
 {
  "id": "2E8000_1195.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、ああ……。",
  "en": ""
 },
 {
  "id": "2E8000_11DF.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "お父さんはミネルバ大陸で石になってるよ。",
  "en": ""
 },
 {
  "id": "2E8000_11FC.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ご、ごめんなさい…… / 変なことを聞いてしまいました。",
  "en": ""
 },
 {
  "id": "2E8000_11FC.1",
