  "nlines": 1,
  "jp": "カルタス",
  "en": ""
 },
 {
  "id": "2DA01B_022F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ゴロンゴン",
  "en": ""
 },
 {
  "id": "2DA01B_0235.0",
