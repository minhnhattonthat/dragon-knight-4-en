  "nlines": 1,
  "jp": "ガリバン",
  "en": ""
 },
 {
  "id": "2DA01B_0241.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネクラマンサー",
  "en": ""
 },
 {
  "id": "2DA01B_0247.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ピエール",
  "en": ""
 },
 {
  "id": "2DA01B_024D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ラビット",
  "en": ""
 },
 {
  "id": "2DA01B_0253.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "パウエル",
  "en": ""
 },
 {
  "id": "2DA01B_0259.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "バルカン",
  "en": ""
 },
 {
  "id": "2DA01B_025B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "、 / 君は外の捜索の指揮をとってくれ。",
  "en": ""
 },
 {
  "id": "2DA01B_02D5.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "は、はい……わかりました、エトさん。",
  "en": ""
 },
 {
  "id": "2DA01B_02EC.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかった、エト。こっちはまかせろ。",
  "en": ""
 },
 {
  "id": "2DA01B_0303.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "孑解したわ。そっちも気をつけてね。",
  "en": ""
 },
 {
  "id": "2DA01B_031B.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "あたしのこのすらりと伸びた足と知性的な / 顔をもってすれば、どうってことないわ。",
  "en": ""
 },
 {
  "id": "2DA01B_034B.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、わかった。セイル、気をつけてね。",
  "en": ""
 },
 {
  "id": "2DA01B_0363.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 1,
  "jp": "にゃ、わかったにゃん。",
  "en": ""
 },
 {
  "id": "2DA01B_0372.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかった……カケル殿、気をつけてな。",
  "en": ""
 },
 {
  "id": "2DA01B_0389.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "おう、孑解したぜ。",
  "en": ""
 },
 {
  "id": "2DA01B_0399.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "うむ。バナナが見つかるといいがなあ。",
  "en": ""
 },
 {
  "id": "2DA01B_03AF.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかった……気をつけろよ。",
  "en": ""
 },
 {
  "id": "2DA01B_03C2.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "うむ、わかったぞい。",
  "en": ""
 },
 {
  "id": "2DA01B_03D2.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺がじゃまで追い払うつもりなんだ。この村で / 新しい仲間を入れる気なんだ……ぶつぶつ……。",
  "en": ""
 },
 {
  "id": "2DA01B_0404.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかった、外の方は俺にまかせとけって。",
  "en": ""
 },
 {
  "id": "2DA01B_041E.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "にょにょにょ、わかったにょ。",
  "en": ""
 },
 {
  "id": "2DA01B_0432.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 2,
  "jp": "しかとうけたまわったでござる。 / 外の偵察はまかせてほしいでござる。",
  "en": ""
 },
 {
  "id": "2DA01B_045D.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかった……そちらも気をつけてな。",
  "en": ""
 },
 {
  "id": "2DA01B_0474.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……とにかく調べてみよう。",
  "en": ""
 },
 {
  "id": "2DA01B_048E.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "くのっくのっくのっ！（げしげしっ）",
  "en": ""
 },
 {
  "id": "2DA01B_04A5.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ばぶっばぶっばぶっ！　カケルたすけてえっ！",
  "en": ""
 },
 {
  "id": "2DA01B_04BF.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あはははは。",
  "en": ""
 },
 {
  "id": "2DA01B_04C9.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "またウェンディにふまれてるんだね、 / セイル。楽しいの？",
  "en": ""
 },
 {
  "id": "2DA01B_04E5.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "……これが楽しいなら、ルシフォンとの戦闘は / きっと天国にいる気分だろうね……。",
  "en": ""
 },
 {
  "id": "2DA01B_0517.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "くのっくのっくの……っ！（げしげしっ）",
  "en": ""
 },
 {
  "id": "2DA01B_0530.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ばぶっばぶっばぶっ！",
  "en": ""
 },
 {
  "id": "2DA01B_0540.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あ……まだやってる……）",
  "en": ""
 },
 {
  "id": "2DA01B_0559.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いやなところだね、カケル。",
  "en": ""
 },
 {
  "id": "2DA01B_056B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、人なんてぜんぜん住んでないみたいだ。",
  "en": ""
 },
 {
  "id": "2DA01B_0587.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "こ、こういうところにいるのいやだよ…… / 早く出たいなあ。",
  "en": ""
 },
 {
  "id": "2DA01B_05AE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぷつぶつぶつ……。",
  "en": ""
 },
 {
  "id": "2DA01B_05BD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あれ……エトが考えごとしてるぞ？）",
  "en": ""
 },
 {
  "id": "2DA01B_05D5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "……私は取り返しのつかないミスを犯しているの / ではないだろうか……このままでは……。",
  "en": ""
 },
 {
  "id": "2DA01B_05D5.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（……なんのことだろう？）",
  "en": ""
 },
 {
  "id": "2DA01B_061B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぶつぶつぶつ……。",
  "en": ""
 },
 {
  "id": "2DA01B_0625.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（……あっちにいこうっと）",
  "en": ""
 },
 {
  "id": "2DA01B_0638.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぶつぶつぶつ……。",
  "en": "",
  "dup": "2DA01B_061B.0"
 },
 {
  "id": "2DA01B_0642.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ……カケルさん。",
  "en": ""
 },
 {
  "id": "2DA01B_064F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "やあ、マルレーネ……どうしたの？ / うかない顔で。",
  "en": ""
 },
 {
  "id": "2DA01B_064F.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……早くこの村を出ましょう、カケルさん。",
  "en": ""
 },
 {
  "id": "2DA01B_0682.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……え？",
  "en": "",
  "dup": "2F2B41_1FD8.0"
 },
 {
  "id": "2DA01B_068C.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 3,
  "jp": "この気配……どこで感じたのか……でも、 / これはよくない……必ず悪いことがおこります。 / 早く出た方がいいです。",
  "en": ""
 },
 {
  "id": "2DA01B_06CC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "でも、ナターシャを取り戻さないと / 動くわけにはいかないよ。",
  "en": ""
 },
 {
  "id": "2DA01B_06CC.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうですね……でも……。",
  "en": ""
 },
 {
  "id": "2DA01B_06FD.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "……この感じ……よくないわ / ……なにか悪いことが……？",
  "en": ""
 },
 {
  "id": "2DA01B_071F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれ……ネレイド、元気がないね。",
  "en": ""
 },
 {
  "id": "2DA01B_0733.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "……私は……悪い女なの……。",
  "en": ""
 },
 {
  "id": "2DA01B_0746.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてさ！？",
  "en": ""
 },
 {
  "id": "2DA01B_0753.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャさんがさらわれたとき……",
  "en": ""
 },
 {
  "id": "2DA01B_0767.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私、一瞬だけど「これでエトさんも、私のこと見 / てくれるかもしれない」って思ったの……。",
  "en": ""
 },
 {
  "id": "2DA01B_0796.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネレイド……。",
  "en": ""
 },
 {
  "id": "2DA01B_07A0.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん……私……。",
  "en": ""
 },
 {
  "id": "2DA01B_07AB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネレイドは悪い女の子なんかじゃないよ。",
  "en": ""
 },
 {
  "id": "2DA01B_07BF.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "……ネレイドは、 / そんなにエトのことが好きなんだね。",
  "en": ""
 },
 {
  "id": "2DA01B_07BF.1",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……。",
  "en": ""
 },
 {
  "id": "2DA01B_07E5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "でも、ナターシャは絶対に取り返すよ…… / 手伝ってくれるよね？",
  "en": ""
 },
 {
  "id": "2DA01B_07E5.1",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "はい！　私……がんばります！",
  "en": ""
 },
 {
  "id": "2DA01B_081B.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん、私がんばります！",
  "en": ""
 },
 {
  "id": "2DA01B_082E.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……カケル。",
  "en": ""
 },
 {
  "id": "2DA01B_083A.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "早くナターシャを取り戻して出かけましょう。",
  "en": ""
 },
 {
  "id": "2DA01B_0853.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "こんな陰気なところに長居はしたくないわ。",
  "en": ""
 },
 {
  "id": "2DA01B_086D.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……複雑な気分です。",
  "en": ""
 },
 {
  "id": "2DA01B_087F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしたの、ビアンカ？",
  "en": ""
 },
 {
  "id": "2DA01B_088E.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "こんな複雑で、 / いやな気分になったのは初めてです。",
  "en": ""
 },
 {
  "id": "2DA01B_088E.1",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私、自分を大嫌いになりそうです……。",
  "en": ""
 },
 {
  "id": "2DA01B_08C7.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "すみません、ひとりにして下さい……。",
  "en": ""
 },
 {
  "id": "2DA01B_08DF.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "やあ、ジーナ。そっちはどう？ / なにか見つかった？",
  "en": ""
 },
 {
  "id": "2DA01B_08DF.1",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん……だめ。カケルの方は？",
  "en": ""
 },
 {
  "id": "2DA01B_090D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "こっちもさっぱりだ…… / どこにかくれてるんだろうなあ。",
  "en": ""
 },
 {
  "id": "2DA01B_090D.1",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あのね……。",
  "en": ""
 },
 {
  "id": "2DA01B_0937.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……なに、ジーナ？",
  "en": ""
 },
 {
  "id": "2DA01B_0945.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……あのね……カケルって強いのね。",
  "en": ""
 },
 {
  "id": "2DA01B_095A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、僕は強いよ。",
  "en": ""
 },
 {
  "id": "2DA01B_0969.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ドラゴンに乗った少年も、 / カケルくらいかっこいいといいな。",
  "en": ""
 },
 {
  "id": "2DA01B_0969.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……え？",
  "en": "",
  "dup": "2F2B41_1FD8.0"
 },
 {
  "id": "2DA01B_0994.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ごめん、ヘんなこと言っちゃった……。",
  "en": ""
 },
 {
  "id": "2DA01B_09A9.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あたし、もう少しこのヘんを捜してみる……。",
  "en": ""
 },
 {
  "id": "2DA01B_09CA.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "……なんだか気持ちの悪い部屋だなあ / ……石像ばっかりだ。",
  "en": ""
 },
 {
  "id": "2DA01B_09F4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "……なんだか気持ちのわるい部屋だなあ / ……石像ばっかりだ。",
  "en": ""
 },
 {
  "id": "2DA01B_09F4.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……あれっ？",
  "en": ""
 },
 {
  "id": "2DA01B_0A26.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あのだれにもまして気味の悪い石像は / どこかで見たことがあるような……？",
  "en": ""
 },
 {
  "id": "2DA01B_0A59.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……バーンおじさん！？",
  "en": ""
 },
 {
  "id": "2DA01B_0A6B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "カポネさんにアンガスさん…… / 商人のおじさんも！？ / どうしてこんなところに……？",
  "en": ""
 },
 {
  "id": "2DA01B_0A9F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "み、みんなきてくれ――――っ！！",
  "en": ""
 },
 {
  "id": "2DA01B_0ABA.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "どたどたどた……",
  "en": ""
 },
 {
  "id": "2DA01B_0AC5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、どうし……うわっ！？",
  "en": ""
 },
 {
  "id": "2DA01B_0AD8.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "えっ！？　パ、パパあっ！？",
  "en": ""
 },
 {
  "id": "2DA01B_0AEB.0",
  "speaker": "女の声",
  "form": "dlg",
  "nlines": 4,
  "jp": "フフフ、 / ハーディスはうまくやったようですね…… / さあ、お前たち……その者たちをつかまえて / たたきつぶしてしまいなさい。",
  "en": ""
 },
 {
  "id": "2DA01B_0B2D.0",
  "speaker": "バーンの石像",
  "form": "dlg",
  "nlines": 1,
  "jp": "無念じゃあ～……不覚をとった～……。",
  "en": ""
 },
 {
  "id": "2DA01B_0B49.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "バ、バーンおじさん！？　生きてるの？",
  "en": ""
 },
 {
  "id": "2DA01B_0B61.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ～……とうとう逃げ切れなかった～……。",
  "en": ""
 },
 {
  "id": "2DA01B_0B7B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "こ……これ……。",
  "en": ""
 },
 {
  "id": "2DA01B_0B88.0",
  "speaker": "カポネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……金をなくしただけでなく～……。",
  "en": ""
 },
 {
  "id": "2DA01B_0BA0.0",
  "speaker": "アンガス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……女をなくしただけでなく～……。",
  "en": ""
 },
 {
  "id": "2DA01B_0BB7.0",
  "speaker": "カポネ＆アンガス",
  "form": "dlg",
  "nlines": 1,
  "jp": "こんな目に～……あわされるとは理不尽な～。",
  "en": ""
 },
 {
  "id": "2DA01B_0BD7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だ、だめだ、みんなゾンビみたいになってる。",
  "en": ""
 },
 {
  "id": "2DA01B_0BF4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "バーンおじさんたちを砕いちゃうわけには / いかない……逃げるしかないや！",
  "en": ""
 },
 {
  "id": "2DA01B_0BF4.1",
  "speaker": "女の声",
  "form": "dlg",
  "nlines": 1,
  "jp": "逃がすわけにはいきません……。",
  "en": ""
 },
 {
  "id": "2DA01B_0C32.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だ、だれだっ！？",
  "en": ""
 },
 {
  "id": "2DA01B_0C47.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 5,
  "jp": "お初にお目にかかります…… / そしてこれで最後になる。 / ただ、神の血を受けた勇者に敬意を表して / 名乗りましょう……私の名はリディア。 / ルシフォン様の第一の側近です……。",
  "en": ""
 },
 {
  "id": "2DA01B_0C47.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォン！？　ナターシャはどこだ！！",
  "en": ""
 },
 {
  "id": "2DA01B_0CBD.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 1,
  "jp": "……その娘ならこの村にはおりません……。",
  "en": ""
 },
 {
  "id": "2DA01B_0CD7.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 4,
  "jp": "あの娘は、あなたがたをこの村ヘ / ご招待するためのおとり…… / ハーディスがあの娘をどうしたかまでは、 / 私の知るところではありません……。",
  "en": ""
 },
 {
  "id": "2DA01B_0D22.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そんなっ！？",
  "en": ""
 },
 {
  "id": "2DA01B_0D30.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 5,
  "jp": "どうやら村の外に、 / 私の軍も到着したようですね…… / さあ、外ヘ出て私の精鋭と絶望的な闘いを / 演じるか、それとも肉親や知人と殺しあうか、 / お好きな方を選ばせてさしあげます……。",
  "en": ""
 },
 {
  "id": "2DA01B_0D30.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "くっ……こ、こいつ……っ！！",
  "en": ""
 },
 {
  "id": "2DA01B_0DAD.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、冷静さを欠いたら負けだぞ！",
  "en": ""
 },
 {
  "id": "2DA01B_0DC7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "バーンたちと闘うわけにはいかない。 / ここは外に討って出るぞ！ / どんな状況でも……最後まであきらめるな！！",
  "en": ""
 },
 {
  "id": "2DA01B_0E07.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "わかったよ、エトっ！ / みんな、村の外に出て闘うんだ！！",
  "en": ""
 }
]
