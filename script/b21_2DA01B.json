[
 {
  "id": "2DA01B_0024.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "デス・バレー…… / ここに、ナターシャがいるんだね。",
  "en": ""
 },
 {
  "id": "2DA01B_0024.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "なにか……村全体から強いプレッシャーを / 感じます。",
  "en": ""
 },
 {
  "id": "2DA01B_0024.2",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "こ、こわいなあ……。",
  "en": ""
 },
 {
  "id": "2DA01B_0078.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "（ぴくくぅっ）またそーゆー軟弱なことをっ！",
  "en": ""
 },
 {
  "id": "2DA01B_0098.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あたしはそ～ゆ～セリフ大っきらいだって / 何度も言ってるでしょうが！！",
  "en": ""
 },
 {
  "id": "2DA01B_00D4.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いじめないでよう……。",
  "en": ""
 },
 {
  "id": "2DA01B_00E4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "それにしてもこの圧迫感…… / どこかにマリアンでもいるのかな？",
  "en": ""
 },
 {
  "id": "2DA01B_00E4.1",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぎくうっ！　ややややめてよカケルっ！！",
  "en": ""
 },
 {
  "id": "2DA01B_0186.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……とにかく部隊を二手にわけよう。",
  "en": ""
 },
 {
  "id": "2DA01B_019E.0",
  "speaker": "",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
