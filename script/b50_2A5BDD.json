 },
 {
  "id": "2A5BDD_1FFE.1",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "あいつらときたら、 / この俺様を仲間だとカンちがいしやがって……。",
  "en": ""
 },
 {
  "id": "2A5BDD_1FFE.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ライナスっ！！",
  "en": ""
 },
 {
  "id": "2A5BDD_204B.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ぎゃあああああっ！！ / デス・バレーのゴーレムが追っかけてきたあ！！",
  "en": ""
 },
 {
  "id": "2A5BDD_2077.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "はっきり言うが、 / 私はストーンゴーレムなどではないぞ。",
  "en": ""
 },
 {
  "id": "2A5BDD_209C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ここを出るとドラゴンの砦に行くことになる。 / つまり戻るってことだ。",
  "en": ""
 },
 {
  "id": "2A5BDD_20C6.0",
  "speaker": "女の子の声",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふん、ふん……♥",
  "en": "",
  "dup": "2D8000_1AE7.0"
 },
 {
  "id": "2A5BDD_20D5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "おや？ / 鼻歌が聞こえるぞ……この中か？",
  "en": ""
 },
 {
  "id": "2A5BDD_20F4.0",
  "speaker": "女の子",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふん、ふん……♥",
