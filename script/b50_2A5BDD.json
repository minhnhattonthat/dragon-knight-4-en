  "dup": "2FB86E_08C9.1"
 },
 {
  "id": "2A5BDD_1F2C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "すまないが、やっぱり話をするのはやめよう。",
