 },
 {
  "id": "2A5BDD_08FC.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "今度は俺たちが、逆にライムリン大陸に / 攻め入る番だ……おぼえてろよ、ルシフォンめ！",
  "en": ""
 },
 {
  "id": "2A5BDD_0923.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿、好きだあ。",
  "en": ""
 },
 {
  "id": "2A5BDD_0932.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……そっとしておこう。",
  "en": ""
 },
 {
  "id": "2A5BDD_0943.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト……ドワラルの村の東には、 / ポーの港街があるんですって。",
  "en": ""
 },
 {
  "id": "2A5BDD_0943.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "その通りだ……",
  "en": ""
 },
 {
  "id": "2A5BDD_096C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "その港街の手前で待ち伏せしてる / ルシフォン軍を倒せば、 / 私たちはライムリン大陸に行けるだろう。",
  "en": ""
 },
 {
  "id": "2A5BDD_096C.1",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ライムリン大陸…… / その名前を聞く度に、心が高鳴るわ。",
  "en": ""
 },
 {
  "id": "2A5BDD_096C.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どれどれ。",
  "en": ""
 },
 {
  "id": "2A5BDD_09C1.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "あのねえ……カケルみたいなことしないでよ。",
  "en": ""
 },
 {
  "id": "2A5BDD_09D8.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト……ライムリン大陸には、 / 私たちが目指すライムリン王国があるはずよ。",
  "en": ""
 },
 {
  "id": "2A5BDD_09FA.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ゴロンゴンバナナか……うんうん。",
  "en": ""
 },
 {
  "id": "2A5BDD_0A0C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ゴロンゴンは、一日中バナナのことを / 考えてるんだな。",
  "en": ""
 },
 {
  "id": "2A5BDD_0A0C.1",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "それはちがうぞ……寝てる時だって、 / ちゃんとバナナの夢を見てるんだ。",
  "en": ""
 },
 {
  "id": "2A5BDD_0A4F.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト……バナナが世界の主食になる日が / 来ればいいよなあ。",
  "en": ""
 },
 {
  "id": "2A5BDD_0A4F.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2A5BDD_0A78.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "（ルシフォンが世界を征服する次くらいに / イヤだぞ、それは）",
  "en": ""
 },
 {
  "id": "2A5BDD_0A9C.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "うーん、お客さぁん…… / だめよ、そんなとこさわっちゃあ。",
  "en": "",
  "dup": "2D8000_0A80.0"
 },
 {
  "id": "2A5BDD_0A9C.1",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすうすう……すうすうすう。",
  "en": "",
  "dup": "2D8000_0A80.1"
 },
 {
  "id": "2A5BDD_0ACC.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……最近、私に冷たくありませんか？",
  "en": ""
 },
 {
  "id": "2A5BDD_0AE8.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ど、どうしてだ？",
  "en": ""
 },
 {
  "id": "2A5BDD_0AF6.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "全然私のことをかまってくれないですし…… / 優しい言葉すらかけてくれないじゃないですか。",
  "en": ""
 },
 {
  "id": "2A5BDD_0AF6.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "メイフェア、怪我をしないように闘うんだぞ。",
  "en": ""
 },
 {
  "id": "2A5BDD_0B40.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "今さらそんなことを言われても、 / ちっともうれしくありません。",
  "en": ""
 },
 {
  "id": "2A5BDD_0B65.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさんは好きな女性がいるんですね…… / だから私に優しくしてくれないんです。",
  "en": ""
 },
 {
  "id": "2A5BDD_0B94.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト…… / カケルとナターシャってつき合ってるのか？",
  "en": ""
 },
 {
  "id": "2A5BDD_0B94.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ、そうみたいだな。",
  "en": ""
 },
 {
  "id": "2A5BDD_0BC0.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあ聞くけど、エトはどうなんだ？",
  "en": ""
 },
 {
  "id": "2A5BDD_0BD7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "わっはっはっ！！ / 私はみんなを愛してるぞ……ひとり残らずな。",
  "en": ""
 },
 {
  "id": "2A5BDD_0BD7.1",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "そういう答えが一番たちが悪いんだ……。",
  "en": ""
 },
 {
  "id": "2A5BDD_0C15.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "あーあ……エトなんか、 / 好きになるんじゃなかったよ。",
  "en": "",
  "dup": "2D8000_0BAC.0"
 },
 {
  "id": "2A5BDD_0C15.1",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "もうエトのことなんかどーでもいいや……",
  "en": ""
 },
 {
  "id": "2A5BDD_0C4E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンを倒したら、 / 新しい彼氏をつくって幸せな結婚をするんだ。",
  "en": ""
 },
 {
  "id": "2A5BDD_0C75.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "クラリスが結婚をするのか！？ / ……そりゃあ大変だな。",
  "en": ""
 },
 {
  "id": "2A5BDD_0C75.1",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "なにが大変なんだよう…… / 詳しく説明してくれよ、エト。",
  "en": ""
 },
 {
  "id": "2A5BDD_0CB9.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト、早く説明してくれよ…… / 私が結婚するとなにが大変なんだ？",
  "en": ""
 },
 {
  "id": "2A5BDD_0CE2.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやあ、今回は特に激しい闘いだったなあ…… / もう身体がボロボロだよ。",
  "en": "",
  "dup": "2D8000_0BCD.0"
 },
 {
  "id": "2A5BDD_0CE2.1",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 3,
  "jp": "まあ、それだけ俺たちがルシフォンが / いるばしょに近づいているってことだからな…… / やつらも必死なんだぜ、きっと。",
  "en": ""
 },
 {
  "id": "2A5BDD_0D4F.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ここはドワラルの村だろ？",
  "en": "",
  "dup": "2D8000_0C3C.0"
 },
 {
  "id": "2A5BDD_0D5D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……この村の東には、 / ポーの港街があるそうだぜ。",
  "en": "",
  "dup": "2D8000_0C4A.0"
 },
 {
  "id": "2A5BDD_0D74.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト殿……先ほどの闘いは、 / 今までになく激しいものであったぞい。",
  "en": ""
 },
 {
  "id": "2A5BDD_0D74.1",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "しかし我々の軍隊は史上最強だぞい……",
  "en": ""
 },
 {
  "id": "2A5BDD_0DB5.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "やつらがいくら軍隊を増強しようと、 / 我々にかなうわけがないぞい。",
  "en": "",
  "dup": "2D8000_0CBD.0"
 },
 {
  "id": "2A5BDD_0DDA.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト殿、ドワラルの村の東には / ポーの港街があるそうだぞい。",
  "en": ""
 },
 {
  "id": "2A5BDD_0DF5.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさん……ドラゴンが味方についてくれますと / やはり心強いですわね。",
  "en": ""
 },
 {
  "id": "2A5BDD_0DF5.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ああ……空から攻撃できることが、 / これほど効果があるとは思わなかった。",
  "en": ""
 },
 {
  "id": "2A5BDD_0DF5.2",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "これで私たちの結婚も、 / より現実味を帯びてきましたわ。",
  "en": ""
 },
 {
  "id": "2A5BDD_0DF5.3",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "いきなり話題を変えないでくれ、ビアンカ。",
  "en": ""
 },
 {
  "id": "2A5BDD_0E83.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさんは……どんな女性が好きなんですか？",
  "en": ""
 },
 {
  "id": "2A5BDD_0E9F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "結婚の話をしない女だ。",
  "en": ""
 },
 {
  "id": "2A5BDD_0EB2.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2BBE84_17F9.0"
 },
 {
  "id": "2A5BDD_0EBA.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさんって……ずるいですわ。",
  "en": ""
 },
 {
  "id": "2A5BDD_0ECC.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 2,
  "jp": "いきなりだが、エト…… / 私と結婚する女性は幸せだろうな。",
  "en": ""
 },
 {
  "id": "2A5BDD_0ECC.1",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 4,
  "jp": "毎日いっしょにいても、 / 会話すらかわす必要がない…… / これほど手間のかからない亭主は、 / 他にはいないだろう。",
  "en": ""
 },
 {
  "id": "2A5BDD_0F36.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2A5BDD_0F3E.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は、ベスト・オブ・ダディだぞ…… / わかってるのか、エト？",
  "en": ""
 },
 {
  "id": "2A5BDD_0F3E.1",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 2,
  "jp": "まあ私ぐらいの人物となると、 / 嫁にする女は厳選しなければな。",
  "en": ""
 },
 {
  "id": "2A5BDD_0F3E.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "どうせ口を利かないなら、 / 馬とか羊を嫁さんにしたらどうだ？",
  "en": ""
 },
 {
  "id": "2A5BDD_0F3E.3",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……なかなかいいアイデアだな。",
  "en": ""
 },
 {
  "id": "2A5BDD_0FCD.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 2,
  "jp": "馬語と羊語を勉強しなくては…… / よし、ルシフォンを倒したら留学でもするか。",
  "en": ""
 },
 {
  "id": "2A5BDD_0FFD.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、最近脚の調子がいいのよ……",
  "en": ""
 },
 {
  "id": "2A5BDD_1015.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "つるつるしてて張りがあって、 / 触ってるだけでいとおしくなっちゃうわ。",
  "en": ""
 },
 {
  "id": "2A5BDD_103D.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ああ、早くルシフォンに…… / この脚を見てもらいたいわあ。",
  "en": "",
  "dup": "2D8000_105A.0"
 },
 {
  "id": "2A5BDD_105E.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……セイルを普通の剣士に戻してよ。",
  "en": ""
 },
 {
  "id": "2A5BDD_1078.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おいおい、無理を言うな……",
  "en": ""
 },
 {
  "id": "2A5BDD_108C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "空を飛べる部隊がいないと、 / これからの闘いが苦しくなるだろ？",
  "en": ""
 },
 {
  "id": "2A5BDD_10B1.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "だって……セイルったらドラゴン酔いで、 / 私とロクに話もしてくれないのよ。",
  "en": ""
 },
 {
  "id": "2A5BDD_10D8.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "セイルう……ドラゴンナイトなんだから、 / ドラゴンの背中に乗って酔わないでよお。",
  "en": ""
 },
 {
  "id": "2A5BDD_1101.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふう……もうくたくただよ。",
  "en": "",
  "dup": "2D8000_118F.0"
 },
 {
  "id": "2A5BDD_1114.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 4,
  "jp": "なあエト、 / 俺たちはいつまで闘い続ければいいんだ？ / ……このままずっと闘ってたら、 / そのうちに倒れちゃうぜ。",
  "en": ""
 },
 {
  "id": "2A5BDD_1154.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 2,
  "jp": "他のみんなだって疲れてるんだ…… / この村でゆっくりと休養しようぜ。",
  "en": ""
 },
 {
  "id": "2A5BDD_117F.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……あのね。",
  "en": ""
 },
 {
  "id": "2A5BDD_118C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしたんだ、ジーナ？",
  "en": ""
 },
 {
  "id": "2A5BDD_119C.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私ね……カケルとね。",
  "en": ""
 },
 {
  "id": "2A5BDD_11AB.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルと？",
  "en": ""
 },
 {
  "id": "2A5BDD_11B5.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん、なんでもないの……ごめんなさい。",
  "en": ""
 },
 {
  "id": "2A5BDD_11C7.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 3,
  "jp": "あの時のことを思い出すと、 / 心臓がどきどきしちゃうの…… / まるで小さな爆弾が爆発してるみたいに。",
  "en": ""
 },
 {
  "id": "2A5BDD_1203.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあラビット……だいぶ活躍してるな。",
  "en": ""
 },
 {
  "id": "2A5BDD_121B.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕なんかまだまだだにょ……みんなに / 助けられながら、なんとか闘ってるにょ。",
  "en": ""
 },
 {
  "id": "2A5BDD_1247.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "これからもよろしくだにょ。",
  "en": "",
  "dup": "2D8000_145F.0"
 },
 {
  "id": "2A5BDD_125A.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 2,
  "jp": "激しい闘いでこざったな…… / 拙者も、何度か危ない目に合ってたでござる。",
  "en": ""
 },
 {
  "id": "2A5BDD_125A.1",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 2,
  "jp": "しかしエト殿は強いでござるな…… / ほとほと感心したでござるよ。",
  "en": ""
 },
 {
  "id": "2A5BDD_12AC.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 3,
  "jp": "この村を東に行けば、 / 港街があるといううわさでござる…… / また船旅でござるな、エト殿。",
  "en": ""
 },
 {
  "id": "2A5BDD_12E0.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 1,
  "jp": "にゃんにゃん、さすがに疲れたにゃん。",
  "en": "",
  "dup": "2D8000_14F9.0"
 },
 {
  "id": "2A5BDD_12F5.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 3,
  "jp": "他のみんなは、私よりずーっと前から / 闘い続けてるにゃん…… / すごい体力だと思うにゃん。",
  "en": ""
 },
 {
  "id": "2A5BDD_1326.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 2,
  "jp": "にゃんにゃん、私は強い男が好きだにゃん。 / 強くなければ男じゃないにゃん。",
  "en": ""
 },
 {
  "id": "2A5BDD_1349.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 1,
  "jp": "私はマルレーネと話したことがないのだ。",
  "en": ""
 },
 {
  "id": "2A5BDD_135F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "それが、どうかしたのか？",
  "en": ""
 },
 {
  "id": "2A5BDD_1371.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 2,
  "jp": "どうかしたのか、だと？ / ……あまりにもさびしいではないか。",
  "en": ""
 },
 {
  "id": "2A5BDD_1371.1",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 2,
  "jp": "私がこんなに好いているのに、 / 彼女ときたら、私のことなど見もしない。",
  "en": ""
 },
 {
  "id": "2A5BDD_1371.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "彼女は……色々と悩みがあるのさ。",
  "en": ""
 },
 {
  "id": "2A5BDD_13D3.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ならば私が相談に乗ってやろう。",
  "en": ""
 },
 {
  "id": "2A5BDD_13E9.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "人生経験豊富な私が相談に乗れば、 / マルレーネの悩みなど / 一瞬にして消え失せてしまうぞ。",
  "en": ""
 },
 {
  "id": "2A5BDD_141F.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ああマルレーネ……あれほどの美しい人が、 / この世に存在してたとは。",
  "en": ""
 },
 {
  "id": "2A5BDD_1447.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "トルル……君が仲間に加わってくれて、 / 本当に助かるぞ。",
  "en": ""
 },
 {
  "id": "2A5BDD_1447.1",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕はおじいちゃんに言われたから、 / しかたなく闘ってるんだ。",
  "en": ""
 },
 {
  "id": "2A5BDD_148C.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 2,
  "jp": "みんなも空を飛べれば、あっという間に / ライムリン大陸なんだけどなぁ。",
  "en": ""
 },
 {
  "id": "2A5BDD_14BC.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "きゃっ……だ、だれですか？",
  "en": ""
 },
 {
  "id": "2A5BDD_14CF.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……脅かさないでください。",
  "en": ""
 },
 {
  "id": "2A5BDD_14E7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "すまなかった、レア……寝ようとしてたのか？",
  "en": ""
 },
 {
  "id": "2A5BDD_1502.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "ええ……。",
  "en": ""
 },
 {
  "id": "2A5BDD_150C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2A5BDD_1514.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なんですか？",
  "en": ""
 },
 {
  "id": "2A5BDD_1522.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "いや……そうやって横になってると、 / レアも女らしく見えるな。",
  "en": ""
 },
 {
  "id": "2A5BDD_1522.1",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 2,
  "jp": "失礼な言い方をしないでください…… / そんなに普段の私は男っぽいですか？",
  "en": ""
 },
 {
  "id": "2A5BDD_1522.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私の言い方がよくなかったみたいだな……",
  "en": ""
 },
 {
  "id": "2A5BDD_158E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私が言いたかったのは、 / いつも以上に色っぽく見えるってことだ。",
  "en": ""
 },
 {
  "id": "2A5BDD_15B3.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "やだ……。",
  "en": ""
 },
 {
  "id": "2A5BDD_15BD.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "君ぐらいの女性であれば、 / 男がほっておかないだろう。",
  "en": ""
 },
 {
  "id": "2A5BDD_15BD.1",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 3,
  "jp": "エトさん、色っぽいと言われるのは / うれしいですけど…… / そんな話をしてる場合ではないと思います。",
  "en": ""
 },
 {
  "id": "2A5BDD_1617.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "たしかにそうだな……レアの言うとおりだ。",
  "en": ""
 },
 {
  "id": "2A5BDD_1637.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……私、眠りたいんですけど。",
  "en": ""
 },
 {
  "id": "2A5BDD_1650.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "きゃっ……だ、だれですか！？",
  "en": ""
 },
 {
  "id": "2A5BDD_1667.0",
  "speaker": "レア",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2A5BDD_1670.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……。",
  "en": ""
 },
 {
  "id": "2A5BDD_167B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "またエトさんですか、脅かさないでください。",
  "en": ""
 },
 {
  "id": "2A5BDD_1694.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "すまない……レア。",
  "en": ""
 },
 {
  "id": "2A5BDD_16A3.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "へレネのこと……ありがとうございました。",
  "en": ""
 },
 {
  "id": "2A5BDD_16BB.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "いや、私はなにもしていない。",
  "en": ""
 },
 {
  "id": "2A5BDD_16CF.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 5,
  "jp": "いいえ！ / 私は、エトさんの言葉を信じませんでした。 / へレネの無事を祈りながら、 / どこかであきらめの気持ちを持っていたんです。 / あんなに信じろと言ってくれたのに……。",
  "en": ""
 },
 {
  "id": "2A5BDD_16CF.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "へレネが生きのびたのは、 / あの娘の幸運と、頭のよさと、 / なにより生きて姉に再会するんだという / 強い意思のたまものだ。",
  "en": ""
 },
 {
  "id": "2A5BDD_1774.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "……エトさん。",
  "en": ""
 },
 {
  "id": "2A5BDD_1781.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "……私はいくよ。 / じゃましてすまなかったな。",
  "en": ""
 },
 {
  "id": "2A5BDD_1781.1",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……。",
  "en": "",
  "dup": "2B3278_1D08.0"
 },
 {
  "id": "2A5BDD_17AB.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさん……あなたの顔を見ると / 心臓がどきどきして、眠れそうにありません。",
  "en": ""
 },
 {
  "id": "2A5BDD_17D9.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……エトさん。",
  "en": ""
 },
 {
  "id": "2A5BDD_17E7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、へレネ……なにをしてるんだい？",
  "en": ""
 },
 {
  "id": "2A5BDD_17FD.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 4,
  "jp": "なんでか寝られなくて……あ、そうだ。 / 忘れていました。 / 私と姉を助けてくださったこと、 / どうもありがとうございました。",
  "en": ""
 },
 {
  "id": "2A5BDD_1840.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "いや…… / わたしは礼を言われるようなことはしていない。 / 君たちを救ったのは、 / 君たちの再会を願う強い意思だ。",
  "en": ""
 },
 {
  "id": "2A5BDD_1882.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "レアの気持ち、わかるなあ……。",
  "en": ""
 },
 {
  "id": "2A5BDD_1896.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……なんだ、それは？",
  "en": ""
 },
 {
  "id": "2A5BDD_18A6.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 4,
  "jp": "くすっ、レアには絶対言うなって / 言われてるんですけど……言っちゃいますね。 / レアはあなたのことが / 好きになったみたいなんです。",
  "en": ""
 },
 {
  "id": "2A5BDD_18EE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……光栄、というべきだな、それは。",
  "en": ""
 },
 {
  "id": "2A5BDD_1907.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 3,
  "jp": "な、なんか…… / あんまりうれしそうじゃないですね。 / ひょっとして、好きな人がいるんですか？",
  "en": ""
 },
 {
  "id": "2A5BDD_193D.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "ああ、いるぞ",
  "en": ""
 },
 {
  "id": "2A5BDD_1948.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "いや、いない",
  "en": ""
 },
 {
  "id": "2A5BDD_195B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ……いるぞ。",
  "en": ""
 },
 {
  "id": "2A5BDD_1967.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "やっぱり……かわいそうなレア。",
  "en": ""
 },
 {
  "id": "2A5BDD_197C.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "それじゃ、エトさんはだれが好きなんですか？",
  "en": ""
 },
 {
  "id": "2A5BDD_1997.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……だれが？",
  "en": ""
 },
 {
  "id": "2A5BDD_19A3.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（私はいったい、だれが好きなんだろう？）",
  "en": ""
 },
 {
  "id": "2A5BDD_19BF.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "ナターシャが好き",
  "en": "",
  "dup": "2B0000_03E5.0"
 },
 {
  "id": "2A5BDD_19C9.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "マルレーネも好き",
  "en": ""
 },
 {
  "id": "2A5BDD_19DB.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "（そう、私はナターシャを守るために / この世界にきたんだ）",
  "en": ""
 },
 {
  "id": "2A5BDD_19DB.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（しかし、本当にそれだけなのだろうか？",
  "en": ""
 },
 {
  "id": "2A5BDD_1A0F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私に黒い石を渡してくれた時の…… / あのマルレーネのまなざし……）",
  "en": ""
 },
 {
  "id": "2A5BDD_1A32.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "（私はナターシャだけでなく、彼女を / 救うためにも闘っているのではないか？）",
  "en": ""
 },
 {
  "id": "2A5BDD_1A32.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（も、もしかして私は……？）",
  "en": ""
 },
 {
  "id": "2A5BDD_1A6B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（ナターシャは大好きだ……しかし、",
  "en": ""
 },
 {
  "id": "2A5BDD_1A7E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネにも同じような / 感情を持ってはいないか？）",
  "en": ""
 },
 {
  "id": "2A5BDD_1A98.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（そうなると私は……？）",
  "en": ""
 },
 {
  "id": "2A5BDD_1AA9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（そうか……私はナターシャと同じように、",
  "en": ""
 },
 {
  "id": "2A5BDD_1ABC.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネにも特別な / 感情をいだいているのだ）",
  "en": ""
 },
 {
  "id": "2A5BDD_1AE0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "（だからカケルと彼女が / 抱き合っているのを見た時 / ……私はあれほど取り乱してしまった）",
  "en": ""
 },
 {
  "id": "2A5BDD_1B14.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "（私はなにを考えているのだ…… / 同じ人間が同じ時間を共有することはできない）",
  "en": ""
 },
 {
  "id": "2A5BDD_1B42.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（私はいずれ消え行く身だ……",
  "en": ""
 },
 {
  "id": "2A5BDD_1B56.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "その私が、人を好きになることに / どんな意味があると言うのだ？）",
  "en": ""
 },
 {
  "id": "2A5BDD_1B79.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は……負けない。",
  "en": ""
 },
 {
  "id": "2A5BDD_1B89.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ど、どうしたんですか、エトさん……。",
  "en": ""
 },
 {
  "id": "2A5BDD_1BA0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンを倒し……救うのだ。",
  "en": ""
 },
 {
  "id": "2A5BDD_1BB3.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "たとえ……消え行く身であろうとも。",
  "en": ""
 },
 {
  "id": "2A5BDD_1BCB.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……消える？",
  "en": ""
 },
 {
  "id": "2A5BDD_1BD8.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は……負けるわけにはいかない。",
  "en": ""
 },
 {
  "id": "2A5BDD_1BEF.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F2B41_1615.0"
 },
 {
  "id": "2A5BDD_1BF7.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……どうしちゃったんですか？",
  "en": ""
 },
 {
  "id": "2A5BDD_1C1B.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "やあエト君、 / やっとまともな村にたどり着いたね…… / 僕たち以外、だれもいないから / 寂しい感じがするけど。",
  "en": ""
 },
 {
  "id": "2A5BDD_1C5B.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 3,
  "jp": "ルシフォン軍は、僕たちの仲間を / 増やしたくないみたいだね…… / 考えてみれば当たり前のことだけどね。",
  "en": ""
 },
 {
  "id": "2A5BDD_1C91.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "そんなことよりエト君、 / さっきの闘いはさらにすごかったね…… / 僕は離れて見てたけど、 / 血が逆流するかと思えるほど興奮したよ。",
  "en": ""
 },
 {
  "id": "2A5BDD_1CDE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ロイドンもいっしょに闘うかい？",
  "en": ""
 },
 {
  "id": "2A5BDD_1CF1.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル君も同じことを言ってたよ……",
  "en": ""
 },
 {
  "id": "2A5BDD_1D07.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "でも僕なんかが仲間になったら、 / みんなの足手まといになるだけさ。",
  "en": ""
 },
 {
  "id": "2A5BDD_1D2C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "わからないぞ…… / 戦闘は腕力だけじゃなくて、頭も使うからな。",
  "en": ""
 },
 {
  "id": "2A5BDD_1D2C.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "エト君に誘われると、 / ついついその気になっちゃいそうだね…… / でもやっぱり僕は、カケル君とエト君の話を / 聞いて想像力をふくらませることにするよ。",
  "en": ""
 },
 {
  "id": "2A5BDD_1DA5.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "さあ、今日は何色のノートがいい？ / ……もちろん話はしてくれるんだろ？",
  "en": "",
  "dup": "2D8000_17DF.0"
 },
 {
  "id": "2A5BDD_1DD8.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……今度こそ僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_079C.0"
 },
 {
  "id": "2A5BDD_1DEE.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2A5BDD_1DF7.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "2A5BDD_1E0B.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度はどのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07D0.0"
 },
 {
  "id": "2A5BDD_1E24.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "君は何色が好きなんだい？ / 青色のノート",
  "en": "",
  "dup": "2FB86E_07EA.0"
 },
 {
  "id": "2A5BDD_1E39.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "赤色のノート / 緑色のノート | 次の機会にする",
  "en": "",
  "dup": "2FB86E_07FF.0"
 },
 {
  "id": "2A5BDD_1E6A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は青色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_11D8.0"
 },
 {
  "id": "2A5BDD_1E85.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 青色のノート",
  "en": "",
  "dup": "2FB86E_084F.0"
 },
 {
  "id": "2A5BDD_1E9A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は赤色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_1208.0"
 },
 {
  "id": "2A5BDD_1EB5.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 赤色のノート",
  "en": "",
  "dup": "2FB86E_0883.0"
 },
 {
  "id": "2A5BDD_1ECA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は緑色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_1238.0"
 },
 {
  "id": "2A5BDD_1EE5.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 緑色のノート",
  "en": "",
  "dup": "2FB86E_08B8.0"
 },
 {
  "id": "2A5BDD_1EF6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "に君の冒険を書き込もう。",
  "en": "",
  "dup": "2FB86E_08C9.0"
 },
 {
  "id": "2A5BDD_1EF6.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやあ、とても楽しかったよ…… / よかったらまた話を聞かせてくれ。",
