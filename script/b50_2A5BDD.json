 },
 {
  "id": "2A5BDD_1FFE.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "はあはあはあ……ちくしょう、 / やっとデス・バレーの村から逃げ出せた。",
