  "dup": "2CA4C9_129A.0"
 },
 {
  "id": "2A5BDD_1F47.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……また今度話を聞かせてくれよ。",
  "en": "",
  "dup": "2CA4C9_12B5.0"
 },
 {
  "id": "2A5BDD_1F6B.0",
  "speaker": "ラスカス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふん、ひとつだけいいことを教えてやるぞ。",
  "en": "",
  "dup": "2D8000_19AA.0"
 },
 {
  "id": "2A5BDD_1F86.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "空を飛んでいる時に見えたんだが、 / この村の東には港街があるようだな。",
  "en": "",
  "dup": "2D8000_19C5.0"
 },
 {
  "id": "2A5BDD_1FAD.0",
  "speaker": "ラスカス",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は誇り高きホワイトドラゴンだ…… / 人間などと話をする気はない。",
  "en": "",
  "dup": "2D8000_19EC.0"
 },
 {
  "id": "2A5BDD_1FD0.0",
  "speaker": "サイレス",
  "form": "dlg",
  "nlines": 2,
  "jp": "しっしっしっ、あっちに行ってろ…… / 私に触っていいのは、トルルとセイル様だけだ。",
