  "dup": "2E8000_0D6A.0"
 },
 {
  "id": "2DE230_14CA.1",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 3,
  "jp": "私は見たんだ、 / ユリシーズの街が黒い霧に包まれるのを…… / そりゃあ、恐ろしい光景だった。",
  "en": "",
  "dup": "2E8000_0D6A.1"
 },
 {
  "id": "2DE230_152C.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 3,
  "jp": "仲間のフルトンも、長老のシドも…… / みーんな石になってしまった、 / ぶるぶるぶるぶる！！",
