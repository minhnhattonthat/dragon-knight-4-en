 },
 {
  "id": "2DE230_13C9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は青色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_11D8.0"
 },
 {
  "id": "2DE230_13E4.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 青色のノート",
  "en": "",
  "dup": "2FB86E_084F.0"
 },
 {
  "id": "2DE230_13F9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は赤色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_1208.0"
 },
 {
  "id": "2DE230_1414.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 赤色のノート",
  "en": "",
  "dup": "2FB86E_0883.0"
 },
 {
  "id": "2DE230_1429.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は緑色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_1238.0"
 },
 {
  "id": "2DE230_1444.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 緑色のノート",
  "en": "",
  "dup": "2FB86E_08B8.0"
 },
 {
  "id": "2DE230_1455.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "に君の冒険を書き込もう。",
  "en": "",
  "dup": "2FB86E_08C9.0"
 },
 {
  "id": "2DE230_1455.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやあ、とても楽しかったよ…… / よかったらまた話を聞かせてくれ。",
  "en": "",
  "dup": "2FB86E_08C9.1"
 },
 {
  "id": "2DE230_148B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "すまないが、やっぱり話をするのはやめよう。",
