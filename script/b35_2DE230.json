  "nlines": 1,
  "jp": "いいえ",
  "en": "",
  "dup": "2F9C88_11A3.0"
 },
 {
  "id": "2DE230_16FB.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "みんな！！　出発するぞっ！！",
  "en": ""
 },
 {
