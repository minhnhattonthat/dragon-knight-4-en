 },
 {
  "id": "2DE230_0D9E.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "先ほどの闘いを見せてもらったぞ…… / いやあ、エト殿の剣さばきはすばらしいな。",
  "en": ""
 },
 {
  "id": "2DE230_0D9E.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そりゃそうだ……これで二回目なんだから。",
  "en": ""
 },
 {
  "id": "2DE230_0DE4.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "なにが……二回目なのだ？",
  "en": ""
 },
 {
  "id": "2DE230_0DF8.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そういえば、カケル殿も強い剣士になるぞ…… / まだまだ荒削りだが、さすがタケル殿の息子だ。",
  "en": ""
 },
 {
  "id": "2DE230_0DF8.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そりゃそうだ……以前の私なんだから。",
  "en": ""
 },
 {
  "id": "2DE230_0E42.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "以前の私とは……どういうことだ？",
  "en": ""
 },
 {
  "id": "2DE230_0E59.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "つ、つまり…… / 以前の私によく似てるということだな。",
  "en": ""
 },
 {
  "id": "2DE230_0E7C.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト殿、カケル殿に手を出すなよ。",
  "en": ""
 },
 {
  "id": "2DE230_0E91.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "なあネプチューン…… / マルレーネのことをどう思う？",
  "en": ""
 },
 {
  "id": "2DE230_0E91.1",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "どう思うって……きれいな女の人だと思うわ。",
  "en": ""
 },
 {
  "id": "2DE230_0EC4.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "彼女はここの住人だったと思うか？",
  "en": ""
 },
 {
  "id": "2DE230_0EDB.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "あたり前じゃない…… / あの耳はエルフ一族のものよ。",
  "en": ""
 },
 {
  "id": "2DE230_0EFC.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトは……マルレーネが気に入ったようね。",
  "en": ""
 },
 {
  "id": "2DE230_0F13.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もぐもぐもぐ…… / エト、バナナを食べるか？",
  "en": ""
 },
 {
  "id": "2DE230_0F13.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいや、遠庫しておくよ。",
  "en": ""
 },
 {
  "id": "2DE230_0F3D.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 4,
  "jp": "バナナを食べれば、 / エトの剣さばきも一段と鋭くなるぜ…… / さっきカケルにも言ったんだが、 / 本気にしないんだ。",
  "en": ""
 },
 {
  "id": "2DE230_0F7C.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "しかしひどい村だなあ……",
  "en": "",
  "dup": "2E8000_085C.0"
 },
 {
  "id": "2DE230_0F8E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "これじゃあバナナ台を作っても、 / だれも買ってくれないな。",
  "en": "",
  "dup": "2E8000_086E.0"
 },
 {
  "id": "2DE230_0FAF.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、ライナス……まだ生きてるのか？",
  "en": ""
 },
 {
  "id": "2DE230_0FC6.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあはあ、ひいひい……",
  "en": ""
 },
 {
  "id": "2DE230_0FD7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前ら、俺をラビニアに / おいてきばりにしやがって！！",
  "en": ""
 },
 {
  "id": "2DE230_0FF3.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "黒い霧に包まれるところだったんだぞっ！！ / 街を出る時には、俺様にも一声かけろっ！！",
  "en": ""
 },
 {
  "id": "2DE230_1027.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "なるほど……ルシフォンを倒すまで、 / ライナスを石にしておくのもひとつの手だな。",
  "en": ""
 },
 {
  "id": "2DE230_1062.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、こんにちは。",
  "en": "",
  "dup": "2C315D_13CE.0"
 },
 {
  "id": "2DE230_106D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、ロイドン……ひさしぶりだね。",
  "en": "",
  "dup": "2CA4C9_0FB5.0"
 },
 {
  "id": "2DE230_1080.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ひさしぶり！？",
  "en": "",
  "dup": "2CA4C9_0FC8.0"
 },
 {
  "id": "2DE230_108D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……い、いや。",
  "en": "",
  "dup": "2CA4C9_0FD5.0"
 },
 {
  "id": "2DE230_109B.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして……僕の名前を知ってるんだい？",
  "en": "",
  "dup": "2CA4C9_0FE3.0"
 },
 {
  "id": "2DE230_10B4.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "えーと……カ、カケルから聞いたんだ。",
  "en": "",
  "dup": "2CA4C9_0FFC.0"
 },
 {
  "id": "2DE230_10C9.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "なーんだ、そうだったのかい。",
  "en": "",
  "dup": "2CA4C9_1011.0"
 },
 {
  "id": "2DE230_10DD.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル君には、さっき色々と / 話をしてもらったんだ。",
  "en": "",
  "dup": "2CA4C9_1025.0"
 },
 {
  "id": "2DE230_10F7.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "彼は『ヤマト・タケル』の息子なんだよね。 / 彼の話はなかなか面白かったよ。",
  "en": "",
  "dup": "2CA4C9_103F.0"
 },
 {
  "id": "2DE230_10F7.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、ああ、やつは話をするのが好きだからな。",
  "en": "",
  "dup": "2CA4C9_103F.1"
 },
 {
  "id": "2DE230_1141.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕は冒険小説家になりたいんだよ。",
  "en": "",
  "dup": "2C315D_14AD.0"
 },
 {
  "id": "2DE230_1158.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "レイモンド王国で起こったことを / 忘れないようにメモして、 / いつかこのことを本にして出販するつもりさ。",
  "en": "",
  "dup": "2CA4C9_10A0.0"
 },
 {
  "id": "2DE230_1158.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "がんばってくれ、ロイドン。",
  "en": "",
  "dup": "2C315D_14C4.1"
 },
 {
  "id": "2DE230_119C.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "君って……なれなれしいんだね。",
  "en": "",
  "dup": "2C315D_1508.0"
 },
 {
  "id": "2DE230_11B0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうか？",
  "en": "",
  "dup": "2C315D_151C.0"
 },
 {
  "id": "2DE230_11BC.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "まあいい、君もカケル君の仲間なんだろう？ / カケル君みたいに話を聞かせて貫えないか？",
  "en": "",
  "dup": "2C315D_1528.0"
 },
 {
  "id": "2DE230_11BC.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わ、私も話をするのか？",
  "en": "",
  "dup": "2CA4C9_1101.0"
 },
 {
  "id": "2DE230_11F9.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "協力してくれよ…… / ほら、君の好きな色のノートに書くからさ。",
  "en": "",
  "dup": "2CA4C9_1112.0"
 },
 {
  "id": "2DE230_1227.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "やあエト君、君の剣さばきはすばらしいねえ。 / どこかで特別な訓練でも受けたのかい？",
  "en": ""
 },
 {
  "id": "2DE230_1227.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうだな……しいて言えば、 / ルシフォンの軍隊にきたえられたんだ。",
  "en": ""
 },
 {
  "id": "2DE230_1227.2",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "おいおい、 / ルシフォン軍はそんな昔からいたのかい？ / 冗談じゃなくて、 / 僕はマジメに質問したんだ。",
  "en": ""
 },
 {
  "id": "2DE230_12B4.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私だってマジメに答えたんだぞ。",
  "en": ""
 },
 {
  "id": "2DE230_12CC.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "あははは、エト君は冗談が好きだなあ……",
  "en": ""
 },
 {
  "id": "2DE230_12E5.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "それよりも、 / ルシフォンの軍隊をやっつけた時の話を / 聞かせてくれないか？",
  "en": ""
 },
 {
  "id": "2DE230_12E5.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "さてと、今度は何色のノートに書くかな。 / エト君、何色がいい？",
  "en": ""
 },
 {
  "id": "2DE230_1337.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……今度こそ僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_079C.0"
 },
 {
  "id": "2DE230_134D.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2DE230_1356.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "2DE230_136A.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度はどのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07D0.0"
 },
 {
  "id": "2DE230_1383.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "君は何色が好きなんだい？ / 青色のノート",
