 },
 {
  "id": "2DE230_0CB1.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ぽっ。",
  "en": ""
 },
 {
  "id": "2DE230_0CBD.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさん、この村の東には / シーボーズの港街があるそうです。",
  "en": ""
 },
 {
  "id": "2DE230_0CD9.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "なあ、ルシフォン軍と闘ってるのは / 俺たちだけなのか？",
  "en": ""
 },
 {
  "id": "2DE230_0CD9.1",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 4,
  "jp": "それとも、みんなルシフォン軍の味方に / なっちまったのかな……。 / そうなると、俺たちは世界を相手に / ケンカしてるようなものだぜ。",
  "en": ""
 },
 {
  "id": "2DE230_0D38.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "敵はルシフォンひとりさ…… / やつを倒せばみんな目がさめるだろう。",
  "en": ""
 },
 {
  "id": "2DE230_0D38.1",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ようするに…… / ルシフォンひとりに操られてるってことか。",
  "en": ""
 },
 {
  "id": "2DE230_0D7D.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "なあエト、ルシフォンを倒したら…… / 俺たちは英雄だぜ。",
