 },
 {
  "id": "2DE230_0C14.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おいおい、私はハエではないぞ。",
  "en": ""
 },
 {
  "id": "2DE230_0C47.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……エトさん。",
  "en": ""
 },
 {
  "id": "2DE230_0C55.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネレイド、怪我はしてないかい？",
  "en": ""
 },
 {
  "id": "2DE230_0C69.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "は、はい……全然してません。",
  "en": ""
 },
 {
  "id": "2DE230_0C7E.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "あの……私のこと、 / 心配してくれるんですか？",
