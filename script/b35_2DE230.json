  "dup": "2CA4C9_129A.0"
 },
 {
  "id": "2DE230_14A6.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……また今度話を聞かせてくれよ。",
  "en": "",
  "dup": "2CA4C9_12B5.0"
 },
 {
  "id": "2DE230_14CA.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ひえぇぇぇっ！！　た、大変だあっ！！ / 西の空から、黒い霧が迫ってくるぞお！！",
