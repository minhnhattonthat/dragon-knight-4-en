[
 {
  "id": "2DE230_0087.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、ここで解散っ！！",
  "en": "",
  "dup": "2E8000_0087.0"
 },
 {
  "id": "2DE230_009A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれれ……エト、だれか倒れてるよ。",
  "en": "",
  "dup": "2E8000_009A.0"
 },
 {
  "id": "2DE230_00B7.0",
  "speaker": "エルフの女の子",
  "form": "dlg",
  "nlines": 1,
  "jp": "うっうう……た、助けて。",
  "en": "",
  "dup": "2E8000_00B7.0"
 },
 {
  "id": "2DE230_00C9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ど、どうしたの！？",
  "en": "",
  "dup": "2E8000_00C9.0"
 },
 {
  "id": "2DE230_00D8.0",
  "speaker": "エルフの女の子",
  "form": "dlg",
  "nlines": 2,
  "jp": "私の名前はマルレーネ…… / ルシフォンの軍隊が私たちにひどいことを……。",
  "en": "",
  "dup": "2E8000_00D8.0"
 },
 {
  "id": "2DE230_00D8.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "み、みんな殺されてしまった……",
  "en": "",
  "dup": "2E8000_00D8.1"
 },
 {
  "id": "2DE230_010F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "誇り高きエルフ一族は…… / やつらの味方にはならないと言ったせいで……。",
  "en": "",
  "dup": "2E8000_010F.0"
 },
 {
  "id": "2DE230_0139.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "もうしゃべらない方がいい。 / ……エト、彼女をベッドに運ばうよ。",
  "en": "",
  "dup": "2E8000_0139.0"
 },
 {
  "id": "2DE230_0139.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2DE230_0169.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしたの、エト？",
  "en": "",
  "dup": "2E8000_0169.0"
 },
 {
  "id": "2DE230_0178.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ！？　……ああ……なにか言ったか？",
  "en": "",
  "dup": "2E8000_0178.0"
 },
 {
  "id": "2DE230_018E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だからあ、彼女をベッドに運ばうって。",
  "en": "",
  "dup": "2E8000_018E.0"
 },
 {
  "id": "2DE230_01A9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうか……うん、そうだな。",
  "en": "",
  "dup": "2E8000_01A9.0"
 },
 {
  "id": "2DE230_01BB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "変だよ、エト……どうかしたの？",
  "en": "",
  "dup": "2E8000_01BB.0"
 },
 {
  "id": "2DE230_01D0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "わ、私が彼女をベッドに運ばうっ…… / みんなは闘いの疲れを十分に癒してくれ。",
  "en": ""
 },
 {
  "id": "2DE230_021D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2DE230_0225.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、あっちに行ってろ…… / 彼女は私が看病する。",
  "en": ""
 },
 {
  "id": "2DE230_0225.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめだよ、エトひとりにしたら心配だもの。",
  "en": ""
 },
 {
  "id": "2DE230_025E.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト、ドラゴンが空を飛んでるよ。 / 恐いなあ。",
  "en": ""
 },
 {
  "id": "2DE230_025E.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "セイルはバーンの息子なんだろ？ / ……どうしてドラゴンが恐いんだ？",
  "en": ""
 },
 {
  "id": "2DE230_025E.2",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ドラゴンナイトはパパだよ…… / 僕はただの人間だい。",
  "en": "",
  "dup": "2E8000_0225.2"
 },
 {
  "id": "2DE230_02B7.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト……さっきの女の人、 / マルレーネさんっていうんでしょ？",
  "en": ""
 },
 {
  "id": "2DE230_02B7.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ、美人だな。",
  "en": ""
 },
 {
  "id": "2DE230_02E2.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "先に言わないでよ、 / 僕が言おうと思ったのに。",
  "en": ""
 },
 {
  "id": "2DE230_02FE.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネさんかあ……。",
  "en": ""
 },
 {
  "id": "2DE230_0312.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、もう大丈夫だ……心配するな。",
  "en": "",
  "dup": "2E8000_02F1.0"
 },
 {
  "id": "2DE230_0329.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトがこの人の側にいることが心配なんだ。",
  "en": "",
  "dup": "2E8000_0308.0"
 },
 {
  "id": "2DE230_0345.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "わっはっはっ！！ / お前も言うようになったな！！",
  "en": "",
  "dup": "2E8000_0324.0"
 },
 {
  "id": "2DE230_0345.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "本気で言ってるんだよ……エト。",
  "en": "",
  "dup": "2E8000_0324.1"
 },
 {
  "id": "2DE230_0377.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……そう。",
  "en": "",
  "dup": "2E8000_0356.0"
 },
 {
  "id": "2DE230_0389.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "ルシフォンの軍隊め、 / ひどいことをしやがる。 / エルフ一族をみな殺しにするなんて。",
  "en": ""
 },
 {
  "id": "2DE230_03B8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……許せないよ、僕。",
  "en": "",
  "dup": "2E8000_0362.1"
 },
 {
  "id": "2DE230_03C8.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、いっしょにがんばろうな……",
  "en": "",
  "dup": "2E8000_039E.0"
 },
 {
  "id": "2DE230_03DE.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "闘い続ければ、 / きっとライムリンの国にたどり着くさ。",
  "en": ""
 },
 {
  "id": "2DE230_03FB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2DE230_0403.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうした、カケル？",
  "en": "",
  "dup": "2E8000_03D8.0"
 },
 {
  "id": "2DE230_0411.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あのさ、ナターシャと……。",
  "en": ""
 },
 {
  "id": "2DE230_0420.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャと？",
  "en": ""
 },
 {
  "id": "2DE230_042A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん、なんでもない……なんでもないんだ。",
  "en": ""
 },
 {
  "id": "2DE230_0443.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、疲れは十分にとっておけよ。 / これからの闘いは、ますます激しくなるぜ。",
  "en": "",
  "dup": "2E8000_04FF.0"
 },
 {
  "id": "2DE230_0482.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なんだよ……僕になんか用？",
  "en": ""
 },
 {
  "id": "2DE230_0498.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、なにをしてたんだ？",
  "en": ""
 },
 {
  "id": "2DE230_04AA.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いいじゃないか……なにをしてたって。",
  "en": ""
 },
 {
  "id": "2DE230_04C2.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "くんくんくん…… / カケル、いい匂いがするぞ。",
  "en": ""
 },
 {
  "id": "2DE230_04C2.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕はマルレーネと話をしてるんだ…… / あっちに行ってよ。",
  "en": ""
 },
 {
  "id": "2DE230_04FD.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ……。",
  "en": ""
 },
 {
  "id": "2DE230_0507.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすうすう……。",
  "en": "",
  "dup": "2E8000_0548.0"
 },
 {
  "id": "2DE230_0510.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "今度こそ……絶対に失敗しないからな。",
  "en": ""
 },
 {
  "id": "2DE230_052A.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすうすう……うーん、カケルぅ。",
  "en": ""
 },
 {
  "id": "2DE230_0539.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2DE230_0541.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうもありがとう……もう平気です。",
  "en": "",
  "dup": "2E8000_0F34.0"
 },
 {
  "id": "2DE230_0558.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よかった……元気になったようだな。",
  "en": ""
 },
 {
  "id": "2DE230_056F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "よかったね、元気になって。",
  "en": "",
  "dup": "2E8000_0F4B.0"
 },
 {
  "id": "2DE230_0582.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ええ、あなたがずっと看病してくれたから。",
  "en": ""
 },
 {
  "id": "2DE230_059E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、用がないならあっちに行けよ。",
  "en": "",
  "dup": "2E8000_0F7A.0"
 },
 {
  "id": "2DE230_05B6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトだって、用があるわけじゃないでしょ？",
  "en": "",
  "dup": "2E8000_0F92.0"
 },
 {
  "id": "2DE230_05CD.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの、私……もう平気ですから。",
  "en": "",
  "dup": "2E8000_0FA9.0"
 },
 {
  "id": "2DE230_05E2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ほら、マルレーネだって / 平気って言ってるじゃないか。",
  "en": "",
  "dup": "2E8000_0FBE.0"
 },
 {
  "id": "2DE230_05E2.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 3,
  "jp": "エトさん、カケルさん…… / 私、お願いがあるんです。 / ……私を、仲間に加えてもらえませんか？",
  "en": "",
  "dup": "2E8000_0FBE.1"
 },
 {
  "id": "2DE230_062E.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私、弓を使うことができます……",
  "en": "",
  "dup": "2E8000_100A.0"
 },
 {
  "id": "2DE230_0644.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "それに、死んでいった仲間のためにも / 闘いたいんです。",
  "en": "",
  "dup": "2E8000_1020.0"
 },
 {
  "id": "2DE230_0662.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そりゃ願ってもない。",
  "en": ""
 },
 {
  "id": "2DE230_0672.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "実は俺たちもエルフ族で仲間になってくれる人を / さがしにきたんですよ。",
  "en": ""
 },
 {
  "id": "2DE230_0697.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "弓があれば、離れたところから攻撃できるね。",
  "en": "",
  "dup": "2E8000_1079.0"
 },
 {
  "id": "2DE230_06B5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "それに、空を飛ぶドラゴンにだって / ダメージを与えられるぜ。",
  "en": "",
  "dup": "2E8000_1097.0"
 },
 {
  "id": "2DE230_06B5.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあ……仲間にしてもらえるんですね？",
  "en": "",
  "dup": "2E8000_1097.1"
 },
 {
  "id": "2DE230_06F5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "もちろん…… / 君がいっしょに闘ってくれないと困るのだ。",
  "en": "",
  "dup": "2E8000_10D7.0"
 },
 {
  "id": "2DE230_06F5.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "？　なんか……ふくみのある言い方だなあ。",
  "en": "",
  "dup": "2E8000_10D7.1"
 },
 {
  "id": "2DE230_0733.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネが仲間に加わった！！",
  "en": "",
  "dup": "2E8000_1115.0"
 },
 {
  "id": "2DE230_073D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うれしいなあ…… / こんなきれいな人といっしょに闘えるんだ。",
  "en": "",
  "dup": "2E8000_111F.0"
 },
 {
  "id": "2DE230_073D.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 3,
  "jp": "あの……さっきから気になってたんですけど、 / カケルさんって、もしかして…… / あの「ヤマト・タケル」様の？",
  "en": ""
 },
 {
  "id": "2DE230_079D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、パパの名前はタケルだよ。",
  "en": "",
  "dup": "2E8000_1180.0"
 },
 {
  "id": "2DE230_07B2.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "や、やはりカケルさんって / ……あのタケル様の息子なんですね！？",
  "en": "",
  "dup": "2E8000_1195.0"
 },
 {
  "id": "2DE230_07B2.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "あの……お父様のタケル様は / いっしょではないのですか？",
  "en": "",
  "dup": "2E8000_1195.1"
 },
 {
  "id": "2DE230_07B2.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、ああ……。",
  "en": "",
  "dup": "2E8000_1195.2"
 },
 {
  "id": "2DE230_07FC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "お父さんはミネルバ大陸で石になってるよ。",
  "en": "",
  "dup": "2E8000_11DF.0"
 },
 {
  "id": "2DE230_0819.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ご、ごめんなさい…… / 変なことを聞いてしまいました。",
  "en": "",
  "dup": "2E8000_11FC.0"
 },
 {
  "id": "2DE230_0819.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん、いいんだよ……。",
  "en": "",
  "dup": "2E8000_11FC.1"
 },
 {
  "id": "2DE230_0845.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "タケル様の血を引く方と / いっしょに闘えるなんて……私、光栄です。",
  "en": "",
  "dup": "2E8000_1228.0"
 },
 {
  "id": "2DE230_0845.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私、興奮して身体がほてってきました…… / 井戸で身体を冷やしてきます。",
  "en": "",
  "dup": "2E8000_1228.1"
 },
 {
  "id": "2DE230_08AC.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おい。",
  "en": "",
  "dup": "2E8000_1293.0"
 },
 {
  "id": "2DE230_08B5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なあに？",
  "en": "",
  "dup": "2E8000_129C.0"
 },
 {
  "id": "2DE230_08BF.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ここにいたいんだろ？ / ……私はもう行くぜ。",
  "en": "",
  "dup": "2E8000_12A6.0"
 },
 {
  "id": "2DE230_08BF.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
