  "dup": "2E8000_0E01.0"
 },
 {
  "id": "2DE230_15A2.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "お、俺はどうすりゃいい…… / だれか、俺の進む道を教えてくれえ！！",
  "en": "",
  "dup": "2E8000_0E42.0"
 },
 {
  "id": "2DE230_15CC.0",
  "speaker": "エルフ一族ララミナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "わ、私たちの村をこんなにしたのは……。",
  "en": "",
  "dup": "2E8000_0E6C.0"
 },
 {
  "id": "2DE230_15E4.0",
  "speaker": "エルフ一族ニイナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンがくる……恐い……恐い……。",
  "en": "",
  "dup": "2E8000_0E84.0"
 },
 {
  "id": "2DE230_15F9.0",
  "speaker": "エルフ一族ムウ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ク、クラリス……私のかわいい娘を…… / だれか助けてあげて……。",
  "en": ""
 },
 {
  "id": "2DE230_161D.0",
  "speaker": "エルフ一族サラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "か、彼女は……何者なの……。",
  "en": "",
  "dup": "2E8000_0EBE.0"
 },
 {
  "id": "2DE230_1630.0",
  "speaker": "エルフ一族ターノン",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、あいつは……何者なんだ……。",
  "en": "",
  "dup": "2E8000_0ED1.0"
 },
 {
  "id": "2DE230_1643.0",
  "speaker": "エルフ一族ロデオ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの軍隊が去ったあとに…… / ああ、恐ろしいことが……。",
  "en": "",
  "dup": "2E8000_0EE4.0"
 },
 {
  "id": "2DE230_1666.0",
  "speaker": "エルフ一族マハト",
  "form": "dlg",
  "nlines": 1,
  "jp": "魔法なんか使って……ずるいや……。",
  "en": "",
  "dup": "2E8000_0F07.0"
 },
