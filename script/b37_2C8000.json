[
 {
  "id": "2C8000_008E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ここがロンボニ大陸の最西端、カラープだあ！！",
  "en": "",
  "dup": "2E0000_00F4.0"
 },
 {
  "id": "2C8000_00A6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、ルシフォンの軍隊がいないよ。",
  "en": "",
  "dup": "2E0000_010C.0"
 },
 {
  "id": "2C8000_00B9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "きっと逃げ出したんだろ？",
  "en": "",
  "dup": "2E0000_011F.0"
 },
 {
  "id": "2C8000_00C9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうかなあ……。",
  "en": "",
  "dup": "2E0000_012F.0"
 },
 {
  "id": "2C8000_00D4.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "３週間ぶりの地面だが…… / 少し休んで、すぐに東に行くぞ！！",
  "en": "",
  "dup": "2E0000_013A.0"
 },
 {
  "id": "2C8000_00FC.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト、ロイドンさんって知ってる？ / 小説家の卵なんだって。",
  "en": ""
 },
 {
  "id": "2C8000_00FC.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ああ、知ってるとも。 / 何度か話をしたことがあるからな。",
  "en": ""
 },
 {
  "id": "2C8000_00FC.2",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 3,
  "jp": "エト、ここだけの話だけど…… / 小説家の卵ってどんな卵なの？ / やっぱりおいしいのかな？",
  "en": ""
 },
 {
  "id": "2C8000_0172.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕ね、昔から本を読むのが好きだったんだよ。 / エトは本を読むのが好き？",
  "en": ""
 },
 {
  "id": "2C8000_0172.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は昔から剣術の練習ばかりしていたからな。 / 本のことはよくわからんのだ。",
  "en": ""
 },
 {
  "id": "2C8000_0172.2",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ふーん、そうなんだ。 / 僕は昔、パパによく本を読んでもらったよ。",
  "en": ""
 },
 {
  "id": "2C8000_0172.3",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "バーンおじさんが本を読んでくれるのかい？ / なんか想像できないな。",
  "en": ""
 },
 {
  "id": "2C8000_0172.4",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、パパに会ったことがあるの？",
  "en": ""
 },
 {
  "id": "2C8000_0230.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "い、いや……ないけど、 / よく絵で君のお父さんを見るからさ。",
  "en": ""
 },
 {
  "id": "2C8000_0255.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……いつになったら、卵になるんだろ？",
  "en": ""
 },
 {
  "id": "2C8000_026E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うわあ……すごいや。",
  "en": ""
 },
 {
  "id": "2C8000_027E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……カケル、なにをやっているのだ？",
  "en": ""
 },
 {
  "id": "2C8000_0294.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "え、エト！　な、な、なんでもないっ！",
  "en": ""
 },
 {
  "id": "2C8000_02B6.0",
  "speaker": "エト",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2C8000_02BF.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "……おかしなやつだな……。",
  "en": ""
 },
 {
  "id": "2C8000_02D0.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……あのときのエトの気持ちが / ようやくわかったよ……。",
  "en": ""
 },
 {
  "id": "2C8000_02EE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……ここはロンボニ大陸だよね。",
  "en": ""
 },
 {
  "id": "2C8000_0300.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだな……ここはロンボニ大陸だぞ。",
  "en": ""
 },
 {
  "id": "2C8000_0314.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト、 / 今日はナターシャといっしょじゃないんだね。",
  "en": ""
 },
 {
  "id": "2C8000_0314.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "おいおいカケル、 / 俺はいつもナターシャといっしょにいるのか？",
  "en": ""
 },
 {
  "id": "2C8000_0314.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "いつもいっしょだよ。 / ふたりは仲がよさそうだもの。",
  "en": ""
 },
 {
  "id": "2C8000_036D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネの寝顔ってきれいだね。",
  "en": ""
 },
 {
  "id": "2C8000_037F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……マルレーネのことが好きか？",
  "en": ""
 },
 {
  "id": "2C8000_0393.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、好きだよ……仲間だもの。",
  "en": ""
 },
 {
  "id": "2C8000_03A8.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャとどっちが好きだ？",
  "en": ""
 },
 {
  "id": "2C8000_03B9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナ、ナターシャとなんか比べられないよ。",
  "en": ""
 },
 {
  "id": "2C8000_03CF.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネは、ナターシャよりも / ずっと大人で、色っぽくて、優しいもの。",
  "en": ""
 },
 {
  "id": "2C8000_03F2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトは、ナターシャとマルレーネと / どっちが好き？",
  "en": ""
 },
 {
  "id": "2C8000_03F2.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "決まってるさ、マルレーネだ。",
  "en": ""
 },
 {
  "id": "2C8000_041B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "えーっ！？ / そ、そんなことを言っていいの！？",
  "en": ""
 },
 {
  "id": "2C8000_041B.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだったら、ナターシャに言ってもいいぞ。",
  "en": ""
 },
 {
  "id": "2C8000_044F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "馬鹿にしないでよ…… / 僕はそういうことをする男じゃないよっ！！",
  "en": ""
 },
 {
  "id": "2C8000_0473.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトって……おかしなやつだなあ。",
  "en": ""
 },
 {
  "id": "2C8000_0488.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わっはっはっ！！　お互いさまだ。",
  "en": ""
 },
 {
  "id": "2C8000_049F.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、きれいな花が咲いているわ。",
  "en": ""
 },
 {
  "id": "2C8000_04B7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍も、 / 花畑を荒らすことまではしなかったようだな。",
  "en": ""
 },
 {
  "id": "2C8000_04B7.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "さっきね、カケルがきてね……。",
  "en": ""
 },
 {
  "id": "2C8000_04ED.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "話をしたのか？",
  "en": ""
 },
 {
  "id": "2C8000_04FA.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん、話をしたっていうか……。",
  "en": ""
 },
 {
  "id": "2C8000_050F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルはナターシャの前にでると…… / いつもと態度がちがってしまうみたいだな。",
  "en": ""
 },
 {
  "id": "2C8000_050F.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてわかるの？",
  "en": ""
 },
 {
  "id": "2C8000_0547.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "カケルが他の女の子と話をしてる時と、 / ナターシャと話をしてる時と / 様子がちがう気がする。",
  "en": ""
 },
 {
  "id": "2C8000_0576.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そう……。",
  "en": ""
 },
 {
  "id": "2C8000_0580.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "おいおい、いい意味で言ったんだぜ。 / それだけナターシャが特別だってことだろ？",
  "en": ""
 },
 {
  "id": "2C8000_0580.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "じゃあエトにとっては、 / マルレーネさんが特別なのね。",
  "en": ""
 },
 {
  "id": "2C8000_0580.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "と、とにかくカケルにとっては、 / ナターシャが特別な存在なんだ。",
  "en": ""
 },
 {
  "id": "2C8000_0580.3",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "でも、私……カケルから優しい言葉を / かけられたことがないもの……。",
  "en": ""
 },
 {
  "id": "2C8000_0580.4",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "それはもう少し大人にならなくちゃだめだ。 / 男の優しさは言葉であらわすものじゃない。",
  "en": ""
 },
 {
  "id": "2C8000_0580.5",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、女の子はちがうのよ。",
  "en": ""
 },
 {
  "id": "2C8000_0654.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "たとえウソでも、 / 優しい言葉をかけられたいって思うものだもの。",
  "en": ""
 },
 {
  "id": "2C8000_0679.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "……やだ、なんかカケルと話をしてるみたい。",
  "en": ""
 },
 {
  "id": "2C8000_0690.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "わっはっはっ！！ / とにかくカケルはナターシャが好きさ…… / 俺のカンにまちがいはない。",
  "en": ""
 },
 {
  "id": "2C8000_06BE.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ねえ……ひとつだけお願いをしていいかしら？ / 私、エトの顔が見てみたいの。",
  "en": ""
 },
 {
  "id": "2C8000_06BE.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめだ……それだけはできない。",
  "en": ""
 },
 {
  "id": "2C8000_06FA.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして？",
  "en": ""
 },
 {
  "id": "2C8000_0705.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "わ、私の顔は、人に不快感を与える顔なのだ。 / それも強烈にな。",
  "en": ""
 },
 {
  "id": "2C8000_0705.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は平気……だってエトのことが好きだもの。",
  "en": ""
 },
 {
  "id": "2C8000_0748.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "兜を取ったとたん、この街の中には / いやな雰囲気が漂い出し…… / せっかくいっしょに闘っている仲間たちは、 / 理由もわからずここにいたくなくなるだろう。",
  "en": ""
 },
 {
  "id": "2C8000_07A1.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトって、たまに冗談だか本気だか / わからないことを言うのよね……。",
  "en": ""
 },
 {
  "id": "2C8000_07CE.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "……ルシフォンを倒したら、 / エトの顔が見てみたいわ。",
  "en": ""
 },
 {
  "id": "2C8000_07EC.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……さん。",
  "en": ""
 },
 {
  "id": "2C8000_07F9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ、寝ようとしてたのか？",
  "en": ""
 },
 {
  "id": "2C8000_080C.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ええ……。",
  "en": ""
 },
 {
  "id": "2C8000_0816.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2C8000_081E.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……なにか話があるみたいですね。",
  "en": ""
 },
 {
  "id": "2C8000_0838.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネ……君はトリアノンの村に / 住んでいなかったんだろう？",
  "en": ""
 },
 {
  "id": "2C8000_0838.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいえ、私はトリアノンの村に住んでました。",
  "en": ""
 },
 {
  "id": "2C8000_086C.0",
  "speaker": "エト",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2C8000_0875.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "メイフェアを知ってるな？",
  "en": ""
 },
 {
  "id": "2C8000_0883.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "クラリスを知ってるな？",
  "en": ""
 },
 {
  "id": "2C8000_088F.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "知ってます。",
  "en": ""
 },
 {
  "id": "2C8000_089B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "彼女はトリアノンの村で生まれ育ったんだ…… / でも君のことは知らないと言っていた。",
  "en": ""
 },
 {
  "id": "2C8000_089B.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……なにを言いたいのですか？",
  "en": ""
 },
 {
  "id": "2C8000_08DA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ……私は君を助けたいのだ。",
  "en": ""
 },
 {
  "id": "2C8000_08EF.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私を……助けたい？",
  "en": ""
 },
 {
  "id": "2C8000_08FE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうとも……そしてこれは、 / 君自身からも頼まれたことだ。",
  "en": ""
 },
 {
  "id": "2C8000_08FE.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさん…… / あなたの言っていることがわかりません。",
  "en": ""
 },
 {
  "id": "2C8000_08FE.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そう、今はわからないだろうな……",
  "en": ""
 },
 {
  "id": "2C8000_0957.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私にも君の正体はわからないし、 / 君だって私の言うことがわからないはずだ。",
  "en": ""
 },
 {
  "id": "2C8000_0980.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "しかしこのまま放っておけば、 / お互いに後悔する結果になる。",
  "en": ""
 },
 {
  "id": "2C8000_0980.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_1406.0"
 },
 {
  "id": "2C8000_09B4.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "話すことはなにもありません……",
  "en": ""
 },
 {
  "id": "2C8000_09C9.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "どうして私のことを、 / そんなに気にするのですか？",
  "en": ""
 },
 {
  "id": "2C8000_09E2.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_1406.0"
 },
 {
  "id": "2C8000_09EA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうやら……眠れなくしてしまったようだな。",
  "en": ""
 },
 {
  "id": "2C8000_0A06.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいんです……気にしないでください。",
  "en": ""
 },
 {
  "id": "2C8000_0A1E.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……ひとりにしてください。",
  "en": ""
 },
 {
  "id": "2C8000_0A35.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネレイドじゃないか……船酔はしなかったか？",
  "en": ""
 },
 {
  "id": "2C8000_0A4D.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "は、はい……大丈夫です。",
  "en": ""
 },
 {
  "id": "2C8000_0A5E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "この港街の東には、ロンボニ王国がある。",
  "en": ""
 },
 {
  "id": "2C8000_0A72.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……もっとも、そこに行くにはルシフォン軍との / 闘いは避けられないだろうがな。",
  "en": ""
 },
 {
  "id": "2C8000_0A99.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "は、はい…… / 私、エトさんのためにもがんばります！！",
  "en": ""
 },
 {
  "id": "2C8000_0ABA.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "私、がんばります。",
  "en": ""
 },
 {
  "id": "2C8000_0AC9.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "よう、エト……シーボーズの港街が / 黒い霧に包まれたんだってよ。",
  "en": ""
 },
 {
  "id": "2C8000_0AC9.1",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "まるで俺たちのあとを追いかけてるみたいだな… / ほら、西の空を見てみろよ。",
  "en": ""
 },
 {
  "id": "2C8000_0AC9.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "真っ黒だな。",
  "en": ""
 },
 {
  "id": "2C8000_0B23.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ああ……俺たちの国はあの下にあるんだ。 / 勝たなきゃあな……絶対。",
  "en": ""
 },
 {
  "id": "2C8000_0B4A.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "なあエト、カケルにも言ったんだが、 / こうやって出会ったのも、なにかの運命だよな。",
  "en": ""
 },
 {
  "id": "2C8000_0B79.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルって、エトに似てるよな…… / 顔とかじゃなくて、雰囲気の話だけど。",
  "en": ""
 },
 {
  "id": "2C8000_0BA5.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト殿……カケル殿はどこにいるのだ？",
  "en": ""
 },
 {
  "id": "2C8000_0BBC.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれれ、寝てたんじゃないのか？",
  "en": ""
 },
 {
  "id": "2C8000_0BCE.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ふふふふふふ…… / こうやってカケル殿を待っておるのだ。",
  "en": ""
 },
 {
  "id": "2C8000_0BEF.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト殿……カケル殿を見かけたら、 / ここにくるように伝えてくれ。",
  "en": ""
 },
 {
  "id": "2C8000_0C1B.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……あのマルレーネって女、生意気だわ。",
  "en": ""
 },
 {
  "id": "2C8000_0C33.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おいおい、仲間なんだから仲良くしてくれよ。",
  "en": ""
 },
 {
  "id": "2C8000_0C4F.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 4,
  "jp": "だって、私が話しかけても / ロクに返事をしないんだから、 / ちょっと美人だと思って、 / いい気になってるんじゃない？",
  "en": ""
 },
 {
  "id": "2C8000_0C8E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "彼女は両親を殺されて、友だちも失ったんだ。 / きっと落ち込んでるだけだよ。",
  "en": ""
 },
 {
  "id": "2C8000_0C8E.1",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "肉親を殺されたのは彼女だけじゃないわ。",
  "en": ""
 },
 {
  "id": "2C8000_0CD4.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "たしかに……そうだな。",
  "en": ""
 },
 {
  "id": "2C8000_0CE5.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "彼女に言っておいてよ。",
  "en": ""
 },
 {
  "id": "2C8000_0CF6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "いっしょに闘うんだったら、 / もっと私に気を使いなさいって。",
  "en": ""
 },
 {
  "id": "2C8000_0D17.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ネプチューンって…… / けっこう恐い性格をしてないか？",
  "en": ""
 },
 {
  "id": "2C8000_0D17.1",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "失礼ねっ……はっきり、 / すっきりした性格って言ってくれないかしら？",
  "en": ""
 },
 {
  "id": "2C8000_0D5E.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトは、マルレーネのことが好きなんでしょ？",
  "en": ""
 },
 {
  "id": "2C8000_0D74.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "好きだよ。ネプチューンと同じくらいにね。",
  "en": ""
 },
 {
  "id": "2C8000_0D8A.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "パパが生きてたころによく言われたわ…… / そういう言い方をする男には気をつけろってね。",
  "en": ""
 },
 {
  "id": "2C8000_0DBB.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト……調子のいいことばっかり言ってると、 / そのうちに火傷するわよ。",
  "en": ""
 },
 {
  "id": "2C8000_0DE7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネプチューン……元気がないな。",
  "en": ""
 },
 {
  "id": "2C8000_0DF8.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "だって……。",
  "en": ""
 },
 {
  "id": "2C8000_0E01.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだ、まだ気にしてるのか？",
  "en": ""
 },
 {
  "id": "2C8000_0E15.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、ううん……そういうわけじゃないけど。",
  "en": ""
 },
 {
  "id": "2C8000_0E2B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はもう忘れたぞ…… / だからネプチューンも忘れろ。",
  "en": ""
 },
 {
  "id": "2C8000_0E2B.1",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……はい。",
  "en": ""
 },
 {
  "id": "2C8000_0E51.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "これは、ポセイドンって言う守り神よ…… / 知ってた？",
  "en": ""
 },
 {
  "id": "2C8000_0E51.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ、海の守り神だな。",
  "en": ""
 },
 {
  "id": "2C8000_0E86.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "神様っていえば、カケルは……。",
  "en": ""
 },
 {
  "id": "2C8000_0E9A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ああ、やつは神の血を引くやつだよ。 / 有名人の息子ってところだな。",
  "en": ""
 },
 {
  "id": "2C8000_0E9A.1",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルにも言ったんだけど、 / すごく不思議な気持ちなの。",
  "en": ""
 },
 {
  "id": "2C8000_0E9A.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "なにがだ？",
  "en": "",
  "dup": "2C315D_00C1.0"
 },
 {
  "id": "2C8000_0EF1.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 4,
  "jp": "だって、パパに何度となく / 聞かせてもらったお話の / その人の息子がいっしょに / いるんですもの。",
  "en": ""
 },
 {
  "id": "2C8000_0F28.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "なーに、やつはただのガキさ。",
  "en": ""
 },
 {
  "id": "2C8000_0F3D.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめよ、エト……人のことを悪く言ったら。",
  "en": ""
 },
 {
  "id": "2C8000_0F57.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "いまさら祈っても遅いわよね…… / もう着いちゃったんですもの。",
  "en": ""
 },
 {
  "id": "2C8000_0F7C.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 3,
  "jp": "もぐもぐ…… / エト、東にはロンボニ王国があるんだってな。 / その国のバナナはおいしいのか？",
  "en": ""
 },
 {
  "id": "2C8000_0FAB.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "知らないな……バナナのことなんか。",
  "en": ""
 },
 {
  "id": "2C8000_0FC1.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "バナナのことなんか、とはなんだ……",
  "en": ""
 },
 {
  "id": "2C8000_0FD4.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "バナナを馬鹿にするやつは、 / たとえエトでも許さないぞ。",
  "en": ""
 },
 {
  "id": "2C8000_0FF5.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "バナナはな、腐りかけが一番おいしいんだ…… / もぐもぐもぐ。",
  "en": ""
 },
 {
  "id": "2C8000_1016.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか、くたくたになるほど踊りたい気分。",
  "en": ""
 },
 {
  "id": "2C8000_1031.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "馬鹿なことを言うもんじゃない。",
  "en": ""
 },
 {
  "id": "2C8000_1046.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "この街でゆっくり休んで、 / 次の戦闘に備えてくれ。",
  "en": ""
 },
 {
  "id": "2C8000_1065.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私、踊りながら闘っちゃおうかしら？",
  "en": ""
 },
 {
  "id": "2C8000_108C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "おやおや、風邪をひいたらたいヘんだ…… / ベッドに運んでやろう。",
  "en": "",
  "dup": "2E0000_026E.0"
 },
 {
  "id": "2C8000_108C.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……待てよ……そうだ、思いだした！",
  "en": ""
 },
 {
  "id": "2C8000_10CD.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "私がカケルだったとき、 / エトは苦しまぎれに / よけいなことをいって / ドツボにはまっていたんだ。",
  "en": ""
 },
 {
  "id": "2C8000_1104.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "……そうそう、たしか / 「きみがあまりにもきれいだから……」 / とかなんとか。",
  "en": ""
 },
 {
  "id": "2C8000_1104.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "同じ失敗を繰り返してたまるものか。 / あのセリフだけはいってはだめだ。 / 「あまりにもきれい」はだめ、 / 「あまりにもきれい」はだめ……。",
  "en": ""
 },
 {
  "id": "2C8000_1191.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "う……うん……。",
  "en": "",
  "dup": "2E0000_02A7.0"
 },
 {
  "id": "2C8000_119D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お、め、目を覚ましたか。",
  "en": ""
 },
 {
  "id": "2C8000_11AF.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさん……？ / ……きゃあああああああっ！！",
  "en": "",
  "dup": "2E0000_02C3.0"
 },
 {
  "id": "2C8000_11AF.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どわわわわわっ！？",
  "en": "",
  "dup": "2E0000_02C3.1"
 },
 {
  "id": "2C8000_11D3.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "え、え、エトさん！",
  "en": "",
  "dup": "2E0000_02E7.0"
 },
 {
  "id": "2C8000_11E2.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "わ、私が眠っている間に / いったいなにをなさったんですか！？",
  "en": "",
  "dup": "2E0000_02F6.0"
 },
 {
  "id": "2C8000_1204.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（そらきた、落ちついて落ちついて……）",
  "en": ""
 },
 {
  "id": "2C8000_121E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやまて、メイフェア落ちつけ、 / 「きみがあまりにもきれいだ」はだめなんだ。",
  "en": ""
 },
 {
  "id": "2C8000_1247.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2BBE84_1142.1"
 },
 {
  "id": "2C8000_124F.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "……は？",
  "en": ""
 },
 {
  "id": "2C8000_1259.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（しまった。なにを言っているのだ私は）",
  "en": ""
 },
 {
  "id": "2C8000_1271.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 3,
  "jp": "どういう意味ですか？ / きれいだ、はだめ……って。 / 文法がまちがってますよ。",
  "en": ""
 },
 {
  "id": "2C8000_12A0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "いやその、だから、",
  "en": ""
 },
 {
  "id": "2C8000_12AF.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "君があまりにもきれいなのがいけないのだ、 / だから私はついふらふらとこの部屋にだな……。",
  "en": ""
 },
 {
  "id": "2C8000_12DF.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "（……ってさらになにを / 墓穴を掘っているんだ、私はっ！！）",
  "en": ""
 },
 {
  "id": "2C8000_12DF.1",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "え……ええ！？（ぽっ）",
  "en": "",
  "dup": "2E0000_035F.0"
 },
 {
  "id": "2C8000_1316.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（い、いかん、どんどんドツボにはまっていく）",
  "en": ""
 },
 {
  "id": "2C8000_1333.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（ぷっ）",
  "en": ""
 },
 {
  "id": "2C8000_133D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あ、カケルに笑われた）",
  "en": ""
 },
 {
  "id": "2C8000_134F.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "……本当ですか？　今の言葉。",
  "en": ""
 },
 {
  "id": "2C8000_1364.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "も、もちろんだとも。",
  "en": "",
  "dup": "2E0000_039B.0"
 },
 {
  "id": "2C8000_1374.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "そ、それじゃ今後の作戦を / 考えなければならないから、また……。",
  "en": "",
  "dup": "2E0000_03AB.0"
 },
 {
  "id": "2C8000_1396.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……もう少しここにいてください。",
  "en": "",
  "dup": "2E0000_03CD.0"
 },
 {
  "id": "2C8000_13B0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（し、しまったあああっ！！）",
  "en": ""
 },
 {
  "id": "2C8000_13C9.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……。",
  "en": "",
  "dup": "2E0000_0418.0"
 },
 {
  "id": "2C8000_13E5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "おやおや、風邪をひいたらたいヘんだ…… / ベッドに運んでやろう。",
  "en": "",
  "dup": "2E0000_026E.0"
 },
 {
  "id": "2C8000_13E5.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……待てよ……そうだ、思いだした！",
  "en": "",
  "dup": "2C8000_108C.1"
 },
 {
  "id": "2C8000_1426.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "私がカケルだったとき、 / エトは苦しまぎれに / よけいなことをいって / ドツボにはまっていたんだ。",
  "en": "",
  "dup": "2C8000_10CD.0"
 },
 {
  "id": "2C8000_145D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "……そうそう、たしか / 「きみがあまりにもきれいだから……」 / とかなんとか。",
  "en": "",
  "dup": "2C8000_1104.0"
 },
 {
  "id": "2C8000_145D.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "同じ失敗を繰り返してたまるものか。 / あのセリフだけはいってはだめだ。 / 「あまりにもきれい」はだめ、 / 「あまりにもきれい」はだめ……。",
  "en": "",
  "dup": "2C8000_1104.1"
 },
 {
  "id": "2C8000_14EA.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "う……うん……。",
  "en": "",
  "dup": "2E0000_04FD.0"
 },
 {
  "id": "2C8000_14F6.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お、め、目を覚ましたか。",
  "en": "",
  "dup": "2C8000_119D.0"
 },
 {
  "id": "2C8000_1508.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……え？　うわあああああああっ！！",
  "en": "",
  "dup": "2E0000_0519.0"
 },
 {
  "id": "2C8000_151A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どわわわわわっ！？",
  "en": "",
  "dup": "2E0000_02C3.1"
 },
 {
  "id": "2C8000_1529.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "え、え、エト！ / 私が眠っている間にいったいなにをした！？",
  "en": "",
  "dup": "2E0000_053A.0"
 },
 {
  "id": "2C8000_1529.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（そらきた、落ちついて落ちついて……）",
  "en": "",
  "dup": "2C8000_1204.0"
 },
 {
  "id": "2C8000_1566.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやまて、クラリス落ちつけ、 / 「きみがあまりにもきれいだ」はだめなんだ。",
  "en": ""
 },
 {
  "id": "2C8000_158F.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2BBE84_133A.0"
 },
 {
  "id": "2C8000_1597.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ヘ？",
  "en": ""
 },
 {
  "id": "2C8000_15A1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（しまった。なにを言っているのだ私は）",
  "en": "",
  "dup": "2C8000_1259.0"
 },
 {
  "id": "2C8000_15B9.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 3,
  "jp": "どういう意味だ？ / きれいだ、はだめ……ってのは。 / 文法がまちがってるぞ。",
  "en": ""
 },
 {
  "id": "2C8000_15E7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "いやその、だから、",
  "en": "",
  "dup": "2C8000_12A0.0"
 },
 {
  "id": "2C8000_15F6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "君があまりにもきれいなのがいけないのだ、 / だから私はついふらふらとこの部屋に……。",
  "en": ""
 },
 {
  "id": "2C8000_1624.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "（……ってさらになにを / 墓穴を掘っているんだ、私はっ！！）",
  "en": "",
  "dup": "2C8000_12DF.0"
 },
 {
  "id": "2C8000_1624.1",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "え……ええ！？（ぽっ）",
  "en": "",
  "dup": "2E0000_058D.1"
 },
 {
  "id": "2C8000_165B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（い、いかん、どんどんドツボにはまっていく）",
  "en": "",
  "dup": "2C8000_1316.0"
 },
 {
  "id": "2C8000_1678.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（ぷっ）",
  "en": "",
  "dup": "2C8000_1333.0"
 },
 {
  "id": "2C8000_1682.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あ。カケルに笑われた）",
  "en": ""
 },
 {
  "id": "2C8000_1693.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……な、なあ、今なんて言った？",
  "en": ""
 },
 {
  "id": "2C8000_16A8.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わ、私は、君が美しいと言ったんだ。",
  "en": "",
  "dup": "2E0000_05E4.0"
 },
 {
  "id": "2C8000_16BE.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "そ、それじゃ今後の作戦を / 考えなければならないからな、またあとで……。",
  "en": ""
 },
 {
  "id": "2C8000_16E4.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……もうちょっとここにいてもいいぜ。",
  "en": "",
  "dup": "2E0000_061F.0"
 },
 {
  "id": "2C8000_16FC.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（し、しまったあああっ！！）",
  "en": "",
  "dup": "2C8000_13B0.0"
 },
 {
  "id": "2C8000_1715.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……。",
  "en": "",
  "dup": "2E0000_0668.0"
 },
 {
  "id": "2C8000_172F.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、こんにちは。",
  "en": "",
  "dup": "2C315D_13CE.0"
 },
 {
  "id": "2C8000_173A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、ロイドン……ひさしぶりだね。",
  "en": "",
  "dup": "2CA4C9_0FB5.0"
 },
 {
  "id": "2C8000_174D.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ひさしぶり！？",
  "en": "",
  "dup": "2CA4C9_0FC8.0"
 },
 {
  "id": "2C8000_175A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……い、いや。",
  "en": "",
  "dup": "2CA4C9_0FD5.0"
 },
 {
  "id": "2C8000_1768.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして……僕の名前を知ってるんだい？",
  "en": "",
  "dup": "2CA4C9_0FE3.0"
 },
 {
  "id": "2C8000_1781.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "えーと……カ、カケルから聞いたんだ。",
  "en": "",
  "dup": "2CA4C9_0FFC.0"
 },
 {
  "id": "2C8000_1796.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "なーんだ、そうだったのかい。",
  "en": "",
  "dup": "2CA4C9_1011.0"
 },
 {
  "id": "2C8000_17AA.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル君には、さっき色々と / 話をしてもらったんだ。",
  "en": "",
  "dup": "2CA4C9_1025.0"
 },
 {
  "id": "2C8000_17C4.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "彼は『ヤマト・タケル』の息子なんだよね。 / 彼の話はなかなか面白かったよ。",
  "en": "",
  "dup": "2CA4C9_103F.0"
 },
 {
  "id": "2C8000_17C4.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、ああ、やつは話をするのが好きだからな。",
  "en": "",
  "dup": "2CA4C9_103F.1"
 },
 {
  "id": "2C8000_180E.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕は冒険小説家になりたいんだよ。",
  "en": "",
  "dup": "2C315D_14AD.0"
 },
 {
  "id": "2C8000_1825.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "レイモンド王国で起こったことを / 忘れないようにメモして、 / いつかこのことを本にして出販するつもりさ。",
  "en": "",
  "dup": "2CA4C9_10A0.0"
 },
 {
  "id": "2C8000_1825.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "がんばってくれ、ロイドン。",
  "en": "",
  "dup": "2C315D_14C4.1"
 },
 {
  "id": "2C8000_1869.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "君って……なれなれしいんだね。",
  "en": "",
  "dup": "2C315D_1508.0"
 },
 {
  "id": "2C8000_187D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうか？",
  "en": "",
  "dup": "2C315D_151C.0"
 },
 {
  "id": "2C8000_1889.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "まあいい、君もカケル君の仲間なんだろう？ / カケル君みたいに話を聞かせて貫えないか？",
  "en": "",
  "dup": "2C315D_1528.0"
 },
 {
  "id": "2C8000_1889.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わ、私も話をするのか？",
  "en": "",
  "dup": "2CA4C9_1101.0"
 },
 {
  "id": "2C8000_18C6.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "協力してくれよ…… / ほら、君の好きな色のノートに書くからさ。",
  "en": "",
  "dup": "2CA4C9_1112.0"
 },
 {
  "id": "2C8000_18F4.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあエト君、また会ったねえ……",
  "en": ""
 },
 {
  "id": "2C8000_1907.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕も君たちといっしょの船で / ロンボニ大陸にきたんだ。",
  "en": "",
  "dup": "2E0000_0E16.0"
 },
 {
  "id": "2C8000_191F.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 3,
  "jp": "聞いたかい？……とうとう、シーボーズの港街も / 黒い霧に包まれたそうだ、 / じきにカラープにもやってくるだろうね。",
  "en": ""
 },
 {
  "id": "2C8000_1954.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 3,
  "jp": "僕は命ある限り、 / 今回の冒険を書き続けるつもりさ…… / よかったら君も協力してくれよ。",
  "en": "",
  "dup": "2ED46D_0D87.0"
 },
 {
  "id": "2C8000_198A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかった……協力するぞ。",
  "en": ""
 },
 {
  "id": "2C8000_199D.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "さてと、今度は何色のノートに書くかなあ…… / エト君、何色がいい？",
  "en": "",
  "dup": "2C315D_15BB.1"
 },
 {
  "id": "2C8000_19CB.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……今度こそ僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_079C.0"
 },
 {
  "id": "2C8000_19E1.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2C8000_19EA.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "2C8000_19FE.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度はどのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07D0.0"
 },
 {
  "id": "2C8000_1A17.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "君は何色が好きなんだい？ / 青色のノート",
  "en": "",
  "dup": "2FB86E_07EA.0"
 },
 {
  "id": "2C8000_1A2C.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "赤色のノート / 緑色のノート | 次の機会にする",
  "en": "",
  "dup": "2FB86E_07FF.0"
 },
 {
  "id": "2C8000_1A5D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は青色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_11D8.0"
 },
 {
  "id": "2C8000_1A78.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 青色のノート",
  "en": "",
  "dup": "2FB86E_084F.0"
 },
 {
  "id": "2C8000_1A8D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は赤色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_1208.0"
 },
 {
  "id": "2C8000_1AA8.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 赤色のノート",
  "en": "",
  "dup": "2FB86E_0883.0"
 },
 {
  "id": "2C8000_1ABD.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は緑色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_1238.0"
 },
 {
  "id": "2C8000_1AD8.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 緑色のノート",
  "en": "",
  "dup": "2FB86E_08B8.0"
 },
 {
  "id": "2C8000_1AE9.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "に君の冒険を書き込もう。",
  "en": "",
  "dup": "2FB86E_08C9.0"
 },
 {
  "id": "2C8000_1AE9.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやあ、とても楽しかったよ…… / よかったらまた話を聞かせてくれ。",
  "en": "",
  "dup": "2FB86E_08C9.1"
 },
 {
  "id": "2C8000_1B1F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "すまないが、やっぱり話をするのはやめよう。",
  "en": "",
  "dup": "2CA4C9_129A.0"
 },
 {
  "id": "2C8000_1B3A.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……また今度話を聞かせてくれよ。",
  "en": "",
  "dup": "2CA4C9_12B5.0"
 },
 {
  "id": "2C8000_1B5E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "やあライナス、なんだか顔色が悪いな。 / ……青をとおり越して紫になっているぞ。",
  "en": ""
 },
 {
  "id": "2C8000_1B5E.1",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うるさい……お、俺は船が苦手なんだ。",
  "en": ""
 },
 {
  "id": "2C8000_1BA8.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わっはっはっ！！",
  "en": "",
  "dup": "2D259F_00FC.0"
 },
 {
  "id": "2C8000_1BB6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "船になんか乗らないで、 / 泳いでくればよかったんだ。",
  "en": ""
 },
 {
  "id": "2C8000_1BD2.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふざけんなっ！！",
  "en": ""
 },
 {
  "id": "2C8000_1BE0.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "船で３週間もかかるんだぜ！！ / 海のどまん中で黒い霧に包まれちまうよっ！！",
  "en": ""
 },
 {
  "id": "2C8000_1C0B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わっはっはっ！！　冗談だよ、ライナス。",
  "en": ""
 },
 {
  "id": "2C8000_1C26.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ロンボニ王国に行ったら…… / うっぷ……おばえてろよっ！！",
  "en": ""
 },
 {
  "id": "2C8000_1C42.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 2,
  "jp": "この船はもうレイモンド大陸には戻らないぜ。 / あの大陸は、黒い霧に包まれちまったそうだ。",
  "en": "",
  "dup": "2E0000_1132.0"
 },
 {
  "id": "2C8000_1C42.1",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 3,
  "jp": "船のない船長なんざ、 / 泡の出ないビールのようなもんだ…… / 俺の船長稼業も潮時だな。",
  "en": "",
  "dup": "2E0000_1132.1"
 },
 {
  "id": "2C8000_1CA5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "船長をやめてどうするんだ？",
  "en": ""
 },
 {
  "id": "2C8000_1CB8.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前たちみたいに闘う勇気もないし…… / まあ、これから考えてみるさ。",
  "en": "",
  "dup": "2E0000_11A7.0"
 },
 {
  "id": "2C8000_1CE1.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 2,
  "jp": "うーん…… / どの職業も、俺には似合いそうもないな。",
  "en": ""
 },
 {
  "id": "2C8000_1D01.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "また会ったな。",
  "en": "",
  "dup": "2E0000_11F5.0"
 },
 {
  "id": "2C8000_1D0E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "トルへスもいっしょの船できたのか？",
  "en": ""
 },
 {
  "id": "2C8000_1D26.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "俺様がいなくなったら、お前だって困るだろ？",
  "en": ""
 },
 {
  "id": "2C8000_1D42.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "まあ……な。",
  "en": ""
 },
 {
  "id": "2C8000_1D4E.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "わっはっはっ、わかればいいんだ。",
  "en": ""
 },
 {
  "id": "2C8000_1D64.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "で、この街ではだれを紹介してくれるんだ？",
  "en": ""
 },
 {
  "id": "2C8000_1D7E.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "えー……あれ！？",
  "en": ""
 },
 {
  "id": "2C8000_1D8C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "すまん、この街の住人はみんな / ルシフォン軍に連れ去られてしまったようだ。",
  "en": ""
 },
 {
  "id": "2C8000_1DB2.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 4,
  "jp": "あとはシーボーズの港街から / 逃げてきた連中ばかりだからな…… / 残念だが、今のところは / だれも登録してないようだ。",
  "en": ""
 },
 {
  "id": "2C8000_1DEF.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "トルへス……最近、悩んでないか？",
  "en": ""
 },
 {
  "id": "2C8000_1E05.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "いきなりなんだよ、 / 俺はなにも悩んでないぞ。",
  "en": ""
 },
 {
  "id": "2C8000_1E05.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "悩むとだな、ますます悩みの種が大きくなるぞ… / 一番いいのは気にしないことだ。",
  "en": ""
 },
 {
  "id": "2C8000_1E05.2",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……いったいなんのことを言ってるんだ？",
  "en": ""
 },
 {
  "id": "2C8000_1E6D.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、カケルみたいなことを言うなよ！",
  "en": ""
 },
 {
  "id": "2C8000_1E84.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ほっほっほ、わしはユリシーズの出身ぢゃよ。",
  "en": ""
 },
 {
  "id": "2C8000_1E9C.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 3,
  "jp": "わしに話しかけてくれたお礼にな、 / いいことを教えてやるわい…… / これはワシが独自に調べ上げたものぢゃ。",
  "en": "",
  "dup": "2E0000_1408.0"
 },
 {
  "id": "2C8000_1EDE.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 4,
  "jp": "ドラゴンに乗っとるやつらが、すべて / ドラゴンナイト一族というわけではないのぢゃ… / ルシフォンという男だけがドラゴンナイトでな、 / あとはワシたちと同じただの民間人ぢゃ。",
  "en": ""
 },
 {
  "id": "2C8000_1F37.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 4,
  "jp": "それとな、すべてのドラゴンがルシフォンと / 手を組んだわけではないのぢゃ…… / 人間と同じように中にはいいやつも、 / 悪いやつもおるわい。",
  "en": ""
 },
 {
  "id": "2C8000_1F7F.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ユリシーズの街は、とうの昔に黒い霧の中ぢゃよ",
  "en": "",
  "dup": "2E0000_14E8.0"
 },
 {
  "id": "2C8000_1F97.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……ワシは、生まれ育った家で / 石になってやろうと思ったんぢゃが。",
  "en": "",
  "dup": "2E0000_1500.0"
 },
 {
  "id": "2C8000_1FC0.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 2,
  "jp": "いくつになっても死ぬのは恐いわい…… / ふおっふおっふおっ。",
  "en": "",
  "dup": "2E0000_1529.0"
 },
 {
  "id": "2C8000_1FE5.0",
  "speaker": "ドン・カポネ",
  "form": "dlg",
  "nlines": 4,
  "jp": "この街はシーボーズと交易してたから、 / 何度もきたことがあるんだが…… / ここに住んでたやつらは / どこに行っちまったんだ！？",
  "en": "",
  "dup": "2E0000_1550.0"
 },
 {
  "id": "2C8000_202A.0",
  "speaker": "ドン・カポネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "金目の物はなにもねーし…… / シケた街になっちまったぜ。",
  "en": "",
  "dup": "2E0000_1595.0"
 },
 {
  "id": "2C8000_204E.0",
  "speaker": "ドン・カポネ",
  "form": "dlg",
  "nlines": 4,
  "jp": "こうなったら……闘いに巻き込まれてない街を / さがし出してやる…… / そこでまた街のボスとして / 君臨してやるぜえっ！！",
  "en": ""
 },
 {
  "id": "2C8000_2093.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 3,
  "jp": "俺はルシフォン軍の目を盗み、 / ロンボニ王国からこの街を偵察にきた / サントスってもんだ。",
  "en": "",
  "dup": "2E0000_15FD.0"
 },
 {
  "id": "2C8000_20BF.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "我が王国は完全にルシフォンの支配下にある……",
  "en": "",
  "dup": "2E0000_1629.0"
 },
 {
  "id": "2C8000_20DD.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "国王とビアンカ姫は無事だが、 / 国は完全に乗っ取られてるよ。",
  "en": "",
  "dup": "2E0000_1647.0"
 },
 {
  "id": "2C8000_2101.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "私はロンボニ王国に戻るとしよう。",
  "en": "",
  "dup": "2E0000_16C8.0"
 },
 {
  "id": "2C8000_2113.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの目的が、 / おばろげながらわかったからな……。",
  "en": "",
  "dup": "2E0000_16DA.0"
 },
 {
  "id": "2C8000_2134.0",
  "speaker": "メンミイ",
  "form": "dlg",
  "nlines": 4,
  "jp": "ドラゴンに乗ってれば / ドラゴンナイトなのかしら？ / この間、ドラゴンから / 振り落とされた人を見たわよ。",
  "en": ""
 },
 {
  "id": "2C8000_216A.0",
  "speaker": "メンミイ",
  "form": "dlg",
  "nlines": 1,
  "jp": "情けないドラゴンナイトよね……",
  "en": ""
 },
 {
  "id": "2C8000_217E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "初心者マークをつけた方が / いいんじゃないかしら？",
  "en": "",
  "dup": "2E0000_1840.0"
 },
 {
  "id": "2C8000_2198.0",
  "speaker": "メンミイ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はユリシーズの街から逃げ続けてるの。 / ようするにプロの逃亡者ね。",
  "en": ""
 },
 {
  "id": "2C8000_2198.1",
  "speaker": "メンミイ",
  "form": "dlg",
  "nlines": 3,
  "jp": "何度も見つかりそうになって、 / その度にひやひやしっぱなしだったけど…… / あのスリルがたまらなく快感なのよねえ。",
  "en": ""
 },
 {
  "id": "2C8000_21FE.0",
  "speaker": "メンミイ",
  "form": "dlg",
  "nlines": 2,
  "jp": "さーて、またスリルを味わいに / 東ヘ行ってみようかしら……。",
  "en": ""
 },
 {
  "id": "2C8000_224E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "東にいるルシフォン軍をやっつければ、 / ロンボニ王国に行くことができるんだ。",
  "en": ""
 },
 {
  "id": "2C8000_2271.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍め…… / 私たちを待ち伏せしてるんだろうな。",
  "en": ""
 },
 {
  "id": "2C8000_2290.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "東に向かいますか？",
  "en": "",
  "dup": "2F9C88_1191.0"
 },
 {
  "id": "2C8000_229B.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "はい / ",
  "en": "",
  "dup": "2F9C88_119C.0"
 },
 {
  "id": "2C8000_22A2.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "いいえ",
  "en": "",
  "dup": "2F9C88_11A3.0"
 },
 {
  "id": "2C8000_22B4.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "よーし、みんなっ！！ / 東に向かって出発だあ！！",
  "en": ""
 },
 {
  "id": "2C8000_22E7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "やっと出発するんだね。",
  "en": ""
 },
 {
  "id": "2C8000_22F5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "うわさでは、ルシフォンの軍隊が / 俺たちを待ち伏せしてるそうだ。 / 気をひきしめていこう！！",
  "en": ""
 },
 {
  "id": "2C8000_232F.0",
  "speaker": "ポセイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "街の右下にある木箱を探せ…… / 合言葉は『ちぬたたぬち』だ。",
  "en": "",
  "dup": "2E0000_1B7B.0"
 },
 {
  "id": "2C8000_2365.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "地響きがしたかと思うと、 / エトの身体が地面に吸い込まれた！！",
  "en": ""
 },
 {
  "id": "2C8000_2399.0",
  "speaker": "木箱の精",
  "form": "dlg",
  "nlines": 1,
  "jp": "汝、合言葉を言え。",
  "en": "",
  "dup": "2E0000_1BE5.0"
 },
 {
  "id": "2C8000_23AA.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "ぬちたたちぬ / ",
  "en": "",
  "dup": "2E0000_1BF6.0"
 },
 {
  "id": "2C8000_23B7.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "ちぬたたぬち / たちぬぬちた",
  "en": "",
  "dup": "2E0000_1C03.0"
 },
 {
  "id": "2C8000_23D8.0",
  "speaker": "木箱の精",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E0000_1C24.0"
 },
 {
  "id": "2C8000_23E4.0",
  "speaker": "木箱の精",
  "form": "dlg",
  "nlines": 2,
  "jp": "３本の、まん中を探せ…… / 合言葉は『すなみみなす』だ。",
  "en": "",
  "dup": "2E0000_1C30.0"
 },
 {
  "id": "2C8000_2413.0",
  "speaker": "木の精",
  "form": "dlg",
  "nlines": 1,
  "jp": "汝、合言葉を言え。",
  "en": "",
  "dup": "2E0000_1C5F.0"
 },
 {
  "id": "2C8000_2424.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "すなみみなす / ",
  "en": "",
  "dup": "2E0000_1C70.0"
 },
 {
  "id": "2C8000_242F.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "なすみみすな / みなすすなみ",
  "en": "",
  "dup": "2E0000_1C7B.0"
 },
 {
  "id": "2C8000_244C.0",
  "speaker": "木の精",
  "form": "dlg",
  "nlines": 1,
  "jp": "ポセイドンのところに戻るのだ……。",
  "en": "",
  "dup": "2E0000_1C98.0"
 },
 {
  "id": "2C8000_2470.0",
  "speaker": "木の精",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E0000_1CBC.0"
 },
 {
  "id": "2C8000_247D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトは力の種を３個見つけた！！",
  "en": "",
  "dup": "2DE230_177E.0"
 },
 {
  "id": "2C8000_248E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトは守りの種を３個見つけだした！！",
  "en": ""
 },
 {
  "id": "2C8000_249F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトは力の種を２個見つけた！！ / エトは守りの種を２個見つけた！！",
  "en": ""
 }
]
