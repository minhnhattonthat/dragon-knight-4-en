  "nlines": 1,
  "jp": "ルシフォン様。",
  "en": ""
 },
 {
  "id": "2E7828_0018.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 1,
  "jp": "今、報告が入りました。",
  "en": ""
 },
 {
  "id": "2E7828_002A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "カケルとその一行は、孤島を脱出して、 / ドラゴニア大陸ヘ向かっているとのことで / ございます。",
  "en": ""
 },
 {
  "id": "2E7828_002A.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……どうだ、リディア？",
  "en": ""
 },
 {
  "id": "2E7828_006A.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 4,
  "jp": "お前にやつらの首をくれてやろうか？ / いまやつらを襲えば、簡単にけりがつくぞ。 / ……なにもハーディスに / 手柄をくれてやることはあるまい。",
  "en": ""
 },
 {
  "id": "2E7828_00B8.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 1,
  "jp": "ご命令とあれば、いかようにも。",
  "en": ""
 },
 {
  "id": "2E7828_00CE.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……フフ、冗談だ。",
  "en": ""
 },
 {
  "id": "2E7828_00DF.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "せっかく島から脱出するのを / だまって待っていてやったのだからな……",
  "en": ""
 },
 {
  "id": "2E7828_0105.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "せいぜい楽しませてくれねば、 / 割にあわぬと言うものだ。 / フフフ……。",
  "en": ""
 }
]
