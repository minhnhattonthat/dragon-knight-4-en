[
 {
  "id": "2F553D_00AB.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、ホビットの村を解放したぞ！！",
  "en": ""
 },
 {
  "id": "2F553D_00C0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか……火薬の匂いがするなあ。",
  "en": ""
 },
 {
  "id": "2F553D_00D8.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえ、カケル……。",
  "en": ""
 },
 {
  "id": "2F553D_00E5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネのことでしょ？ / セイルがそう言う時は、決まってるんだ。",
  "en": ""
 },
 {
  "id": "2F553D_00E5.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そんなことないよ……。",
  "en": ""
 },
 {
  "id": "2F553D_0116.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、マルレーネだ。",
  "en": ""
 },
 {
  "id": "2F553D_0122.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "え！？　ど、どこ！？",
  "en": ""
 },
 {
  "id": "2F553D_0132.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ウソ。",
  "en": ""
 },
 {
  "id": "2F553D_013B.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕は真剣なのに……ひどいや。",
  "en": ""
 },
 {
  "id": "2F553D_0156.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、ナターシャだ。",
  "en": ""
 },
 {
  "id": "2F553D_0162.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……マルレーネだ。",
  "en": ""
 },
 {
  "id": "2F553D_016F.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "え！？　ど、どこ！？",
  "en": "",
  "dup": "2F553D_0122.0"
 },
 {
  "id": "2F553D_017F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ははは……ウソ。",
  "en": ""
 },
 {
  "id": "2F553D_0191.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "こ……こわいよぉ……。",
  "en": ""
 },
 {
  "id": "2F553D_01A7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……ひとりでいるなんてめずらしいね。",
  "en": ""
 },
 {
  "id": "2F553D_01BF.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "うーん、本当はここで / なにかが起きると思ったんだが…… / 残念ながらなにも起きなかった。",
  "en": ""
 },
 {
  "id": "2F553D_01F1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "言ってる意味がわからないよ。",
  "en": ""
 },
 {
  "id": "2F553D_0204.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ははは……実は自分でもわからないんだ。",
  "en": ""
 },
 {
  "id": "2F553D_021E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャとはうまくいってるのか？",
  "en": ""
 },
 {
  "id": "2F553D_0232.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "それは僕がエトに聞くことでしょ？",
  "en": ""
 },
 {
  "id": "2F553D_0246.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……なにかかんちがいしてないか？",
  "en": ""
 },
 {
  "id": "2F553D_025C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "……みんなだいぶ疲れてるみたいだな。 / この村でゆっくり休もう。",
  "en": ""
 },
 {
  "id": "2F553D_025C.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕は全然疲れてないよ。",
  "en": ""
 },
 {
  "id": "2F553D_0295.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "だからカケル以外のみんなが疲れてるんだよ。",
  "en": ""
 },
 {
  "id": "2F553D_02B2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（ありゃりゃりゃ！？）",
  "en": ""
 },
 {
  "id": "2F553D_02C2.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "いや……。",
  "en": ""
 },
 {
  "id": "2F553D_02CC.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私の言うことをなんでも聞くと言ったな？",
  "en": ""
 },
 {
  "id": "2F553D_02E5.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……それとも君は約束を破るのか？ / ……ロンボニ王国の姫君ともあろうお方が。",
  "en": ""
 },
 {
  "id": "2F553D_030E.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ど、どうしてそれを知ってるのですか？",
  "en": ""
 },
 {
  "id": "2F553D_0323.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "みんな知ってるさ。",
  "en": ""
 },
 {
  "id": "2F553D_0332.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は……約束を破ったことは、 / 今まで一度もありませんわ。",
  "en": ""
 },
 {
  "id": "2F553D_0332.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そう……じゃあ遠庫なく。",
  "en": ""
 },
 {
  "id": "2F553D_036B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ビアンカ……君が普通の女の子であることを / わからせてやろう。",
  "en": ""
 },
 {
  "id": "2F553D_0392.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "あ……く、くちびるを……？ / ぶ、無礼者っ！！",
  "en": ""
 },
 {
  "id": "2F553D_0392.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 5,
  "jp": "私が君を普通の女の子だと言ったのは、 / なにも姿形とか、剣の腕どうとかではないんだ。 / 君だって、みんなと同じように人を愛する心を / 持っているはずさ……そしてそれは人間が持つ、 / 一番美しい部分なんだ。",
  "en": ""
 },
 {
  "id": "2F553D_0392.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "（む、むずかしくて……なにを言ってるのか、 / よくわからないや）",
  "en": ""
 },
 {
  "id": "2F553D_0446.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……どうだ、心に愛が満ちていくだろう？",
  "en": ""
 },
 {
  "id": "2F553D_0460.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "いや……恥ずかしいですわ。",
  "en": ""
 },
 {
  "id": "2F553D_0473.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "（またやってらあ……だれかに見られたら、 / どうするつもりだろ？）",
  "en": ""
 },
 {
  "id": "2F553D_04A3.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん……なにしてるのですか？",
  "en": ""
 },
 {
  "id": "2F553D_04B2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どわわわっ！！",
  "en": ""
 },
 {
  "id": "2F553D_04BF.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "マ、マルレーネ……し――――っ！！",
  "en": ""
 },
 {
  "id": "2F553D_04D3.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "やだ……エトさんとビアンカさんが。",
  "en": ""
 },
 {
  "id": "2F553D_04E8.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさんって、ナターシャさんの / 恋人なんじゃないんですか？",
  "en": ""
 },
 {
  "id": "2F553D_04E8.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトはね、だれとでもするんだよ……。",
  "en": ""
 },
 {
  "id": "2F553D_051C.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "本当ですか？",
  "en": ""
 },
 {
  "id": "2F553D_0528.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……カケルさん……こっちに来てください。",
  "en": ""
 },
 {
  "id": "2F553D_053D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "むぎゅっ……。",
  "en": ""
 },
 {
  "id": "2F553D_054A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（や、やわらかあい……）",
  "en": ""
 },
 {
  "id": "2F553D_055B.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 3,
  "jp": "カケルさんは、一番好きな人以外と / あんなことをしたらだめですよ。 / 傷つく人がいるから。",
  "en": ""
 },
 {
  "id": "2F553D_0591.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、エトがあんなことをしたら…… / ナターシャが傷つくんだね。",
  "en": ""
 },
 {
  "id": "2F553D_0591.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 3,
  "jp": "ナターシャさん以外の女の子が / こんな場面を見たら、 / もっと傷つくかも知れません。",
  "en": ""
 },
 {
  "id": "2F553D_05E1.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "だってその女の子は、 / いつも我慢しているんですよ…… / ナターシャさんがいるから、って。",
  "en": ""
 },
 {
  "id": "2F553D_05E1.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……わかったよ、マルレーネ。",
  "en": ""
 },
 {
  "id": "2F553D_062C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（まだやってらあ……）",
  "en": ""
 },
 {
  "id": "2F553D_0642.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしたの……元気がないね。",
  "en": ""
 },
 {
  "id": "2F553D_0656.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "元気はあるわよ……。",
  "en": ""
 },
 {
  "id": "2F553D_0665.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "なんか悩んでるみたい。 / ……相談に乗ってあげるよ。",
  "en": ""
 },
 {
  "id": "2F553D_0665.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルじゃ……だめなの。",
  "en": ""
 },
 {
  "id": "2F553D_0697.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ、僕が相談にのってあげるってば。",
  "en": ""
 },
 {
  "id": "2F553D_06B0.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "だからね、カケルじゃ相談相手にならないの。",
  "en": ""
 },
 {
  "id": "2F553D_06CB.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふふふっ……うわさをすれば、だわ。",
  "en": ""
 },
 {
  "id": "2F553D_06E2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うわさ？",
  "en": ""
 },
 {
  "id": "2F553D_06EC.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんでもないわよ……ねえ、ネプチューン？",
  "en": ""
 },
 {
  "id": "2F553D_06FE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか気になるなあ……。",
  "en": ""
 },
 {
  "id": "2F553D_070F.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふふふ……内緒。",
  "en": ""
 },
 {
  "id": "2F553D_071F.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、乙女の会話に口をはさまないでね。",
  "en": ""
 },
 {
  "id": "2F553D_073A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ヘいヘい……。",
  "en": ""
 },
 {
  "id": "2F553D_0752.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "一人でなにやってんの？",
  "en": ""
 },
 {
  "id": "2F553D_0763.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "西の空を見てました……。",
  "en": ""
 },
 {
  "id": "2F553D_0775.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "黒い霧はまだこの村には / やってこないようですね。",
  "en": ""
 },
 {
  "id": "2F553D_0795.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん、エトさんのことですけど……。",
  "en": ""
 },
 {
  "id": "2F553D_07AD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトがどうかしたの？",
  "en": ""
 },
 {
  "id": "2F553D_07BD.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……いいえ……なんでもありません。",
  "en": ""
 },
 {
  "id": "2F553D_07DA.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……邪魔するんじゃねーよ。",
  "en": ""
 },
 {
  "id": "2F553D_07F0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネ、なんだか知らないけど / 邪魔しちゃ悪いよ……あっちに行こう。",
  "en": ""
 },
 {
  "id": "2F553D_07F0.1",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちっが――――うっ！！",
  "en": ""
 },
 {
  "id": "2F553D_082E.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "世間話をするならあとにしてくれよ。 / あっちに行ってろ。",
  "en": ""
 },
 {
  "id": "2F553D_082E.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私がですか？",
  "en": ""
 },
 {
  "id": "2F553D_085B.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ち、ちがいますよお……。",
  "en": ""
 },
 {
  "id": "2F553D_0873.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん、こんにちは。",
  "en": ""
 },
 {
  "id": "2F553D_0881.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルっ！！　マルレーネと話すなっ！！",
  "en": ""
 },
 {
  "id": "2F553D_0896.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふふふ……見飽きちゃったんですか？",
  "en": ""
 },
 {
  "id": "2F553D_08AC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "見てるだけじゃつまらないもの。",
  "en": ""
 },
 {
  "id": "2F553D_08C1.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさんって、大人みたいですよ。",
  "en": ""
 },
 {
  "id": "2F553D_08D5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕は大人だよ。",
  "en": ""
 },
 {
  "id": "2F553D_08E2.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさんは……どこにいますか？",
  "en": ""
 },
 {
  "id": "2F553D_08F7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2F553D_08FF.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん、私の言うこと、聞いてます？",
  "en": ""
 },
 {
  "id": "2F553D_0917.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、邪魔だよ。",
  "en": ""
 },
 {
  "id": "2F553D_0926.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "はっきり言うなあ。",
  "en": ""
 },
 {
  "id": "2F553D_0934.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺は女のことになると、性格が変わるんだよ。 / 男同士の友情なんて、どうでもよくなるんだ。",
  "en": ""
 },
 {
  "id": "2F553D_0934.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "つまりいつものカルタスってことだね。",
  "en": ""
 },
 {
  "id": "2F553D_097E.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "あのねカケル……マルレーネさんの前で、 / そういうことを言わないでくれる？",
  "en": ""
 },
 {
  "id": "2F553D_09A4.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "なあカケル……この状況を見て、 / 遠庫しようっていう気が起こらないのか？",
  "en": ""
 },
 {
  "id": "2F553D_09D1.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 4,
  "jp": "どうやらこの村は火薬の生産が / 盛んだったらしい……。 / 火薬を使えるやつが仲間になってくれれば / 邪魔な岩など一発で吹き飛ばしてくれるぞ。",
  "en": ""
 },
 {
  "id": "2F553D_0A24.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "火薬の入った袋をさわらぬ方がいいぞ……。",
  "en": ""
 },
 {
  "id": "2F553D_0A41.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿に、もしものことがあったら……",
  "en": ""
 },
 {
  "id": "2F553D_0A59.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はこれからなにを生きがいに / 生きればいいのだ？",
  "en": ""
 },
 {
  "id": "2F553D_0A75.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、ナターシャったらね……。",
  "en": ""
 },
 {
  "id": "2F553D_0A86.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネプチューン！！　だめだめだめだめっ！！",
  "en": ""
 },
 {
  "id": "2F553D_0A9C.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャがなにを言ったか気になる？",
  "en": ""
 },
 {
  "id": "2F553D_0AB1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……。",
  "en": "",
  "dup": "2E8000_13AE.1"
 },
 {
  "id": "2F553D_0ABA.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "うーん、教えてあげたいけど…… / ナターシャが怒るから。",
  "en": ""
 },
 {
  "id": "2F553D_0ABA.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうよ、言っちゃだめ。",
  "en": ""
 },
 {
  "id": "2F553D_0AE9.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぶはあ……一戦交えたあとの水は格別だな。",
  "en": ""
 },
 {
  "id": "2F553D_0B06.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "今日はバナナを食べないの？",
  "en": ""
 },
 {
  "id": "2F553D_0B18.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 4,
  "jp": "さっきこの井戸に、 / バナナを１００本ほどむいて落としたんだ…… / ようするに、 / バナナエキスがたっぷりの水なのさ。",
  "en": ""
 },
 {
  "id": "2F553D_0B60.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "げ……。",
  "en": ""
 },
 {
  "id": "2F553D_0B69.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルも飲むかい？",
  "en": ""
 },
 {
  "id": "2F553D_0B78.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "遠庫しておくよ、ゴロンゴン。",
  "en": ""
 },
 {
  "id": "2F553D_0B91.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ライナス、なにをしてるの？",
  "en": ""
 },
 {
  "id": "2F553D_0BA4.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあはあはあ……うっ。",
  "en": ""
 },
 {
  "id": "2F553D_0BAF.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあはあはあ……ううっ。",
  "en": ""
 },
 {
  "id": "2F553D_0BBB.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "腹がいたい。トイレはないのか……。",
  "en": ""
 },
 {
  "id": "2F553D_0BD3.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあはあはあ……うううっ。",
  "en": ""
 },
 {
  "id": "2F553D_0BE0.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ト、トイレが見つからないんだ……ううっ！",
  "en": ""
 },
 {
  "id": "2F553D_0BFF.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あれれ？　ライナスのやつ、またやってるよ）",
  "en": ""
 },
 {
  "id": "2F553D_0C19.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "あーん、おねーちゃまあ、僕さみちいのぉ！",
  "en": ""
 },
 {
  "id": "2F553D_0C33.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2ED46D_0852.0"
 },
 {
  "id": "2F553D_0C3B.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしたんでちゅか？　コワイ顔ちて。",
  "en": ""
 },
 {
  "id": "2F553D_0C56.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……アンタのこと、全部聞いてるわよ。",
  "en": ""
 },
 {
  "id": "2F553D_0C6F.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "どきっ！！",
  "en": ""
 },
 {
  "id": "2F553D_0C7A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あっはっは！）",
  "en": ""
 },
 {
  "id": "2F553D_0C87.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "さっさと私の前から消えないと、 / ムチでいじめ倒すわよ。",
  "en": ""
 },
 {
  "id": "2F553D_0C87.1",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "あうあうあう……っ。",
  "en": ""
 },
 {
  "id": "2F553D_0CBB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（パンドラもすごいこと言うなあ）",
  "en": ""
 },
 {
  "id": "2F553D_0CCE.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん……",
  "en": ""
 },
 {
  "id": "2F553D_0CD6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの軍勢は、黒い霧の動きを止めて、 / だれかを生け捕りにするんだそうです。",
  "en": ""
 },
 {
  "id": "2F553D_0D01.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "生け捕りにするって、まさか…… / 私たちの中のだれかじゃないですよね？",
  "en": ""
 },
 {
  "id": "2F553D_0D26.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "この村にいると、火薬の匂いで / 頭が痛くなってきます……。",
  "en": ""
 },
 {
  "id": "2F553D_0D4D.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルよう……",
  "en": ""
 },
 {
  "id": "2F553D_0D59.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの軍勢は黒い霧の動きを止めて、 / だれかを生け捕りにするらしいぜ。",
  "en": ""
 },
 {
  "id": "2F553D_0D81.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "生け捕りにするって、まさかっ…… / 私たちの中のだれかじゃないだろうな？",
  "en": ""
 },
 {
  "id": "2F553D_0DA7.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "この村にいると、火薬の匂いで / 頭が痛くなってくるぜ……。",
  "en": ""
 },
 {
  "id": "2F553D_0DCE.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "乙乙乙……乙乙乙……。",
  "en": ""
 },
 {
  "id": "2F553D_0DDE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "起こしちゃ悪いや……。",
  "en": ""
 },
 {
  "id": "2F553D_0DEE.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "乙乙乙……乙乙乙……。",
  "en": ""
 },
 {
  "id": "2F553D_0DFE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "起こしちゃ悪いや……。",
  "en": "",
  "dup": "2F553D_0DDE.0"
 },
 {
  "id": "2F553D_0E0E.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "俺を仲間にしたことを、後悔してんだろ？",
  "en": ""
 },
 {
  "id": "2F553D_0E26.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "別にしてないよ。",
  "en": ""
 },
 {
  "id": "2F553D_0E33.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいや、その顔は後悔してる顔だ……。",
  "en": ""
 },
 {
  "id": "2F553D_0E4B.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぶつぶつぶつ……。",
  "en": "",
  "dup": "2FDDA8_0B8A.0"
 },
 {
  "id": "2F553D_0E55.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私を選んでよかったでしょう？ / このすらりと伸びた脚、形のいい胸。",
  "en": ""
 },
 {
  "id": "2F553D_0E55.1",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "それにしてもルシフォン軍ってしつこいわね。",
  "en": ""
 },
 {
  "id": "2F553D_0E8E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私たちにはかなうわけがないんだから、 / とっととあきらめればいいのに。",
  "en": ""
 },
 {
  "id": "2F553D_0EB5.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえ……早く東に行きましょうよ。",
  "en": ""
 },
 {
  "id": "2F553D_0EC9.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえカケル……あの子、かわいい。",
  "en": ""
 },
 {
  "id": "2F553D_0EDE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイルのこと？",
  "en": ""
 },
 {
  "id": "2F553D_0EEA.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "お話してくれるかなあ……。",
  "en": ""
 },
 {
  "id": "2F553D_0EF8.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "やっぱり……お話するの恥ずかしいな。",
  "en": ""
 },
 {
  "id": "2F553D_0F11.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "素敵な人だなあ……。",
  "en": ""
 },
 {
  "id": "2F553D_0F22.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんなら僕が呼んでこようか？",
  "en": ""
 },
 {
  "id": "2F553D_0F37.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめっ……まだ心の準備ができてないの。",
  "en": ""
 },
 {
  "id": "2F553D_0F58.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺はホビットの一族だ。ルシフォンの軍隊が、 / この村をこんなにしちまったんだ。",
  "en": ""
 },
 {
  "id": "2F553D_0F58.1",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 3,
  "jp": "俺もいっしょに連れてってくれよ…… / 絶対に後悔はさせないからさ。 / 訓練所に登録してるんだ。",
  "en": ""
 },
 {
  "id": "2F553D_0FBB.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 2,
  "jp": "ジーナは俺の友だちなんだけど、 / はっきり言って彼女より俺の方がいいよ。",
  "en": ""
 },
 {
  "id": "2F553D_0FE5.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、俺を選んでくれたんだな。",
  "en": ""
 },
 {
  "id": "2F553D_0FF9.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺は絶対に役に立つよ……ジーナなんかより、 / よっぽど爆弾作りがうまいからね。",
  "en": ""
 },
 {
  "id": "2F553D_102A.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "もう、いつでも出発できるよ。",
  "en": ""
 },
 {
  "id": "2F553D_104C.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ま、また失敗しちゃったあ。",
  "en": ""
 },
 {
  "id": "2F553D_105F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "げほげほげほっ、火薬の匂いがすごいなあ。",
  "en": ""
 },
 {
  "id": "2F553D_107A.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ご、ごめんなさあい……。",
  "en": ""
 },
 {
  "id": "2F553D_108B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "君はだれ？",
  "en": ""
 },
 {
  "id": "2F553D_1096.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私はジーナ……ホビットの一族よ。",
  "en": ""
 },
 {
  "id": "2F553D_10AA.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 4,
  "jp": "私ね、ピエールたちといっしょに / ハイキングに行ってて、 / 村に戻ってきたら……パパもママも、 / みーんないなくなってたの。",
  "en": ""
 },
 {
  "id": "2F553D_10EE.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 5,
  "jp": "この村をこんなにしたのは、 / ルシフォンの軍隊だって聞いたわ。 / だから、一生懸命爆弾の作り方をおばえて、 / ルシフォンと闘う軍隊に / 入れてもらおうと思って……。",
  "en": ""
 },
 {
  "id": "2F553D_10EE.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふーん……。",
  "en": "",
  "dup": "2FB86E_061B.0"
 },
 {
  "id": "2F553D_1148.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "おにーさん、離れてて…… / また爆弾を作る練習をしちゃうんだから。",
  "en": ""
 },
 {
  "id": "2F553D_1178.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "これをこうやって……これとあれを混ぜて。",
  "en": ""
 },
 {
  "id": "2F553D_1193.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "これで火をつけると……。 / ぷっすん。",
  "en": ""
 },
 {
  "id": "2F553D_1193.1",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……どうしてうまくいかないんだろ？",
  "en": ""
 },
 {
  "id": "2F553D_11C1.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私を仲間に入れてくれるなんて…… / とってもうれしい。",
  "en": ""
 },
 {
  "id": "2F553D_11C1.1",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私、爆弾作りはヘただけど、 / がんばるからよろしくね。",
  "en": ""
 },
 {
  "id": "2F553D_1202.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "いつでも出発できるわよ。",
  "en": ""
 },
 {
  "id": "2F553D_121F.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……こんにちは。",
  "en": "",
  "dup": "2FB86E_0599.0"
 },
 {
  "id": "2F553D_1227.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "こんにちは、おにーさん。",
  "en": "",
  "dup": "2FB86E_05A1.0"
 },
 {
  "id": "2F553D_122E.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "僕は冒険小説家を目指してる、 / ロイドンっていうんだ…… / レイモンド大陸とロンボニ大陸で起こったことを / 忘れないようにメモしてたのさ。",
  "en": "",
  "dup": "2FDDA8_10A6.0"
 },
 {
  "id": "2F553D_123E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふーん……。",
  "en": "",
  "dup": "2FB86E_061B.0"
 },
 {
  "id": "2F553D_1245.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "君は……どこからきたんだい？",
  "en": "",
  "dup": "2FB86E_0622.0"
 },
 {
  "id": "2F553D_124C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "僕はレイモンド王国を出て、 / ルシフォンの軍隊と闘い続けて…… / それでこの街にきたんだ。",
