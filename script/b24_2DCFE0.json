  "jp": "（なんだかなぁ……）",
  "en": ""
 },
 {
  "id": "2DCFE0_0802.0",
  "speaker": "ラスィ",
  "form": "dlg",
  "nlines": 1,
  "jp": "俺さまのように……。",
  "en": ""
 },
 {
  "id": "2DCFE0_0811.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E34B4_2280.0"
 },
 {
  "id": "2DCFE0_0819.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（まだやってるよ）",
  "en": ""
 },
 {
  "id": "2DCFE0_0827.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 3,
  "jp": "あああ、こんなところで野宿するはめに / なるなんて……もう、体じゅう汗でベトベトよ！ / 気持ち悪い……お風呂に入りたいわ……。",
  "en": ""
 },
 {
  "id": "2DCFE0_0873.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあ、入ったら？",
  "en": ""
 },
 {
  "id": "2DCFE0_0882.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "この岩場のどこにお風呂があるってーのよ？",
  "en": ""
 },
 {
  "id": "2DCFE0_089F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "お風呂場はないけど、温泉だったら / なんとかなるんじゃない？ / 自分で掘ればいいんだよ。",
  "en": ""
 },
 {
  "id": "2DCFE0_08D4.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "掘る？",
  "en": ""
 },
 {
  "id": "2DCFE0_08DE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、その頭についてるりっぱなドリルで。",
  "en": ""
 },
 {
  "id": "2DCFE0_08F9.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……あっちいきなさいよ……。",
  "en": ""
 },
 {
  "id": "2DCFE0_090C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあウェンディ、温泉は掘りあてた？",
  "en": ""
 },
 {
  "id": "2DCFE0_0923.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "掘ってないわよ、そんなもの！！",
  "en": ""
 },
 {
  "id": "2DCFE0_093D.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル君、まだ寝ないのかい？",
  "en": ""
 },
 {
  "id": "2DCFE0_0950.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ロイドンこそ…… / こんな遅い時間になにをしてるの？",
  "en": ""
 },
 {
  "id": "2DCFE0_0950.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ははは……僕の場合、夜の方が筆が進むんだ。",
  "en": ""
 },
 {
  "id": "2DCFE0_098C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "すごいなあ、ロイドンって…… / こんな時間まで小説を書いてるんだ。",
  "en": ""
 },
 {
  "id": "2DCFE0_098C.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちょうどよかったよ、カケル君…… / まだ寝ないなら、話をしてくれないかな？",
  "en": ""
 },
 {
  "id": "2DCFE0_098C.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "こんな時間に！？",
  "en": ""
 },
 {
  "id": "2DCFE0_09E7.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕にとってはまだお昼さ……",
  "en": ""
 },
 {
  "id": "2DCFE0_0A07.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……今度こそ僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_079C.0"
 },
 {
  "id": "2DCFE0_0A1D.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2DCFE0_0A27.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "2DCFE0_0A3B.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度はどのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07D0.0"
 },
 {
  "id": "2DCFE0_0A55.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "君は何色が好きなんだい？ / 青色のノート",
  "en": "",
  "dup": "2FB86E_07EA.0"
 },
 {
  "id": "2DCFE0_0A6A.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "赤色のノート / 緑色のノート | 次の機会にする",
  "en": "",
  "dup": "2FB86E_07FF.0"
 },
 {
  "id": "2DCFE0_0A9B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、青色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0830.0"
 },
 {
  "id": "2DCFE0_0AB2.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 青色のノート",
  "en": "",
  "dup": "2FB86E_084F.0"
 },
 {
  "id": "2DCFE0_0AC7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、赤色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0864.0"
 },
 {
  "id": "2DCFE0_0ADE.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 赤色のノート",
  "en": "",
  "dup": "2FB86E_0883.0"
 },
 {
  "id": "2DCFE0_0AF3.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、緑色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0898.0"
 },
 {
  "id": "2DCFE0_0B0B.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 緑色のノート",
  "en": "",
  "dup": "2FB86E_08B8.0"
 },
 {
  "id": "2DCFE0_0B1C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "に君の冒険を書き込もう。",
  "en": "",
  "dup": "2FB86E_08C9.0"
 },
 {
  "id": "2DCFE0_0B1C.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやあ、とても楽しかったよ…… / よかったらまた話を聞かせてくれ。",
  "en": "",
  "dup": "2FB86E_08C9.1"
 },
 {
  "id": "2DCFE0_0B5A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ごめん、やっぱり話をするのはやめるよ。",
  "en": "",
  "dup": "2FB86E_08FF.0"
 },
 {
  "id": "2DCFE0_0B73.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか・・・また今度話を聞かせてくれよ。",
  "en": "",
  "dup": "2FB86E_0918.0"
 },
 {
  "id": "2DCFE0_0B9E.0",
  "speaker": "長老ヤコブ",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん……トルル……元気でなぁ。",
  "en": ""
 },
 {
  "id": "2DCFE0_0BB0.0",
  "speaker": "長老ヤコブ",
  "form": "dlg",
  "nlines": 1,
  "jp": "乙乙乙……乙乙乙……。",
  "en": ""
 },
 {
  "id": "2DCFE0_0BC0.0",
  "speaker": "ラスカス",
  "form": "dlg",
  "nlines": 1,
  "jp": "乙乙乙……乙乙乙……。",
  "en": ""
 },
 {
  "id": "2DCFE0_0BD0.0",
  "speaker": "サイレス",
  "form": "dlg",
  "nlines": 1,
  "jp": "乙乙乙……乙乙乙……。",
  "en": ""
 },
 {
  "id": "2DCFE0_0BE0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "出発は明日の朝だな…… / ついでに、出口はここじゃない。",
  "en": ""
 },
 {
  "id": "2DCFE0_0C0D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふぁぁぁ……なんだか眠くなっちゃったぞ。",
  "en": ""
 },
 {
  "id": "2DCFE0_0C29.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ここで寝ますか？",
  "en": ""
 },
 {
  "id": "2DCFE0_0C33.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "はい / ",
  "en": "",
  "dup": "2F9C88_119C.0"
 },
 {
  "id": "2DCFE0_0C3A.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "いいえ",
  "en": "",
  "dup": "2F9C88_11A3.0"
 },
 {
  "id": "2DCFE0_0CB1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふあああっ……よく寝たな。",
  "en": ""
 },
 {
  "id": "2DCFE0_0CC4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そろそろ出発の時間じゃないか？",
  "en": ""
 },
 {
  "id": "2DCFE0_0CED.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "はあはあはあ……おはようカケル、 / そろそろ出発の時間だな。",
  "en": ""
 },
 {
  "id": "2DCFE0_0CED.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "みんな！！　そろそろ出発するぞうっ！！",
  "en": ""
 },
 {
  "id": "2DCFE0_0D20.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "東にはドワラルの村があるそうだ…… / そこを占領している / ルシフォン軍を蹴散らすぞうっ！！",
  "en": ""
 },
 {
  "id": "2DCFE0_0D4F.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "ま、待ってください！",
  "en": ""
 },
 {
  "id": "2DCFE0_0D63.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 2,
  "jp": "実は……へレネがタスタの港街に / 戻ったらしいんです。",
  "en": ""
 },
 {
  "id": "2DCFE0_0D63.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだって！",
  "en": ""
 },
 {
  "id": "2DCFE0_0D8C.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "ホワイトドラゴンが話してくれたんです。",
  "en": ""
 },
 {
  "id": "2DCFE0_0D9F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "数日前にここを通ろうとした / 「小さな人間」がいて、 / それが私と同じにおいをさせていたって……。",
  "en": ""
 },
 {
  "id": "2DCFE0_0D9F.1",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 4,
  "jp": "その人間はこの砦を通ることができなかったので / 西に引き返したんだそうです。 / 私はこれからひとりで、 / タスタに戻ってみようと思うんです。",
  "en": ""
 },
 {
  "id": "2DCFE0_0E23.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "それじゃデス・バレーを / 通るってことじゃないか！ / それなら、みんなで迎えにいかなきゃ！！",
  "en": ""
 },
 {
  "id": "2DCFE0_0E53.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "今の私たちには西ヘ引き返す時間も、 / デス・バレーで戦力を失う余裕もないぞ！",
  "en": ""
 },
 {
  "id": "2DCFE0_0E53.1",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの……なぜ、そんな大げさな話に？",
  "en": ""
 },
 {
  "id": "2DCFE0_0E97.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "今のデス・バレーはそんなに甘くないよ！",
  "en": ""
 },
 {
  "id": "2DCFE0_0EAC.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕たちだって全力で闘って、 / やっと切り抜けてこられたんだ。",
  "en": ""
 },
 {
  "id": "2DCFE0_0ECD.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 2,
  "jp": "そ、それじゃあへレネは……お願い！ / へレネを、妹を助けて！！",
  "en": ""
 },
 {
  "id": "2DCFE0_0ECD.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめだ！",
  "en": ""
 },
 {
  "id": "2DCFE0_0EFA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "いまそれをやれば、 / 戦力を大幅に減らすことになる…… / ルシフォンに対抗できなくなるかもしれない。 / それでもいいのか！？",
  "en": ""
 },
 {
  "id": "2DCFE0_0F3E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……！",
  "en": ""
 },
 {
  "id": "2DCFE0_0F47.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 2,
  "jp": "わかりましたっ…… / それなら、私ひとりで西ヘ戻ります！",
  "en": ""
 },
 {
  "id": "2DCFE0_0F47.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "すまない。そうしてく……。",
  "en": ""
 },
 {
  "id": "2DCFE0_0F7C.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん、本当にそれでいいのですか？",
  "en": ""
 },
 {
  "id": "2DCFE0_0F91.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "マ、マルレーネ……。",
  "en": ""
 },
 {
  "id": "2DCFE0_0F9D.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 5,
  "jp": "たしかに、へレネさんを迎えにいくための / 部隊をさけば、戦力は落ちてしまうでしょう。 / でも、ここで迎えを出さなかったら、 / あなたはもっと大事なものを / 失ってしまうことになりませんか？",
  "en": ""
 },
 {
  "id": "2DCFE0_0F9D.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そう……仲間の「信頼」を……。",
  "en": ""
 },
 {
  "id": "2DCFE0_101B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ……私は……。",
  "en": ""
 },
 {
  "id": "2DCFE0_1029.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうだよ！　エトがいかないっていうなら、 / 僕がいく！　止めたってむだだからね！！",
  "en": ""
 },
 {
  "id": "2DCFE0_1029.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん、私も手伝います。",
  "en": ""
 },
 {
  "id": "2DCFE0_106C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "だ、だめだ！ / 君達をあそこにやる訳には……！！",
  "en": ""
 },
 {
  "id": "2DCFE0_106C.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんで？　なんでだよ！",
  "en": ""
 },
 {
  "id": "2DCFE0_109C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 5,
  "jp": "わかった……迎えの隊を出そう……。 / ただし大部隊ではかえって危険だ。 / 発見される確率も高くなる。 / そう……６部隊ぐらいならちょうどいいだろう。 / これ以上はさけないぞ。",
  "en": ""
 },
 {
  "id": "2DCFE0_109C.1",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "ありがとう……！！",
  "en": ""
 },
 {
  "id": "2DCFE0_110D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "いや……。",
  "en": ""
 },
 {
  "id": "2DCFE0_111A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "誰をへレネの迎えにやりますか？ / レアの他に５人まで選べます。",
  "en": ""
 },
 {
  "id": "2DCFE0_1141.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よし、ドワラルの村に向かうぞ……。",
  "en": ""
 },
 {
  "id": "2DCFE0_116B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "眠れないから……散歩にでも行こうかな。",
  "en": ""
 },
 {
  "id": "2DCFE0_1187.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "こらーっ！！　カケルっ！！",
  "en": ""
 },
 {
