[
 {
  "id": "2E795A_0004.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふええぇぇぇっやっと勝ったあ……。",
  "en": ""
 },
 {
  "id": "2E795A_001D.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……も、もう１歩も動けないわ……。",
  "en": ""
 },
 {
  "id": "2E795A_0035.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "しっかりしろ、ナターシャ。",
  "en": ""
 },
 {
  "id": "2E795A_0045.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "無理もないわ。 / 今回は激戦でしたもの。",
  "en": ""
 },
 {
  "id": "2E795A_0045.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "……待って！ / う、上からなにかくるっ！！",
  "en": ""
 },
 {
  "id": "2E795A_0045.2",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "きゃあああああぁっ！！",
  "en": ""
 },
 {
  "id": "2E795A_008A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャっ！！",
  "en": ""
 },
 {
  "id": "2E795A_009B.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ははははははっ！ / なかなかやるではないか、人間ども！",
  "en": ""
 },
 {
  "id": "2E795A_009B.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なんだお前は！",
  "en": ""
 },
 {
  "id": "2E795A_00CA.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……！！",
  "en": ""
 },
 {
  "id": "2E795A_00D4.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 3,
  "jp": "元気がいいな、小僧。 / さすが神の血を引く勇者の息子だけはある。 / 正直、ここまで苦戦するとは思わなかったぞ！",
  "en": ""
 },
 {
  "id": "2E795A_0119.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "人質なんて卑怯だぞ！ / ナターシャを返せ！",
  "en": ""
 },
 {
  "id": "2E795A_0119.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "はははははっ！",
  "en": ""
 },
 {
  "id": "2E795A_0141.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "この女を取り戻したければ、 / デス・バレーまでこい！！ / そこを貴様らとの最終決戦場としよう！",
  "en": ""
 },
 {
  "id": "2E795A_0141.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "勝手なことをいうなあっ！",
  "en": ""
 },
 {
  "id": "2E795A_0183.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんとでもほざくがいい……",
  "en": ""
 },
 {
  "id": "2E795A_0196.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺は、貴様らを倒さない限り / 先には進めないのだ！",
  "en": ""
 },
 {
  "id": "2E795A_01B6.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "小僧！　必ず来い……殺されになぁ！！ / 待っているぞ！！",
  "en": ""
 },
 {
  "id": "2E795A_01B6.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルうぅっ！！",
  "en": ""
 },
 {
  "id": "2E795A_01E7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャああああああぁぁっ！！",
  "en": ""
 }
