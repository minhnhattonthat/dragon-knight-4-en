[
 {
  "id": "2B6754_0042.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2B6754_004A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううーん……。",
  "en": ""
 },
 {
  "id": "2B6754_0054.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……はっ！？",
  "en": ""
 },
 {
  "id": "2B6754_0060.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "また……孤島での生活が始まるのか。",
  "en": ""
 },
 {
  "id": "2B6754_0082.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイル、大丈夫だよな？",
  "en": ""
 },
 {
  "id": "2B6754_0091.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん……げろげろげろ。",
  "en": "",
  "dup": "2E1D1C_0070.0"
 },
 {
  "id": "2B6754_00A0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "海水を飲んでるが、平気みたいだ。",
  "en": ""
 },
 {
  "id": "2B6754_00B9.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うーん……。",
  "en": "",
  "dup": "2E1D1C_00A5.0"
 },
 {
  "id": "2B6754_00DC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……みんなの様子はどう？",
  "en": ""
 },
 {
  "id": "2B6754_00F0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "意識はあるが、みんな身体が動かないようだ。",
  "en": ""
 },
 {
  "id": "2B6754_010B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "これから……どうするの？",
  "en": ""
 },
 {
  "id": "2B6754_011D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうするって、ここで暮らすしかないだろう。",
  "en": ""
 },
 {
  "id": "2B6754_0139.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "泳いでドラゴニア大陸まで行くのか？",
  "en": "",
  "dup": "2E1D1C_01C8.0"
 },
 {
  "id": "2B6754_014C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だって、僕たちはライムリンまで行かないと。",
  "en": "",
  "dup": "2E1D1C_01DB.0"
 },
 {
  "id": "2B6754_0164.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "せっかく助かった命を無駄にするつもりか？",
  "en": ""
 },
 {
  "id": "2B6754_017F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だって……。",
  "en": "",
  "dup": "2E1D1C_020F.0"
 },
 {
  "id": "2B6754_0188.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "みんなが元気になったら、 / どうするかを決めよう……話はそれからだ。",
  "en": "",
  "dup": "2E1D1C_0218.0"
 },
 {
  "id": "2B6754_0247.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "そして、その日の夜……。",
  "en": "",
  "dup": "2E1D1C_02D1.0"
 },
 {
  "id": "2B6754_0269.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……他のみんなは？",
  "en": "",
  "dup": "2E1D1C_02F3.0"
 },
 {
  "id": "2B6754_027A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "休んでもらったよ……私たちでどうするか / 決めていいことになっている。",
  "en": ""
 },
 {
  "id": "2B6754_027A.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "で、これからのことだが……",
  "en": "",
  "dup": "2E1D1C_0304.1"
 },
 {
  "id": "2B6754_02B5.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルは、すぐにでも / ドラゴニア大陸に行きたいそうだ。",
  "en": "",
  "dup": "2E1D1C_033F.0"
 },
 {
  "id": "2B6754_02CE.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "行くって……どうやって？",
  "en": "",
  "dup": "2E1D1C_0358.0"
 },
 {
  "id": "2B6754_02E0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕はレイモンドの王様や / ロンボニの王様と約束したんだ！",
  "en": ""
 },
 {
  "id": "2B6754_02E0.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "他のみんなだって / ドラゴニア大陸に行きたいのは同じですよ。",
  "en": "",
  "dup": "2E1D1C_036A.1"
 },
 {
  "id": "2B6754_02E0.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、だからみんなで行こう。",
  "en": "",
  "dup": "2E1D1C_036A.2"
 },
 {
  "id": "2B6754_033A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕だったら、泳いででも行くよ。",
  "en": "",
  "dup": "2E1D1C_03C5.0"
 },
 {
  "id": "2B6754_0350.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "無茶を言うな…… / 船で一ヶ月かかるんだぜ。",
  "en": "",
  "dup": "2E1D1C_03DB.0"
 },
 {
  "id": "2B6754_0350.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "じゃあ船を造ろうよ…… / ここには木がいっぱいあるじゃないか。",
  "en": "",
  "dup": "2E1D1C_03DB.1"
 },
 {
  "id": "2B6754_0350.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "帆船でなければ、 / ドラゴニア大陸にはたどり着けない……。",
  "en": "",
  "dup": "2E1D1C_03DB.2"
 },
 {
  "id": "2B6754_0350.3",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕はここに残る…… / マルレーネさんだってここにいるでしょ？",
  "en": "",
  "dup": "2E1D1C_03DB.3"
 },
 {
  "id": "2B6754_0350.4",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ええ……泳いでドラゴニア大陸まで / 行く自信はありませんし。",
  "en": "",
  "dup": "2E1D1C_03DB.4"
 },
 {
  "id": "2B6754_0350.5",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちぇっ……いいよ、 / 僕ひとりでも行くから。",
  "en": "",
  "dup": "2E1D1C_03DB.5"
 },
 {
  "id": "2B6754_0350.6",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "……カケル。 / 私があげたお守りを返して。",
  "en": ""
 },
 {
  "id": "2B6754_0350.7",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "あなたみたいに命を大事にしない人なんか…… / お守りは必要ないでしょ？",
  "en": "",
  "dup": "2E1D1C_04A8.0"
 },
 {
  "id": "2B6754_0350.8",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "やだよ、一度もらったんだから僕の物だ。",
  "en": "",
  "dup": "2E1D1C_04A8.1"
 },
 {
  "id": "2B6754_0460.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、わがままもいいかげんにしろ……。",
  "en": "",
  "dup": "2E1D1C_04E9.0"
 },
 {
  "id": "2B6754_0478.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "わがままじゃないよっ！！ / ……みんながいくじなしなだけだい！！",
  "en": "",
  "dup": "2E1D1C_0501.0"
 },
 {
  "id": "2B6754_0478.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前の剣の力はみんな知っている…… / だからお前のことをみんなは頼ってるんだ。",
  "en": ""
 },
 {
  "id": "2B6754_0478.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "なにもお前がタケルの息子だからじゃないぞ。",
  "en": "",
  "dup": "2E1D1C_0501.2"
 },
 {
  "id": "2B6754_04E1.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "みんなお前と話し、お前といっしょに / 闘ってそう思うようになったんだ。 / 俺もそのひとりだ。",
  "en": ""
 },
 {
  "id": "2B6754_04E1.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前はみんなを見捨てて行けるのか？",
  "en": "",
  "dup": "2E1D1C_056B.1"
 },
 {
  "id": "2B6754_0527.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "自分さえ目的を果たせれば、 / あとはどうでもいいのか？",
  "en": "",
  "dup": "2E1D1C_05B1.0"
 },
 {
  "id": "2B6754_0547.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンを倒したいと思ってるのは、 / お前だけじゃないぞ。",
  "en": "",
  "dup": "2E1D1C_05D1.0"
 },
 {
  "id": "2B6754_0547.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうよ、カケル……エトはやっぱり大人だわ。",
  "en": "",
  "dup": "2E1D1C_05D1.1"
 },
 {
  "id": "2B6754_057F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ……よけいなことは言うな。",
  "en": "",
  "dup": "2E1D1C_0609.0"
 },
 {
  "id": "2B6754_0594.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ご、ごめんなさい……。",
  "en": "",
  "dup": "2E1D1C_061E.0"
 },
 {
  "id": "2B6754_05A0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "カケル、お前ひとりで / ドラゴニア大陸に行ってどうなる？ / まさかひとりで闘って、ルシフォン軍に / 勝てるなどと考えてるわけではあるまいな？",
  "en": "",
  "dup": "2E1D1C_062A.0"
 },
 {
  "id": "2B6754_05DE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、それは……。",
  "en": "",
  "dup": "2E1D1C_0668.0"
 },
 {
  "id": "2B6754_05EB.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさん…… / 私もカケルさんと別れたくありません。",
  "en": "",
  "dup": "2E1D1C_0675.0"
 },
 {
  "id": "2B6754_05EB.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 4,
  "jp": "もしここにいる仲間たちが、 / 最初から出会う運命であったのなら…… / きっと私たちはドラゴニア大陸にも、 / ルシフォンがいる場所にも行けます。",
  "en": ""
 },
 {
  "id": "2B6754_064D.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "だからカケルさん、今は我慢の時です……。",
  "en": ""
 },
 {
  "id": "2B6754_0666.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "今は黒い霧は動いていない。",
  "en": "",
  "dup": "2E1D1C_06F4.0"
 },
 {
  "id": "2B6754_0678.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "じっと待っていればこのあたりの海を / 通る船がいるかもしれない",
  "en": ""
 },
 {
  "id": "2B6754_069C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "……いや、きっといるさ。",
  "en": ""
 },
 {
  "id": "2B6754_06AB.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "いっしょにいてください。 / お願いです。",
  "en": "",
  "dup": "2E1D1C_0706.1"
 },
 {
  "id": "2B6754_06AB.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかった、マルレーネの言うとおりにするよ。",
  "en": "",
  "dup": "2E1D1C_0706.2"
 },
 {
  "id": "2B6754_06DC.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネさんだとずいぶんちがうのね。",
  "en": "",
  "dup": "2E1D1C_0768.0"
 },
 {
  "id": "2B6754_06F2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネは、ナターシャとちがって / 大人だからね。",
  "en": "",
  "dup": "2E1D1C_077E.0"
 },
 {
  "id": "2B6754_06F2.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ケンカはよせ……",
  "en": ""
 },
 {
  "id": "2B6754_0719.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "これから私たちは協力しあって、 / この島で生活するんだからな。",
  "en": ""
 },
 {
  "id": "2B6754_073D.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト、だれか見張りを立てた方がいいよ。 / いつ船がやってくるかわからないもの。",
  "en": "",
  "dup": "2E1D1C_07C9.0"
 },
 {
  "id": "2B6754_073D.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、そうだな……。",
  "en": "",
  "dup": "2E1D1C_07C9.1"
 },
 {
  "id": "2B6754_077A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "それに住む場所を造らなくては…… / 幸いこの島には、木がいっぱい生えている。 / 食料もなんとかしないと……。",
  "en": "",
  "dup": "2E1D1C_0806.0"
 },
 {
  "id": "2B6754_07B9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "明日から忙しくなるな。 / 今日はもう休むぞ。",
  "en": "",
  "dup": "2E1D1C_0845.0"
 },
 {
  "id": "2B6754_07B9.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさんの言うとおりです…… / みなさん、今日はもう休みましょう。",
  "en": "",
  "dup": "2E1D1C_0845.1"
 },
 {
  "id": "2B6754_07FE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "翌日から、私たちはこの島の開拓をはじめた。",
  "en": ""
 },
 {
  "id": "2B6754_081C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "私が全体の指揮をとって、 / その指示でみんな一生懸命働いた。",
  "en": ""
 },
 {
  "id": "2B6754_081C.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "船がこないかと海の方を見張りながら……。",
  "en": ""
 },
 {
  "id": "2B6754_0860.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "小屋を建て……。",
  "en": ""
 },
 {
  "id": "2B6754_086F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "食べ物を集め……。",
  "en": ""
 },
 {
  "id": "2B6754_087E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "そしてあっというまに、 / 遭難から５日が過ぎようとしていた。",
  "en": ""
 },
 {
  "id": "2B6754_08B3.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、エト。",
  "en": ""
 },
 {
  "id": "2B6754_08BE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "なにがやあ、だ……お前、 / いつもと変わらないじゃないか。",
  "en": ""
 },
 {
  "id": "2B6754_08BE.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前って……丈夫な身体をしてるなあ。",
  "en": ""
 },
 {
  "id": "2B6754_08F6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕、さっきみんなの様子を見に行ったんだ…… / ナターシャも無事だったみたいだね。",
  "en": ""
 },
 {
  "id": "2B6754_08F6.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……側についててやれよ。",
  "en": ""
 },
 {
  "id": "2B6754_0932.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕が？　……エトがついてた方が、 / ナターシャだって喜ぶよ。",
  "en": ""
 },
 {
  "id": "2B6754_0932.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "いいから、側についていてやれよ。 / 私はみんなの様子を見てくるから。",
  "en": ""
 },
 {
  "id": "2B6754_0932.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかったよ……ナターシャの側にいるよ。",
  "en": ""
 },
 {
  "id": "2B6754_0998.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、ナターシャは平気みたいだよ。",
  "en": ""
 },
 {
