[
 {
  "id": "2CF0C2_0007.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ぜ……全滅、全滅だと？ / こ、こん……こんなことが……。",
  "en": "",
  "dup": "2EF59B_000A.0"
 },
 {
  "id": "2CF0C2_0007.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前の軍隊はぜんぶやっつけたぞっ！ / もうあきらめろ！",
  "en": ""
 },
 {
  "id": "2CF0C2_0007.2",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "う……うそだっ！",
  "en": "",
  "dup": "2EF59B_000A.2"
 },
 {
  "id": "2CF0C2_0057.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺が……この俺が、 / 下等な人間ふぜいに敗れるはずがない！",
  "en": ""
 },
 {
  "id": "2CF0C2_007A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "そんなことがあっていいはずは……！！",
  "en": ""
 },
 {
  "id": "2CF0C2_008F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "むだな抗戦はやめろ！",
  "en": ""
 },
 {
  "id": "2CF0C2_00A0.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "ルシフォンにとって、 / お前は捨てゴマに過ぎないんだぞ。 / これ以上闘う意味はない！",
  "en": ""
 },
 {
  "id": "2CF0C2_00A0.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "認めん……私は認めん！！",
  "en": ""
 },
 {
  "id": "2CF0C2_00E1.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "この私が人間ごときに敗れるなど…… / あっていいはずがない！！",
  "en": ""
 },
 {
  "id": "2CF0C2_0104.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "お前はなかなかの武人だと / 思っていたのだが…… / その程度の器量なのか。 / 見そこなったぞ。",
  "en": ""
 },
 {
  "id": "2CF0C2_013D.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "うるさいっ！　なんとでも言え！",
  "en": ""
 },
 {
  "id": "2CF0C2_0152.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "人間ごとき下等な奴を相手に / 敗北を認めてたまるか！",
  "en": ""
 },
 {
  "id": "2CF0C2_0175.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 4,
  "jp": "闘いは勝たねばならんのだ！ / 勝たねばな！ / そうさ、マノを救うためには、 / 俺には敗北は許されないのだ！",
  "en": ""
 },
 {
  "id": "2CF0C2_01B4.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_1406.0"
 },
 {
  "id": "2CF0C2_01BC.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "俺はいつかこの手でマノを抱きしめる！！",
  "en": ""
 },
 {
  "id": "2CF0C2_01D6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "邪魔なやつは伝説の勇者タケルだろうと、 / ルシフォンだろうと……すべて排除する！",
  "en": "",
  "dup": "2EF59B_0274.0"
 },
 {
  "id": "2CF0C2_0203.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "……ならば、私がこの手でその首を落として、 / そのゆがんだ執着を断ち切ろう！",
  "en": ""
 },
 {
  "id": "2CF0C2_0203.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト！？",
  "en": ""
 },
 {
  "id": "2CF0C2_023E.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "フン……人間ふぜいが！　来い！！",
  "en": ""
 },
 {
  "id": "2CF0C2_0254.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おおおおおおっ！",
  "en": ""
 },
 {
  "id": "2CF0C2_0262.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ハーディス、よけろっ！",
  "en": ""
 },
 {
  "id": "2CF0C2_0272.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 1,
  "jp": "……なにっ！？",
  "en": ""
 },
 {
  "id": "2CF0C2_0285.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "なっ……リディア！？",
  "en": ""
 },
 {
  "id": "2CF0C2_0297.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "！？",
  "en": "",
  "dup": "2F553D_1A42.0"
 },
 {
  "id": "2CF0C2_029F.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "リ、リディア！？",
  "en": "",
  "dup": "2EF59B_02CC.0"
 },
 {
  "id": "2CF0C2_02AF.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 2,
  "jp": "『なぜ！？　なぜ読めたのだ、私の動きが！？ / 人間には見切れるはずが……』",
  "en": ""
 },
 {
  "id": "2CF0C2_02AF.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 5,
  "jp": "おまえの身体を借りている / ルシフォンに伝えておけ。 / たとえはかない人間であっても…… / いつまでも貴様の手のひらで / おどってはいないとな！",
  "en": ""
 },
 {
  "id": "2CF0C2_02AF.2",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 2,
  "jp": "『……そこまで見抜いているのか。 / ……何者だ、貴様！？』",
  "en": ""
 },
 {
  "id": "2CF0C2_02AF.3",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、その声……ルシフォンっ！？",
  "en": "",
  "dup": "2EF59B_0333.0"
 },
 {
  "id": "2CF0C2_0365.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 5,
  "jp": "『……ふむ。 / どうやら、いささか分が悪いようだな。 / そちらの君には、 / そのうち改めてごあいさつさせていただこう。 / ……リディア、引け』",
  "en": ""
 },
 {
  "id": "2CF0C2_0365.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ル、ルシフォン……待て！",
  "en": ""
 },
 {
  "id": "2CF0C2_03CC.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……おい……貴様……。",
  "en": ""
 },
 {
  "id": "2CF0C2_03DD.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "私の名はエトだ。 / おばえておいていただこう。",
  "en": ""
 },
 {
  "id": "2CF0C2_03DD.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "……エト。 / なぜ……なぜ私を助けた！",
  "en": ""
 },
 {
  "id": "2CF0C2_03DD.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "理由などない……",
  "en": ""
 },
 {
  "id": "2CF0C2_0421.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "強いて言えば、ハーディスという敵を、 / 私は好敵手として認めているからだ。",
  "en": ""
 },
 {
  "id": "2CF0C2_0449.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "背後から刃をつきたてられるような、 / つまらない形で死なせるには措しい。",
  "en": ""
 },
 {
  "id": "2CF0C2_0474.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "こ、殺せ！",
  "en": ""
 },
 {
  "id": "2CF0C2_047F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "敵に……それも人間ごときに情をかけられて、 / おめおめ生きていられるか！！",
  "en": ""
 },
 {
  "id": "2CF0C2_04A9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "斬ってしまってもいいが…… / おまえが死んだらマノとかいう女性はどうなる？",
  "en": ""
 },
 {
  "id": "2CF0C2_04A9.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "く……っ！",
  "en": ""
 },
 {
  "id": "2CF0C2_04E0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 5,
  "jp": "それに……私は情をかけたのでは断じてない。 / 今や我々の共通の敵はルシフォンであるはずだ。 / 少なくとも我々には、 / それ以外の相手と闘う意味はない、 / それだけのことだ。",
  "en": ""
 },
 {
  "id": "2CF0C2_04E0.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F7891_0097.0"
 },
 {
  "id": "2CF0C2_0551.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ハーディス殿……私たちの仲間にならぬか？",
  "en": ""
 },
 {
  "id": "2CF0C2_0569.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "な、なんだとっ！？ / こ、この私に、人間と手を組めというのか！？",
  "en": ""
 },
 {
  "id": "2CF0C2_0569.1",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ハーディス殿、私の瞳を……見てくれ……。",
  "en": ""
 },
 {
  "id": "2CF0C2_05A6.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "目を見ろ、だと……？ / 術にでもかけようというならそうはいかんぞ！",
  "en": ""
 },
 {
  "id": "2CF0C2_05A6.1",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は魔術など使えん。",
  "en": ""
 },
 {
  "id": "2CF0C2_05DE.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "お主の瞳の中にきらめく光には、 / 私と共通のなにかを感じるのだ……。",
  "en": ""
 },
 {
  "id": "2CF0C2_0607.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "人間ふぜいが……私と……同じ？",
  "en": ""
 },
 {
  "id": "2CF0C2_061C.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ハーディス殿、お主「愛」を知っておるか？",
  "en": ""
 },
 {
  "id": "2CF0C2_0636.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 3,
  "jp": "あ、愛……むろん知っているともっ / ……それがどうした。 / なんの関係がある！",
  "en": ""
 },
 {
  "id": "2CF0C2_0665.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "私はカケル殿を愛している。",
  "en": ""
 },
 {
  "id": "2CF0C2_0677.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（おひ……）",
  "en": ""
 },
 {
  "id": "2CF0C2_0683.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 3,
  "jp": "しかし……ある時より / その純粋な気持ちにただ一点、 / 疑問を投げかける存在があったのだ。",
  "en": ""
 },
 {
  "id": "2CF0C2_06BF.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "……それがお主だ。 / ハーディス殿。",
  "en": ""
 },
 {
  "id": "2CF0C2_06BF.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（……いきなりなにを言うのかこの人は）",
  "en": ""
 },
 {
  "id": "2CF0C2_06EC.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 5,
  "jp": "ハーディス殿…… / いままでのお主は、たった今死んだのだ。 / 生まれ変わって、 / 新しい愛に生きようではないか……。 / さすれば……。",
  "en": ""
 },
 {
  "id": "2CF0C2_06EC.1",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……私も新しい愛をはじめられる。",
  "en": ""
 },
 {
  "id": "2CF0C2_0748.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "！？",
  "en": ""
 },
 {
  "id": "2CF0C2_0750.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "……今度は我々の愛のために、 / その力を使ってはくれぬか……？",
  "en": ""
 },
 {
  "id": "2CF0C2_0750.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "貴様、人間の分際で、こ、この俺を……。",
  "en": ""
 },
 {
  "id": "2CF0C2_078F.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ハーディス殿……。",
  "en": ""
 },
 {
  "id": "2CF0C2_079C.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "（な、なんだ……この感覚は！？）",
  "en": ""
 },
 {
  "id": "2CF0C2_07AF.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 3,
  "jp": "エト殿…… / カケル殿に貴殿の口から伝えてほしい…… / 「すまぬ」と。",
  "en": ""
 },
 {
  "id": "2CF0C2_07DD.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……い、いいとも。",
  "en": ""
 },
 {
  "id": "2CF0C2_07EC.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "き……きき貴様の言い分はさっぱりわからぬ！ / と、とにかく、俺は人間などとは手は組まん！",
  "en": ""
 },
 {
  "id": "2CF0C2_07EC.1",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ハーディス殿！！",
  "en": ""
 },
 {
  "id": "2CF0C2_082D.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "……貴様らの言い分はわからぬでもない。 / しかし、俺は人間などとは手は組まぬ！",
  "en": ""
 },
 {
  "id": "2CF0C2_082D.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ハーディス！！",
  "en": ""
 },
 {
  "id": "2CF0C2_0867.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……さらばだ、また会おう！！",
  "en": ""
 }
]
