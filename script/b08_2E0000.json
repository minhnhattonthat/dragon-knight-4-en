  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……私はナターシャと話をしてるんだ。",
  "en": ""
 },
 {
  "id": "2E0000_0787.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 4,
  "jp": "カケル、シーボーズの港街が / 黒い霧に包まれたんですって。 / 私たちも、あの霧に包まれると / 石になっちゃうのかしら？",
  "en": ""
 },
 {
  "id": "2E0000_07C2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "平気だよ、きっと。",
  "en": ""
 },
 {
  "id": "2E0000_07D1.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 3,
  "jp": "カケルは楽天家よね…… / でも、私は石になんかなりたくない。 / 私はまだやりたいことがたくさんあるの……。",
  "en": ""
 },
 {
  "id": "2E0000_080D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャのやりたいことってなあに？",
