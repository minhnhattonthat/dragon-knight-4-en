[
 {
  "id": "2E0000_00F4.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ここがロンボニ大陸の最西端、カラープだあ！！",
  "en": "This is the westernmost tip of the Romboni continent: Karap!!"
 },
 {
  "id": "2E0000_010C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、ルシフォンの軍隊がいないよ。",
  "en": "Eto, there's no sign of Lushifon's army."
 },
 {
  "id": "2E0000_011F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "きっと逃げ出したんだろ？",
  "en": "They must've run off, right?"
 },
 {
  "id": "2E0000_012F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうかなあ……。",
  "en": "I wonder..."
 },
 {
  "id": "2E0000_013A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "３週間ぶりの地面だが…… / 少し休んで、すぐに東に行くぞ！！",
  "en": "First solid ground in 3 weeks... We'll rest a bit, then head straight east!!"
 },
 {
  "id": "2E0000_0162.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、隣にいるおにーさんはね、 / 小説家の卵なんだって。",
  "en": "Kakeru, the big brother next to me is a budding novelist."
 },
 {
  "id": "2E0000_0162.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "話がすっごく面白いんだ。 / きっとこの人、有名な小説家になるよ。",
  "en": "His stories are super interesting. I bet he'll be a famous novelist someday."
 },
 {
  "id": "2E0000_01B0.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕は隣のおにーさんと話してるんだ。 / 悪いけど邪魔しないで。",
  "en": "I'm talking with the big brother next to me. Sorry, but don't interrupt."
 },
 {
  "id": "2E0000_01D6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あれれれっ！？）",
  "en": "(Huh-whaaat?!)"
 },
 {
  "id": "2E0000_01E3.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすう……。",
  "en": "Zzz... zzz..."
 },
 {
  "id": "2E0000_01EF.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "（メイフェアってすっごく寝相が悪いんだなあ、 / なんか意外だなあ……）",
  "en": "(Wow, Mayfair sure tosses and turns in her sleep... Didn't expect that...)"
 },
 {
  "id": "2E0000_021B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あれれれれ……）",
  "en": "(Whoa whoa whoa...)"
 },
 {
