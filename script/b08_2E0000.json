  "form": "dlg",
  "nlines": 1,
  "jp": "うっぷ……ち、ちくしょーっ！！",
  "en": ""
 },
 {
  "id": "2E0000_10CC.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "気持ちが悪くて女の子に / いたずらする元気がないっ。",
  "en": ""
 },
 {
  "id": "2E0000_10E8.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ロンボニ王国に行ったら……うっぷ…… / おぼえてろよっ……うえっぷ！！",
  "en": ""
 },
 {
  "id": "2E0000_110E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ありゃりゃ…… / 口を押さえて、走って行ってしまった。",
  "en": ""
 },
 {
  "id": "2E0000_1132.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 2,
  "jp": "この船はもうレイモンド大陸には戻らないぜ。 / あの大陸は、黒い霧に包まれちまったそうだ。",
  "en": ""
 },
 {
  "id": "2E0000_1132.1",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 3,
  "jp": "船のない船長なんざ、 / 泡の出ないビールのようなもんだ…… / 俺の船長稼業も潮時だな。",
  "en": ""
 },
 {
  "id": "2E0000_1195.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "船長をやめてどうするの？",
  "en": ""
 },
 {
  "id": "2E0000_11A7.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前たちみたいに闘う勇気もないし…… / まあ、これから考えてみるさ。",
  "en": ""
 },
 {
  "id": "2E0000_11D0.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 2,
  "jp": "うーん……どの職業も、 / 俺には似合いそうにないな。",
  "en": ""
 },
 {
  "id": "2E0000_11F5.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "また会ったな。",
  "en": ""
 },
 {
  "id": "2E0000_1202.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おじさんもいっしょの船できたんだ。",
  "en": ""
 },
 {
  "id": "2E0000_1217.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "逃げてきたわけじゃないぞ。",
  "en": ""
 },
 {
  "id": "2E0000_1228.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "俺様がいなくなったら、 / お前だって困るだろうが？ / だれも仲間を紹介しなくなるぜ。",
  "en": ""
 },
 {
  "id": "2E0000_1228.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "で、この街ではだれを紹介してくれるの？",
  "en": ""
 },
 {
  "id": "2E0000_1270.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "えーと……あれれ！？",
  "en": ""
 },
 {
  "id": "2E0000_127F.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "すまん……",
  "en": ""
 },
 {
  "id": "2E0000_128A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "この街の住人は、みんなルシフォンの軍隊に / 連れ去られてしまったようだ。",
  "en": ""
 },
 {
  "id": "2E0000_12B0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "役にたたないおじさんだな。",
  "en": ""
 },
 {
  "id": "2E0000_12C4.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前……かわいくないなあ。",
  "en": ""
 },
 {
  "id": "2E0000_12D5.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうそう、カケル……恐い話を聞きたいか？",
  "en": ""
 },
 {
  "id": "2E0000_12F1.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "聞きたい",
  "en": "",
  "dup": "2ED46D_19C1.0"
 },
 {
  "id": "2E0000_12FA.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "聞きたくない",
  "en": "",
  "dup": "2ED46D_19CA.0"
 },
 {
  "id": "2E0000_130E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "恐い話ってなあに？",
  "en": ""
 },
 {
  "id": "2E0000_131D.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "この街にポセイドンの像があるだろ？ / その像を曉めていたら、話しかけてきたんだ。",
  "en": ""
 },
 {
  "id": "2E0000_131D.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だれが？",
  "en": ""
 },
 {
  "id": "2E0000_1355.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "だからあ、ポセイドンの像がだよ…… / な、恐い話だろ？",
  "en": ""
 },
 {
  "id": "2E0000_1355.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちっとも恐くないよ、そんな話。",
  "en": ""
 },
 {
  "id": "2E0000_138E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "聞きたくないよ、恐い話なんか。",
  "en": ""
 },
 {
  "id": "2E0000_13A2.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前……本当にかわいくないなあ。",
  "en": ""
 },
 {
  "id": "2E0000_13B6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おじさん、だれか登録してる？",
  "en": ""
 },
 {
  "id": "2E0000_13CC.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "わっはっはっはっは！！",
  "en": ""
 },
 {
  "id": "2E0000_13DD.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "すまん、だれもしてないんだ。",
  "en": ""
 },
 {
  "id": "2E0000_13F1.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ほっほっ、わしはユリシーズの出身ぢゃよ。",
  "en": ""
 },
 {
  "id": "2E0000_1408.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 3,
  "jp": "わしに話しかけてくれたお礼にな、 / いいことを教えてやるわい…… / これはワシが独自に調べ上げたものぢゃ。",
  "en": ""
 },
 {
  "id": "2E0000_144A.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 4,
  "jp": "ドラゴンに乗っとるやつらが、全て / ドラゴンナイト一族というわけではないのぢゃ… / ルシフォンという男だけがドラゴンナイトで、 / あとはワシたちと同じただの民間人ぢゃ。",
  "en": ""
 },
 {
  "id": "2E0000_14A1.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 4,
  "jp": "それとな、全てのドラゴンがルシフォンと / 手を組んだわけではないのぢゃ…… / 人間と同じように中にはいいやつも、 / 悪いやつもおるわい。",
  "en": ""
 },
 {
  "id": "2E0000_14E8.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ユリシーズの街は、とうの昔に黒い霧の中ぢゃよ",
  "en": ""
 },
 {
  "id": "2E0000_1500.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……ワシは、生まれ育った家で / 石になってやろうと思ったんぢゃが。",
  "en": ""
 },
 {
  "id": "2E0000_1529.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 2,
  "jp": "いくつになっても死ぬのは恐いわい…… / ふおっふおっふおっ。",
  "en": ""
 },
 {
  "id": "2E0000_1550.0",
  "speaker": "ドン・カポネ",
  "form": "dlg",
  "nlines": 4,
  "jp": "この街はシーボーズと交易してたから、 / 何度もきたことがあるんだが…… / ここに住んでたやつらは / どこに行っちまったんだ！？",
  "en": ""
 },
 {
  "id": "2E0000_1595.0",
  "speaker": "ドン・カポネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "金目の物はなにもねーし…… / シケた街になっちまったぜ。",
  "en": ""
 },
 {
  "id": "2E0000_15B9.0",
  "speaker": "ドン・カポネ",
  "form": "dlg",
  "nlines": 4,
  "jp": "こうなったら、闘いに巻き込まれてない街を / 探し出してやる…… / そこでまた街のボスとして / 君臨してやるぜえっ！！",
  "en": ""
 },
 {
  "id": "2E0000_15FD.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 3,
  "jp": "俺はルシフォン軍の目を盗み、 / ロンボニ王国からこの街を偵察にきた / サントスってもんだ。",
  "en": ""
 },
 {
  "id": "2E0000_1629.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "我が王国は完全にルシフォンの支配下にある……",
  "en": ""
 },
 {
  "id": "2E0000_1647.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "国王とビアンカ姫は無事だが、 / 国は完全に乗っ取られてるよ。",
  "en": ""
 },
 {
  "id": "2E0000_166B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "どうしてルシフォン軍は、 / この街から引き上げたの？",
  "en": ""
 },
 {
  "id": "2E0000_166B.1",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 4,
  "jp": "なんでも、とても強い軍隊が / レイモンド大陸からくるらしい…… / やつらはカラープとロンボニ王国の間で、 / そいつらを待ち伏せしてるんだ。",
  "en": ""
 },
 {
  "id": "2E0000_16C8.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "私はロンボニ王国に戻るとしよう。",
  "en": ""
 },
 {
  "id": "2E0000_16DA.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの目的が、 / おぼろげながらわかったからな……。",
  "en": ""
 },
 {
  "id": "2E0000_16F7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンの目的？",
  "en": ""
 },
 {
  "id": "2E0000_1704.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 2,
  "jp": "なんでもやつらの目的には『ヤマト・タケル』様 / が関係しているらしいんだ……。",
  "en": ""
 },
 {
  "id": "2E0000_1704.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "お父さんは、もう石になってるよ。",
  "en": ""
 },
 {
  "id": "2E0000_174C.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 4,
  "jp": "なんと！？ / そなたがタケル様の息子、カケル殿か！？ / すると、レイモンド大陸からきた / 軍隊というのは！？",
  "en": ""
 },
 {
  "id": "2E0000_1782.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "たぶん僕たちのことだよ。",
  "en": ""
 },
 {
  "id": "2E0000_1791.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうであったか。",
  "en": ""
 },
 {
  "id": "2E0000_179F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "これでロンボニ王国は、 / ルシフォン軍の支配下から / 解放されるかもしれんぞ！！",
  "en": ""
 },
 {
  "id": "2E0000_179F.1",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "むむむ、早く戻らねば……",
  "en": ""
 },
 {
  "id": "2E0000_17D7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "我が軍隊が、ルシフォン軍の / 味方についてしまう前に！！",
  "en": ""
 },
 {
  "id": "2E0000_17F6.0",
  "speaker": "ミンメイ",
  "form": "dlg",
  "nlines": 4,
  "jp": "ドラゴンに乗ってれば / ドラゴンナイトなのかしら？ / この間、ドラゴンから / 振り落とされた人を見たわよ。",
  "en": ""
 },
 {
  "id": "2E0000_182C.0",
  "speaker": "ミンメイ",
  "form": "dlg",
  "nlines": 1,
  "jp": "情けないドラゴンナイトよね……",
  "en": ""
 },
 {
  "id": "2E0000_1840.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "初心者マークをつけた方が / いいんじゃないかしら？",
  "en": ""
 },
 {
  "id": "2E0000_185A.0",
  "speaker": "ミンメイ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はユリシーズの街から逃げ続けてるの。 / ようするにプロの逃亡者ね。",
  "en": ""
 },
 {
  "id": "2E0000_185A.1",
  "speaker": "ミンメイ",
  "form": "dlg",
  "nlines": 3,
  "jp": "何度も見つかりそうになって、 / その度にひやひやしっぱなしだったけど…… / あのスリルがたまらなく快感なのよねえ。",
  "en": ""
 },
 {
  "id": "2E0000_18C0.0",
  "speaker": "ミンメイ",
  "form": "dlg",
  "nlines": 2,
  "jp": "さーて、またスリルを味わいに / 東ヘ行ってみようかしら……。",
  "en": ""
 },
 {
  "id": "2E0000_1902.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍がいっぱいいるんだろうなあ…… / わくわくするなあ。",
  "en": ""
 },
 {
  "id": "2E0000_1902.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル――――っ！！",
  "en": ""
 },
 {
  "id": "2E0000_1935.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあはあ……だめだよ、ひとりで外に出たら。",
  "en": ""
 },
 {
  "id": "2E0000_194D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかってるよ……。",
  "en": ""
 },
 {
  "id": "2E0000_195B.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だったらいいけど……。",
  "en": ""
 },
 {
  "id": "2E0000_1977.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちょっと外に出てみようかな……。",
  "en": ""
 },
 {
  "id": "2E0000_198B.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おーい、カケルっっ！！",
  "en": ""
 },
 {
  "id": "2E0000_19A3.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "はあはあはあ……ちょっと目を離すと、 / すぐにひとりで行こうとするんだから。",
  "en": ""
 },
 {
  "id": "2E0000_19A3.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だって……退屈なんだもの。",
  "en": ""
 },
 {
  "id": "2E0000_19D5.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "だめだよ、エトさんに言われたんだ。 / 見張ってろって。",
  "en": ""
 },
 {
  "id": "2E0000_19D5.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちぇ……わかったよ。",
  "en": ""
 },
 {
  "id": "2E0000_1A09.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "東に向かいますか？",
  "en": "",
  "dup": "2F9C88_1191.0"
 },
 {
  "id": "2E0000_1A14.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "はい",
  "en": "",
  "dup": "2F9C88_119C.0"
 },
 {
  "id": "2E0000_1A1B.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "いいえ",
  "en": "",
  "dup": "2F9C88_11A3.0"
 },
 {
  "id": "2E0000_1A2E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "もう……いつまでこの街にいるんだろ？",
  "en": ""
 },
 {
  "id": "2E0000_1A42.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル――――っっ！！",
  "en": ""
 },
 {
  "id": "2E0000_1A5C.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあはあはあ……。",
  "en": "",
  "dup": "2FB86E_1A5D.0"
 },
 {
  "id": "2E0000_1A65.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかってるよ、外に出るなって言うんだろ？",
  "en": ""
 },
 {
  "id": "2E0000_1A7E.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ち、ちがうよ…… / 黒い霧の動きが、急に早くなったんだ！！",
  "en": ""
 },
 {
  "id": "2E0000_1A7E.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "急いで東に出発しないと、 / 僕たちみんな石になっちゃうよ！！",
  "en": ""
 },
 {
  "id": "2E0000_1A7E.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "みんなー、集合してよーっ！！ / 黒い霧の動きが早くなったんだって！！",
  "en": ""
 },
 {
  "id": "2E0000_1A7E.3",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ロンボニ王国に向けて出発するよ！！ / エト、聞こえてる！？",
  "en": ""
 },
 {
  "id": "2E0000_1A7E.4",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
