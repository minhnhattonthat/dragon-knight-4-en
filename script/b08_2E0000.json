  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あ、エトだ）",
  "en": "(Oh, it's Eto.)"
 },
 {
  "id": "2E0000_026E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "おやおや、風邪をひいたらたいヘんだ…… / ベッドに運んでやろう。",
  "en": "Well, well, it'd be terrible if she caught a cold... I'll carry her to bed."
 },
 {
