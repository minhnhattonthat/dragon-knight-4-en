[
 {
  "id": "2D259F_0087.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、ポーの港街を解放したぞっ！！",
  "en": ""
 },
 {
  "id": "2D259F_009D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "やっぱりだれもいないね。",
  "en": ""
 },
 {
  "id": "2D259F_00AF.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "問題は船があるかどうかだ。",
  "en": ""
 },
 {
  "id": "2D259F_00C4.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、船があるかどうか / 船着場を見てきてくれないか。",
  "en": ""
 },
 {
  "id": "2D259F_00C4.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちぇっ……なんでも僕に頼むんだから。",
  "en": ""
 },
 {
  "id": "2D259F_00FC.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わっはっはっ！！",
  "en": ""
 },
 {
  "id": "2D259F_010A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "それだけカケルのことを / 頼りにしてるってことさ。",
  "en": ""
 },
 {
  "id": "2D259F_012C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイル……ベッドの横でなにをしてるの？",
  "en": ""
 },
 {
  "id": "2D259F_0147.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "寝ようと思ってたんだけど…… / 全然、眠れないんだ。",
  "en": ""
 },
 {
  "id": "2D259F_0147.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか興奮しちゃって……。",
  "en": ""
 },
 {
  "id": "2D259F_017C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ドラゴンの背中に乗ってると、 / 血が逆流するような感覚に襲われるんだ。",
  "en": ""
 },
 {
  "id": "2D259F_01A6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイルはやっぱりドラゴンナイトなんだね。",
  "en": ""
 },
 {
  "id": "2D259F_01BC.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……羊を９９９匹まで数えたよ。",
  "en": ""
 },
 {
  "id": "2D259F_01E9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あれ？　セイルとロザリンドだ）",
  "en": ""
 },
 {
  "id": "2D259F_01FA.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "だって、好きだって言ってくれたじゃない！",
  "en": ""
 },
 {
  "id": "2D259F_0212.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "嫌いじゃないなら好きってことでしょう！？",
  "en": ""
 },
 {
  "id": "2D259F_022A.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてそうなっちゃうのかな……。",
  "en": ""
 },
 {
  "id": "2D259F_0240.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "好きじゃないなら、どうしてキスしたの？",
  "en": ""
 },
 {
  "id": "2D259F_0257.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……でも、それは……。",
  "en": ""
 },
 {
  "id": "2D259F_0268.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あたし……初めてだったのに……。",
  "en": ""
 },
 {
  "id": "2D259F_027E.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 3,
  "jp": "好きだから…… / 好きになってくれたと思ったから……。 / ぐすっ……ひっく、ひっく……。",
  "en": ""
 },
 {
  "id": "2D259F_02AC.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "あ、ご……ごめん、ロザリンド…… / お願いだから泣きやんでよ。",
  "en": ""
 },
 {
  "id": "2D259F_02AC.1",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "なによ……ぐすっ…… / 泣いてなんか……ないわよ……ひっく……。",
  "en": ""
 },
 {
  "id": "2D259F_02AC.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "（な、なんか…… / 見るに耐えない状況になってきちゃったぞ。）",
  "en": ""
 },
 {
  "id": "2D259F_0314.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイル……もういいの。",
  "en": ""
 },
 {
  "id": "2D259F_0324.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "私……全然気にしてないから。",
  "en": ""
 },
 {
  "id": "2D259F_0339.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあ……。",
  "en": "",
  "dup": "2E34B4_05D6.0"
 },
 {
  "id": "2D259F_0343.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイル……どうしたの？",
  "en": ""
 },
 {
  "id": "2D259F_0353.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ロザリンドのことを考えてたんだ……はあ。",
  "en": ""
 },
 {
  "id": "2D259F_036A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ロザリンドのことを考えると、 / どうしてため息が出るの？",
  "en": ""
 },
 {
  "id": "2D259F_036A.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "自分でもわからないよ…… / どうしてなんだろ？",
  "en": ""
 },
 {
  "id": "2D259F_03A2.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "彼女も今の僕と同じ気持ちだったのかな。",
  "en": ""
 },
 {
  "id": "2D259F_03BB.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、船はあったのか？",
  "en": ""
 },
 {
  "id": "2D259F_03CF.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "船はあった",
  "en": ""
 },
 {
  "id": "2D259F_03D9.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "船はない",
  "en": ""
 },
 {
  "id": "2D259F_03EA.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、船はあったよ。",
  "en": ""
 },
 {
  "id": "2D259F_03FA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "そ、そうか…… / これでライムリン大陸に行くことができるな。",
  "en": ""
 },
 {
  "id": "2D259F_0417.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん……船はなかったよ。",
  "en": ""
 },
 {
  "id": "2D259F_0428.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、もう一度見てきてくれ…… / 絶対に船はあるはずなんだ。",
  "en": ""
 },
 {
  "id": "2D259F_044C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル……ドラゴニア大陸を東に行けば、 / ライムリン大陸があるぞ。",
  "en": ""
 },
 {
  "id": "2D259F_044C.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん、やっとルシフォンに / 会うことができるんだ……どきどきするよ。",
  "en": ""
 },
 {
  "id": "2D259F_048B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あれ……ひとりでなにをしてるんだろう？）",
  "en": ""
 },
 {
  "id": "2D259F_04A3.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わたしのせいだ……",
  "en": ""
 },
 {
  "id": "2D259F_04B2.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "こうなるとわかっていながら…… / なぜ彼らを行かせてしまったんだ……！",
  "en": ""
 },
 {
  "id": "2D259F_04D8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（……え？　いま……なんだって？）",
  "en": ""
 },
 {
  "id": "2D259F_04EE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "あのときもっと強く止めておけば…… / くそっ、エト！　この大ばか者め！！",
  "en": ""
 },
 {
  "id": "2D259F_04EE.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（まさか……泣いてる！？　エトが……）",
  "en": ""
 },
 {
  "id": "2D259F_0531.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（わかっていたって、どういうことだろう？）",
  "en": ""
 },
 {
  "id": "2D259F_054B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……ナターシャ、どうしたの？",
  "en": ""
 },
 {
  "id": "2D259F_055D.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……私の……せいよね？",
  "en": ""
 },
 {
  "id": "2D259F_056E.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私がさらわれなければ……",
  "en": ""
 },
 {
  "id": "2D259F_0580.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私の命なんかと引き換えに / 仲間を死なせずにすんだわ！！",
  "en": ""
 },
 {
  "id": "2D259F_05A1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちがう！ / ナターシャのせいじゃない！",
  "en": ""
 },
 {
  "id": "2D259F_05A1.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 5,
  "jp": "あの時……ナターシャを助けられなかった / 僕やエトだって、他のみんなだって / 同じだけの責任があるんだ！ / ……それに……エトが止めたのに…… / むりやり迎えを出させたのは僕なんだ……。",
  "en": ""
 },
 {
  "id": "2D259F_05A1.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だからナターシャは気にしなくていい。",
  "en": ""
 },
 {
  "id": "2D259F_0629.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ひとりで全部しょいこもうなんて、 / 考えちゃだめだよ。",
  "en": ""
 },
 {
  "id": "2D259F_0644.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……。",
  "en": ""
 },
 {
  "id": "2D259F_0651.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……あのね。",
  "en": ""
 },
 {
  "id": "2D259F_065E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なあに？",
  "en": "",
  "dup": "2E8000_129C.0"
 },
 {
  "id": "2D259F_0668.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん、なんでもないの……ごめんなさい。",
  "en": ""
 },
 {
  "id": "2D259F_0680.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……カケルさん。",
  "en": ""
 },
 {
  "id": "2D259F_068E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ……この港には船があったんだね。",
  "en": ""
 },
 {
  "id": "2D259F_06A6.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "この船……見覚えがありません？",
  "en": ""
 },
 {
  "id": "2D259F_06BC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん……この船は、 / 僕たちを孤島から助け出してくれた船だ。",
  "en": ""
 },
 {
  "id": "2D259F_06BC.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてここに、その船があるのでしょう？",
  "en": ""
 },
 {
  "id": "2D259F_06F8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ザム船長が……ここまで乗ってきたのかな？",
  "en": ""
 },
 {
  "id": "2D259F_0714.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "黒い霧が動き出したのでしょうか？",
  "en": ""
 },
 {
  "id": "2D259F_0726.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……わからない。",
  "en": ""
 },
 {
  "id": "2D259F_0734.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "でもそうだとすると……",
  "en": ""
 },
 {
  "id": "2D259F_0745.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "タスタに残ったみんなは / どこに行っちゃったんだろ？",
  "en": ""
 },
 {
  "id": "2D259F_075D.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "たぶん……ルシフォン軍に。",
  "en": ""
 },
 {
  "id": "2D259F_076C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……大丈夫だよ、マルレーネ……",
  "en": ""
 },
 {
  "id": "2D259F_077D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンを倒せば、 / みんなを助け出すことができるはずさ。",
  "en": ""
 },
 {
  "id": "2D259F_079A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "この船で東に行けば、 / ライムリン大陸がある…… / ルシフォンはそこで僕たちを待ってるはずだ。",
  "en": ""
 },
 {
  "id": "2D259F_07CD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ……元気がないね。",
  "en": ""
 },
 {
  "id": "2D259F_07DE.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ごめんなさい……。",
  "en": ""
 },
 {
  "id": "2D259F_07E8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "あやまらなくていいけど…… / なにか悩んでるなら、相談して欲しいな。",
  "en": ""
 },
 {
  "id": "2D259F_07E8.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ありがとうカケルさん…… / でもこれは私自身の問題ですから。",
  "en": ""
 },
 {
  "id": "2D259F_0837.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさん…… / 早くライムリン大陸に行きたいですね。",
  "en": ""
 },
 {
  "id": "2D259F_084E.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさん…… / いつになったら出航するんでしょうか？",
  "en": ""
 },
 {
  "id": "2D259F_084E.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん、エトに聞いてみないと……。",
  "en": ""
 },
 {
  "id": "2D259F_087E.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "エトを呼ぶ",
  "en": ""
 },
 {
  "id": "2D259F_0889.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "エトを呼ばない",
  "en": ""
 },
 {
  "id": "2D259F_08A4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おーい、エトっ！！",
  "en": ""
 },
 {
  "id": "2D259F_08B1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、私のことを呼んだみたいだな！！",
  "en": ""
 },
 {
  "id": "2D259F_08D2.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "言いたいことはわかってるぞ、",
  "en": ""
 },
 {
  "id": "2D259F_08E6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "早くライムリン大陸に / 行きたいって言うんだろう？",
  "en": ""
 },
 {
  "id": "2D259F_08FD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだよ……早く出航しようよ。",
  "en": ""
 },
 {
  "id": "2D259F_0913.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "安心しろ、カケル…… / 実は私もそう思っていたのだ。",
  "en": ""
 },
 {
  "id": "2D259F_0913.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "でもエトさん…… / だれがこの船を操舵するのですか？",
  "en": ""
 },
 {
  "id": "2D259F_0913.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……カケル、お前がしろ。",
  "en": ""
 },
 {
  "id": "2D259F_0962.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぼ、僕が！？",
  "en": ""
 },
 {
  "id": "2D259F_096E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "船ぐらい操れなければ、 / りっぱな剣士とは言えないぞ。",
  "en": ""
 },
 {
  "id": "2D259F_096E.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトだって同じじゃないか。",
  "en": ""
 },
 {
  "id": "2D259F_09A0.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうですね…… / エトさんに操舵してもらいましょう。",
  "en": ""
 },
 {
  "id": "2D259F_09A0.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "まあ……なんとかなるだろう。",
  "en": ""
 },
 {
  "id": "2D259F_09DB.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイルはドラゴンに乗って移動してくれっ！！",
  "en": ""
 },
 {
  "id": "2D259F_09F4.0",
  "speaker": "",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2D259F_09F9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "セイルとトルルはドラゴンに乗って / 移動してくれ！！ / ……",
  "en": ""
 },
 {
  "id": "2D259F_0A18.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "ライムリン大陸に着く前に、 / 敵のドラゴンナイトどもが近づいてきたら / すぐに知らせるんだ！！",
  "en": ""
 },
 {
  "id": "2D259F_0A18.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "よーし、船に乗り込むぞお…… / ライムリン大陸に向けて出発だ！！",
  "en": ""
 },
 {
  "id": "2D259F_0A7F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2D259F_0A87.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしたんですか？　いきなり黙り込んで。",
  "en": ""
 },
 {
  "id": "2D259F_0AA2.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさん…… / この海の先に、ライムリン大陸があるんですね。",
  "en": ""
 },
 {
  "id": "2D259F_0AA2.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……。",
  "en": "",
  "dup": "2E8000_13AE.1"
 },
 {
  "id": "2D259F_0AC7.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ずいぶんと長い間、闘ってきた気がします……",
  "en": ""
 },
 {
  "id": "2D259F_0AE2.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさんと知り合ったのは、 / たしかユリシーズの街でしたね。",
  "en": ""
 },
 {
  "id": "2D259F_0AFE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうそう、あの時ネレイドは / 納屋の中で縛られてたんだ。",
  "en": ""
 },
 {
  "id": "2D259F_0AFE.1",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさん…… / 私と出会った時のことは忘れてください。",
  "en": ""
 },
 {
  "id": "2D259F_0B3B.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンを倒したら…… / 私たち、お別れなんですよね。",
  "en": ""
 },
 {
  "id": "2D259F_0B59.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ようカケル…… / この海の先に、ライムリン大陸があるんだな。",
  "en": ""
 },
 {
  "id": "2D259F_0B59.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだね……。",
  "en": ""
 },
 {
  "id": "2D259F_0B84.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 3,
  "jp": "カケルと知りあったのは、 / たしかユリシーズだったな。 / ずいぶんいっしょに闘ってきたもんだ。",
  "en": ""
 },
 {
  "id": "2D259F_0BB5.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンを倒したら、お別れかあ……。",
  "en": ""
 },
 {
  "id": "2D259F_0BCA.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "おお、カケル殿…… / とうとうライムリン大陸に行けるな。",
  "en": ""
 },
 {
  "id": "2D259F_0BCA.1",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "思えば長い闘いであったな……。",
  "en": ""
 },
 {
  "id": "2D259F_0BF7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カロン、まだ闘いは終ってないよ。",
  "en": ""
 },
 {
  "id": "2D259F_0C0C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ライムリン王国が大陸のどこにあるかも / 知らないんだから。",
  "en": ""
 },
 {
  "id": "2D259F_0C26.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "うむ、カケル殿の言うとおりだ……",
  "en": ""
 },
 {
  "id": "2D259F_0C3B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの顔を拝むまで、 / 気を引きしめていかねば。",
  "en": ""
 },
 {
  "id": "2D259F_0C58.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル殿、 / 私はいっしょに闘えたことを誇りに思うぞ。",
  "en": ""
 },
 {
  "id": "2D259F_0C79.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ここは酒場だったみたいね…… / 残念ながらお酒は残ってないようだけど。",
  "en": ""
 },
 {
  "id": "2D259F_0C79.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ねえねえ、ネプチューンって / お酒を飲むとどうなるの？",
  "en": ""
 },
 {
  "id": "2D259F_0C79.2",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうねえ……陽気になるかしら？",
  "en": ""
 },
 {
  "id": "2D259F_0CD4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "それだけ？ / ……服を脱ぐとか、エッチになるとか。",
  "en": ""
 },
 {
  "id": "2D259F_0CD4.1",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もちろんあるわよ。 / ……ただし、好きな男といっしょの時だけね。",
  "en": ""
 },
 {
  "id": "2D259F_0D1D.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル…… / ルシフォンを絶対にやっつけましょうね。",
  "en": ""
 },
 {
  "id": "2D259F_0D39.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "バナナよ、バナナ…… / どうしてお前はバナナなの？",
  "en": ""
 },
 {
  "id": "2D259F_0D39.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ゴロンゴン、なにかのおまじない？",
  "en": ""
 },
 {
  "id": "2D259F_0D67.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "いいや、バナナが女の子だったら、 / どんなにいいかって思ってな。",
  "en": ""
 },
 {
  "id": "2D259F_0D8B.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、冗談だからな……信じるなよ。",
  "en": ""
 },
 {
  "id": "2D259F_0DA5.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 3,
  "jp": "この港街に住んでいた人たちも、 / みんなルシフォン軍に / 連れて行かれちゃったのかしら？",
  "en": ""
 },
 {
  "id": "2D259F_0DD2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "たぶんそうだね……",
  "en": ""
 },
 {
  "id": "2D259F_0DE1.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "この港街はライムリン大陸に近い街だから、 / ルシフォン軍が攻めてきたのも / ずっと前なんじゃないかな。",
  "en": ""
 },
 {
  "id": "2D259F_0DE1.1",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうよね…… / ここはドラゴニア大陸の、東端ですもの。",
  "en": ""
 },
 {
  "id": "2D259F_0DE1.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "うん、もう少しでルシフォンに / 会えるはずだよ…… / がんばろうね、パンドラ。",
  "en": ""
 },
 {
  "id": "2D259F_0E51.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル…… / ライムリン大陸って、どんなところなのかしら？",
  "en": ""
 },
 {
  "id": "2D259F_0E6D.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん、また船旅ですね。",
  "en": ""
 },
 {
  "id": "2D259F_0E80.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうだね、メイフェア…… / でも、これが最後の船旅だと思うよ。",
  "en": ""
 },
 {
  "id": "2D259F_0EA2.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん……がんばりましょうね。",
  "en": ""
 },
 {
  "id": "2D259F_0EB4.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……また船旅だね。",
  "en": ""
 },
 {
  "id": "2D259F_0EC4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、でも今度がさいごの船旅になるよ。",
  "en": ""
 },
 {
  "id": "2D259F_0EDD.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……がんばろうな。",
  "en": ""
 },
 {
  "id": "2D259F_0EEE.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 2,
  "jp": "なあカケル、 / 最近マルレーネの様子がおかしくないか？",
  "en": ""
 },
 {
  "id": "2D259F_0EEE.1",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "なにか悩んでるのかなあ……",
  "en": ""
 },
 {
  "id": "2D259F_0F19.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "悩んでるんだったら、 / 俺に相談してくれればいいのに。",
  "en": ""
 },
 {
  "id": "2D259F_0F39.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺さあ……この闘いが終ったら、 / マルレーネに告白しようと思うんだ。",
  "en": ""
 },
 {
  "id": "2D259F_0F61.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネに愛の告白して、 / そしてふたりで、新たな冒険の旅に出るんだ。",
  "en": ""
 },
 {
  "id": "2D259F_0F8B.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル殿…… / ここは酒場なのに、どうして酒がないのだぞい？",
  "en": ""
 },
 {
  "id": "2D259F_0F8B.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍に、 / 全部飲まれちゃったんじゃないの？",
  "en": ""
 },
 {
  "id": "2D259F_0F8B.2",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "むむむ……これでまたひとつ、 / ルシフォン軍を惜む理由ができたぞい。",
  "en": ""
 },
 {
  "id": "2D259F_0FEF.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル殿……船旅が終れば、 / そこはもうライムリン大陸だぞい。",
  "en": ""
 },
 {
  "id": "2D259F_100F.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "とうとうライムリン大陸ですわね。",
  "en": ""
 },
 {
  "id": "2D259F_101D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、最後の船旅だ。",
  "en": ""
 },
 {
  "id": "2D259F_102D.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍も強くなりますわね…… / もうあとがないわけですから。",
  "en": ""
 },
 {
  "id": "2D259F_1050.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "一刻も早くルシフォンを倒して、 / お父様を石から戻したいですわ。",
  "en": ""
 },
 {
  "id": "2D259F_1072.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 2,
  "jp": "ぶつぶつぶつぶつ…… / カケル、お前は強い剣士だな。",
  "en": ""
 },
 {
  "id": "2D259F_1072.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ありがとう、ネクラマンサー。",
  "en": ""
 },
 {
  "id": "2D259F_109B.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FDDA8_0BCB.0"
 },
 {
  "id": "2D259F_10A3.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、私は誉めたんだぞ…… / どうしてお返しに私を誉めてくれないのだ？",
  "en": ""
 },
 {
  "id": "2D259F_10A3.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネクラマンサーって、すごい魔法使いだね。",
  "en": ""
 },
 {
  "id": "2D259F_10E3.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ふん……心にもないことを言うな。",
  "en": ""
 },
 {
  "id": "2D259F_10FB.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぶつぶつぶつぶつ……。",
  "en": "",
  "dup": "2F2B41_0CEF.0"
 },
 {
  "id": "2D259F_1107.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あーあ……また船旅かあ。",
  "en": ""
 },
 {
  "id": "2D259F_1119.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイラって船が嫌いなの？",
  "en": ""
 },
 {
  "id": "2D259F_112A.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "だって退屈じゃない……",
  "en": ""
 },
 {
  "id": "2D259F_113B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "見える景色と言えば海ばかりで、 / だいたいこのすらりと伸びた脚を / もてあましちゃうわ。",
  "en": ""
 },
 {
  "id": "2D259F_1166.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "今度はどのくらい船に乗ってるのかしら？",
  "en": ""
 },
 {
  "id": "2D259F_117E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん……僕にもわからないよ。",
  "en": ""
 },
 {
  "id": "2D259F_1199.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……カケル……。",
  "en": ""
 },
 {
  "id": "2D259F_11A6.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あたしね、ライナスとキスしちゃった……。",
  "en": ""
 },
 {
  "id": "2D259F_11BD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ええええええっ！！",
  "en": ""
 },
 {
  "id": "2D259F_11CE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてライナスなんかと……。",
  "en": ""
 },
 {
  "id": "2D259F_11E2.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "いいのっ！！ / 好きでしたんだからっ！！",
  "en": ""
 },
 {
  "id": "2D259F_11FC.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "私……セイルといっしょにいたくない。",
  "en": ""
 },
 {
  "id": "2D259F_1213.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "この港に停泊してる船を見たかい？",
  "en": ""
 },
 {
  "id": "2D259F_122C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……あれは、俺たちを孤島から / 助け出してくれた船だぜ。",
  "en": ""
 },
 {
  "id": "2D259F_124C.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 3,
  "jp": "つまり、俺たちがタスタの港街に / 残してきた船ってことだ…… / どうしてここにあるんだ？",
  "en": ""
 },
 {
  "id": "2D259F_127B.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 2,
  "jp": "まさか…… / また黒い霧が動き出したんじゃないだろうな？",
  "en": ""
 },
 {
  "id": "2D259F_12A0.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさん、 / この港に停泊してる船……私、見覚えがあるの。",
  "en": ""
 },
 {
  "id": "2D259F_12A0.1",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 4,
  "jp": "あの船は、私たちを孤島から / 助け出してくれた船よ…… / どうしてタスタに残してきた船が / この港街にあるのかなあ？",
  "en": ""
 },
 {
  "id": "2D259F_1306.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさん…… / もしかして、黒い霧が動き出したとか？",
  "en": ""
 },
 {
  "id": "2D259F_1321.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "黒い霧が動き出したとしたら…… / 早く東に逃げないと危ないわ。",
  "en": ""
 },
 {
  "id": "2D259F_1344.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん、私のこと……好き？",
  "en": ""
 },
 {
  "id": "2D259F_1358.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "もちろん好きだよ。",
  "en": ""
 },
 {
  "id": "2D259F_1367.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私が石になっても好き？",
  "en": ""
 },
 {
  "id": "2D259F_1378.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "もちろん好きだよ。",
  "en": "",
  "dup": "2D259F_1358.0"
 },
 {
  "id": "2D259F_1387.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあ、私がゴキブリになっても好き？",
  "en": ""
 },
 {
  "id": "2D259F_13A1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "もちろん好きだよ。",
  "en": "",
  "dup": "2D259F_1358.0"
 },
 {
  "id": "2D259F_13B0.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……カケルさんのウソつき。",
  "en": ""
 },
 {
  "id": "2D259F_13C2.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "またあの船で旅をするのはいいけど…… / ザム船長たちは、どこに行ったのかなあ。",
  "en": ""
 },
 {
  "id": "2D259F_13EE.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "にょにょにょにょ……にょにょにょにょ。",
  "en": "",
  "dup": "2E34B4_2100.0"
 },
 {
  "id": "2D259F_1407.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ラビットは疲れてるんだ、 / 寝かせてあげよう。",
  "en": ""
 },
 {
  "id": "2D259F_1423.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん……ごうごう、があがあ。",
  "en": ""
 },
 {
  "id": "2D259F_1435.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "パウエルは寝ている…… / そっとしておいてあげよう。",
  "en": ""
 },
 {
  "id": "2D259F_1453.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 2,
  "jp": "にゃんにゃん、船は苦手だにゃん…… / 乗るのはいやだにゃん。",
  "en": ""
 },
 {
  "id": "2D259F_1453.1",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 2,
  "jp": "泳いだ方がマシにゃん…… / 船に乗ると、すごく気分が悪くなるにゃん。",
  "en": ""
 },
 {
  "id": "2D259F_1499.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 2,
  "jp": "今度の船旅がさいごだと聞いたにゃん…… / ウソだったら、承知しないにゃん。",
  "en": ""
 },
 {
  "id": "2D259F_14C2.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 3,
  "jp": "船着場に立っていたマルレーネに / 話しかけたんだが…… / まったく相手にしてもらえんのだ。",
  "en": ""
 },
 {
  "id": "2D259F_14F3.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 2,
  "jp": "この私を無視するとは…… / いったい何様だと思ってるんだ、あの女は！！",
  "en": ""
 },
 {
  "id": "2D259F_151D.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ううむ……どうすれば、 / マルレーネに気に入られるのだ。",
  "en": ""
 },
 {
  "id": "2D259F_153C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "やあトルル…… / さっきの攻撃はすごかったね。",
  "en": ""
 },
 {
  "id": "2D259F_153C.1",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ふん、僕はホワイトドラゴン一族のために / 闘ってるんだ……。",
  "en": ""
 },
 {
  "id": "2D259F_153C.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕はどっちでもいいよ…… / とにかくトルルがいてくれると助かるなあ。",
  "en": ""
 },
 {
  "id": "2D259F_153C.3",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……本当？",
  "en": ""
 },
 {
  "id": "2D259F_15A4.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 1,
  "jp": "早く出発しようよ……",
  "en": ""
 },
 {
  "id": "2D259F_15B4.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "ルシフォンを倒したら、 / たとえおじいちゃんが反対しても、 / 僕はドラゴンの砦に戻るんだ。",
  "en": ""
 },
 {
  "id": "2D259F_15DE.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "けっけっけっ…… / あの子だよ、そう、あの子がナターシャなんだ。",
  "en": ""
 },
 {
  "id": "2D259F_15DE.1",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "けっけっけっ、",
  "en": ""
 },
 {
  "id": "2D259F_160D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あの女をうしろからはがいじめにして、 / 身動きができないようにして……",
  "en": ""
 },
 {
  "id": "2D259F_1632.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "スカートの中に、ミミズやトカゲを入れて、 / 思いっきり泣かせてやる。",
  "en": ""
 },
 {
  "id": "2D259F_165C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ライナス、だめだよ…… / ナターシャはエトの彼女なんだから。",
  "en": ""
 },
 {
  "id": "2D259F_165C.1",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "げげげっ！！　カケル！！ / ……い、いつからそこにいたんだ！？",
  "en": ""
 },
 {
  "id": "2D259F_165C.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ずっと前から。",
  "en": ""
 },
 {
  "id": "2D259F_16A8.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "聞かれたからには計画は中止だいっ！！",
  "en": ""
 },
 {
  "id": "2D259F_16C3.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前が驚くことをやらなきゃ、 / 意味がないからな！！",
  "en": ""
 },
 {
  "id": "2D259F_16E1.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえ、セイルがどこにいったか知らない？",
  "en": ""
 },
 {
  "id": "2D259F_16F9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "知らないよ。どうしたの？",
  "en": ""
 },
 {
  "id": "2D259F_170A.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 3,
  "jp": "セイルのやつ、ドワラルの村で / あたしのお風呂をのぞいてたのよっ！ / あそこまで軟弱なやつとは思わなかったわっ！！",
  "en": ""
 },
 {
  "id": "2D259F_1748.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……僕は軟弱じゃないよ。",
  "en": ""
 },
 {
  "id": "2D259F_175A.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "だれもカケルのことなんて言ってないでしょ。",
  "en": ""
 },
 {
  "id": "2D259F_1774.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "まさか……あんたものぞいてたのっ！？",
  "en": ""
 },
 {
  "id": "2D259F_1792.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "じ、じゃあね、ウェンディ。",
  "en": ""
 },
 {
  "id": "2D259F_17A2.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "逃げるなあっ！！",
  "en": ""
 },
 {
  "id": "2D259F_17B0.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "今度のぞいたら殺すわよ。",
  "en": ""
 },
 {
  "id": "2D259F_17C2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん、もうそんなおそろしいことは / しないようにするよ。",
  "en": ""
 },
 {
  "id": "2D259F_17C2.1",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2D259F_17F0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 4,
  "jp": "セイルならロザリンドに / つかまってるんじゃない？ / あ……それともマルレーネを / 見に行ってるかもしれないな。",
  "en": ""
 },
 {
  "id": "2D259F_1825.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ゆるせなーいっ！",
  "en": ""
 },
 {
  "id": "2D259F_1834.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "乙女の入浴姿をのぞいておきながら、 / 他の女といちゃつくなんてっ！",
  "en": ""
 },
 {
  "id": "2D259F_185B.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 2,
  "jp": "セイルを捜しにいってくるわ。 / ちゃんと復警しないと！！",
  "en": ""
 },
 {
  "id": "2D259F_188C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いってらっしゃーい！",
  "en": ""
 },
 {
  "id": "2D259F_189C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイル……ごめんね。",
  "en": ""
 },
 {
  "id": "2D259F_18AD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……あっ！",
  "en": ""
 },
 {
  "id": "2D259F_18B8.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なによいきなり。",
  "en": ""
 },
 {
  "id": "2D259F_18C8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "セイルならきっとロザリンドといっしょだよ。 / ふたりで軟弱なことをしているんだ、きっと。",
  "en": ""
 },
 {
  "id": "2D259F_18C8.1",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ゆるせなーいっ！",
  "en": "",
  "dup": "2D259F_1825.0"
 },
 {
  "id": "2D259F_1906.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "乙女の入浴姿をのぞいておきながら、 / 他の女といちゃつくなんてっ！",
  "en": "",
  "dup": "2D259F_1834.0"
 },
 {
  "id": "2D259F_192D.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 2,
  "jp": "セイルを捜しにいってくるわ。 / ちゃんと復警しないと！！",
  "en": "",
  "dup": "2D259F_185B.0"
 },
 {
  "id": "2D259F_195E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いってらしゃーい！",
  "en": ""
 },
 {
  "id": "2D259F_196D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイル。……ごめん。",
  "en": ""
 },
 {
  "id": "2D259F_198A.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……ドラゴニア大陸ともお別れだね。",
  "en": ""
 },
 {
  "id": "2D259F_199B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん……ライムリン大陸に渡ったら、 / 今までにないくらい激しい闘いになるよ。",
  "en": ""
 },
 {
  "id": "2D259F_199B.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうだろうなあ…… / なんたって、ルシフォン軍の本拠地だからね。",
  "en": ""
 },
 {
  "id": "2D259F_199B.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ねえ……ロイドンは、ここに残った方が / いいんじゃないかな。",
  "en": ""
 },
 {
  "id": "2D259F_199B.3",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ど、どうしてだい？",
  "en": ""
 },
 {
  "id": "2D259F_1A10.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ロイドンだって言ったじゃないか、 / ライムリン大陸はルシフォンの本拠地だって。",
  "en": ""
 },
 {
  "id": "2D259F_1A10.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "た、たしかに言ったけど……。",
  "en": ""
 },
 {
  "id": "2D259F_1A45.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "危険すぎると思うんだ…… / ロイドンはここに残った方がいい。",
  "en": ""
 },
 {
  "id": "2D259F_1A45.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "よ、よしてくれよ…… / 僕が書いてる冒険小説はどうなるんだい？",
  "en": ""
 },
 {
  "id": "2D259F_1A45.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "ルシフォンを倒したら、 / 僕たちはここに戻ってくる…… / その時に話をするよ。",
  "en": ""
 },
 {
  "id": "2D259F_1AB5.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 3,
  "jp": "だめだ、僕はこの目で見て、 / カケル君から話を聞いて、 / それで小説を書きたいんだ。",
  "en": ""
 },
 {
  "id": "2D259F_1AE4.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "もしかして、僕が足手まといなのかい？",
  "en": ""
 },
 {
  "id": "2D259F_1AFD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そんなことはないけど……。",
  "en": ""
 },
 {
  "id": "2D259F_1B0F.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "それならこの話はもうよそう……",
  "en": ""
 },
 {
  "id": "2D259F_1B24.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "とにかく僕は君たちといっしょに、 / 船に乗り込むからね。",
  "en": ""
 },
 {
  "id": "2D259F_1B43.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "それより、さっきの戦闘の話を / 僕にしてくれないか？",
  "en": ""
 },
 {
  "id": "2D259F_1B70.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……今度こそ僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_079C.0"
 },
 {
  "id": "2D259F_1B86.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2D259F_1B90.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "2D259F_1BA4.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度はどのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07D0.0"
 },
 {
  "id": "2D259F_1BBE.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "君は何色が好きなんだい？ / 青色のノート",
  "en": "",
  "dup": "2FB86E_07EA.0"
 },
 {
  "id": "2D259F_1BD3.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "赤色のノート / 緑色のノート | 次の機会にする",
  "en": "",
  "dup": "2FB86E_07FF.0"
 },
 {
  "id": "2D259F_1C04.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、青色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0830.0"
 },
 {
  "id": "2D259F_1C1B.0",
  "speaker": "ロイドン",
