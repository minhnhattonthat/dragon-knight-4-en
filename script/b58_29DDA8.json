[
 {
  "id": "29DDA8_004B.0",
  "speaker": "",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "29DDA8_004E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "そして、セイルは……。",
  "en": ""
 },
 {
  "id": "29DDA8_005B.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "て、天にましましまし……。",
  "en": ""
 },
 {
  "id": "29DDA8_006E.0",
  "speaker": "バーン",
  "form": "dlg",
  "nlines": 1,
  "jp": "まします、だぞ。",
  "en": ""
 },
 {
  "id": "29DDA8_007C.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ま、まします……えーと。",
  "en": ""
 },
 {
  "id": "29DDA8_008E.0",
  "speaker": "バーン",
  "form": "dlg",
  "nlines": 1,
  "jp": "我等が神よ。",
  "en": ""
 },
 {
  "id": "29DDA8_009C.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "我々が神よ。",
  "en": ""
 },
 {
  "id": "29DDA8_00A9.0",
  "speaker": "バーン",
  "form": "dlg",
  "nlines": 1,
  "jp": "我々が神になってどうするんだ？",
  "en": ""
 },
 {
  "id": "29DDA8_00BF.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……そうか。",
  "en": ""
 },
 {
  "id": "29DDA8_00CC.0",
  "speaker": "バーン",
  "form": "dlg",
  "nlines": 2,
  "jp": "平和な世の中に戻ったんだ、 / しっかりと司祭になる勉強をしてもらうからな。",
  "en": ""
 },
 {
  "id": "29DDA8_00FB.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちぇっ……勝手なんだから。",
  "en": ""
 },
 {
  "id": "29DDA8_010D.0",
  "speaker": "バーン",
  "form": "dlg",
  "nlines": 1,
  "jp": "うるさい、早く続きを読め。",
  "en": ""
 },
 {
  "id": "29DDA8_0122.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "お父さん、マルレーネさんは？",
  "en": ""
 },
 {
  "id": "29DDA8_0133.0",
  "speaker": "バーン",
  "form": "dlg",
  "nlines": 1,
  "jp": "彼女には買い物に行ってもらった。",
  "en": ""
 },
 {
  "id": "29DDA8_014A.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだ……家にいないのか。",
  "en": ""
 },
 {
  "id": "29DDA8_015B.0",
  "speaker": "バーン",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前があの子を連れて帰って来た時は / びっくりしたぞ。",
  "en": ""
 },
 {
  "id": "29DDA8_017D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちょっと耳は長いが、 / あんな美人は見たことがないな。",
  "en": ""
 },
 {
  "id": "29DDA8_019B.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "お父さん、変なことをしちゃだめだよ。",
  "en": ""
 },
 {
  "id": "29DDA8_01B1.0",
  "speaker": "バーン",
  "form": "dlg",
  "nlines": 1,
  "jp": "馬鹿なことを言うな、私は司祭だぞ。",
  "en": ""
 },
 {
  "id": "29DDA8_01CC.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "変なことをしたら、 / お母さんに言いつけるからね。",
  "en": ""
 },
 {
  "id": "29DDA8_01EC.0",
  "speaker": "バーン",
  "form": "dlg",
  "nlines": 1,
  "jp": "お、お前なあ。",
  "en": ""
 },
 {
  "id": "29DDA8_01F8.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "彼女は帰る場所がないから、 / ここにきたんじゃないよ。",
  "en": ""
 },
 {
  "id": "29DDA8_0217.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕がたのみ込んで / いっしょに帰ってもらったんだ。",
  "en": ""
 },
 {
  "id": "29DDA8_0232.0",
  "speaker": "バーン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そのことはもう耳にタコとイカができるくらい / 聞いたぞ。",
  "en": ""
 },
 {
  "id": "29DDA8_0255.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だったら買い物なんかさせないでよ。",
  "en": ""
 },
 {
  "id": "29DDA8_026B.0",
  "speaker": "バーン",
  "form": "dlg",
  "nlines": 2,
  "jp": "だからあ、彼女から言ってきたんだ…… / なにかすることはありませんかって。",
  "en": ""
 },
 {
  "id": "29DDA8_0296.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そういう時は、 / ありませんって言えばいいじゃないか。",
  "en": ""
 },
 {
  "id": "29DDA8_02B5.0",
  "speaker": "バーン",
  "form": "dlg",
  "nlines": 2,
  "jp": "セイル、いーかげんにしろ…… / とっとと続きを読めっ。",
  "en": ""
 },
 {
  "id": "29DDA8_02D7.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "あーあ……マルレーネさん、 / 早く帰ってこないかなあ。",
  "en": ""
 },
 {
  "id": "29DDA8_02F5.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "そして、そのマルレーネは……。",
  "en": ""
 },
 {
  "id": "29DDA8_031B.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_1406.0"
 },
 {
  "id": "29DDA8_0327.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネさん、ご飯だよ。",
  "en": ""
 },
 {
  "id": "29DDA8_033C.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "は、はい。",
  "en": ""
 },
 {
  "id": "29DDA8_034B.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_1406.0"
 },
 {
  "id": "29DDA8_0357.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "星が……きれい。",
  "en": ""
 },
 {
  "id": "29DDA8_036E.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしたのマルレーネさん。",
  "en": ""
 },
 {
  "id": "29DDA8_0382.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いえ……すぐに行きますから。",
  "en": ""
 },
 {
  "id": "29DDA8_0398.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_1495.0"
 },
 {
  "id": "29DDA8_03A0.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕といっしょに、 / ここにきたことを後悔してるんじゃない？",
  "en": ""
 },
 {
  "id": "29DDA8_03C2.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいえ、そんなことはありません。",
  "en": ""
 },
 {
  "id": "29DDA8_03D8.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "本当に？",
  "en": "",
  "dup": "2A8000_287B.0"
 },
 {
  "id": "29DDA8_03E2.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は帰る場所がありませんから、 / セイルさんには本当に感謝しています。",
  "en": ""
 },
 {
  "id": "29DDA8_040D.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "本当はカケルといっしょにいたいんじゃない？",
  "en": ""
 },
 {
  "id": "29DDA8_0425.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_1406.0"
 },
 {
  "id": "29DDA8_042D.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさんには、ナターシャさんがいます。",
  "en": ""
 },
 {
  "id": "29DDA8_0443.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そ、そうだよね…… / そして僕にはだれもいないんだもの。",
  "en": ""
 },
 {
  "id": "29DDA8_0465.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_1406.0"
 },
 {
  "id": "29DDA8_046D.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "お父さんがね、 / マルレーネさんは美人だって。",
  "en": ""
 },
 {
  "id": "29DDA8_0488.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ありがとう、セイルさん。",
  "en": ""
 },
 {
  "id": "29DDA8_0499.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "早くおいでよ……",
  "en": ""
 },
 {
  "id": "29DDA8_04A7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕、マルレーネさんがくるまで / 食べないで待ってるからね。",
  "en": ""
 },
 {
  "id": "29DDA8_04CE.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_1406.0"
 },
 {
  "id": "29DDA8_04DE.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ごめんなさい、セイルさん。",
  "en": ""
 },
 {
  "id": "29DDA8_04F6.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は……あなたたちといっしょに / 生活するわけにはいきません。",
  "en": ""
 },
 {
  "id": "29DDA8_051C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトに対する愛情を心の中にそっとしまい込み、 / マルレーネはソニアの街を出ることを決心した。",
  "en": ""
 },
 {
  "id": "29DDA8_0546.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "もちろん地上界に / 彼女の行くあてなどあるはずもない。",
  "en": ""
 },
 {
  "id": "29DDA8_0563.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "しかしここで安穏として日々を過ごすことが / 彼女には耐えられなかった。",
  "en": ""
 },
 {
  "id": "29DDA8_058B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "もちろんそれは、 / 自らを犠牲にして消え去った / エトに対する負目なのかもしれない。",
  "en": ""
 },
 {
  "id": "29DDA8_05BA.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……さん。",
  "en": "",
  "dup": "2E8000_1498.0"
 },
 {
  "id": "29DDA8_05C7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "時間の流れとは残酷なものだ。 / たとえ魔族でもこれを止めることはできないだろう。",
  "en": ""
 },
 {
  "id": "29DDA8_05F4.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "若き者は老い、そして老いた者は屍となる。 / そう、彼女は恐れていたのだ。",
  "en": ""
 },
 {
  "id": "29DDA8_061D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルがエトの姿になり、 / 再びマルレーネの前に現われることを。",
  "en": ""
 },
 {
  "id": "29DDA8_063D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "セイルのそばにいれば、 / きっとその時がくることを彼女は予感していた。",
  "en": ""
 },
 {
  "id": "29DDA8_0661.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "彼女にとってのエトは / 消え去っていったエトだけであり、 / それ以外の何者でもなかった。",
  "en": ""
 },
 {
  "id": "29DDA8_0691.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "しかしカケルが成長し、 / エトの姿となり自分の前に現われた時、 / はたして自分は冷静でいられるだろうか？",
  "en": ""
 },
 {
  "id": "29DDA8_06C9.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトは……もういません。",
  "en": ""
 },
 {
  "id": "29DDA8_06DB.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "彼女はひとり言のようにつぶやく。",
  "en": ""
 },
 {
  "id": "29DDA8_06ED.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "未来の魔界に帰ることもできなければ、 / 消え去ることすらできない悲しみの女マルレーネ。",
  "en": ""
 },
 {
  "id": "29DDA8_071B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "彼女はいったいどこに行くのだろうか……。",
  "en": ""
 },
 {
  "id": "29DDA8_073C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "そしてカケルは……。",
  "en": ""
 },
 {
  "id": "29DDA8_074B.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、またそんな格好をしてどこに行くの！！",
  "en": ""
 },
 {
  "id": "29DDA8_0767.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あはは……どこにも行かないよ、母さん。",
  "en": ""
 },
 {
  "id": "29DDA8_0780.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "まったくだれに似たのかしら、 / 目を離すとすぐにいなくなっちゃうんだから。",
  "en": ""
 },
 {
  "id": "29DDA8_07AA.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ん？　……私を呼んだか？",
  "en": ""
 },
 {
  "id": "29DDA8_07BD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちょっと散歩に行くだけだよ、 / いいでしょっ、父さん。",
  "en": ""
 },
 {
  "id": "29DDA8_07DE.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うむ、私はかまわんが…… / その剣は置いていったらどうだ？",
  "en": ""
 },
 {
  "id": "29DDA8_0802.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、散歩に剣は必要ないでしょ！？",
  "en": ""
 },
 {
  "id": "29DDA8_081D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "はーい。",
  "en": ""
 },
 {
  "id": "29DDA8_0827.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、サインをねだられても断るんですよ。",
  "en": ""
 },
 {
  "id": "29DDA8_0843.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "はーい。",
  "en": "",
  "dup": "29DDA8_081D.0"
 },
 {
  "id": "29DDA8_084D.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの話をして、 / 人に自慢するんじゃありませんよ。",
  "en": ""
 },
 {
  "id": "29DDA8_086E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "はーい。",
  "en": "",
  "dup": "29DDA8_081D.0"
 },
 {
  "id": "29DDA8_0878.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おいおい、カケルはもう大人なんだ。",
  "en": ""
 },
 {
  "id": "29DDA8_088E.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私にとってはまだまだ子供です！！",
  "en": ""
 },
 {
  "id": "29DDA8_08A5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあ行ってくるよ、母さん。",
  "en": ""
 },
 {
  "id": "29DDA8_08BA.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ご飯の時間には、帰ってくるんですよ！！",
  "en": ""
 },
 {
  "id": "29DDA8_08DB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "剣を持ってきちゃった。",
  "en": ""
 },
 {
  "id": "29DDA8_08EE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "みんな……なにをしてるのかなあ？",
  "en": ""
 },
 {
  "id": "29DDA8_0907.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "この道をまっすぐに行って、 / 森を抜けるとソニアの街があるんだ。",
  "en": ""
 },
 {
  "id": "29DDA8_0931.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ソニアの街には、マルレーネがいるんだよな。",
  "en": ""
 },
 {
  "id": "29DDA8_0946.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あと少しだけ……行ってみようっと。",
  "en": ""
 },
 {
  "id": "29DDA8_0961.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぼー……。",
  "en": ""
 },
 {
  "id": "29DDA8_096F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ばあっ！！",
  "en": ""
 },
 {
  "id": "29DDA8_0978.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うわっ！！",
  "en": ""
 },
 {
  "id": "29DDA8_098E.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あははっ、驚いたでしょ？",
  "en": ""
 },
 {
  "id": "29DDA8_099F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "……カケルの家に行ったら、 / 散歩に出かけたって言うから / 追いかけてきちゃった。",
  "en": ""
 },
 {
  "id": "29DDA8_09CC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "び、びっくりしたあ。",
  "en": ""
 },
 {
  "id": "29DDA8_09DC.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "たまにはいいじゃない……",
  "en": ""
 },
 {
  "id": "29DDA8_09EC.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "いつも私がカケルに / 脅かされるばっかりなんだから。",
  "en": ""
 },
 {
  "id": "29DDA8_0A07.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "脅かすって、最近は何もしてないと思うけど。",
  "en": ""
 },
 {
  "id": "29DDA8_0A23.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "……そうよね / ……帰ってきてからのカケルは変だもの。",
  "en": ""
 },
 {
  "id": "29DDA8_0A44.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "29DDA8_0A4C.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "そう、前みたいに / 私のスカートはまくらないし……",
  "en": ""
 },
 {
  "id": "29DDA8_0A6B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "いつもぼーっとしてる感じ。",
  "en": ""
 },
 {
  "id": "29DDA8_0A7B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうかなあ。",
  "en": ""
 },
 {
  "id": "29DDA8_0A86.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私、カケルにはあまり変わって欲しくないな。",
  "en": ""
 },
 {
  "id": "29DDA8_0AA1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "え？　……なにか言った？",
  "en": ""
 },
 {
  "id": "29DDA8_0AB3.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "う、ううん、なんでもないわ…… / それよりこの場所をおぼえてる？",
  "en": ""
 },
 {
  "id": "29DDA8_0AD6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "この場所？",
  "en": ""
 },
 {
  "id": "29DDA8_0AE2.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "やだ、忘れちゃったの？",
  "en": ""
 },
 {
  "id": "29DDA8_0AF1.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……ほら、ここで私がカケルに / お守りを渡したのよ。",
  "en": ""
 },
 {
  "id": "29DDA8_0B0E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……そうか。",
  "en": "",
  "dup": "2E5EB7_036D.0"
 },
 {
  "id": "29DDA8_0B1B.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私のお守り、まだ持ってる？",
  "en": ""
 },
 {
  "id": "29DDA8_0B2E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "捨てちゃった。",
  "en": ""
 },
 {
  "id": "29DDA8_0B40.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、ウソ。",
  "en": ""
 },
 {
  "id": "29DDA8_0B4B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、ウソ。",
  "en": ""
 },
 {
  "id": "29DDA8_0B57.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F8000_1A29.0"
 },
 {
  "id": "29DDA8_0B5F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そんな恐い顔でにらむなよ。",
  "en": ""
 },
 {
  "id": "29DDA8_0B74.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どーせ私の顔は恐いですよ。",
  "en": ""
 },
 {
  "id": "29DDA8_0B87.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ところでカケル、 / どうして剣を持ってるのかしら？",
  "en": ""
 },
 {
  "id": "29DDA8_0BA1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "剣を持ってないと落ち着かないんだ。",
  "en": ""
 },
 {
  "id": "29DDA8_0BB9.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "散歩する時でも？",
  "en": ""
 },
 {
  "id": "29DDA8_0BC9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うん。",
  "en": "",
  "dup": "2E5EB7_02C0.1"
 },
 {
  "id": "29DDA8_0BD4.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "さあて質問です。",
  "en": ""
 },
 {
  "id": "29DDA8_0BE4.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "この道をまっすぐに行くと、 / どこにたどり着くんでしょう？",
  "en": ""
 },
 {
  "id": "29DDA8_0C05.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "さあ……プラムの村だったっけ？",
  "en": ""
 },
 {
  "id": "29DDA8_0C1C.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……私の目を見て。",
  "en": ""
 },
 {
  "id": "29DDA8_0C2D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なんだよう。",
  "en": ""
 },
 {
  "id": "29DDA8_0C3B.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネさんに……会いに行くんでしょ？",
  "en": ""
 },
 {
  "id": "29DDA8_0C50.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "まさか……僕は散歩をしてるだけだい。",
  "en": ""
 },
 {
  "id": "29DDA8_0C6A.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめよ、マルレーネさんに会っちゃ。",
  "en": ""
 },
 {
  "id": "29DDA8_0C7E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして？",
  "en": "",
  "dup": "2F9C88_00A9.0"
 },
 {
  "id": "29DDA8_0C89.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしても。",
  "en": ""
 },
 {
  "id": "29DDA8_0C95.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕がだれに会おうと関係ないでしょ？",
  "en": ""
 },
 {
  "id": "29DDA8_0CAC.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あるのよ。",
  "en": ""
 },
 {
  "id": "29DDA8_0CB7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてえ？",
  "en": ""
 },
 {
  "id": "29DDA8_0CC3.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてもなのっ。",
  "en": ""
 },
 {
  "id": "29DDA8_0CD2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ナターシャと話をしてると、 / 僕までおかしくなりそうだ。",
  "en": ""
 },
 {
  "id": "29DDA8_0CF1.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトが最後に言った言葉を忘れたの？",
  "en": ""
 },
 {
  "id": "29DDA8_0D09.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……私とカケルは / 仲良くしないといけないんだから。",
  "en": ""
 },
 {
  "id": "29DDA8_0D24.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトは僕なんでしょ？",
  "en": ""
 },
 {
  "id": "29DDA8_0D32.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトはエトよ。",
  "en": ""
 },
 {
  "id": "29DDA8_0D3F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕だよ。",
  "en": ""
 },
 {
  "id": "29DDA8_0D49.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F8000_1A29.0"
 },
 {
  "id": "29DDA8_0D51.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルなんて、大っ嫌い。",
  "en": ""
 },
 {
  "id": "29DDA8_0D62.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そう。",
  "en": ""
 },
 {
  "id": "29DDA8_0D6B.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルの馬鹿。",
  "en": ""
 },
 {
  "id": "29DDA8_0D79.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ば、馬鹿！？",
  "en": ""
 },
 {
  "id": "29DDA8_0D87.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "馬鹿じゃないなら、大馬鹿だわ。",
  "en": ""
 },
 {
  "id": "29DDA8_0D9E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "お、大馬鹿あ！？ / ……いいかげんにしないと怒るぞ。",
  "en": ""
 },
 {
  "id": "29DDA8_0DC1.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "怒ったって恐くないわ。",
  "en": ""
 },
 {
  "id": "29DDA8_0DD1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "アホらしくてやってられないや、 / せっかく気持ちよく散歩してたのに。",
  "en": ""
 },
 {
  "id": "29DDA8_0DFC.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私と話をするのがアホらしいって言うの？",
  "en": ""
 },
 {
  "id": "29DDA8_0E16.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕はもう行くよ。 / そこをどいてよ。",
  "en": ""
 },
 {
  "id": "29DDA8_0E2E.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめ！！",
  "en": ""
 },
 {
  "id": "29DDA8_0E3E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どわわわわわわわぁぁ～～～っ！？",
  "en": ""
 },
 {
  "id": "29DDA8_0E57.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私のこと嫌いでもいい…… / でも、カケルには変わって欲しくないの！！",
  "en": ""
 },
 {
  "id": "29DDA8_0E7F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "は、は、はなせぇ！！",
  "en": ""
 },
 {
  "id": "29DDA8_0E90.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルが変わっちゃうぐらいなら、 / 毎日スカートをまくられてたほうがましだわ！！",
  "en": ""
 },
 {
  "id": "29DDA8_0EBE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "は、はなせっ！！",
  "en": ""
 },
 {
  "id": "29DDA8_0ECC.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやっ、 / はなしたらカケルはどこかに行っちゃうもの！！",
