[
 {
  "id": "2FDDA8_0058.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、ミシエルの街を解放したぞ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_006D.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……相談したいことがあるんだけど。",
  "en": ""
 },
 {
  "id": "2FDDA8_0087.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "実は……僕ね、マルレーネさんが好きなんだ。",
  "en": ""
 },
 {
  "id": "2FDDA8_00A0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかってる、キスしたいんだね？",
  "en": ""
 },
 {
  "id": "2FDDA8_00B5.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そんな直接的な……。",
  "en": ""
 },
 {
  "id": "2FDDA8_00C9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕は物ごとをはっきりさせるのが好きなんだ。 / はっきり言えよ、マルレーネとキスしたいって。",
  "en": ""
 },
 {
  "id": "2FDDA8_00F9.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "もういいよ、ひとりで考えるから。",
  "en": ""
 },
 {
  "id": "2FDDA8_010D.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、僕は考えたいことがあるんだ…… / あっちに行ってくれよ。",
  "en": ""
 },
 {
  "id": "2FDDA8_014A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あ！？）",
  "en": ""
 },
 {
  "id": "2FDDA8_0154.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "（マルレーネとエトがいっしょにいるなんて…… / めずらしいなあ）",
  "en": ""
 },
 {
  "id": "2FDDA8_0154.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（なにを話してるんだろ？）",
  "en": ""
 },
 {
  "id": "2FDDA8_018B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトに話しかけますか？",
  "en": "",
  "dup": "2E0000_06A1.0"
 },
 {
  "id": "2FDDA8_019A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネに話しかけますか？",
  "en": ""
 },
 {
  "id": "2FDDA8_01AA.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "話しかける / ",
  "en": "",
  "dup": "2E0000_06AE.0"
 },
 {
  "id": "2FDDA8_01B4.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "話しかけない",
  "en": ""
 },
 {
  "id": "2FDDA8_01CD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、エト……。",
  "en": ""
 },
 {
  "id": "2FDDA8_01DB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ、こんにちは。",
  "en": ""
 },
 {
  "id": "2FDDA8_01E7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルか……身体をちゃんと休めておけよ。",
  "en": ""
 },
 {
  "id": "2FDDA8_01FE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトだって、休まないと……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0211.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "大丈夫。ちゃんと休んでいるさ。",
  "en": ""
 },
 {
  "id": "2FDDA8_0223.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あやしいなあ。こないだも……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0235.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさんが、どうかしたんですか？",
  "en": ""
 },
 {
  "id": "2FDDA8_024B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、いいかげんにしろ……。",
  "en": ""
 },
 {
  "id": "2FDDA8_025E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかったよ……。",
  "en": "",
  "dup": "2E9A8B_01F2.0"
 },
 {
  "id": "2FDDA8_026D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（やめたっと……）",
  "en": ""
 },
 {
  "id": "2FDDA8_027F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "邪魔だぞカケル……しっしっしっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0296.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕は犬じゃないよ。",
  "en": ""
 },
 {
  "id": "2FDDA8_02A4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "やあ、ナターシャ…… / エトのことでも考えてるの？",
  "en": ""
 },
 {
  "id": "2FDDA8_02A4.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして……私がエトのことを考えるの？",
  "en": ""
 },
 {
  "id": "2FDDA8_02D7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうマジメな顔で聞かれると困るなあ……。",
  "en": ""
 },
 {
  "id": "2FDDA8_02FC.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "こうやってふたりで話をするの…… / 久しぶりだと思わない？",
  "en": ""
 },
 {
  "id": "2FDDA8_02FC.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえ、私があげたお守り……まだ持ってる？",
  "en": ""
 },
 {
  "id": "2FDDA8_0339.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……持ってるよ。",
  "en": ""
 },
 {
  "id": "2FDDA8_0347.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "見せて。",
  "en": ""
 },
 {
  "id": "2FDDA8_0351.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいよ……あれ？",
  "en": ""
 },
 {
  "id": "2FDDA8_035F.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "本当は、とっくにすてちゃったんでしょ？",
  "en": ""
 },
 {
  "id": "2FDDA8_0374.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ああ、あったあった…… / いつの間にかパンツの中に入ってた。",
  "en": ""
 },
 {
  "id": "2FDDA8_039D.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いや……不潔っ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_03B0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "あははは、ウソだよ…… / ちゃんと首に下げてあったんだ。",
  "en": ""
 },
 {
  "id": "2FDDA8_03B0.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 4,
  "jp": "もう……カケルって、昔からそうなんだから。 / 私のことをからかってばかり。 / もう少し大人になってよ…… / いくら剣の腕が強くても、それじゃあ……いや。",
  "en": ""
 },
 {
  "id": "2FDDA8_041E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトは大人だもんなあ。",
  "en": ""
 },
 {
  "id": "2FDDA8_042E.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、あっちに行ってよっ…… / もう話なんかしたくない。",
  "en": ""
 },
 {
  "id": "2FDDA8_0454.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……私、カケルと話をしたくないの。",
  "en": ""
 },
 {
  "id": "2FDDA8_0470.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネレイド……元気がないね。",
  "en": ""
 },
 {
  "id": "2FDDA8_0481.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "そんなことはないです……はあ。",
  "en": ""
 },
 {
  "id": "2FDDA8_0496.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "さっきの闘いで怪我でもしたの？",
  "en": ""
 },
 {
  "id": "2FDDA8_04AC.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの……カケルさん、私って変ですか？",
  "en": ""
 },
 {
  "id": "2FDDA8_04C3.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なんだい……いきなり。",
  "en": ""
 },
 {
  "id": "2FDDA8_04D6.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 4,
  "jp": "さっき、エトさんとマルレーネさんが / 親しそうに話してたんです。 / 私、エトさんとふたりきりで / 話したことなんかありません。",
  "en": ""
 },
 {
  "id": "2FDDA8_0519.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "きっと、私に変なところがあるんです。",
  "en": ""
 },
 {
  "id": "2FDDA8_0531.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさんって大人ですから、それを見抜いてて、 / だから私に近づかないようにしてるんです。",
  "en": ""
 },
 {
  "id": "2FDDA8_055F.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさんは……私って変だと思いませんか？",
  "en": ""
 },
 {
  "id": "2FDDA8_057C.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "変じゃない / ",
  "en": ""
 },
 {
  "id": "2FDDA8_0584.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "変だと思う",
  "en": ""
 },
 {
  "id": "2FDDA8_0596.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "変じゃないよ、ネレイド。",
  "en": ""
 },
 {
  "id": "2FDDA8_05A4.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ウソです……だからエトさんは冷たいんです。",
  "en": ""
 },
 {
  "id": "2FDDA8_05C0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん……。",
  "en": ""
 },
 {
  "id": "2FDDA8_05CB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "変なところがあるような気がしてきた。 / でも、どこが変なのかわからないや。",
  "en": ""
 },
 {
  "id": "2FDDA8_05CB.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "ネレイド……君はかわいいし、 / 優しい女の子だと思う。 / もっと自信を持ったほうがいいよ。",
  "en": ""
 },
 {
  "id": "2FDDA8_0627.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "本当ですか？　私は……変じゃないのですね？",
  "en": ""
 },
 {
  "id": "2FDDA8_0640.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、全然変じゃない。",
  "en": ""
 },
 {
  "id": "2FDDA8_0650.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "……よかった。",
  "en": ""
 },
 {
  "id": "2FDDA8_065D.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "私が変じゃないとすると…… / もしかして、エトさんが変なのかしら？",
  "en": ""
 },
 {
  "id": "2FDDA8_065D.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだよ……きっとそうだ。",
  "en": ""
 },
 {
  "id": "2FDDA8_0693.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "たとえエトさんが変だとしても…… / 私の気持ちは変わりません。",
  "en": ""
 },
 {
  "id": "2FDDA8_06B8.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルよう、早く東に行こうぜ。",
  "en": ""
 },
 {
  "id": "2FDDA8_06CC.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……俺はよ、ルシフォンにパンチの一発も / おみまいしてやらねーと、気がすまないんだよ。",
  "en": ""
 },
 {
  "id": "2FDDA8_06F8.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 4,
  "jp": "カケル殿、この街の長老はルシフォン軍に / 殺されてしまったそうだ。 / 砲術隊もルシフォン軍が連れ去ったみたいだし… / 闘いはさらに厳しいものとなるだろう。",
  "en": ""
 },
 {
  "id": "2FDDA8_0747.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "でも僕たちは絶対に負けないよ。",
  "en": ""
 },
 {
  "id": "2FDDA8_075C.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿、少し背が伸びたのではないか？",
  "en": ""
 },
 {
  "id": "2FDDA8_0774.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、私の手料理を食べる？",
  "en": ""
 },
 {
  "id": "2FDDA8_0789.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ヘえ、ネプチューンも料理を作るんだ。",
  "en": ""
 },
 {
  "id": "2FDDA8_079F.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "私はね、こう見えても家事は得意なんだから。",
  "en": ""
 },
 {
  "id": "2FDDA8_07BA.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "くんくんくん……なんか焦げくさいわね。",
  "en": ""
 },
 {
  "id": "2FDDA8_07D4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "さっきからずっと焦げくさかったよ。",
  "en": ""
 },
 {
  "id": "2FDDA8_07EC.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "あーっ！！　焦げてるうっ！！ / また作りなおさないと……。",
  "en": ""
 },
 {
  "id": "2FDDA8_080F.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "もぐもぐもぐ……よう、カケル。",
  "en": ""
 },
 {
  "id": "2FDDA8_081F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "最近思ったんだけどさ…… / エトの顔をちゃんと見たことがあるかい？",
  "en": ""
 },
 {
  "id": "2FDDA8_0841.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そういえば、一度も顔を見たことがないや。",
  "en": ""
 },
 {
  "id": "2FDDA8_085B.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "あいつ、絶対になにか隠してるぜ……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0873.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 4,
  "jp": "ルシフォンは……私たちがライムリン大陸まで / これないと思ってるわよ。 / カケル、やつの期待を / 見事に裏切ってあげましょうね。",
  "en": ""
 },
 {
  "id": "2FDDA8_08B3.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕たちは絶対にライムリン大陸まで行くんだ。",
  "en": ""
 },
 {
  "id": "2FDDA8_08C9.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私だって絶対にあきらめないんだから。",
  "en": ""
 },
 {
  "id": "2FDDA8_08DF.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさんはあの有名な方の息子さんなのに、 / そのことを自慢しないんですね。",
  "en": ""
 },
 {
  "id": "2FDDA8_08DF.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "自慢って？　……よくわからないな。",
  "en": ""
 },
 {
  "id": "2FDDA8_0923.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさんって……いい子ですね。",
  "en": ""
 },
 {
  "id": "2FDDA8_0936.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "メイフェア、僕はもう子供じゃないよ……。",
  "en": ""
 },
 {
  "id": "2FDDA8_094B.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルはさ、あの有名なタケルの息子なのに、 / そのことを自慢しないんだよな……どうしてだ？",
  "en": ""
 },
 {
  "id": "2FDDA8_094B.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "自慢って？　……よくわからないな。",
  "en": "",
  "dup": "2FDDA8_08DF.1"
 },
 {
  "id": "2FDDA8_0996.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルって……いい子なんだな。",
  "en": ""
 },
 {
  "id": "2FDDA8_09AA.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "クラリス、僕はもう子供じゃないよ……。",
  "en": ""
 },
 {
  "id": "2FDDA8_09BF.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 2,
  "jp": "なあカケル……ルシフォンってやつは、 / 本当にドラゴンナイト一族なんだろうか？",
  "en": ""
 },
 {
  "id": "2FDDA8_09BF.1",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 2,
  "jp": "やつはなにかの目的があって、ドラゴンナイトの / 名前を使ってるだけじゃないか……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0A11.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 3,
  "jp": "我が故郷である街が…… / こんなになってるとは驚いたぞい。 / しかし、この街を抜け出して正解だったぞい。",
  "en": ""
 },
 {
  "id": "2FDDA8_0A50.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "どうせ命を落とすなら、 / やつらと闘って死にたいぞい……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0A73.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "この街の東には、ホビットの村があるぞい。",
  "en": ""
 },
 {
  "id": "2FDDA8_0A87.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "日影にいませんと肌が焼けてしまいますわ…… / アンナ、帽子を持ってきてくださる？",
  "en": ""
 },
 {
  "id": "2FDDA8_0A87.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあビアンカ……無事だったようだね。",
  "en": ""
 },
 {
  "id": "2FDDA8_0ACD.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "きゃっ！！ / 脅かさないでください……だぜ。",
  "en": ""
 },
 {
  "id": "2FDDA8_0ACD.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ビアンカはロンボニ王国のお姫様なんでしょ？",
  "en": ""
 },
 {
  "id": "2FDDA8_0AFD.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "いやですわ……知ってらっしゃったの？",
  "en": ""
 },
 {
  "id": "2FDDA8_0B14.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん、エトさんって何者ですの？",
  "en": ""
 },
 {
  "id": "2FDDA8_0B29.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕もよく知らないんだ…… / 気がついたらいっしょに闘う仲間になってた。",
  "en": ""
 },
 {
  "id": "2FDDA8_0B29.1",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ずいぶんと失礼な方ですわね……",
  "en": ""
 },
 {
  "id": "2FDDA8_0B67.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私が意見されるなんて / 生まれて初めてのことですわ。",
  "en": ""
 },
 {
  "id": "2FDDA8_0B8A.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぶつぶつぶつ……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0B94.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2FDDA8_0BA2.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぶつぶつぶつ……。",
  "en": "",
  "dup": "2FDDA8_0B8A.0"
 },
 {
  "id": "2FDDA8_0BAC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "気味が悪いなあ……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0BBB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おじさんがネクラマンサーさん？",
  "en": ""
 },
 {
  "id": "2FDDA8_0BCB.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0BD3.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ま、いっか……とにかくよろしくね。",
  "en": ""
 },
 {
  "id": "2FDDA8_0BEA.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FDDA8_0BCB.0"
 },
 {
  "id": "2FDDA8_0BF2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "まさか……寝てるんじゃないだろなあ？",
  "en": ""
 },
 {
  "id": "2FDDA8_0C0E.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私の名前はセイラ……いっしょに闘いたかったら / 訓練所に行くといいわ。",
  "en": ""
 },
 {
  "id": "2FDDA8_0C0E.1",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "すらりと伸びた脚、大きすぎず小さすぎない胸 / ……そして均整のとれた身体。",
  "en": ""
 },
 {
  "id": "2FDDA8_0C0E.2",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私の名前はセイラ……。 / こんな私といっしょに闘いたかったら……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0C0E.3",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかった……もう十分にわかった。",
  "en": ""
 },
 {
  "id": "2FDDA8_0C9B.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私の名前はセイラ……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0CAA.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕の名前はカケル……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0CB9.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……マネしないでよ。",
  "en": ""
 },
 {
  "id": "2FDDA8_0CC8.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私を選んでくれたのね…… / このすらりと伸びた脚、気品のある顔立ち。",
  "en": ""
 },
 {
  "id": "2FDDA8_0CC8.1",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "後悔させないわよ、うふふのふっ。",
  "en": ""
 },
 {
  "id": "2FDDA8_0D00.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "早く東に行きましょうよ……",
  "en": ""
 },
 {
  "id": "2FDDA8_0D13.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "このすらりと伸びた脚を / 早く味わってみたいでしょ？ / ……って、いやらしい意味じゃないわよ。",
  "en": ""
 },
 {
  "id": "2FDDA8_0D41.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍め、覚悟しろっ！！ / おぢーちゃんのかたきっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0D41.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ば、僕はルシフォン軍じゃない！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0D72.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "覚悟おっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0D80.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うわわわ、本気だよこりゃ。",
  "en": ""
 },
 {
  "id": "2FDDA8_0D93.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "待てえっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0D9F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "待ったらどうするの？",
  "en": ""
 },
 {
  "id": "2FDDA8_0DAF.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "この大砲の餌食にしてやるうっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0DC7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあ待たないっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0DD7.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "待ちなさいっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0DE5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "こ、このままでは無駄な体力を消耗してしまう… / よーし、こうなったら……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0DE5.1",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "きゃっ！！　き、急に止まらないでよ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0E2A.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "うにゅ――――っ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0E3B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "いででででっ！！ / ほっぺたを……ひっはるな！",
  "en": ""
 },
 {
  "id": "2FDDA8_0E3B.1",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "どいてよおっ！！ / 私に変なことをしたら承知しないからあっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0E3B.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ヘんなほほをしようとしてるふんなひっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0E97.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "うにゅにゅにゅにゅ――――っ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0EB1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ひひかげんに……しろっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0EC4.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "きゃああんっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0ED2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いててて……顔の皮が伸びた。",
  "en": ""
 },
 {
  "id": "2FDDA8_0EE8.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あーん、あんあん！！",
  "en": ""
 },
 {
  "id": "2FDDA8_0EF8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 4,
  "jp": "あ、あのね、お嬢さん。 / 僕はルシフォン軍じゃなくて…… / まったくの逆で、 / ルシフォン軍と闘ってるんだってば。",
  "en": ""
 },
 {
  "id": "2FDDA8_0F39.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ほんと？",
  "en": ""
 },
 {
  "id": "2FDDA8_0F43.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "本当だってば。",
  "en": ""
 },
 {
  "id": "2FDDA8_0F50.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "私、おぢいちゃんのかたきを討とうと思って、 / 友だちといっしょにずっと納屋に隠れてたの。",
  "en": ""
 },
 {
  "id": "2FDDA8_0F50.1",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "おぢいちゃんはこの街の長老だったの…… / でもルシフォンの軍隊に殺されちゃって……。",
  "en": ""
 },
 {
  "id": "2FDDA8_0F50.2",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "お願い、おぢいちゃんのかたきが討ちたいの。 / あなたたちの仲間に入れてくれない？",
  "en": ""
 },
 {
  "id": "2FDDA8_0F50.3",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "なんだそんなことか……いいとも。 / 大砲を持ってるんでしょ？",
  "en": ""
 },
 {
  "id": "2FDDA8_0F50.4",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "わーい、うれしいなっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_1015.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "これでおぢいちゃんのかたきが討てるっ！！ / 私、いっしょに隠れてた友だちを集めてくるね、 / わーいわーいっ！！",
  "en": ""
 },
 {
  "id": "2FDDA8_1055.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ロザリンドが仲間に加わった！！",
  "en": ""
 },
 {
  "id": "2FDDA8_1063.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "早くルシフォン軍と闘いたい…… / 闘わせてくれないと、また泣いちゃうから。",
  "en": ""
 },
 {
  "id": "2FDDA8_1097.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……こんにちは。",
  "en": "",
  "dup": "2FB86E_0599.0"
 },
 {
  "id": "2FDDA8_109F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "こんにちは、おにーさん。",
  "en": "",
  "dup": "2FB86E_05A1.0"
 },
 {
  "id": "2FDDA8_10A6.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "僕は冒険小説家を目指してる、 / ロイドンっていうんだ…… / レイモンド大陸とロンボニ大陸で起こったことを / 忘れないようにメモしてたのさ。",
  "en": ""
 },
 {
  "id": "2FDDA8_10B6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふーん……。",
  "en": "",
  "dup": "2FB86E_061B.0"
 },
 {
  "id": "2FDDA8_10BD.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "君は……どこからきたんだい？",
  "en": "",
  "dup": "2FB86E_0622.0"
 },
 {
  "id": "2FDDA8_10C4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕はレイモンド王国を出て、ルシフォンの軍隊と / 闘い続けて……それでこの街にきたんだ。",
  "en": ""
 },
 {
  "id": "2FDDA8_10C4.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "知ってるよ……実は僕、 / 君たちのあとをずっとついてきたのさ。",
  "en": "",
  "dup": "2E9A8B_09E0.0"
 },
 {
  "id": "2FDDA8_10C4.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだ……そうなのか。",
  "en": "",
  "dup": "2E0000_0D62.1"
 },
 {
  "id": "2FDDA8_1108.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "君の顔、どこかで見たことがあるな。",
  "en": "",
  "dup": "2E8000_0A68.1"
 },
 {
  "id": "2FDDA8_110F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "たしかソニアの街にあった / タケル様とバーン様の肖像画！？",
  "en": "",
  "dup": "2E8000_0A8F.0"
 },
 {
  "id": "2FDDA8_1116.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "も、もしかして君は…… / カケルって名前なんじゃないか！？",
  "en": "",
  "dup": "2FB86E_06DA.0"
 },
 {
  "id": "2FDDA8_1116.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだよ、どうして僕の名前を知ってるの？",
  "en": "",
  "dup": "2FB86E_06DA.1"
 },
 {
  "id": "2FDDA8_1127.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうか、君がカケル君か！！",
  "en": "",
  "dup": "2E9A8B_0A24.0"
 },
 {
  "id": "2FDDA8_1136.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……いやあ、かの有名なタケル様の / 息子に会えるとは光栄だ！！",
  "en": "",
  "dup": "2ED46D_0CA5.0"
 },
 {
  "id": "2FDDA8_114C.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "レイモンド王国にいた商人に聞いたんだ……",
  "en": "",
  "dup": "2F9C88_1896.0"
 },
 {
  "id": "2FDDA8_1162.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "タケル様とバーン様の息子が、レイモンド国王に / 呼ばれてこの大陸にきてるってね。",
  "en": "",
  "dup": "2F9C88_18AC.0"
 },
 {
  "id": "2FDDA8_1169.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふーん……お父さんって、有名なんだなあ。",
  "en": "",
  "dup": "2FB86E_071D.0"
 },
 {
  "id": "2FDDA8_1170.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "なあ、よかったら今までのことを / 話してくれないか？ / ロンボニ大陸に渡ってきて…… / 君が今までどんな冒険をしてきたかってことを。",
  "en": "",
  "dup": "2E0000_0DBD.0"
 },
 {
  "id": "2FDDA8_119B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいよ、まだ出発しないみたいだし。",
  "en": "",
