 },
 {
  "id": "2D4417_1937.1",
  "speaker": "ラスカス",
  "form": "dlg",
  "nlines": 2,
  "jp": "早くルシフォンを倒して、 / ドラゴニア大陸に帰りたいものだ……。",
  "en": ""
 },
 {
  "id": "2D4417_1983.0",
  "speaker": "ラスカス",
  "form": "dlg",
  "nlines": 2,
  "jp": "私に話しかけるな…… / ついつい喋ってしまうではないか。",
