 },
 {
  "id": "2D4417_16CA.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕は目で見て、カケル君から話を聞いて、 / それで小説を書きたいんだ。",
