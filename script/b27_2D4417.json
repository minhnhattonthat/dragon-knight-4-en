[
 {
  "id": "2D4417_0069.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "やっと着いたぞ……ここがライムリン大陸だ。",
  "en": ""
 },
 {
  "id": "2D4417_007F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "人がいないのはいつもどおりだけど…… / 街の中も荒れてる感じだね。",
  "en": ""
 },
 {
  "id": "2D4417_007F.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "この港街はなんていう名前なのかしら？",
  "en": ""
 },
 {
  "id": "2D4417_00BD.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "この港街は、ディノというんだ。",
  "en": ""
 },
 {
  "id": "2D4417_00D2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト、よく知ってるね…… / 前に一度きたことがあるの？",
  "en": ""
 },
 {
  "id": "2D4417_00D2.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いや……前に聞いたことがあるだけさ。",
  "en": ""
 },
 {
  "id": "2D4417_010C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ディノの東には、マルクスの村があるはずだ。 / もちろん簡単には行かせてくれないだろうがな。",
  "en": ""
 },
 {
  "id": "2D4417_0146.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ついにライムリン大陸にきたんだね。",
  "en": ""
 },
 {
  "id": "2D4417_0155.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ライムリン王国って、どこにあるんだろ？",
  "en": ""
 },
 {
  "id": "2D4417_0167.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そりゃあ、ライムリン大陸のどこかだよ。",
  "en": ""
 },
 {
  "id": "2D4417_017B.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だれにでもわかる答え方をしないでよ。",
  "en": ""
 },
 {
  "id": "2D4417_0192.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンを倒せば、パパのいるミネルバ大陸に / 戻ることができるんだね。",
  "en": ""
 },
 {
  "id": "2D4417_01BA.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあ……。",
  "en": "",
  "dup": "2E34B4_05D6.0"
 },
 {
  "id": "2D4417_01C4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "あれれ、元気がないね…… / もしかしてまたドラゴン酔いとか？",
  "en": ""
 },
 {
  "id": "2D4417_01C4.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルって……女の子とキスしたことある？",
  "en": ""
 },
 {
  "id": "2D4417_01FD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、あるよ。",
  "en": ""
 },
 {
  "id": "2D4417_020A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイルもだれかとキスをしたの？",
  "en": ""
 },
 {
  "id": "2D4417_021E.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ば、僕はしてないよ……そんなこと。",
  "en": ""
 },
 {
  "id": "2D4417_0234.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ついにライムリン大陸にきたんだね。",
  "en": "",
  "dup": "2D4417_0146.0"
 },
 {
  "id": "2D4417_0243.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンを倒せば、パパのいるミネルバ大陸に / 戻ることができるんだね。",
  "en": "",
  "dup": "2D4417_0192.0"
 },
 {
  "id": "2D4417_026B.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……ロザリンドの姿が見えないけど。",
  "en": ""
 },
 {
  "id": "2D4417_0282.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……どこに行ったんだろ？",
  "en": ""
 },
 {
  "id": "2D4417_0292.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕にもわからない…… / もしかしたら、船に乗らなかったのかも。",
  "en": ""
 },
 {
  "id": "2D4417_0292.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "きっと……僕のせいだよ。",
  "en": ""
 },
 {
  "id": "2D4417_02C8.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕がいけないんだ……彼女を傷つけたから。",
  "en": ""
 },
 {
  "id": "2D4417_02E1.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕って……子供なんだよ、きっと。",
  "en": ""
 },
 {
  "id": "2D4417_0304.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ……落ち着くんだ！！",
  "en": ""
 },
 {
  "id": "2D4417_0317.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトって勝手なのね…… / これじゃあ、カケルがかわいそうだわ！！",
  "en": ""
 },
 {
  "id": "2D4417_0317.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（僕が……かわいそう？）",
  "en": ""
 },
 {
  "id": "2D4417_034C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "しかたがないじゃないか……。",
  "en": ""
 },
 {
  "id": "2D4417_035D.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 3,
  "jp": "カケルに話せば、それですむことだわ！！ / このままカケルに誤解されてるのはいやっ…… / 絶対にいやなのっ！！",
  "en": ""
 },
 {
  "id": "2D4417_03A2.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なんだカケル……そこにいたのか。",
  "en": ""
 },
 {
  "id": "2D4417_03B9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえねえ、なにを話してたの？",
  "en": ""
 },
 {
  "id": "2D4417_03CD.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、私が説明してあげるわ。",
  "en": ""
 },
 {
  "id": "2D4417_03E2.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ、本気で怒るぞ。",
  "en": ""
 },
 {
  "id": "2D4417_03F7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ははは……いい天気だな、カケル。",
  "en": ""
 },
 {
  "id": "2D4417_040D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか……わざとらしいなあ。",
  "en": ""
 },
 {
  "id": "2D4417_042D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ……落ち着くんだ！！",
  "en": "",
  "dup": "2D4417_0304.0"
 },
 {
  "id": "2D4417_0440.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトって勝手なのね…… / これじゃあ、カケルがかわいそうだわ！！",
  "en": "",
  "dup": "2D4417_0317.0"
 },
 {
  "id": "2D4417_0440.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（僕が……かわいそう？）",
  "en": "",
  "dup": "2D4417_0317.1"
 },
 {
  "id": "2D4417_0475.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "仕方がないじゃないか……。",
  "en": ""
 },
 {
  "id": "2D4417_0486.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 3,
  "jp": "カケルに話せば、それで済むことだわ！！ / このままカケルに誤解されてるのはいやっ…… / 絶対にいやなのっ！！",
  "en": ""
 },
 {
  "id": "2D4417_04CC.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……いつからそこにいたの？",
  "en": ""
 },
 {
  "id": "2D4417_04E1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちょっと前からだよ、ナターシャ。",
  "en": ""
 },
 {
  "id": "2D4417_04F2.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、いいことを教えてあげるわ / ……とっても大事なこと。",
  "en": ""
 },
 {
  "id": "2D4417_04F2.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか…… / ナターシャは、私を本気で怒らせたいのだな。",
  "en": ""
 },
 {
  "id": "2D4417_0536.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……あのね。",
  "en": "",
  "dup": "2D259F_0651.0"
 },
 {
  "id": "2D4417_0543.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめっ！！",
  "en": ""
 },
 {
  "id": "2D4417_054E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ……海を見てるの？",
  "en": ""
 },
 {
  "id": "2D4417_0560.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_1406.0"
 },
 {
  "id": "2D4417_0568.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネったら。",
  "en": ""
 },
 {
  "id": "2D4417_0574.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん……いつからそこにいたんですか？",
  "en": ""
 },
 {
  "id": "2D4417_058A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕の言ったことを聞いてなかったんだね。",
  "en": ""
 },
 {
  "id": "2D4417_05A2.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ごめんなさい……。",
  "en": "",
  "dup": "2D259F_07DE.0"
 },
 {
  "id": "2D4417_05AC.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん、とうとうライムリン大陸ですね。",
  "en": ""
 },
 {
  "id": "2D4417_05BF.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "これでよかったのか…… / それとも、私がまちがってたのか。",
  "en": ""
 },
 {
  "id": "2D4417_05BF.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "え？",
  "en": "",
  "dup": "2FB86E_14C4.1"
 },
 {
  "id": "2D4417_05E9.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いえ……なんでもありません。",
  "en": ""
 },
 {
  "id": "2D4417_05FF.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_1406.0"
 },
 {
  "id": "2D4417_0607.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ライムリン大陸って……大きいのですか？",
  "en": ""
 },
 {
  "id": "2D4417_0618.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕も初めてきたんだよ…… / エトに聞けばわかるんじゃないの？",
  "en": ""
 },
 {
  "id": "2D4417_0618.1",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "だって、エトさんったら…… / ナターシャさんといっしょなんですもの。",
  "en": ""
 },
 {
  "id": "2D4417_065F.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンって、どんな人なのかしら……？",
  "en": ""
 },
 {
  "id": "2D4417_0675.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "とうとうライムリン大陸にこれたな。",
  "en": ""
 },
 {
  "id": "2D4417_0685.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "しかしまあ、長い船旅だったぜ…… / 陸地に上がった時、脚がふらふらしちまったよ。",
  "en": ""
 },
 {
  "id": "2D4417_0685.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "ルシフォンを倒すまで、 / もう船に乗ることもないね…… / ここはもうライムリン大陸なんだから。",
  "en": ""
 },
 {
  "id": "2D4417_06E0.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "なんとなくだけど……まだ船に乗らなくちゃ / いけないような予感がする。",
  "en": ""
 },
 {
  "id": "2D4417_06E0.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして？",
  "en": "",
  "dup": "2F9C88_00A9.0"
 },
 {
  "id": "2D4417_0713.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "うーん……俺はもう乗らないけどな、 / カケルはまだ乗るような気がするんだ。",
  "en": ""
 },
 {
  "id": "2D4417_073A.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンって……どんなやつなんだろうな？",
  "en": ""
 },
 {
  "id": "2D4417_0752.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ライムリン大陸に来たのはいいが、これでまた / カケル殿とお別れする日が近づいてしまったな。",
  "en": ""
 },
 {
  "id": "2D4417_0752.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "大丈夫だよ、カロン…… / 会おうと思えばいつでも会えるさ。",
  "en": ""
 },
 {
  "id": "2D4417_0752.2",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿……わかってはないな。",
  "en": ""
 },
 {
  "id": "2D4417_07B3.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は会える時に会うのではなく、 / ずっといっしょにいたいのだ。",
  "en": ""
 },
 {
  "id": "2D4417_07D5.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル殿……私はいつでも、 / カケル殿の愛を受け入れる用意があるぞ。",
  "en": ""
 },
 {
  "id": "2D4417_07FD.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん……すうすうすう。",
  "en": ""
 },
 {
  "id": "2D4417_080C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネプチューン……寝てるの？",
  "en": ""
 },
 {
  "id": "2D4417_081B.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすう……すうすう……。",
  "en": "",
  "dup": "2E34B4_1480.0"
 },
 {
  "id": "2D4417_082D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エッチなことをしちゃおうかな。",
  "en": ""
 },
 {
  "id": "2D4417_0845.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やめなさい、カケル。",
  "en": ""
 },
 {
  "id": "2D4417_0854.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "げ！？",
  "en": ""
 },
 {
  "id": "2D4417_085D.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすう……すうすう……。",
  "en": "",
  "dup": "2E34B4_1480.0"
 },
 {
