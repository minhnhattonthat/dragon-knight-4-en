 },
 {
  "id": "2D4417_1937.0",
  "speaker": "ラスカス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ライムリン大陸には初めてきたが……人間の / 匂いが充満してて、気分が悪くなってくる。",
