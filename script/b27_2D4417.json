 },
 {
  "id": "2D4417_14FA.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もちろん本気さ……正直言って恐いけど、 / 彼女と相談して決めたことなんだ。",
  "en": ""
 },
 {
  "id": "2D4417_14FA.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "彼女って……だれのこと？",
