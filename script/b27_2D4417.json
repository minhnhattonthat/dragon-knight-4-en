 },
 {
  "id": "2D4417_1539.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕は彼女なんて言ってないぞ。",
  "en": ""
 },
 {
  "id": "2D4417_154D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "言ったよ。",
  "en": ""
 },
 {
  "id": "2D4417_1558.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 3,
  "jp": "と、とにかく僕はカケル君と / いっしょに闘うんだ…… / 仲間だって、ちゃんと集めたしね。",
