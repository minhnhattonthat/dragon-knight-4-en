 },
 {
  "id": "2D4417_19D5.0",
  "speaker": "サイレス",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前、人間の言葉がわからないのか？ / ……私に近づくなと言ってるんだ。",
  "en": ""
 },
 {
  "id": "2D4417_1A00.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、ロイドン。",
  "en": ""
 },
 {
  "id": "2D4417_1A0B.0",
  "speaker": "ベンガル",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はロイドンではない……ペンを片手に / ルシフォンと闘う戦士、ベンガル様だ。",
  "en": ""
 },
 {
  "id": "2D4417_1A0B.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ペンを片手に闘う戦士？",
  "en": ""
 },
 {
  "id": "2D4417_1A48.0",
  "speaker": "ベンガル",
  "form": "dlg",
  "nlines": 1,
  "jp": "剣で闘うなど、もはや古いのだ。",
  "en": ""
 },
 {
  "id": "2D4417_1A5E.0",
  "speaker": "ベンガル",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、仲間を呼んでくるか……。",
  "en": ""
 },
 {
  "id": "2D4417_1A74.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "ロイドンとか言うやつとは話がついているんだ… / お前たちときたらまったく幸運だぜ、 / 俺たちのような強者と知り合えたんだからな！！",
  "en": ""
 },
 {
  "id": "2D4417_1AC8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふう……まだ出発しないのかなあ。",
  "en": ""
 },
 {
  "id": "2D4417_1ADD.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "まだだぞっ！！　カケルっ！！",
  "en": ""
 },
 {
  "id": "2D4417_1AF4.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……もう少し、この街で休むんだ。",
  "en": ""
 },
