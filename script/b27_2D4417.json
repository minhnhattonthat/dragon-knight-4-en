 },
 {
  "id": "2D4417_143E.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ、マルレーネ様。",
  "en": ""
 },
 {
  "id": "2D4417_144B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なぁんかわざとらしいなあ……。",
  "en": ""
 },
 {
  "id": "2D4417_1465.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……僕は決心したよ。",
