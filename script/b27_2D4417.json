 },
 {
  "id": "2D4417_1489.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ほ、本気なの！？",
  "en": ""
 },
 {
  "id": "2D4417_14BE.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もちろん本気さ……正直言って恐いけど、 / 自分で決めたことなんだ。",
  "en": ""
 },
 {
  "id": "2D4417_14BE.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "大丈夫かなあ、ルシフォン軍は強いよ。",
