  "dup": "2EBA5F_0F27.0"
 },
 {
  "id": "2D4417_18DA.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "げげげっ！！ / どうして俺に話しかけるんだ！？",
