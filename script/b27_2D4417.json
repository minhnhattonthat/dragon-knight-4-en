 },
 {
  "id": "2D4417_11DC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "バルカン、そんな当たり前のことじゃなくて、 / 他のことを話したら？",
  "en": ""
 },
 {
  "id": "2D4417_11DC.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "女の子はね、 / 普通の言葉じゃ振り向いてくれないんだ…… / もっと刺激的なことを言わなきゃ。",
  "en": ""
 },
 {
  "id": "2D4417_123A.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ……私とエッチしてくれないか？",
  "en": ""
 },
 {
  "id": "2D4417_1252.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_1406.0"
 },
 {
  "id": "2D4417_125A.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルぅ……なにもしゃべってくれないぞ。",
  "en": ""
 },
 {
  "id": "2D4417_1274.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちょっと……刺激的すぎるんじゃない？",
  "en": ""
 },
 {
  "id": "2D4417_128B.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネめ、私のことを無視しやがって。",
  "en": ""
 },
 {
  "id": "2D4417_12A3.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……ライムリン王国ってどこにあるの？",
  "en": ""
 },
 {
  "id": "2D4417_12B8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "この大陸のどこかにあるはずだよ。",
  "en": ""
 },
 {
  "id": "2D4417_12CF.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 3,
  "jp": "僕はドラゴンに乗ってたから、 / 遠くまで見えたんだけど、 / お城なんてどこにも見えなかったよ。",
  "en": ""
 },
 {
  "id": "2D4417_1304.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ドラゴンに乗って、偵察してこようかなあ。",
  "en": ""
 },
 {
  "id": "2D4417_131D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "トルル、ひとりで行ったら危ないよ……",
  "en": ""
 },
 {
  "id": "2D4417_1332.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍にはドラゴンナイトが / たくさんいるんだ。",
  "en": ""
 },
 {
  "id": "2D4417_134A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、ウェンディだ。",
  "en": ""
 },
 {
  "id": "2D4417_1356.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "最近、あんまりセイルのこといぢめてないね。",
  "en": ""
 },
 {
  "id": "2D4417_1371.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "人聞きの悪いこと言わないでよっ！",
  "en": ""
 },
 {
  "id": "2D4417_1385.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あたしはあの軟弱者の根性を / たたき直してるだけなの！",
  "en": ""
 },
 {
  "id": "2D4417_13A8.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "だいたい、人のお風呂覗いたりするしさ、",
