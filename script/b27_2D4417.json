  "jp": "見つけ出したら、ただじゃおかないぜ！！",
  "en": ""
 },
 {
  "id": "2D4417_08DE.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ふうふうふう……あいつも、 / バナナみたいに皮をむいてやるうっ！！",
  "en": ""
 },
 {
  "id": "2D4417_0903.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえカケル……あれを見なさいよ。",
  "en": ""
 },
 {
