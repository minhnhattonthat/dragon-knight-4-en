 },
 {
  "id": "2D4417_18DA.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕たちは友だちでしょ？",
  "en": ""
 },
 {
  "id": "2D4417_1906.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふん、冗談じゃないぜ……",
  "en": ""
 },
 {
  "id": "2D4417_1918.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前に復警するために、 / 俺はここにいるんだいっ！！",
