 {
  "id": "2E9A8B_0536.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ……なに考えてるの？",
  "en": ""
 },
 {
  "id": "2E9A8B_0548.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私たち、今はいっしょですけど……",
  "en": ""
 },
 {
  "id": "2E9A8B_055E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "いつかは別れなければならない日が / 来るんでしょうか？",
  "en": ""
 },
 {
  "id": "2E9A8B_0579.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "闘いが終ったら……そうなるかもしれないね。",
  "en": ""
 },
 {
  "id": "2E9A8B_0595.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "少し……さびしいですね。",
  "en": ""
 },
 {
  "id": "2E9A8B_05AD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（やーめたっと……）",
  "en": ""
 },
 {
  "id": "2E9A8B_05C0.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさん、この国の東には / ミシエルって街があるそうです。",
  "en": ""
 },
 {
  "id": "2E9A8B_05E0.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさんって……強いですね。",
  "en": ""
 },
 {
  "id": "2E9A8B_05F2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネレイドだって、よく闘ってると思うよ。",
  "en": ""
 },
 {
  "id": "2E9A8B_0609.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "ああ……どうせだったら、 / エトさんにそう言われたい。",
  "en": ""
 },
 {
  "id": "2E9A8B_0609.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……そう。",
  "en": ""
 },
 {
  "id": "2E9A8B_0633.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "さっきさあ、マルレーネに話しかけたんだよ。",
  "en": ""
 },
 {
  "id": "2E9A8B_064B.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうしたら、 / ちらりと俺を見ただけで無視しやがんの。",
  "en": ""
 },
 {
  "id": "2E9A8B_064B.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネは、とっても優しい人だよ。",
  "en": ""
 },
 {
  "id": "2E9A8B_0682.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうかなあ……。",
  "en": ""
 },
 {
  "id": "2E9A8B_068D.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ロンボニ王国の東には、 / ミシエルの街があるんだとさ。",
  "en": ""
 },
 {
  "id": "2E9A8B_06A4.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "王様に謁見を願い出たのだが…… / 断られてしまったぞ。",
  "en": ""
 },
 {
  "id": "2E9A8B_06A4.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "きっと忙しいんだよ、王様も。",
  "en": ""
 },
 {
  "id": "2E9A8B_06DB.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿がそう言うのなら……納得しよう。",
  "en": ""
 },
 {
  "id": "2E9A8B_06F6.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿、いっしょに散歩でもせんか？",
  "en": ""
 },
 {
  "id": "2E9A8B_070F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕も忙しいんだ。",
  "en": ""
 },
 {
  "id": "2E9A8B_071E.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さびしい。",
  "en": ""
 },
 {
  "id": "2E9A8B_0729.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もぐもぐ……。 / 俺たちがもっと強くなる方法を知ってるか？",
  "en": ""
 },
 {
  "id": "2E9A8B_0729.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "バナナを食べれば、 / もっと強くなれるっていうんでしょ？",
  "en": ""
 },
 {
  "id": "2E9A8B_0729.2",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ありゃりゃ……どうしてわかったの？",
  "en": ""
 },
 {
  "id": "2E9A8B_0780.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺はよぉ、 / この闘いが終ったらバナナ屋さんをやるんだ。",
  "en": ""
 },
 {
  "id": "2E9A8B_07A3.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "パンドラ、なにをしてるの？",
  "en": ""
 },
 {
  "id": "2E9A8B_07B4.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふふふ、台所を借りてお料理をしてるの。",
  "en": ""
 },
 {
  "id": "2E9A8B_07D2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そう言われてみれば、いい匂いがするなあ。",
  "en": ""
 },
 {
  "id": "2E9A8B_07EC.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルも食べる？",
  "en": ""
 },
 {
  "id": "2E9A8B_07F9.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私の作るニンニク料理は最高なんだから。",
  "en": ""
 },
 {
  "id": "2E9A8B_0815.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさんの目って…… / エトさんの目に似てますね。",
  "en": ""
 },
 {
  "id": "2E9A8B_0815.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "エトの目に似てるって言われても、 / いつも覆面のような兜をつけてるからな……。 / メイフェアはどこで見たの？",
  "en": ""
 },
 {
  "id": "2E9A8B_0870.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "見たことはないですけど、 / きれいな目をしてるに決まってます。",
  "en": ""
 },
 {
  "id": "2E9A8B_0895.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさんにかかったら……",
  "en": ""
 },
 {
  "id": "2E9A8B_08A7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍なんて / ゾウリムシのようなものですね。",
  "en": ""
 },
 {
  "id": "2E9A8B_08C3.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "すっごい言い方。",
  "en": ""
 },
 {
  "id": "2E9A8B_08D1.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルってよ……けっこう強いんだな。",
  "en": ""
