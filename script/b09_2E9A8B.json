[
 {
  "id": "2E9A8B_0096.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、ロンボニ王国を解放したぞ！！",
  "en": ""
 },
 {
  "id": "2E9A8B_00AB.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、あの……。",
  "en": ""
 },
 {
  "id": "2E9A8B_00C0.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "た、助けてください……。",
  "en": ""
 },
 {
  "id": "2E9A8B_00D1.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの軍隊が引き上げる時に…… / 姉のレアが連れ去られてしまったのです。",
  "en": ""
 },
 {
  "id": "2E9A8B_00FB.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "姉はこのロンボニ王国一番の弓使いなんです。",
  "en": ""
 },
 {
  "id": "2E9A8B_0115.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "きっと姉の腕を利用しようとして、 / 連れ去ったにちがいありません。",
  "en": ""
 },
 {
  "id": "2E9A8B_013E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、どうするの？",
  "en": ""
 },
 {
  "id": "2E9A8B_014D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "みんな疲れてるからな…… / すぐに出発するのは無理だ。",
  "en": ""
 },
 {
  "id": "2E9A8B_014D.1",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そんな……。",
  "en": ""
 },
 {
  "id": "2E9A8B_017A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "悪いが、連れ去られたのは / 君のお姉さんだけではないんだ。",
  "en": ""
 },
 {
  "id": "2E9A8B_017A.1",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "わかりました…… / 私、自分で姉を助けます。",
  "en": ""
 },
 {
  "id": "2E9A8B_01C9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……すぐに行こうよ。",
  "en": ""
 },
 {
  "id": "2E9A8B_01DB.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、一時の感情に流されるな。",
  "en": ""
 },
 {
  "id": "2E9A8B_01F2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかったよ……。",
  "en": ""
 },
 {
  "id": "2E9A8B_01FF.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、マルレーネさんがね…… / さびしそうに立ってるんだ。",
  "en": ""
 },
 {
  "id": "2E9A8B_01FF.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイルが元気づけてあげればいいじゃないか。",
  "en": ""
 },
 {
  "id": "2E9A8B_0238.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そんなことできないよ。",
  "en": ""
 },
 {
  "id": "2E9A8B_0250.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あ……またふたりでいる）",
  "en": ""
 },
 {
  "id": "2E9A8B_0262.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（いったい……なにを話してるのかなあ）",
  "en": ""
 },
 {
  "id": "2E9A8B_027C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトに話しかけますか？",
  "en": "",
  "dup": "2E0000_06A1.0"
 },
 {
  "id": "2E9A8B_0289.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "話しかける",
  "en": "",
  "dup": "2E0000_06AE.0"
 },
 {
  "id": "2E9A8B_0293.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "話しかけない",
  "en": "",
  "dup": "2E0000_06B8.0"
 },
 {
  "id": "2E9A8B_02A7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……なにしてんの？",
  "en": ""
 },
 {
  "id": "2E9A8B_02B8.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わっ！？　……おどかすな、カケル。",
  "en": ""
 },
 {
  "id": "2E9A8B_02CE.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふふ……ね、私の言ったとおりでしょう？",
  "en": ""
 },
 {
  "id": "2E9A8B_02E7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんのこと？",
  "en": ""
 },
 {
  "id": "2E9A8B_02F3.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、私があげたお守り、今でも持ってる？",
  "en": ""
 },
 {
  "id": "2E9A8B_030D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "持ってるけど……さ。 / 別にすてたってかまわないけど……。",
  "en": ""
 },
 {
  "id": "2E9A8B_030D.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいや、カケル……お前はすてないよ。",
  "en": ""
 },
 {
  "id": "2E9A8B_0344.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちぇっ……僕はもう行くよ！ / なんだか気分が悪いんだ。",
  "en": ""
 },
 {
  "id": "2E9A8B_0368.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（なんか……話しかけづらいな）",
  "en": ""
 },
 {
  "id": "2E9A8B_0381.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……私になにか用か？",
  "en": ""
 },
