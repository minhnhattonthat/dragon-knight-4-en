 },
 {
  "id": "2E9A8B_1962.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "はいはい、おねーさんがあなたのさびしさを / やわらげてあげる。",
  "en": ""
 },
 {
  "id": "2E9A8B_1984.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ねーちゃん、ケチケチしないで / もっとぱーっとサービスしろよ！！",
  "en": ""
 },
 {
  "id": "2E9A8B_1984.1",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_07AF.0"
 },
 {
  "id": "2E9A8B_19B5.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "……おい、こら。 / なにをサービスしろって？",
  "en": ""
 },
 {
  "id": "2E9A8B_19B5.1",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ば、僕はそんなこと……。",
  "en": ""
 },
 {
  "id": "2E9A8B_19E3.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "いーや言った！！",
  "en": ""
 },
 {
  "id": "2E9A8B_19F1.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "このネプチューン様をからかうとは、 / いい根性してるじゃないか。",
  "en": ""
 },
 {
  "id": "2E9A8B_1A13.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "いってえじゃねーか、このアマ！！",
  "en": ""
 },
 {
  "id": "2E9A8B_1A29.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "とうとう本性をあらわしたな、このガキ。",
  "en": ""
 },
 {
  "id": "2E9A8B_1A42.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "か、かんべんちてくだちゃいまちぇ。",
  "en": ""
 },
 {
  "id": "2E9A8B_1A5A.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "もう遅いんだよっ！！",
  "en": ""
 },
 {
  "id": "2E9A8B_1A6B.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "うわわわっ！！ / だれか助けてくれえっ！！",
  "en": ""
 },
 {
  "id": "2E9A8B_1A6B.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "（あはははははっ！！ / ネプチューンって、ケンカも強いんだなあ）",
  "en": ""
 },
 {
  "id": "2E9A8B_1AA5.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "こらあっ！！",
  "en": ""
 },
 {
  "id": "2E9A8B_1AB1.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "もうかんべんしてくれようっ！！",
  "en": ""
 },
 {
  "id": "2E9A8B_1AC6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（ありゃりゃ……まだやってら）",
  "en": ""
 },
 {
  "id": "2E9A8B_1ADC.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 1,
  "jp": "そなたがカケルか……。",
  "en": ""
 },
 {
  "id": "2E9A8B_1AEB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おじさんがロンボニの王様？",
  "en": ""
 },
 {
  "id": "2E9A8B_1B01.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうじゃよ……",
  "en": ""
 },
 {
  "id": "2E9A8B_1B0E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ワシがロンボニ大陸の / いちばんえらいおじさんじゃ。",
  "en": ""
 },
 {
  "id": "2E9A8B_1B29.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 1,
  "jp": "それにしても……",
  "en": ""
 },
 {
  "id": "2E9A8B_1B37.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前のような若者が / この国を救ってくれたとはな。",
  "en": ""
 },
 {
  "id": "2E9A8B_1B56.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕ひとりで救ったわけじゃない…… / みんなで力を合わせて闘ったんだ。",
  "en": ""
 },
 {
  "id": "2E9A8B_1B56.1",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうかそうか…… / とにかく感謝をしておるぞ、カケル。",
  "en": ""
 },
 {
  "id": "2E9A8B_1B56.2",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 3,
  "jp": "ところで、レイモンド大陸のうわさは / この国まで届いておるが…… / あれは本当のことなのか？",
  "en": ""
 },
 {
  "id": "2E9A8B_1BC6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "たぶん今頃は、 / 大陸全体が黒い霧に包まれていると思う。",
  "en": ""
 },
 {
  "id": "2E9A8B_1BC6.1",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 3,
  "jp": "ルシフォンの軍勢を追っ払ったとしても、 / 西からは黒い霧が迫っておる…… / ルシフォンめ、なかなか賢いやつじゃわい。",
  "en": ""
 },
 {
  "id": "2E9A8B_1C28.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの黒い霧は、ルシフォンと関係があるの？",
  "en": ""
 },
 {
  "id": "2E9A8B_1C40.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 2,
  "jp": "あれはな、お前の父が倒した / ディードにも関係があるんじゃよ……。",
  "en": ""
 },
 {
  "id": "2E9A8B_1C40.1",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 3,
  "jp": "これも噂じゃが…… / あの黒い霧は、闇の世界から / 吹き出してきた物らしいわい。",
  "en": ""
 },
 {
  "id": "2E9A8B_1C99.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "そして閉ざされていた闇の扉を、 / 開いたのもルシフォンのしわざというわけじゃ。",
  "en": ""
 },
 {
  "id": "2E9A8B_1CC4.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 2,
  "jp": "まったく、あのルシフォンとかいう男…… / いったい何者なのかのう。",
  "en": ""
 },
 {
  "id": "2E9A8B_1CC4.1",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 2,
  "jp": "とにかく、この国もやがて / 黒い霧に包まれるじゃろう……。",
  "en": ""
 },
 {
  "id": "2E9A8B_1CC4.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おじさんは……どうするの？",
  "en": ""
 },
 {
  "id": "2E9A8B_1D1C.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 2,
  "jp": "ふおっふおっ……レイモンド王と同じじゃよ。 / 見事、石になってやるわい……ふおっふおっ。",
  "en": ""
 },
 {
  "id": "2E9A8B_1D1C.1",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 2,
  "jp": "しかし、すべてをあきらめたわけではないぞ…… / ワシには、カケルという希望がある。",
  "en": ""
 },
 {
  "id": "2E9A8B_1D1C.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕？",
  "en": ""
 },
 {
  "id": "2E9A8B_1D88.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンを倒すことができたら……",
  "en": ""
 },
 {
  "id": "2E9A8B_1D9C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "この黒い霧は消え失せ、 / みなが元に戻るかもしれん。",
  "en": ""
 },
 {
  "id": "2E9A8B_1DBA.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "みんなが……元に戻る？",
  "en": ""
 },
 {
  "id": "2E9A8B_1DCB.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 1,
  "jp": "わからんが……そうなるかもしれんじゃろ？",
  "en": ""
 },
 {
  "id": "2E9A8B_1DE5.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、我が国にはもはや軍隊は存在せぬが、 / せめてゆっくり身体を休めていっておくれ。",
  "en": ""
 },
 {
  "id": "2E9A8B_1DE5.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ありがとう、王様。",
  "en": ""
 },
 {
  "id": "2E9A8B_1E28.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 1,
  "jp": "うんうん……よい男の子に育ったの。",
  "en": ""
 },
 {
  "id": "2E9A8B_1E3E.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうじゃ、ワシにも娘がおるのじゃよ…… / 名前はビアンカというんじゃが。",
  "en": ""
 },
 {
  "id": "2E9A8B_1E3E.1",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 2,
  "jp": "誰か、ビアンカを連れてまいれ…… / カケルに紹介するでな。",
  "en": ""
 },
 {
  "id": "2E9A8B_1E3E.2",
  "speaker": "衛兵ナビ",
  "form": "dlg",
  "nlines": 2,
  "jp": "王様、ビアンカ様はこの城にはおられません。 / ただ今、側近の者がさがしております。",
  "en": ""
 },
 {
  "id": "2E9A8B_1E3E.3",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 1,
  "jp": "まったく、あのじゃじゃ馬娘め……。",
  "en": ""
 },
 {
  "id": "2E9A8B_1ED4.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、ビアンカの姿が見えないようじゃ。",
  "en": ""
 },
 {
  "id": "2E9A8B_1EEB.0",
  "speaker": "ロンボニ王",
  "form": "dlg",
  "nlines": 2,
  "jp": "なあに、また会える時があるじゃろう…… / ふおっふおっふおっ。",
  "en": ""
 },
 {
  "id": "2E9A8B_1F10.0",
  "speaker": "衛兵ナビ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は王様を尊敬しております…… / もちろん我が王と命を共にするつもりです。",
  "en": ""
 },
 {
  "id": "2E9A8B_1F3E.0",
  "speaker": "衛兵ノラン",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は石となり果てても、 / 王様の横でお守りするつもりです。",
  "en": ""
 },
 {
  "id": "2E9A8B_1F63.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルは力の種を２個見つけた！！",
  "en": "",
