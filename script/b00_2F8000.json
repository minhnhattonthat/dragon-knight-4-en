[
 {
  "id": "2F8000_000E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "遠い、遠い未来の時代……",
  "en": ""
 },
 {
  "id": "2F8000_0025.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "人類は新しい文明のあり方を見つけだしていた。",
  "en": ""
 },
 {
  "id": "2F8000_0043.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "そんな時代…… / 物語は未来の魔界よりはじまる――――",
  "en": ""
 },
 {
  "id": "2F8000_0068.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "マノ……どうしたんだ？ / なぜそんなせつない……悲しそうな顔をする？",
  "en": ""
 },
 {
  "id": "2F8000_0068.1",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 2,
  "jp": "だって……私たちのこと、 / お父様が許してくれるはずがない。",
  "en": ""
 },
 {
  "id": "2F8000_0068.2",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "大丈夫だ。私とて魔界の四天王のひとり、 / ミナクス様だってわかってくれる。",
  "en": ""
 },
 {
  "id": "2F8000_0068.3",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 4,
  "jp": "だめ……今、話をしたら、きっと反対される。 / 私はあなたを失いたくないの…… / あなたを失うくらいなら、 / このまま黙っていた方がいい。",
  "en": ""
 },
 {
  "id": "2F8000_0126.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "それでは、ミナクス様を裏切ることになる。",
  "en": ""
 },
 {
  "id": "2F8000_0143.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン、お父様には私から話すわ。 / でも今はその時じゃ……ない。",
  "en": ""
 },
 {
  "id": "2F8000_0143.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……わかった。",
  "en": ""
 },
 {
  "id": "2F8000_0173.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そんな顔をしないでルシフォン。",
  "en": ""
 },
 {
  "id": "2F8000_0185.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……大丈夫、 / いつの日か、お父様もきっとわかってくれるわ。",
  "en": ""
 },
 {
  "id": "2F8000_01A3.0",
  "speaker": "イノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォン様……。",
  "en": ""
 },
 {
  "id": "2F8000_01AE.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン。もういちどキスして……。 / そして私を……抱きしめて……。",
  "en": ""
 },
 {
  "id": "2F8000_01DA.0",
  "speaker": "",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2F8000_01DA.1",
  "speaker": "カケル、生後１ヶ月",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2F8000_01E3.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちゅうちゅうちゅう。",
  "en": ""
 },
 {
  "id": "2F8000_01F6.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "はーい、カケルちゃん…… / いっぱい飲んで早く大きくなるんでちゅよ。",
  "en": ""
 },
 {
  "id": "2F8000_01F6.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちゅうちゅう……むしゃむしゃ。",
  "en": ""
 },
 {
  "id": "2F8000_0233.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……む、むしゃむしゃっ！？",
  "en": ""
 },
 {
  "id": "2F8000_0246.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ちゅうちゅう。",
  "en": ""
 },
 {
  "id": "2F8000_0257.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2F8000_025F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ちゅうちゅう。",
  "en": "",
  "dup": "2F8000_0246.0"
 },
 {
  "id": "2F8000_0270.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ちゅうちゅう。",
  "en": "",
  "dup": "2F8000_0246.0"
 },
 {
  "id": "2F8000_0281.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……むしゃむしゃ。",
  "en": ""
 },
 {
  "id": "2F8000_0290.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ひっ！？",
  "en": ""
 },
 {
  "id": "2F8000_029C.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "タケルうっ！！　この子、絶対に変だわあ！！",
  "en": ""
 },
 {
  "id": "2F8000_02B7.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わっはは！　あたりまえだ……俺の息子だぜ！！",
  "en": ""
 },
 {
  "id": "2F8000_02D8.0",
  "speaker": "",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2F8000_02D8.1",
  "speaker": "カケル、５歳",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2F8000_02E1.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "きゃああん！！ / カケルちゃんなんて大っ嫌い！！",
  "en": ""
 },
 {
  "id": "2F8000_02E1.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わーいっ！！　見えたじょぉー！！",
  "en": ""
 },
 {
  "id": "2F8000_0313.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ママに言いつけてやるからあっ！！",
  "en": ""
 },
 {
  "id": "2F8000_0329.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "平気だもんっ！！",
  "en": ""
 },
 {
  "id": "2F8000_0337.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前のママがきたら、 / ママの背中にカエルをいれてやるじょ！！",
  "en": ""
 },
 {
  "id": "2F8000_035B.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "うちのママは、すっごい魔法使いなんだからね",
  "en": ""
 },
 {
  "id": "2F8000_0377.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……カケルちゃんなんて、 / カエルにされちゃうんだからあっ！！",
  "en": ""
 },
 {
  "id": "2F8000_039F.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 2,
  "jp": "四天王のひとりであるお前が、 / 私に隠れて娘と契りを結ぶとは……な。",
  "en": ""
 },
 {
  "id": "2F8000_039F.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "お言葉ですがミナクス様。 / 遅かれ早かれ、私とマノはこうなったのでは？",
  "en": ""
 },
 {
  "id": "2F8000_039F.2",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "やめて、ルシフォン……",
  "en": ""
 },
 {
  "id": "2F8000_0403.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "お父様、ルシフォンは悪くない…… / 私が彼を誘ったの。",
  "en": ""
 },
 {
  "id": "2F8000_041E.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前は黙っておれ……",
  "en": ""
 },
 {
  "id": "2F8000_042F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "我が娘であるマノと契りを結ぶのは、 / この魔界の跡を継ぐ者だ…… / それはわかっておるな？",
  "en": ""
 },
 {
  "id": "2F8000_042F.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "はい。それが魔界に伝わる儀式です。",
  "en": ""
 },
 {
  "id": "2F8000_047D.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 2,
  "jp": "では聞こう…… / 私がいつ、お前を跡継ぎにすると言った？",
  "en": ""
 },
 {
  "id": "2F8000_047D.1",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "お父様……私、ルシフォンを愛してるの。",
  "en": ""
 },
 {
  "id": "2F8000_04B5.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 4,
  "jp": "愛などはいらん…… / 必要なのは、強大な魔力を持つ子孫なのだ…… / それでなければ、 / 今の状態をくつがえすことができん。",
  "en": ""
 },
 {
  "id": "2F8000_04FD.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 3,
  "jp": "四天王のひとりである私ならば、 / さぞや強大な魔力を持つ子孫が / 生まれるでしょう。",
  "en": ""
 },
 {
  "id": "2F8000_052E.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 3,
  "jp": "たしかに私の跡を継ぐ者は、 / 四天王のひとりとなるであろう…… / しかし、お前ではないかも知れんのだ。",
  "en": ""
 },
 {
  "id": "2F8000_056B.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そんなことはありえません。",
  "en": ""
 },
 {
  "id": "2F8000_057E.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "自分が一番ふさわしいとでもいうか。",
  "en": ""
 },
 {
  "id": "2F8000_0596.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "もちろんそう思っております。",
  "en": ""
 },
 {
  "id": "2F8000_05AA.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "四天王の中で、 / 私以外にだれがいるというのでしょう。",
  "en": ""
 },
 {
  "id": "2F8000_05CC.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "愚か者め……",
  "en": ""
 },
 {
  "id": "2F8000_05D9.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前のように慢心した心の持ち主では、 / 安心して魔界をまかせることなどできん！！",
  "en": ""
 },
 {
  "id": "2F8000_0607.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "しかし……。",
  "en": ""
 },
 {
  "id": "2F8000_0612.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "闇界の王、ディードを忘れたのか！！",
  "en": ""
 },
 {
  "id": "2F8000_062C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……やつは自分の力を過信したからこそ、 / 人間に倒されたのではないのか！？",
  "en": ""
 },
 {
  "id": "2F8000_0654.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2F8000_065C.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンよ、お前は私を裏切ったのだぞ…… / この償いはしてもらう。",
  "en": ""
 },
 {
  "id": "2F8000_065C.1",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いや……。",
  "en": ""
 },
 {
  "id": "2F8000_068F.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前を次元の狭間に送り込んでやる……",
  "en": ""
 },
 {
  "id": "2F8000_06AA.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "次元の狭間で、 / 私が許すまでじっとしておるのだ！！",
  "en": ""
 },
 {
  "id": "2F8000_06CA.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "お、お父様っ！！",
  "en": ""
 },
 {
  "id": "2F8000_06D8.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私もいっしょに…… / ルシフォンといっしょに行かせてっ！！",
  "en": ""
 },
 {
  "id": "2F8000_06F5.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "マノよ、イノを恨むでないぞ……",
  "en": ""
 },
 {
  "id": "2F8000_070B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前の妹は、姉であるお前を思えばこそ / 私に知らせたのだ。",
  "en": ""
 },
 {
  "id": "2F8000_072D.0",
  "speaker": "イノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2F8000_0735.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私もお父様を裏切りました…… / 私もルシフォンといっしょに罪をつぐないます！",
  "en": ""
 },
 {
  "id": "2F8000_0735.1",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "マノよ……私をこれ以上怒らせるな。",
  "en": ""
 },
 {
  "id": "2F8000_0777.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンと離れるくらいなら、 / 生きていても仕方ありません！！",
  "en": ""
 },
 {
  "id": "2F8000_0777.1",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ええい、いいかげんにするのだ！！ / ……ルシフォンよ、次元の狭間におちよっ！！",
  "en": ""
 },
 {
  "id": "2F8000_0777.2",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "や、やめてえっ！！　お父様っ！！",
  "en": ""
 },
 {
  "id": "2F8000_07E3.0",
  "speaker": "",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2F8000_07E3.1",
  "speaker": "カケル、１２歳",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2F8000_07EC.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "まあ！！　またケンカしてきたのね！！",
  "en": ""
 },
 {
  "id": "2F8000_0804.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "今度はだれなの！？ / ……隣のマノクスちゃん？ / それとも二軒先のロバーツちゃん？",
  "en": ""
 },
 {
  "id": "2F8000_0804.1",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ま、まさかシモンちゃんじゃないでしょうね！？",
  "en": ""
 },
 {
  "id": "2F8000_0851.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "シモンちゃんだったら、 / お母さんがまた怒鳴り込んでくるわ…… / ああ、どうしましょう！！",
  "en": ""
 },
 {
  "id": "2F8000_0851.1",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、またケンカか？",
  "en": ""
 },
 {
  "id": "2F8000_0895.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、お父さん……今日も勝ったよ。",
  "en": ""
 },
 {
  "id": "2F8000_08AC.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか、そうか、わっはっはっ！！",
  "en": ""
 },
 {
  "id": "2F8000_08BD.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "もう、あなたっ……ちゃんと叱ってください！！",
  "en": ""
 },
 {
  "id": "2F8000_08D8.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "よし……叱るぞ、すぐに叱るぞ、いま叱るぞ。",
  "en": ""
 },
 {
  "id": "2F8000_08F6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、 / ケンカをする時は勝つことがいちばん大事だぞ。",
  "en": ""
 },
 {
  "id": "2F8000_0914.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかってるよ、お父さん。",
  "en": ""
 },
 {
  "id": "2F8000_0926.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "でもな、ケンカにはルールがあるんだ…… / 相手が降参したら、もう殴っちゃだめだ。",
  "en": ""
 },
 {
  "id": "2F8000_0926.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、僕は殴らなかったよ。",
  "en": ""
 },
 {
  "id": "2F8000_096A.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか、そうか……カケルはえらいな。",
  "en": ""
 },
 {
  "id": "2F8000_097B.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あなたぁっ！！",
  "en": ""
 },
 {
  "id": "2F8000_0988.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あとで文句を言われる / 私の身にもなってください！！",
  "en": ""
 },
 {
  "id": "2F8000_09AD.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンよ……私の声が聞こえるか？",
  "en": ""
 },
 {
  "id": "2F8000_09C3.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "その声は……ミナクス様。",
  "en": ""
 },
 {
  "id": "2F8000_09D7.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 3,
  "jp": "指一本動かすことのできない、哀れな悪魔よ…… / お前が魔界に戻れる機会を与えよう。 / これから言うことをよく聞くのだ。",
  "en": ""
 },
 {
  "id": "2F8000_0A1C.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "魔界に……戻れる？",
  "en": ""
 },
 {
  "id": "2F8000_0A2B.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前の罪はまだつぐなわれていない。",
  "en": ""
 },
 {
  "id": "2F8000_0A43.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……しかし、 / こうしてお前を呼んだのには理由がある。",
  "en": ""
 },
 {
  "id": "2F8000_0A64.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F8000_0654.0"
 },
 {
  "id": "2F8000_0A6C.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンよ……次元を超え、 / ある男を殺してくるのだ。",
  "en": ""
 },
 {
  "id": "2F8000_0A6C.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ある男を……殺す？",
  "en": ""
 },
 {
  "id": "2F8000_0A9B.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 3,
  "jp": "遠い遠い過去に、 / 神の血を受け継いでるにもかかわらず、 / 地上に住んでいた人間がいたのは知っておるな？",
  "en": ""
 },
 {
  "id": "2F8000_0ADF.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "知っております……",
  "en": ""
 },
 {
  "id": "2F8000_0AEE.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "神の血を受け継いだ人間といえば、 / 人間界の歴史の中でもただひとり……",
  "en": ""
 },
 {
  "id": "2F8000_0B1A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "闇界の王・ディードを倒した伝説の剣士、 / ヤマト・タケルのみです。",
  "en": ""
 },
 {
  "id": "2F8000_0B45.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 4,
  "jp": "人間が天界をあがめ、我々魔族が入り込む陥間が / なくなってしまったのは…… / この男の存在があったからこそ。 / やつこそすべての元凶なのだ。",
  "en": ""
 },
 {
  "id": "2F8000_0B97.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F8000_0654.0"
 },
 {
  "id": "2F8000_0B9F.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 5,
  "jp": "タケルの命がつきたあとも、 / 人間たちはやつの示した方向に導かれ続けた…… / つまり、逆にタケルさえいなければ、 / 今の人間どもに天界の入り込むすきなどなくなっ / ていたであろう。",
  "en": ""
 },
 {
  "id": "2F8000_0B9F.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 3,
  "jp": "次元を超えタケルを殺せば、 / 人間界は魔界に近い存在となる……。 / その役目をこの私に？",
  "en": ""
 },
 {
  "id": "2F8000_0C39.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 5,
  "jp": "そうだ。よいか、ルシフォンよ…… / 私はもちろんのこと、 / 我々上級魔族は常に天界の神に監視されている。 / 天界の住人に、我々がなそうとすることを / 気づかれるわけにはいかぬ。",
  "en": ""
 },
 {
  "id": "2F8000_0C39.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "タケルは神の血を受け継ぐ者……",
  "en": ""
 },
 {
  "id": "2F8000_0CB7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "たしかに天界に知れれば、 / やっかいなことになるでしょう。",
  "en": ""
 },
 {
  "id": "2F8000_0CD8.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 4,
  "jp": "しかしお前は３千年もの間、 / 次元の狭間に封じ込められていた…… / 天界のやつらも、 / お前の存在は見落としているようだ。",
  "en": ""
 },
 {
  "id": "2F8000_0D25.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F8000_0654.0"
 },
 {
  "id": "2F8000_0D2D.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "相手はディードを倒したタケルだ……",
  "en": ""
 },
 {
  "id": "2F8000_0D46.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "誇り高きお前にとっても、 / 不足のある相手ではなかろう。",
  "en": ""
 },
 {
  "id": "2F8000_0D69.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "はい…… / 遊ぶ相手としてはちょうどいいかもしれません。",
  "en": ""
 },
 {
  "id": "2F8000_0D69.1",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 2,
  "jp": "くっくっくっ…… / ルシフォンよ、手をひらくがよい。",
  "en": ""
 },
 {
  "id": "2F8000_0DAB.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "それが……なんだかわかるか？",
  "en": ""
 },
 {
  "id": "2F8000_0DBF.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "これは魔族に伝わる…… / 次元を超えるための石ですね。",
  "en": ""
 },
 {
  "id": "2F8000_0DBF.1",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだ。",
  "en": ""
 },
 {
  "id": "2F8000_0DED.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ひとつはタケルがいた過去の世界ヘ行くために… / もうひとつは元の世界に戻るために使うのだ。",
  "en": ""
 },
 {
  "id": "2F8000_0E1F.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "くっくっくっ……",
  "en": ""
 },
 {
  "id": "2F8000_0E2D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "タケルの殺し方はお前にまかせるが、 / その前にひとつだけ言っておくことがある……",
  "en": ""
 },
 {
  "id": "2F8000_0E58.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "次元を超える石は魔族の女を儀式にかけ、 / その子宮から取り出すことは知っておるな？",
  "en": ""
 },
 {
  "id": "2F8000_0E8B.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "はい……知っております。",
  "en": ""
 },
 {
  "id": "2F8000_0E9D.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 2,
  "jp": "そして今、お前が握っているその石は…… / 我が娘マノの子宮から取り出した物だ。",
  "en": ""
 },
 {
  "id": "2F8000_0E9D.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "！？",
  "en": ""
 },
 {
  "id": "2F8000_0ED5.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 4,
  "jp": "マノは自分から願い出たのだぞ。 / お前を助けるために…… / そして自分たちのことを / 認めてもらうために、だ。",
  "en": ""
 },
 {
  "id": "2F8000_0F13.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なんということを……。",
  "en": ""
 },
 {
  "id": "2F8000_0F25.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 4,
  "jp": "その石に込められた願いを解放しなければ、 / マノの傷は永遠に癒えることはない…… / そしてその石に込められた願いとは、 / 神の血を人間界から消し去ることだ。",
  "en": ""
 },
 {
  "id": "2F8000_0F82.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "マノ……。",
  "en": ""
 },
 {
  "id": "2F8000_0F8C.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 3,
  "jp": "ミナクス様、 / 魔族の女には３つの子宮があります…… / 残りのひとつの石は？",
  "en": ""
 },
 {
  "id": "2F8000_0FBC.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 2,
  "jp": "残りのひとつは…… / 最後の時に私が使わせてもらおう。",
  "en": ""
 },
 {
  "id": "2F8000_0FBC.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "最後の時？",
  "en": ""
 },
 {
  "id": "2F8000_0FE7.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 3,
  "jp": "私がこの石を使うのは、 / お前が失敗した時だけだ。 / まさか、私に使わせるつもりではあるまい？",
  "en": ""
 },
 {
  "id": "2F8000_101E.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ミナクス様、相手は人間一匹です…… / 遊びながらでも殺すことができるでしょう。",
  "en": ""
 },
 {
  "id": "2F8000_101E.1",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "よいかルシフォンよ……",
  "en": ""
 },
 {
  "id": "2F8000_105A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前はディードが倒された / 直後の時代に行くのだ。",
  "en": ""
 },
 {
  "id": "2F8000_107A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "その時代であれば、 / 天界は人間界に干渉することができない。",
  "en": ""
 },
 {
  "id": "2F8000_109F.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "たしかに。",
  "en": ""
 },
 {
  "id": "2F8000_10AA.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ディード亡きあと、神は自ら人間界に / つながる扉を閉めたと聞いております。",
  "en": ""
 },
 {
  "id": "2F8000_10D8.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "マノに感謝することだ……",
  "en": ""
 },
 {
  "id": "2F8000_10EB.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前がすべてうまくやれば、 / 私もマノとのことを祝福してやろう。",
  "en": ""
 },
 {
  "id": "2F8000_1110.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ほ、本当ですか、ミナクス様！？",
  "en": ""
 },
 {
  "id": "2F8000_1126.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 2,
  "jp": "くっくっくっ…… / 次元を超え、まずはタケルを捜し出すのだ。",
  "en": ""
 },
 {
  "id": "2F8000_114D.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "お、お任せくださいミナクス様。",
  "en": ""
 },
 {
  "id": "2F8000_1164.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ところでルシフォン……",
  "en": ""
 },
 {
  "id": "2F8000_1172.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "その石の力を使うにあたって、 / やってはならぬことは知っておろうな？",
  "en": ""
 },
 {
  "id": "2F8000_1198.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もちろんです……　過去の世界で自分の正体を / 自分自身に明かさぬこと。",
  "en": ""
 },
 {
  "id": "2F8000_1198.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "しかしミナクス様、",
  "en": ""
 },
 {
  "id": "2F8000_11D5.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "タケルのいる時代には我が魔界ヘの扉も / 閉じられているはず。 / 私自身と出会う可能性などはありません。",
  "en": ""
 },
 {
  "id": "2F8000_11D5.1",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 1,
  "jp": "うむ、お前は我が四天王のひとりだ……",
  "en": ""
 },
 {
  "id": "2F8000_122A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "闇界を利用し、愚かな人間たちを利用すれば / 造作のないことであろう…… / ディードのいない闇界など恐れることはない。",
  "en": ""
 },
 {
  "id": "2F8000_122A.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 4,
  "jp": "闇界が閉じ込められている、 / 次元の狭間を解放するのですね…… / やつらを利用すれば、 / タケルの方から私の元にやってくるでしょう。",
  "en": ""
 },
 {
  "id": "2F8000_12BF.0",
  "speaker": "ミナクス",
  "form": "dlg",
  "nlines": 3,
  "jp": "くっくっくっ、お前が戻ってきた時、 / 人間界は我が魔族が支配しているだろう…… / 楽しみにしているぞ、ルシフォン。",
  "en": ""
 },
 {
  "id": "2F8000_1304.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "……あなた、 / 「ソニアの街」からお手紙がきてるわよ。",
  "en": ""
 },
 {
  "id": "2F8000_1304.1",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "手紙……いったいだれからだろ？",
  "en": ""
 },
 {
  "id": "2F8000_133A.0",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 3,
  "jp": "やだ、ソニアの街って言ったら / バーンが住んでいる街じゃない…… / この間、引越しの案内をもらったでしょ？",
  "en": ""
 },
 {
  "id": "2F8000_1373.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "バーンかあ……懐かしい名前だな。",
  "en": ""
 },
 {
  "id": "2F8000_138F.0",
  "speaker": "",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2F8000_138F.1",
  "speaker": "カケル、１５歳",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2F8000_1398.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルよ……バーンの名前は知ってるな？",
  "en": ""
 },
 {
  "id": "2F8000_13B0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん、お父さん…… / バーンおじさんの話は何度も聞いてるよ。",
  "en": ""
 },
 {
  "id": "2F8000_13B0.1",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そのバーンおじさんから手紙がきた。",
  "en": ""
 },
 {
  "id": "2F8000_13EB.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "悪いやつが「ドラゴンナイト一族」だと名乗り、 / 街を占領し、悪事の限りをつくしているそうだ。",
  "en": ""
 },
 {
  "id": "2F8000_1420.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "悪いやつは退治しないといけないよ…… / そうだよね、お父さん。",
  "en": ""
 },
 {
  "id": "2F8000_1420.1",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "バーンも同じことを書いている……",
  "en": ""
 },
 {
  "id": "2F8000_145B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "悪いやつを退治するために / 手伝ってくれと書いてあるんだ。",
  "en": ""
 },
 {
  "id": "2F8000_147E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うわあ、お父さん…… / また冒険の旅に出かけるんだね！！",
  "en": ""
 },
 {
  "id": "2F8000_147E.1",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、お前がバーンのところに行くんだ。",
  "en": ""
 },
 {
  "id": "2F8000_14B8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "お父さんもいっしょに行くんでしょ？",
  "en": ""
 },
 {
  "id": "2F8000_14CD.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいや、私は行かない。",
  "en": ""
 },
 {
  "id": "2F8000_14DE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕ひとりで行くの？",
  "en": ""
 },
 {
  "id": "2F8000_14EB.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "私がお前ぐらいの歳の時、 / すでにひとりで旅をしたもんだ…… / お前は私の息子だ、強くならなくてはならない。",
  "en": ""
 },
 {
  "id": "2F8000_1526.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "わーい！！　僕もお父さんみたいに / 冒険ができるんだ、うれしいなっ！！",
  "en": ""
 },
 {
  "id": "2F8000_1526.1",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ひとりで行くのが恐いのはわかる…… / 不安な気持ちで一杯だろう。",
  "en": ""
 },
 {
  "id": "2F8000_1526.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わーい、わーい！！",
  "en": ""
 },
 {
  "id": "2F8000_1582.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "でもお父さんは行かないぞ…… / そう、お前ひとりで行くのだ。",
  "en": ""
 },
 {
  "id": "2F8000_1582.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえねえお父さん、明日すぐに行ってもいい？",
  "en": ""
 },
 {
  "id": "2F8000_15BF.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前が泣いて頼んでも、私は行かないぞ…… / 私は強い父親なのだ。",
  "en": ""
 },
 {
  "id": "2F8000_15BF.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 5,
  "jp": "わくわく、わくわく……お父さん、 / 冒険に出かける時ってなにを持って行けばいい？ / そうだ、お願いがあるんだ…… / お父さんが使っていた剣を / 持っていってもいいでしょ？",
  "en": ""
 },
 {
  "id": "2F8000_15BF.2",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "……持っていっていいって / ……お前のうしろにある剣はなんだ？",
  "en": ""
 },
 {
  "id": "2F8000_15BF.3",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あはははは……バレた？",
  "en": ""
 },
 {
  "id": "2F8000_1673.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……全然不安そうじゃないな。",
  "en": ""
 },
 {
  "id": "2F8000_168A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "全然不安なんかないよ……",
  "en": ""
 },
 {
  "id": "2F8000_169E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "だってお父さんが冒険してた時とちがって、 / モンスターもいないし。",
  "en": ""
 },
 {
  "id": "2F8000_16C3.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "たしかにモンスターはいないが、 / 悪い人間に襲われるかもしれないぞ。",
  "en": ""
 },
 {
  "id": "2F8000_16C3.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うわあ、楽しみだなあ！！ / どんなやつかなあ！？",
  "en": ""
 },
 {
  "id": "2F8000_16C3.2",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "その悪いやつが、 / 剣を振り回すかもしれないんだぞ。",
  "en": ""
 },
 {
  "id": "2F8000_16C3.3",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わくわくするなあ！！",
  "en": ""
 },
 {
  "id": "2F8000_1736.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "き、斬られると……痛いぞう。",
  "en": ""
 },
 {
  "id": "2F8000_174C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "す、すごいなあ！！ / ねえねえ、明日の朝出かけてもいいでしょう！？",
  "en": ""
 },
 {
  "id": "2F8000_174C.1",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "ち、ちょっと待て、 / 冒険に出るには準備が必要なんだぞ…… / 干し肉やらなんやら用意しないといけないしな。",
  "en": ""
 },
 {
  "id": "2F8000_17B5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "お父さん、大丈夫だよ！！ / お腹がすいたら木の実でも食べるから！！",
  "en": ""
 },
 {
  "id": "2F8000_17B5.1",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "でも……まだお母さんに話をしてないしな。",
  "en": ""
 },
 {
  "id": "2F8000_17F8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "楽しみだなあ！！　わくわくするなあ！！",
  "en": ""
 },
 {
  "id": "2F8000_180E.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2F8000_1816.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "どきどきどき、わくわくわく…… / 明日出かけたいなあ。",
  "en": ""
 },
 {
  "id": "2F8000_1816.1",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "とにかく今日はもう寝なさい…… / 話は明日にしよう。",
  "en": ""
 },
 {
  "id": "2F8000_185A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "そして数日後……。",
  "en": ""
 },
 {
  "id": "2F8000_1869.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "なんとかルナを説得したタケルは、 / ルナと共にカケルを冒険の旅ヘと / 送り出すのであった。",
  "en": ""
 },
 {
  "id": "2F8000_1869.1",
  "speaker": "ルナ",
  "form": "dlg",
  "nlines": 4,
  "jp": "カケルちゃーん！！ / 気をつけて行くんですよ！！ / ……恐い目に会ったら、 / すぐに戻るんですよお！！",
  "en": ""
 },
 {
  "id": "2F8000_18D2.0",
  "speaker": "タケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "あいつは俺以上の大物かも知れない…… / そう思わないか、ルナ？",
  "en": ""
 },
 {
  "id": "2F8000_18D2.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ずんちゃ、ずんちゃ……行ってきまーす！！",
  "en": ""
 },
 {
  "id": "2F8000_1919.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "あれれ、ナターシャじゃないか…… / ずいぶんと早起きだね。",
  "en": ""
 },
 {
  "id": "2F8000_1919.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふん……。",
  "en": ""
 },
 {
  "id": "2F8000_193E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれれ……もしかして見送りにきてくれたの！？",
  "en": ""
 },
 {
  "id": "2F8000_195C.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "じ、冗談じゃないわ…… / 偶然、ここで考えごとをしてただけ。",
  "en": ""
 },
 {
  "id": "2F8000_195C.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "こんなに朝早くに？",
  "en": ""
 },
 {
  "id": "2F8000_1991.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うるさいわねえ……。",
  "en": ""
 },
 {
  "id": "2F8000_19A1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕がいなくなると、さびしいでしょ？",
  "en": ""
 },
 {
  "id": "2F8000_19B6.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふ、ふん！！　だれがさびしくなるのよっ！！",
  "en": ""
 },
 {
  "id": "2F8000_19D1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだね、僕がいなくてもさびしくないよね。",
  "en": ""
 },
 {
  "id": "2F8000_19EB.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルなんて、どっかに行っちゃえばいいんだわ / ……いじわるされないですむし。",
  "en": ""
 },
 {
  "id": "2F8000_19EB.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ははは……よかったねナターシャ。",
  "en": ""
 },
 {
  "id": "2F8000_1A29.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2F8000_1A31.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ばいばい、ナターシャ！！",
  "en": ""
 },
 {
  "id": "2F8000_1A40.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ばいばいって……も、もう行っちゃうの！？",
  "en": ""
 },
 {
  "id": "2F8000_1A5A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ずんちゃ、ずんちゃ……。",
  "en": ""
 },
 {
  "id": "2F8000_1A6B.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルっ……こ、これを持っていきなさいよ。",
  "en": ""
 },
 {
  "id": "2F8000_1A85.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……なに、これ？",
  "en": ""
 },
 {
  "id": "2F8000_1A93.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私が作った不幸のお守りよ。",
  "en": ""
 },
 {
  "id": "2F8000_1AA8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふ、不幸のお守りぃ！？",
  "en": ""
 },
 {
  "id": "2F8000_1ABC.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そう、不幸のお守り……。",
  "en": ""
 },
 {
  "id": "2F8000_1AD1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふーん。",
  "en": ""
 },
 {
  "id": "2F8000_1ADA.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なによ……。",
  "en": ""
 },
 {
  "id": "2F8000_1AE7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ありがとう、せっかくだからもらっておくよ。 / 元気でね、ナターシャ！！",
  "en": ""
 },
 {
  "id": "2F8000_1AE7.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……。",
  "en": ""
 },
 {
  "id": "2F8000_1B1B.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 1,
  "jp": "おひさしゅうございます、ルシフォン様……。",
  "en": ""
 },
 {
  "id": "2F8000_1B33.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "リディアか……うむ。",
  "en": ""
 },
 {
  "id": "2F8000_1B45.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "これより再び、 / 私のために……そしてマノのために / 我が力となるのだ……よいな。",
  "en": ""
 },
 {
  "id": "2F8000_1B45.1",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 1,
  "jp": "……はい。",
  "en": ""
 },
 {
  "id": "2F8000_1B7C.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "おまかせください。",
  "en": ""
 },
 {
  "id": "2F8000_1B8B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "我が力、我が命、 / すべてルシフォン様とマノ様のもの。",
  "en": ""
 },
 {
  "id": "2F8000_1BA6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "どのようなご命令でも、 / 必ずや成功させてみせましょう。",
  "en": ""
 },
 {
  "id": "2F8000_1BC9.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 1,
  "jp": "少し口をつつしみなさい。",
  "en": ""
 },
 {
  "id": "2F8000_1BDC.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "調子にのって口数を多くする戦士は / あまりに下品……。",
  "en": ""
 },
 {
  "id": "2F8000_1BFF.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なんだと！？",
  "en": ""
 },
 {
  "id": "2F8000_1C0D.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "フフ……まぁよい。",
  "en": ""
 },
 {
  "id": "2F8000_1C1C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "我らが目的はタケルの抹殺だ。 / わざわざ私が手をくだすまでもあるまい。",
  "en": ""
 },
 {
  "id": "2F8000_1C44.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 4,
  "jp": "相手はたかだか人間１匹。 / お前たちのやりたいようにやるがよい。 / 【リディア＆ハーディス】 / はっ！！",
  "en": ""
 }
]
