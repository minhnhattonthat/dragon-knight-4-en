 },
 {
  "id": "2C315D_18A3.2",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "逃げてきたのではない。 / 人聞きの悪いことを言うな。",
  "en": ""
 },
 {
  "id": "2C315D_18A3.3",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 4,
  "jp": "そんなことより、ルシフォンの軍隊を / やっつけるなんてたいしたもんだ。 / よーし、この訓練所に登録している / とびきりの戦士を紹介してやろう。",
  "en": ""
 },
 {
  "id": "2C315D_1950.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 4,
  "jp": "……とはいっても、 / この街の連中はほとんど残ってないけどな。 / この訓練所に登録してるのは、 / 他の街から流れてきたやつばかりなんだ。",
  "en": "",
  "dup": "2EBA5F_107D.0"
 },
 {
  "id": "2C315D_199C.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 3,
  "jp": "ひとりはシーボーズの港街から、 / そしてもうひとりは…… / ええと、どこの出身だったかな？",
  "en": "",
  "dup": "2EBA5F_10C9.0"
 },
 {
  "id": "2C315D_19C8.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "まあいい、とにかく選んでくれ……",
  "en": "",
  "dup": "2EBA5F_10F5.0"
 },
 {
  "id": "2C315D_19DE.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "知ってると思うが、 / 選べるのはひとつの部隊だけだぜ。",
  "en": ""
 },
 {
  "id": "2C315D_1A03.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "よう、またきたんだな…… / 今度こそちゃんと選んでくれよ。",
  "en": "",
  "dup": "2EBA5F_1130.0"
 },
