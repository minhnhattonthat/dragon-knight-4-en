[
 {
  "id": "2C315D_0096.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、ここで解散！！",
  "en": "",
  "dup": "2F9C88_0067.0"
 },
 {
  "id": "2C315D_00AE.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……僕、もういやだよ。",
  "en": ""
 },
 {
  "id": "2C315D_00C1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "なにがだ？",
  "en": ""
 },
 {
  "id": "2C315D_00CC.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕はカケルみたいに能天気じゃないから、 / 闘うことを楽しむなんてことはできないんだ。",
  "en": ""
 },
 {
  "id": "2C315D_0102.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 3,
  "jp": "ナターシャってカケルの幼剛染みなんでしょ？ / かわいい女の子だね。 / うらやましいなあ。",
  "en": ""
 },
 {
  "id": "2C315D_012D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "心配することはない……セイルだって、 / そのうちに素敵な彼女ができるさ。",
  "en": ""
 },
 {
  "id": "2C315D_012D.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕に彼女ができる？ / ……そんなことはありえないと思うけど。",
  "en": ""
 },
 {
  "id": "2C315D_0180.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト、この街を出たら…… / また闘わないといけないんだね。",
  "en": ""
 },
 {
  "id": "2C315D_01A2.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "いい天気だね。 / 空を見てると、ミネルバ大陸を思い出すんだ。",
  "en": ""
 },
 {
  "id": "2C315D_01D6.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……またひとりで行こうとしてるのか？",
  "en": ""
 },
 {
  "id": "2C315D_01EE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ち、ちがうよ。外の様子を見てただけだい。",
  "en": ""
 },
 {
  "id": "2C315D_022B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "こらこら、 / こんなところでおしっこをしたらだめだぞ。",
  "en": ""
 },
 {
  "id": "2C315D_022B.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふう、すっきりした。",
  "en": ""
 },
 {
  "id": "2C315D_026B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "我ながら行儀の悪いやつだな。",
  "en": ""
 },
 {
  "id": "2C315D_0282.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん……よく聞こえないなあ……。",
  "en": ""
 },
 {
  "id": "2C315D_0295.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あのエトって人……かっこいいわね。",
  "en": "",
  "dup": "2EBA5F_02AB.0"
 },
 {
  "id": "2C315D_02AC.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 4,
  "jp": "あんな人が彼氏だったら、 / どんなにいいかしら…… / 平和な世の中に戻ったら、 / 思い切って告白してみようかな？",
  "en": "",
  "dup": "2EBA5F_02C2.0"
 },
 {
  "id": "2C315D_02EE.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 3,
  "jp": "でもあのナターシャとかいう女、 / 気になるわあ…… / あの子、私と同じくらいかわいいし。",
  "en": "",
  "dup": "2EBA5F_0304.0"
 },
 {
  "id": "2C315D_031D.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "でも、私の方が色気はあると思うし…… / うん、きっと心配することないわね。",
  "en": ""
 },
 {
  "id": "2C315D_031D.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2C315D_0350.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか……人の気配がするような？",
  "en": ""
 },
 {
  "id": "2C315D_0377.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルのやつは、慌てて逃げて行ったな…… / 我ながら情けないやつだ。",
  "en": ""
 },
 {
  "id": "2C315D_03A6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……退屈だなあ。",
  "en": ""
 },
 {
  "id": "2C315D_03B7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "もう少しの我慢だ。 / 明日の朝になったら、この街を出発するぞ。",
  "en": ""
 },
 {
  "id": "2C315D_03B7.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "明日の朝かあ……長いなあ。",
  "en": ""
 },
 {
  "id": "2C315D_03F5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "早くルシフォン軍と闘いたいな……。",
  "en": ""
 },
 {
  "id": "2C315D_0407.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "おはよう、カケル。 / そろそろ出発するぞ。",
  "en": ""
 },
 {
  "id": "2C315D_0407.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2C315D_0426.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "どうした？ / ずいぶん機嫌が悪いじゃないか。",
  "en": ""
 },
 {
  "id": "2C315D_0426.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんでもないよ……エト。",
  "en": ""
 },
 {
  "id": "2C315D_044E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、準備はいいか？",
  "en": ""
 },
 {
  "id": "2C315D_0460.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2C315D_046E.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……こんにちは。",
  "en": ""
 },
 {
  "id": "2C315D_047D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ、エトでいい。",
  "en": ""
 },
 {
  "id": "2C315D_048C.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあエト、こんにちは……いい天気ね。",
  "en": ""
 },
 {
  "id": "2C315D_04A3.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだな、とてもいい天気だ。",
  "en": ""
 },
 {
  "id": "2C315D_04B8.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの……カケルとは……いつ知り合ったの？",
  "en": ""
 },
 {
  "id": "2C315D_04D1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "レイモンド王国が黒い霧に包まれた時だよ……",
  "en": ""
 },
 {
  "id": "2C315D_04E7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルとセイルは、逃げようとせずに / 街の出口で立ちつくしてたんだ。",
  "en": ""
 },
 {
  "id": "2C315D_050A.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "それを……あなたが助けた？",
  "en": ""
 },
 {
  "id": "2C315D_051D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいや、助けたっていうか……",
  "en": ""
 },
 {
  "id": "2C315D_0531.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "やつらは呆然自失状態だったからね、 / 私はただ彼らの手を引っ張っただけだ。",
  "en": ""
 },
 {
  "id": "2C315D_0560.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ありがとう……あなたはカケルの命の恩人ね。",
  "en": ""
 },
 {
  "id": "2C315D_057B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "（自分で自分を助けても…… / 命の恩人って言うのかな？）",
  "en": ""
 },
 {
  "id": "2C315D_057B.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 3,
  "jp": "カケルが石になってたら、 / なんでミネルバ大陸を出たのか / わからなくなるところだったわ。",
  "en": ""
 },
 {
  "id": "2C315D_05D1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ナターシャは、 / どうしてレイモンド大陸にきたんだい？",
  "en": ""
 },
 {
  "id": "2C315D_05D1.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "どうしてなのかしら？ / ……自分でもよくわからないの。",
  "en": ""
 },
 {
  "id": "2C315D_060D.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……あのね。",
  "en": ""
 },
 {
  "id": "2C315D_061A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだい？",
  "en": ""
 },
 {
  "id": "2C315D_0625.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、ううん……なんでもないの。",
  "en": ""
 },
 {
  "id": "2C315D_063A.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルは……どこにいるのかしら？",
  "en": ""
 },
 {
  "id": "2C315D_064E.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、昨日は相談にのってくれてありがとう。",
  "en": ""
 },
 {
  "id": "2C315D_066B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おやすい御用さ。",
  "en": ""
 },
 {
  "id": "2C315D_067B.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "でもね……今朝カケルと話したんだけど、 / よそよそしいのよ、なんか。",
  "en": ""
 },
 {
  "id": "2C315D_067B.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "き、気のせいじゃないか？",
  "en": ""
 },
 {
  "id": "2C315D_06B2.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうかしら……。",
  "en": ""
 },
 {
  "id": "2C315D_06BE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "大丈夫、カケルはナターシャが好きだよ……",
  "en": ""
 },
 {
  "id": "2C315D_06D3.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は男だから、 / カケルの気持ちがよくわかるんだ。",
  "en": ""
 },
 {
  "id": "2C315D_06EE.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルのことを考えると……胸が痛くなるの。",
  "en": ""
 },
 {
  "id": "2C315D_070A.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……出発するんでしょう？",
  "en": ""
 },
 {
  "id": "2C315D_0722.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "考えごとをしているようだ。",
  "en": ""
 },
 {
  "id": "2C315D_0738.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "立ち聞きしますか？",
  "en": ""
 },
 {
  "id": "2C315D_0744.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "もちろんする / ",
  "en": ""
 },
 {
  "id": "2C315D_074F.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "そんなことはしない",
  "en": ""
 },
 {
  "id": "2C315D_0765.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 4,
  "jp": "身体が熱い。 / きっと緊張してるのね。 / ルシフォン軍と闘ったの初めてだし、 / それに……ぽっ。",
  "en": ""
 },
 {
  "id": "2C315D_079C.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "そう、恋をするのも初めてだわ……",
  "en": ""
 },
 {
  "id": "2C315D_07B4.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさんの闘ってる姿を見て、 / 一目惚れしてしまったの。",
  "en": ""
 },
 {
  "id": "2C315D_07D5.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ、エトさんのことを考えると……ぽっ。",
  "en": ""
 },
 {
  "id": "2C315D_07F0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（……そろそろ他の場所に行くか。）",
  "en": ""
 },
 {
  "id": "2C315D_0809.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はカケルではない。 / 大人なのだ。",
  "en": ""
 },
 {
  "id": "2C315D_0809.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "大人は、そんな恥知らずなことはしない。",
  "en": ""
 },
 {
  "id": "2C315D_083F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（……まだやっているのか？）",
  "en": ""
 },
 {
  "id": "2C315D_0852.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ、エトさん……好き……。",
  "en": ""
 },
 {
  "id": "2C315D_0865.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（他の場所に行った方がよさそうだな）",
  "en": ""
 },
 {
  "id": "2C315D_087D.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "エ、エトさん。 / おはようございます。",
  "en": ""
 },
 {
  "id": "2C315D_087D.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはようネレイド……そろそろ出発するぞ。",
  "en": ""
 },
 {
  "id": "2C315D_08AC.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "は、はい！",
  "en": ""
 },
 {
  "id": "2C315D_08B7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさんが行くところだったら、 / どこにでも行きます。",
  "en": ""
 },
 {
  "id": "2C315D_08D5.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……私、がんばりますっ。",
  "en": ""
 },
 {
  "id": "2C315D_08EB.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちくしょうっっ……街を解放したのはいいが、 / 住んでるやつらがほとんどいないじゃねーか。",
  "en": "",
  "dup": "2EBA5F_038B.0"
 },
 {
  "id": "2C315D_091C.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "とっとと出発しようぜ。",
  "en": "",
  "dup": "2EBA5F_03BC.0"
 },
 {
  "id": "2C315D_092D.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト殿、カケル殿のことで相談があるのだが。",
  "en": ""
 },
 {
  "id": "2C315D_0948.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "またあいつ、なにかしでかしたのか？",
  "en": ""
 },
 {
  "id": "2C315D_095F.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いや、ちがうのだ。",
  "en": ""
 },
 {
  "id": "2C315D_0970.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "プライベートなことなので、 / ちと言いにくいのだが。",
  "en": ""
 },
 {
  "id": "2C315D_098F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カロン、私たちは仲間ではないか。 / なんでも相談してくれ。",
  "en": ""
 },
 {
  "id": "2C315D_098F.1",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……カケル殿には彼氏はいるのだろうか？",
  "en": ""
 },
 {
  "id": "2C315D_09CA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルに彼氏がいるかって！？",
  "en": ""
 },
 {
  "id": "2C315D_09DE.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "こ、答えてくれ。 / カケル殿に彼氏はいるのか？",
  "en": ""
 },
 {
  "id": "2C315D_09DE.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あいつは男だから、彼氏がいるわけないだろ？",
  "en": ""
 },
 {
  "id": "2C315D_0A17.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "……そ、そうか。 / 彼氏はいないのだな。",
  "en": ""
 },
 {
  "id": "2C315D_0A32.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト殿、この街の東には……。",
  "en": ""
 },
 {
  "id": "2C315D_0A43.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……トリアノンという村があるんだろ？",
  "en": ""
 },
 {
  "id": "2C315D_0A56.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "むう、くわしいではないか……そのとおりだ。",
  "en": ""
 },
 {
  "id": "2C315D_0A71.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "（忘れるものか。トリアノンの村で、 / マルレーネと知り合うはずなのだから）",
  "en": ""
 },
 {
  "id": "2C315D_0A93.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト殿、カケル殿は……いいな。",
  "en": ""
 },
 {
  "id": "2C315D_0AB3.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "なによ……私に用があるの？",
  "en": ""
 },
 {
  "id": "2C315D_0AC7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "こんなところにひとりでいると、 / ルシフォン軍がくるぞ。",
  "en": ""
 },
 {
  "id": "2C315D_0AC7.1",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "くるわけないじゃない。",
  "en": ""
 },
 {
  "id": "2C315D_0AF1.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はあなたとくだらない話をしてる / ヒマはないのよ。",
  "en": ""
 },
 {
  "id": "2C315D_0B15.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "しつこいわね。 / あんただれなの？",
  "en": ""
 },
 {
  "id": "2C315D_0B15.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "名前はエト。 / 顔に似合ったいい名前だろ？",
  "en": ""
 },
 {
  "id": "2C315D_0B15.2",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "顔は兜で見えないじゃない。 / あなた、ラビニアの出身なの？",
  "en": ""
 },
 {
  "id": "2C315D_0B15.3",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "まぁ、どこでもかまわないじゃないか。",
  "en": ""
 },
 {
  "id": "2C315D_0B7A.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 3,
  "jp": "あやしいわね……まぁ、どっちでもいいわ。 / 私はあなたと漫才をしてるヒマはないの。 / 私は軟弱な男は大嫌いなんだからね。",
  "en": ""
 },
 {
  "id": "2C315D_0BC1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネプチューンは強い男が好きなんだな。",
  "en": ""
 },
 {
  "id": "2C315D_0BD5.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 4,
  "jp": "あのね、私はこの街に男友だちを / 見つけにきたんじゃないのよ。 / そんなことのために、 / わざわざシーボーズの港街からこないわ。",
  "en": "",
  "dup": "2EBA5F_0610.1"
 },
 {
  "id": "2C315D_0C0D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "シーボーズの港街…… / というと、トリアノンの村の東にある街だな。",
  "en": ""
 },
 {
  "id": "2C315D_0C0D.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "たしかドン・カポネとかいう男が / 仕切っていた港街だ。 / しかし今では、ルシフォン軍に / なにもかも奪われている。",
  "en": ""
 },
 {
  "id": "2C315D_0C6A.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ず、ずいぶんくわしいじゃない……。",
  "en": ""
 },
 {
  "id": "2C315D_0C7E.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 4,
  "jp": "シーボーズの港街は、 / ルシフォンの軍隊が制圧してるわよ。 / 私、あいつら大っ嫌いだから、 / 西に逃げてきたの。",
  "en": ""
 },
 {
  "id": "2C315D_0CB6.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私だって大嫌いだぞ。",
  "en": ""
 },
 {
  "id": "2C315D_0CC6.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "あなたと話をしてると、調子が狂うわ。 / お願いだからあっちに行って。",
  "en": ""
 },
 {
  "id": "2C315D_0CF2.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネ、ネプチューンじゃないか！　元気か！！",
  "en": ""
 },
 {
  "id": "2C315D_0D07.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "あ、あんただれよ？ / どうして私の名前を知っているの？",
  "en": ""
 },
 {
  "id": "2C315D_0D07.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……胸に名札がついてるぞ。",
  "en": ""
 },
 {
  "id": "2C315D_0D3C.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "幼稚園じゃあるまいし…… / 名札なんかついてるわけがないじゃない。",
  "en": ""
 },
 {
  "id": "2C315D_0D3C.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "今日はいい天気だな。 / 美しいお嬢さん。",
  "en": ""
 },
 {
  "id": "2C315D_0D3C.2",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "わざとらしいわね、なにがお嬢さんよ…… / 私の名前はネプチューンって知ってるんでしょ？",
  "en": ""
 },
 {
  "id": "2C315D_0D3C.3",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "わっはっはっ、いい名前だな。 / そうかあ、ネプチューンか。",
  "en": ""
 },
 {
  "id": "2C315D_0D3C.4",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "額に汗かいて、なにを言ってるのよ。",
  "en": ""
 },
 {
  "id": "2C315D_0DE2.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わっはっはっ……は。",
  "en": ""
 },
 {
  "id": "2C315D_0DF2.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "あんた……何者なの？",
  "en": ""
 },
 {
  "id": "2C315D_0E05.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネプチューンをごまかしますか？",
  "en": ""
 },
 {
  "id": "2C315D_0E12.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "くどいてごまかす / ",
  "en": ""
 },
 {
  "id": "2C315D_0E1F.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "意味もなく笑う",
  "en": ""
 },
 {
  "id": "2C315D_0E34.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "好きだ。",
  "en": ""
 },
 {
  "id": "2C315D_0E3E.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "え！？",
  "en": ""
 },
 {
  "id": "2C315D_0E47.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "好きだ。",
  "en": "",
  "dup": "2C315D_0E34.0"
 },
 {
  "id": "2C315D_0E51.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "と、突然なにを言い出すのかと思ったらっ…… / あなた、馬鹿じゃないのっ！？",
  "en": ""
 },
 {
  "id": "2C315D_0E51.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "いっしょに星でも食べて、ご飯でも見よう。 / 君に一目惚れしてしまったのだ。",
  "en": ""
 },
 {
  "id": "2C315D_0E51.2",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "馬鹿を言わないで。",
  "en": ""
 },
 {
  "id": "2C315D_0EBB.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "平和な時ならまだしも…… / こんな荒れた時代によくそんなことが言えるわ。",
  "en": ""
 },
 {
  "id": "2C315D_0EE5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は楽天家なのだ。",
  "en": ""
 },
 {
  "id": "2C315D_0EF7.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "この街にはマシなやつがいないのかしら。",
  "en": ""
 },
 {
  "id": "2C315D_0F10.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わ～～～はっはっはっはっはっはっ！！",
  "en": ""
 },
 {
  "id": "2C315D_0F2B.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "気味が悪いわねぇ。 / 意味もなく笑わないでよ。",
  "en": ""
 },
 {
  "id": "2C315D_0F4E.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ、だれか私を仲間にしてくれないかしら。",
  "en": ""
 },
 {
  "id": "2C315D_0F68.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "私を仲間にしてくれるのはいいけどさ…… / 変なことをしたら承知しないからね。",
  "en": ""
 },
 {
  "id": "2C315D_0F91.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "私がここにいることをカケルから聞いたの？",
  "en": ""
 },
 {
  "id": "2C315D_0FB0.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さあ、いらっしゃい！！",
  "en": "",
  "dup": "2EBA5F_086D.0"
 },
 {
  "id": "2C315D_0FC1.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……ここにあるバナナは、 / ただのバナナとはちょっとちがうよ！！",
  "en": "",
  "dup": "2EBA5F_087E.0"
 },
 {
  "id": "2C315D_0FE0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "こんな時に、よくバナナなんか売ってるなあ。",
  "en": ""
 },
 {
  "id": "2C315D_0FFA.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 4,
  "jp": "ふっふっふっ、 / 俺をただのバナナ売りだと思うなよ…… / 俺はこれでも、訓練所に登録してる / 騎馬隊の隊長なんだ。",
  "en": "",
  "dup": "2EBA5F_08B7.0"
 },
 {
  "id": "2C315D_103C.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "別にバナナが好きなわけじゃないぞ……",
  "en": "",
  "dup": "2EBA5F_08F9.0"
 },
 {
  "id": "2C315D_1051.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "部下を義うために、 / 仕方なくこんなことをしてるんだ。",
  "en": "",
  "dup": "2EBA5F_090E.0"
 },
 {
  "id": "2C315D_1079.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだよ、またお前か……。",
  "en": ""
 },
 {
  "id": "2C315D_108B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おいしそうなバナナだな。",
  "en": ""
 },
 {
  "id": "2C315D_109C.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 3,
  "jp": "このバナナのことを誉めてくれたのは / あんたが初めてだ。 / うれしくって辛抱たまらんぜ。",
  "en": ""
 },
 {
  "id": "2C315D_10D1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "やっぱりバナナが好きなんじゃないか。 / 正直に言えよ。",
  "en": ""
 },
 {
  "id": "2C315D_10F7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ゴロンゴンは、バナナが好きなんだろ？",
  "en": ""
 },
 {
  "id": "2C315D_1109.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そう、私はバナナが好きさ……大好きだよ。",
  "en": ""
 },
 {
  "id": "2C315D_1122.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もぐもぐもぐ…… / よう、俺を仲間に入れてくれたんだって？",
  "en": "",
  "dup": "2EBA5F_094E.0"
 },
 {
  "id": "2C315D_1122.1",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ひとつだけお願いがあるんだ…… / バナナ、持っていってもいいだろ？",
  "en": "",
  "dup": "2EBA5F_094E.1"
 },
 {
  "id": "2C315D_1122.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "いいとも、 / いくらでも持てるだけ持っていくといい。",
  "en": ""
 },
 {
  "id": "2C315D_1122.3",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ヘえ、話のわかるやつだな……気に入ったぜ。",
  "en": ""
 },
 {
  "id": "2C315D_119F.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もぐもぐもぐ…… / 東にはトリアノンって村があるそうだ。",
  "en": "",
  "dup": "2EBA5F_0992.0"
 },
 {
  "id": "2C315D_119F.1",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そこにもルシフォンの軍隊がいるそうだ…… / もぐもぐもぐ。",
  "en": "",
  "dup": "2EBA5F_0992.1"
 },
 {
  "id": "2C315D_11D4.0",
  "speaker": "フォラガナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "むう……君たちかね、この街を / ルシフォンの軍隊から解放してくれたのは？",
  "en": "",
  "dup": "2EBA5F_09C7.0"
 },
 {
  "id": "2C315D_11D4.1",
  "speaker": "フォラガナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちと遅かったようじゃなあ……見てのとおり、 / 残された住民はごくわずかじゃよ。",
  "en": "",
  "dup": "2EBA5F_09C7.1"
 },
 {
  "id": "2C315D_11D4.2",
  "speaker": "フォラガナ",
  "form": "dlg",
  "nlines": 4,
  "jp": "西からは黒い霧とやらが、 / 東にはルシフォンの軍勢が迫っているんじゃ。 / そして空を見上げれば / 悪しきドラゴンが飛んでおる。",
  "en": "",
  "dup": "2EBA5F_09C7.2"
 },
 {
  "id": "2C315D_126D.0",
  "speaker": "フォラガナ",
  "form": "dlg",
  "nlines": 3,
  "jp": "商人から聞いた話では、タケル様とバーン様も / 黒い霧に包まれたというではないかね……。 / あのおふたりがいなかったらどうにもならんよ。",
  "en": "",
  "dup": "2EBA5F_0A60.0"
 },
 {
  "id": "2C315D_12B6.0",
  "speaker": "フォラガナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前さんたち、東に行くんじゃろう？",
  "en": "",
  "dup": "2EBA5F_0AA9.0"
 },
 {
  "id": "2C315D_12CD.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "東にはトリアノンという村があるが、 / そこに住んでいるエルフ一族は / 皆殺しにされたってうわさじゃ。",
  "en": "",
  "dup": "2EBA5F_0AC0.0"
 },
 {
  "id": "2C315D_12CD.1",
  "speaker": "フォラガナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "今までが平和すぎたんじゃ……",
  "en": "",
  "dup": "2EBA5F_0AC0.1"
 },
 {
  "id": "2C315D_1316.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ワシの若いころはみんな剣術の修業に / 明け暮れていたからの。",
  "en": ""
 },
 {
  "id": "2C315D_133F.0",
  "speaker": "フォラガナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "まあ、愚痴を言ってもはじまらん。",
  "en": "",
  "dup": "2EBA5F_0B32.0"
 },
 {
  "id": "2C315D_1357.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "なにもない街となってしまったが、 / 自由につかってよいぞ。",
  "en": ""
 },
 {
  "id": "2C315D_1378.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうせこの街も黒い霧に包まれる運命じゃ。",
  "en": ""
 },
 {
  "id": "2C315D_1390.0",
  "speaker": "フォラガナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ワシが若かったら……。",
  "en": "",
  "dup": "2EBA5F_0B82.0"
 },
 {
  "id": "2C315D_13A3.0",
  "speaker": "フォラガナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "いや、もう考えまい……これも運命じゃな。",
  "en": "",
  "dup": "2EBA5F_0B95.0"
 },
 {
  "id": "2C315D_13CE.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、こんにちは。",
  "en": ""
 },
 {
  "id": "2C315D_13D9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、ロイドン……ひさしぶりだね。",
  "en": "",
  "dup": "2CA4C9_0FB5.0"
 },
 {
  "id": "2C315D_13EC.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ひさしぶり！？",
  "en": "",
  "dup": "2CA4C9_0FC8.0"
 },
 {
  "id": "2C315D_13F9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……い、いや。",
  "en": "",
  "dup": "2CA4C9_0FD5.0"
 },
 {
  "id": "2C315D_1407.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして……僕の名前を知ってるんだい？",
  "en": "",
  "dup": "2CA4C9_0FE3.0"
 },
 {
  "id": "2C315D_1420.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "えーと……カ、カケルから聞いたんだ。",
  "en": "",
  "dup": "2CA4C9_0FFC.0"
 },
 {
  "id": "2C315D_1435.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "なーんだ、そうだったのかい。",
  "en": "",
  "dup": "2CA4C9_1011.0"
 },
 {
  "id": "2C315D_1449.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル君には、さっき色々と / 話をしてもらったんだ。",
  "en": "",
  "dup": "2CA4C9_1025.0"
 },
 {
  "id": "2C315D_1463.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "彼は『ヤマト・タケル』の息子なんだよね。 / 彼の話はなかなか面白かったよ。",
  "en": "",
  "dup": "2CA4C9_103F.0"
 },
 {
  "id": "2C315D_1463.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、ああ、やつは話をするのが好きだからな。",
  "en": "",
  "dup": "2CA4C9_103F.1"
 },
 {
  "id": "2C315D_14AD.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕は冒険小説家になりたいんだよ。",
  "en": ""
 },
 {
  "id": "2C315D_14C4.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "レイモンド王国で起こったことを / 忘れないようにメモして、 / いつかこのことを本にして出販するつもりさ。",
  "en": "",
  "dup": "2CA4C9_10A0.0"
 },
 {
  "id": "2C315D_14C4.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "がんばってくれ、ロイドン。",
  "en": ""
 },
 {
  "id": "2C315D_1508.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "君って……なれなれしいんだね。",
  "en": ""
 },
 {
  "id": "2C315D_151C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうか？",
  "en": ""
 },
 {
  "id": "2C315D_1528.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "まあいい、君もカケル君の仲間なんだろう？ / カケル君みたいに話を聞かせて貫えないか？",
  "en": ""
 },
 {
  "id": "2C315D_1528.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わ、私も話をするのか？",
  "en": "",
  "dup": "2CA4C9_1101.0"
 },
 {
  "id": "2C315D_1565.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "協力してくれよ…… / ほら、君の好きな色のノートに書くからさ。",
