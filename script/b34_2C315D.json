 },
 {
  "id": "2C315D_17CE.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 4,
  "jp": "言っておくがな、俺はカケルに復警するために / ここにいるんだ…… / カケルと、そのまわりにいる女ども以外には / 興味がないやいっ！！",
  "en": ""
 },
 {
  "id": "2C315D_181D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "そう言えば、ライナスも私のせいで、 / 石像になってしまったんだな。",
