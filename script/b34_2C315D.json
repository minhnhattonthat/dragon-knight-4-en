 },
 {
  "id": "2C315D_1BCC.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……やつがドラゴンナイト一族だなんて、 / わしは絶対に認めんぞっ。",
  "en": "",
  "dup": "2EBA5F_132C.0"
 },
 {
  "id": "2C315D_1BEE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "安心しろ、私だって認めない。",
  "en": ""
 },
 {
  "id": "2C315D_1C04.0",
  "speaker": "マイノックス",
  "form": "dlg",
  "nlines": 1,
  "jp": "うむ、気が合うな……若き剣士よ。",
  "en": ""
 },
 {
  "id": "2C315D_1C1B.0",
  "speaker": "マイノックス",
  "form": "dlg",
  "nlines": 4,
  "jp": "ルシフォンの軍隊のドラゴンナイトは、 / 普通の人間たちが乗っておるんぢゃ…… / なあに、 / ドラゴンのあやつり方を見ればわかるわい。",
  "en": "",
  "dup": "2EBA5F_134E.0"
 },
 {
  "id": "2C315D_1C5F.0",
  "speaker": "マイノックス",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいか、あんなシロートに負けてはいかんぞ！！",
  "en": ""
 },
 {
  "id": "2C315D_1C7E.0",
  "speaker": "マイノックス",
  "form": "dlg",
  "nlines": 4,
  "jp": "トリアノンの村の東には、 / シーボーズという港街がある。 / やつらをそこまで追い込み、 / みーんな海に落としてしまうのぢゃっ！！",
  "en": "",
  "dup": "2EBA5F_13BB.0"
 },
 {
  "id": "2C315D_1CBF.0",
  "speaker": "マイノックス",
  "form": "dlg",
  "nlines": 3,
  "jp": "ひ、ひさしぶりにしゃべったら、 / 疲れてしもうた…… / どれ、わしはもう寝ようかのう。",
  "en": ""
 },
 {
  "id": "2C315D_1CF1.0",
  "speaker": "商人カラール",
  "form": "dlg",
  "nlines": 2,
  "jp": "お、俺は見たぞ…… / ユリシーズの街に、黒い霧が迫ってきたのを！！",
  "en": "",
  "dup": "2EBA5F_142F.0"
 },
 {
  "id": "2C315D_1CF1.1",
  "speaker": "商人カラール",
  "form": "dlg",
  "nlines": 2,
  "jp": "この街にもやってくるぞお！！ / ……あの黒い霧は、悪魔の化身に決まってる！！",
  "en": "",
  "dup": "2EBA5F_142F.1"
 },
 {
  "id": "2C315D_1D3C.0",
  "speaker": "商人カラール",
  "form": "dlg",
  "nlines": 4,
  "jp": "この街に黒い霧がやってくれば、 / みーんな石になっちゃうぞお！！ / ……石になったあと、カナヅチを持った / ルシフォン軍がやってくるんだあっ！！",
  "en": "",
  "dup": "2EBA5F_147A.0"
 },
 {
  "id": "2C315D_1D85.0",
  "speaker": "商人カラール",
  "form": "dlg",
  "nlines": 4,
  "jp": "そのカナヅチで、 / 石になった俺たちを破壊するんだ…… / ひゃあああっ、俺はいやだあっ！！ / 石になんかなりたくなーいっ！！",
  "en": "",
  "dup": "2EBA5F_14C3.0"
 },
 {
  "id": "2C315D_1DD7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わっはっはっ！！　冗談だろう！？",
  "en": ""
 },
 {
  "id": "2C315D_1DEF.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はエトだ……こんな行動をしてると、 / みんなにしめしがつかないぞ。",
  "en": ""
 },
 {
  "id": "2C315D_1E2D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2C315D_1E35.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はひとりで外に出るつもりはないぞ…… / ただ外の様子をうかがっただけだ。",
  "en": ""
 },
 {
  "id": "2C315D_1E60.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2C315D_1E68.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん……どうも昔のクセが抜けきらないな。",
  "en": ""
 },
 {
  "id": "2C315D_1E83.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと……どうするかな。",
  "en": ""
 },
 {
  "id": "2C315D_1E98.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "もう寝る / ",
  "en": ""
 },
 {
  "id": "2C315D_1EA1.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "まだ寝ない",
  "en": "",
  "dup": "2E34B4_0EC9.0"
 },
 {
  "id": "2C315D_1EB5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "出発は明日の朝だ……そろそろ寝るとしよう。",
  "en": ""
 },
 {
  "id": "2C315D_1F31.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "寝られないな……。",
  "en": ""
 },
 {
  "id": "2C315D_1F3F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "散歩でもするか……ふう。",
  "en": ""
 },
 {
  "id": "2C315D_1F5B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あれれ……ナターシャだ）",
  "en": ""
 },
 {
  "id": "2C315D_1F6E.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……こんな時間にどうしたの？",
  "en": ""
 },
 {
  "id": "2C315D_1F84.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "それは私のセリフだ。",
  "en": ""
 },
 {
  "id": "2C315D_1F95.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ナターシャこそ、 / こんな時間になにをしてるんだ？",
  "en": ""
 },
 {
  "id": "2C315D_1FAE.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F8000_1A29.0"
 },
 {
  "id": "2C315D_1FB6.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "明日の朝には東に向けて出発するぞ……。",
  "en": ""
 },
 {
  "id": "2C315D_1FCE.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ええ……。",
  "en": ""
 },
 {
  "id": "2C315D_1FD8.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうした……元気がないな？",
  "en": ""
 },
 {
  "id": "2C315D_1FEB.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルって……。",
  "en": ""
 },
 {
  "id": "2C315D_1FF7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カ、カケルがどうかしたのか？",
  "en": ""
 },
 {
  "id": "2C315D_200A.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……もっと近くにきて。",
  "en": ""
 },
 {
  "id": "2C315D_201D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "え？",
  "en": ""
 },
 {
  "id": "2C315D_2025.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "あんまり大きな声で言いたくないの…… / もっと近くにきて。",
  "en": ""
 },
 {
  "id": "2C315D_2025.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "こ、こうか？",
  "en": ""
 },
 {
  "id": "2C315D_2054.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "（ナ、ナターシャをこんなに近くで見るなんて、 / 初めてだぞ。）",
  "en": ""
 },
 {
  "id": "2C315D_2054.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルって私のこと、どう思ってるのかしら？",
  "en": ""
 },
 {
  "id": "2C315D_208E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "え？",
  "en": "",
  "dup": "2C315D_201D.0"
 },
 {
  "id": "2C315D_2096.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "だからね……カケルって / 私のことをどう思ってるのかな、って。",
  "en": ""
 },
 {
  "id": "2C315D_2096.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルがナターシャのことを / どう思ってるか……うーん。",
  "en": ""
 },
 {
  "id": "2C315D_2096.2",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 4,
  "jp": "エトだから言うけど、 / 私がレイモンド大陸にきた理由は、 / 魔導師の修業なんかじゃなくって…… / カケルのあとを……追いかけてきたの。",
  "en": ""
 },
 {
  "id": "2C315D_211F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルにそのことを言えばいいじゃないか…… / あいつだって喜ぶと思うぞ。",
  "en": ""
 },
 {
  "id": "2C315D_211F.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "だ、だめよ……",
  "en": ""
 },
 {
  "id": "2C315D_2153.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "もしカケルが私のことを / 好きじゃなかったらどうするの？",
  "en": ""
 },
 {
  "id": "2C315D_2171.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 4,
  "jp": "ううん、きっと私のことなんか / 好きじゃないわ…… / だって、いっしょの街で暮らしている時も、 / いつもケンカばかりしていたんですもの。",
  "en": ""
 },
 {
  "id": "2C315D_21BA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "わっはっは！！ / 仲がいいほどケンカをするって言うだろ？",
  "en": ""
 },
 {
  "id": "2C315D_21BA.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "からかわないで、エト。 / 私は真剣なんだから。",
  "en": ""
 },
 {
  "id": "2C315D_21FA.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私ね、カケルのことが大好きなの…… / だから彼に嫌われたくない。",
  "en": ""
 },
 {
  "id": "2C315D_21FA.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルだって、きっとナターシャが好きさ。",
  "en": ""
 },
 {
  "id": "2C315D_2234.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F8000_1A29.0"
 },
 {
  "id": "2C315D_223C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お、おい……泣かないでくれよ。",
  "en": ""
 },
 {
  "id": "2C315D_2252.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（……）",
  "en": "",
  "dup": "2E0000_0894.0"
 },
 {
  "id": "2C315D_225B.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "だって……カケルのことを考えると、 / 自然に涙が出てきそうになるんだもの。",
  "en": ""
 },
 {
  "id": "2C315D_225B.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2C315D_228B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ、今日はもう寝るんだ……",
  "en": ""
 },
 {
  "id": "2C315D_229F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "疲れてる身体で闘ってケガでもしたら、 / カケルだってきっと悲しむぞ。",
  "en": ""
 },
 {
  "id": "2C315D_22C6.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ええ……エトと話してたら、 / なんだか気分が楽になっちゃった。",
  "en": ""
 },
 {
  "id": "2C315D_22C6.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私でよければ、いつでも相談にのるぞ。",
  "en": ""
 },
 {
  "id": "2C315D_2302.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ありがとうエト……おやすみなさい。",
  "en": ""
 },
 {
  "id": "2C315D_2319.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ、おやすみ……。",
  "en": ""
 },
 {
  "id": "2C315D_238C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふああぁぁぁ……気持ちのいい朝だな。",
  "en": ""
 },
 {
  "id": "2C315D_23A5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、そろそろ出発するか……",
  "en": ""
 },
 {
  "id": "2C315D_23B8.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "東にはトリアノンの村、 / つまりマルレーネと出会った村があるはずだ。",
  "en": ""
 },
 {
  "id": "2C315D_23D4.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "東に向かいますか？",
  "en": "",
  "dup": "2F9C88_1191.0"
 },
 {
  "id": "2C315D_23DF.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "はい / ",
  "en": "",
  "dup": "2F9C88_119C.0"
 },
 {
  "id": "2C315D_23E6.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "いいえ",
  "en": "",
  "dup": "2F9C88_11A3.0"
 },
 {
  "id": "2C315D_23F8.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "みんなっ！！　そろそろ出発するぞっ！！",
  "en": ""
 },
 {
  "id": "2C315D_2413.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "待ちくたびれちゃったよ、エト。",
  "en": ""
 },
 {
  "id": "2C315D_2426.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、行くぞ！！",
  "en": ""
 },
 {
  "id": "2C315D_2437.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトは力の種を２個見つけた！！",
  "en": ""
 },
 {
  "id": "2C315D_2448.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトは守りの種を２個見つけた！！",
  "en": ""
 },
 {
  "id": "2C315D_2459.0",
  "speaker": "",
  "form": "dlg",
