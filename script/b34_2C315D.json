  "dup": "2CA4C9_1112.0"
 },
 {
  "id": "2C315D_1593.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、また会ったね。",
  "en": "",
  "dup": "2F0269_0F2F.0"
 },
 {
  "id": "2C315D_15A2.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕も君たちのあとを追って、 / ラビニアの街にきたんだ。",
  "en": ""
 },
 {
  "id": "2C315D_15BB.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "またルシフォンの軍隊をやっつけたみたいだね… / よかったら、また僕に話をしてくれないか？",
  "en": "",
  "dup": "2EBA5F_0D2D.0"
 },
 {
  "id": "2C315D_15BB.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "さてと、今度は何色のノートに書くかなあ…… / エト君、何色がいい？",
  "en": ""
 },
 {
  "id": "2C315D_1615.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……今度こそ僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_079C.0"
 },
 {
  "id": "2C315D_162B.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2C315D_1634.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "2C315D_1648.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度はどのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07D0.0"
 },
 {
  "id": "2C315D_1661.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "君は何色が好きなんだい？ / 青色のノート",
