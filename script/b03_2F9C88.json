[
 {
  "id": "2F9C88_0067.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、ここで解散！！",
  "en": ""
 },
 {
  "id": "2F9C88_0079.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイル、こんなとこでなにやってんの？",
  "en": ""
 },
 {
  "id": "2F9C88_0090.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕……まだ心臓がドキドキしてるんだ。",
  "en": ""
 },
 {
  "id": "2F9C88_00A9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして？",
  "en": ""
 },
 {
  "id": "2F9C88_00B4.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルは平気なの？ / 殺されちゃうかもしれないんだよ。",
  "en": ""
 },
 {
  "id": "2F9C88_00D4.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、いつまでここにいるの？",
  "en": ""
 },
 {
  "id": "2F9C88_00EE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あまりのんびりしてられないぞ。",
  "en": ""
 },
 {
  "id": "2F9C88_0103.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "黒い霧が、この街に向かって / 動き出したそうだ。",
  "en": ""
 },
 {
  "id": "2F9C88_011B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "また東に逃げるの？",
  "en": ""
 },
 {
  "id": "2F9C88_012A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "逃げるんじゃない、 / 闘うために東に行くんだ。",
  "en": ""
 },
 {
  "id": "2F9C88_012A.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだったね……。",
  "en": ""
 },
 {
  "id": "2F9C88_0158.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちょうどいい。",
  "en": ""
 },
 {
  "id": "2F9C88_0165.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、 / いっしょに闘ってくれる仲間を集めてくれ。",
  "en": ""
 },
 {
  "id": "2F9C88_0180.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "訓練所に行けば、 / 志願してるやつがいるかも知れないぜ。",
  "en": ""
 },
 {
  "id": "2F9C88_01A5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "何度も言うが、仲間を集めてくれ。",
  "en": ""
 },
 {
  "id": "2F9C88_01BC.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "訓練所に行けば、 / 志願してるやつがいるかも知れないぜ。",
  "en": "",
  "dup": "2F9C88_0180.0"
 },
 {
  "id": "2F9C88_01DB.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、街の出口に行っててくれ。 / 俺もすぐに行くから。",
  "en": ""
 },
 {
  "id": "2F9C88_01FD.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "もう平気、すぐにでも出かけられるわ。",
  "en": ""
 },
 {
  "id": "2F9C88_021B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれれ……おねーさん、なにやってんの？",
  "en": ""
 },
 {
  "id": "2F9C88_0231.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、あの、助けてくださいっ",
  "en": ""
 },
 {
  "id": "2F9C88_0244.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……自分ではこの鎖を / 解くことができません。",
  "en": ""
 },
 {
  "id": "2F9C88_025F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあ……どうやって自分で縛ったの？",
  "en": ""
 },
 {
  "id": "2F9C88_0278.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "自分で縛ったわけではありません……",
  "en": ""
 },
 {
  "id": "2F9C88_0290.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの軍隊がやってきて、 / 私をこんな格好に。",
  "en": ""
 },
 {
  "id": "2F9C88_02AB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか悲惨だね……あははは！",
  "en": ""
 },
 {
  "id": "2F9C88_02BF.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あははは、じゃなくて……助けてください。",
  "en": ""
 },
 {
  "id": "2F9C88_02DA.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "もちろん助ける",
  "en": ""
 },
 {
  "id": "2F9C88_02E6.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "絶対に助けない",
  "en": ""
 },
 {
  "id": "2F9C88_02FB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いやだよ。",
  "en": ""
 },
 {
  "id": "2F9C88_0306.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "え？",
  "en": ""
 },
 {
  "id": "2F9C88_030E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "黒い霧がこの街にくると、おねーさんは、 / 鎖に縛られたまま石になるんだ。",
  "en": ""
 },
 {
  "id": "2F9C88_030E.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "きっといつか発掘されて、 / 美術館に展示されるよ、うらやましいなあ。",
  "en": ""
 },
 {
  "id": "2F9C88_030E.2",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちっともうらやましくありませんっ！！",
  "en": ""
 },
 {
  "id": "2F9C88_0379.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあね、ばいばい。",
  "en": ""
 },
 {
  "id": "2F9C88_0389.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "待ってえ！！　薄情ものお！！",
  "en": ""
 },
 {
  "id": "2F9C88_03A5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "こんにちは、おねーさん。",
  "en": ""
 },
 {
  "id": "2F9C88_03B4.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "お願いです……今度こそ助けて下さい。",
  "en": ""
 },
 {
  "id": "2F9C88_03CF.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちょっと待ってね。 / よいしょ……よいしょ。",
  "en": ""
 },
 {
  "id": "2F9C88_03CF.1",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "た、助かりました。 / どうもありがとう。",
  "en": ""
 },
 {
  "id": "2F9C88_03CF.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん、特にお礼はいらないけど、 / あえていうなら現金がいいかな。",
  "en": ""
 },
 {
  "id": "2F9C88_03CF.3",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか言いました？",
  "en": ""
 },
 {
  "id": "2F9C88_0437.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なにも言ってないよ。",
  "en": ""
 },
 {
  "id": "2F9C88_0446.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "……そうですよね。 / とにかく本当にありがとうございました。",
  "en": ""
 },
 {
  "id": "2F9C88_0446.1",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "私、魔導師の卵なんです。",
  "en": ""
 },
 {
  "id": "2F9C88_047C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "近くの森にある魔導師学校から、 / 遊びにきてたんですけど、",
  "en": ""
 },
 {
  "id": "2F9C88_04A2.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "いきなりルシフォンの軍隊が / この街にやってきて……。",
  "en": ""
 },
 {
  "id": "2F9C88_04BA.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "私に仲間になれって強制するんです。",
  "en": ""
 },
 {
  "id": "2F9C88_04D2.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "仲間にならないと / こんなことをしちゃうぞって……。",
  "en": ""
 },
 {
  "id": "2F9C88_04EE.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "私、魔導師学校に戻って仲間を呼んできます。 / そして、あの悪いやつらと闘うつもりです。",
  "en": ""
 },
 {
  "id": "2F9C88_04EE.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん、お礼はあとでいいから…… / ちゃんと現金で払ってね。",
  "en": ""
 },
 {
  "id": "2F9C88_055C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "鎖で縛られてたおねーさん？",
  "en": ""
 },
 {
  "id": "2F9C88_0571.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "やっと今、訓練所に登録しました。",
  "en": ""
 },
 {
  "id": "2F9C88_0587.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "私たちだけで東に行くのは不安ですから…… / どこかの軍隊に入れてもらえるのを / 待ってるんです。",
  "en": ""
 },
 {
  "id": "2F9C88_05C2.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "だれか、仲間に入れてくれないかしら。",
  "en": ""
 },
 {
  "id": "2F9C88_05D9.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの……私の部隊を選んでくれたんでしょう？",
  "en": ""
 },
 {
  "id": "2F9C88_05F4.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "がんばりますから、見捨てないでくださいね。",
  "en": ""
 },
 {
  "id": "2F9C88_0610.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの……出発するまで、ここで待ってます。",
  "en": ""
 },
 {
  "id": "2F9C88_0628.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "お前がカケルってやつかい？ / 俺様がつくった部隊を選んでくれたんだろ？",
  "en": ""
 },
 {
  "id": "2F9C88_0628.1",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "言っておくが、俺の剣の腕は超一流だからな。",
  "en": ""
 },
 {
  "id": "2F9C88_066B.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ばやばやしてると、ルシフォン軍なんざ、 / 俺ひとりでやっつけちまうかもしれないぜ？",
  "en": ""
 },
 {
  "id": "2F9C88_0694.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "早く出発しないと、 / ルシフォン軍がまた攻めにやってくるぜ。",
  "en": ""
 },
 {
  "id": "2F9C88_06BA.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ここは勇敢な兵士の訓練所だ。 / お前も兵士として応募しにきたんだな？",
  "en": ""
 },
 {
  "id": "2F9C88_06BA.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちがうよ、僕は仲間を捜しにきたんだ。 / できればきれーな女の人がいいなあ。",
  "en": ""
 },
 {
  "id": "2F9C88_06BA.2",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "どわっはっはっ！！ / よく言うぜ！！",
  "en": ""
 },
 {
  "id": "2F9C88_06BA.3",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "あっはっはっ！！ / 冗談はおじさんの顔でしょ？",
  "en": ""
 },
 {
  "id": "2F9C88_06BA.4",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "まさか、ここを解放したっていうのは / ……お前らか？",
  "en": ""
 },
 {
  "id": "2F9C88_06BA.5",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん、僕とセイルとエトでやったんだ。 / これでも僕は部隊長なんだよ。",
  "en": ""
 },
 {
  "id": "2F9C88_06BA.6",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "わかった、信じてやるよ…… / その前に説明しなきゃいけないことがある。",
  "en": ""
 },
 {
  "id": "2F9C88_06BA.7",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 5,
  "jp": "いいか、この訓練所で / 選べる部隊はひとつだけだ…… / お前ら以外にも、ルシフォンの軍勢と / 闘うやつらがいるんだからな…… / つまり、ひとりじめはだめってことさ。",
  "en": ""
 },
 {
  "id": "2F9C88_06BA.8",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "選べる仲間はひとつだけなんだね。",
  "en": ""
 },
 {
  "id": "2F9C88_0817.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "話のわかる小僧だな。 / さっそく登録されている部隊を紹介してやるぜ。",
  "en": ""
 },
 {
  "id": "2F9C88_084D.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "よう、またきたな。選ぶ部隊を決めたのか？",
  "en": ""
 },
 {
  "id": "2F9C88_0867.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "この訓練所に登録してる部隊は……。",
  "en": ""
 },
 {
  "id": "2F9C88_0884.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "カルタス隊",
  "en": ""
 },
 {
  "id": "2F9C88_088C.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "やめる",
  "en": ""
 },
 {
  "id": "2F9C88_089A.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "カルタス隊",
  "en": "",
  "dup": "2F9C88_0884.0"
 },
 {
  "id": "2F9C88_08A2.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "ネレイド隊 / やめる",
  "en": ""
 },
 {
  "id": "2F9C88_08BA.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "カルタス隊は剣士の集団だ…… / 見た感じは強そうだったな。",
  "en": ""
 },
 {
  "id": "2F9C88_08BA.1",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "こいつらにするかい？",
  "en": ""
 },
 {
  "id": "2F9C88_08E4.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "決定する",
  "en": ""
 },
 {
  "id": "2F9C88_08EA.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "やめる",
  "en": "",
  "dup": "2F9C88_088C.0"
 },
 {
  "id": "2F9C88_08F9.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、カルタス隊に決めるんだな…… / やつには俺から連絡しておくぜ！！",
  "en": ""
 },
 {
  "id": "2F9C88_0909.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "カルタスが仲間に加わった！！",
  "en": ""
 },
 {
  "id": "2F9C88_0916.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだ……カルタス隊にしないのか？",
  "en": ""
 },
 {
  "id": "2F9C88_0922.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "選ぶやつを決めたら、またきてくれ。",
  "en": ""
 },
 {
  "id": "2F9C88_093E.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ネレイド隊は魔導師の集団だ。 / 彼女はかわいい女の子だったぞ。",
  "en": ""
 },
 {
  "id": "2F9C88_093E.1",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "こいつらにするかい？",
  "en": "",
  "dup": "2F9C88_08BA.1"
 },
 {
  "id": "2F9C88_096A.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "決定する",
  "en": "",
  "dup": "2F9C88_08E4.0"
 },
 {
  "id": "2F9C88_0970.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "やめる",
  "en": "",
  "dup": "2F9C88_088C.0"
 },
 {
  "id": "2F9C88_097F.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、ネレイド隊に決めるんだな…… / 彼女には俺から連絡しておくぜ！！",
  "en": ""
 },
 {
  "id": "2F9C88_099F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネレイドが仲間に加わった！！",
  "en": ""
 },
 {
  "id": "2F9C88_09AB.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだ……ネレイド隊にしないのか？",
  "en": ""
 },
 {
  "id": "2F9C88_09B7.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "選ぶやつを決めたら、またきてくれ。",
  "en": "",
  "dup": "2F9C88_0922.0"
 },
 {
  "id": "2F9C88_09D0.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "気が変わったらまたこいよ。",
  "en": ""
 },
 {
  "id": "2F9C88_09DF.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 3,
  "jp": "なんだ、またお前か？ / 俺の説明を忘れてるんじゃないか？ / 選べる部隊はひとつだけだぜ。",
  "en": ""
 },
 {
  "id": "2F9C88_0A10.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 4,
  "jp": "ルシフォンが操る軍隊に、 / この街は占領されていたのぢゃ。 / やつらは次々に国や街を襲い、 / 若者は洗脳して軍隊に加えとるらしい。",
  "en": ""
 },
 {
  "id": "2F9C88_0A5F.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンの不思議な魔法にかかった若者たちは / ルシフォンの思うがままに動くそうぢゃよ。",
  "en": ""
 },
 {
  "id": "2F9C88_0A5F.1",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 2,
  "jp": "黒い霧に体が包まれても大丈夫なのも、 / その魔法のおかげかも知れんな……。",
  "en": ""
 },
 {
  "id": "2F9C88_0AB9.0",
  "speaker": "ハラーシヨ",
  "form": "dlg",
  "nlines": 4,
  "jp": "さーてと、 / わしはもう死ぬ覚悟ができているでな。 / 黒い霧がやってくるのを、 / 生まれ育った家で待つとするかの……。",
  "en": ""
 },
 {
  "id": "2F9C88_0AFD.0",
  "speaker": "ヒロス",
  "form": "dlg",
  "nlines": 1,
  "jp": "俺は木箱の影に隠れていて助かったけど、",
  "en": ""
 },
 {
  "id": "2F9C88_0B1A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "この街の若者たちはほとんど / ルシフォンの軍隊が引き上げる時に / 連れ去られてしまったよ……。",
  "en": ""
 },
 {
  "id": "2F9C88_0B1A.1",
  "speaker": "ヒロス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンはドラゴンたちをたぶらかし、",
  "en": ""
 },
 {
  "id": "2F9C88_0B5E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "自分が洗脳した人間たちに / 「ドラゴンナイト」の称号を / 与えてるみたいだぜ。",
  "en": ""
 },
 {
  "id": "2F9C88_0B5E.1",
  "speaker": "ヒロス",
  "form": "dlg",
  "nlines": 2,
  "jp": "そのうちに偽ドラゴンナイトたちが、 / 大挙してやってくるんじゃないかなあ……。",
  "en": ""
 },
 {
  "id": "2F9C88_0BB4.0",
  "speaker": "ヒロス",
  "form": "dlg",
  "nlines": 1,
  "jp": "俺たちだってこのまま黙っちゃいない……",
  "en": ""
 },
 {
  "id": "2F9C88_0BCE.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "残った男たちで軍隊を作って、 / やつらと闘おうって決めたんだ！",
  "en": ""
 },
 {
  "id": "2F9C88_0BF0.0",
  "speaker": "ヒロス",
  "form": "dlg",
  "nlines": 4,
  "jp": "もし君も闘いたいのなら、 / 訓練所に登録すればいい…… / 若かろうが年よりだろうが、 / 闘いたいやつは登録できるって話だよ。",
  "en": ""
 },
 {
  "id": "2F9C88_0C38.0",
  "speaker": "ヒロス",
  "form": "dlg",
  "nlines": 2,
  "jp": "さてと、俺はもう行くよ…… / これから剣の練習をするんだ、じゃあな！！",
  "en": ""
 },
 {
  "id": "2F9C88_0C63.0",
  "speaker": "シド・ノムル",
  "form": "dlg",
  "nlines": 2,
  "jp": "おお、お前さんたちが / この街を解放してくれたのじゃな。",
  "en": ""
 },
 {
  "id": "2F9C88_0C63.1",
  "speaker": "シド・ノムル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ワシがユリシーズの街の長老、シドじゃよ……",
  "en": ""
 },
 {
  "id": "2F9C88_0C9F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "レイモンド王の遠縁、つまり親戚でな、 / この街をずっとまかされておる。",
  "en": ""
 },
 {
  "id": "2F9C88_0CCB.0",
  "speaker": "シド・ノムル",
  "form": "dlg",
  "nlines": 4,
  "jp": "うむ、レイモンド王国がどうなったかは / 知っておるよ…… / 王様ともども、 / 黒い霧に包まれてしまったのじゃろ？",
  "en": ""
 },
 {
  "id": "2F9C88_0D04.0",
  "speaker": "シド・ノムル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ここも、同じ運命をたどるじゃろうな……",
  "en": ""
 },
 {
  "id": "2F9C88_0D1E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "この街にはもともと、レイモンド城があった / 由緒正しい街なのじゃ、 / まったく残念なことじゃのう。",
  "en": ""
 },
 {
  "id": "2F9C88_0D1E.1",
  "speaker": "シド・ノムル",
  "form": "dlg",
  "nlines": 4,
  "jp": "西からは黒い霧が迫り、東にあるラビニアの国は / ルシフォンの軍隊に占拠されていると聞く…… / ワシら年寄りは、 / ここでじっとしてるしかないからのう。",
  "en": ""
 },
 {
  "id": "2F9C88_0DAA.0",
  "speaker": "シド・ノムル",
  "form": "dlg",
  "nlines": 2,
  "jp": "しかし残された若者たちは自分たちで軍隊を作り / やつらと闘うと言っておる……。",
  "en": ""
 },
 {
  "id": "2F9C88_0DD7.0",
  "speaker": "シド・ノムル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンはな、 / ライムリンの国で指揮をとっておるそうじゃ。",
  "en": ""
 },
 {
  "id": "2F9C88_0DD7.1",
  "speaker": "シド・ノムル",
  "form": "dlg",
  "nlines": 2,
  "jp": "はるか東のそこまで行くには、 / 船で大陸をいくつも渡らなければならん。",
  "en": ""
 },
 {
  "id": "2F9C88_0DD7.2",
  "speaker": "シド・ノムル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンはなんの目的で、 / こんなことをしでかしたのかのう。",
  "en": ""
 },
 {
  "id": "2F9C88_0E45.0",
  "speaker": "ノンノン",
  "form": "dlg",
  "nlines": 1,
  "jp": "長老様は、この奥にいるわよ。",
  "en": ""
 },
 {
  "id": "2F9C88_0E5B.0",
  "speaker": "ノンノン",
  "form": "dlg",
  "nlines": 1,
  "jp": "私の役目は、そのことをあなたに伝えるだけ。",
  "en": ""
 },
 {
  "id": "2F9C88_0E78.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "でも、ちゃんと話しかけてくれたお礼に / いいことを教えてあげるわね。",
  "en": ""
 },
 {
  "id": "2F9C88_0E9D.0",
  "speaker": "ノンノン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ほとんどの場合、街の住人すべてと / 話をしなくても、次のステージに進めるけど……",
  "en": ""
 },
 {
  "id": "2F9C88_0E9D.1",
  "speaker": "ノンノン",
  "form": "dlg",
  "nlines": 3,
  "jp": "でも色々な情報を知りたいなら、 / 面倒でもひとりひとりと / じっくり話すことを勧めるわ。",
  "en": ""
 },
 {
  "id": "2F9C88_0F05.0",
  "speaker": "ノンノン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そのほうが、 / この物語をじっくり楽しめると思うわよ。",
  "en": ""
 },
 {
  "id": "2F9C88_0F28.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "お、俺は見たぞ…… / レイモンドの国がどうなったか。",
  "en": ""
 },
 {
  "id": "2F9C88_0F28.1",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 3,
  "jp": "黒い霧が街を包みだすと、 / 人々は悲鳴を上げる間もなく / 石になってしまったんだ！",
  "en": ""
 },
 {
  "id": "2F9C88_0F7B.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 3,
  "jp": "今はレイモンド王国に / 停滞してるかもしれないが、 / じきにまた動き出すぜ。",
  "en": ""
 },
 {
  "id": "2F9C88_0FA4.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ばうやもここから逃げた方がいい。",
  "en": ""
 },
 {
  "id": "2F9C88_0FBA.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 4,
  "jp": "レイモンド王はタケルとバーンを呼んで、 / なんとかしてもらおうと考えていたらしいが、 / 彼らの住んでいる大陸は、 / とっくに黒い霧に包まれているって話だ。",
  "en": ""
 },
 {
  "id": "2F9C88_1012.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "もう俺たちを助けてくれる勇者はいない……。",
  "en": ""
 },
 {
  "id": "2F9C88_102B.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "俺は……ラビニアの街に行ってみるよ。",
  "en": ""
 },
 {
  "id": "2F9C88_103F.0",
  "speaker": "商人バイナナ",
  "form": "dlg",
  "nlines": 3,
  "jp": "この街にとどまるより、 / 生き延びられる可能性が / 高いような気がするんだ……。",
  "en": ""
 },
 {
  "id": "2F9C88_106F.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ふっ！！ / 俺のことを忘れたとは言わせないぜ！！",
  "en": ""
 },
 {
  "id": "2F9C88_106F.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……ライナスだ。",
  "en": ""
 },
 {
  "id": "2F9C88_109B.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "おばえてろよ…… / 絶対に復警してやるからな！！",
  "en": ""
 },
 {
  "id": "2F9C88_10B7.0",
  "speaker": "カケル",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2F9C88_10C0.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "行くなら、ルシフォン軍がいる東だな……。",
  "en": ""
 },
 {
  "id": "2F9C88_10D6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "西に行っても、ルシフォンの軍隊はいない。",
  "en": ""
 },
 {
  "id": "2F9C88_10F7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ひとりでこの街を出るの！？",
  "en": ""
 },
 {
  "id": "2F9C88_110A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おーい、カケルうっ！！",
  "en": ""
 },
 {
  "id": "2F9C88_111C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "まだ出発しないぞ、もう少し休んでからだ。",
  "en": ""
 },
 {
  "id": "2F9C88_1136.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかったよ、エト。",
  "en": ""
 },
 {
  "id": "2F9C88_1148.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん……早く闘いたいなあ。",
  "en": ""
 },
 {
  "id": "2F9C88_1157.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おーい、カケルうっ！！",
  "en": "",
  "dup": "2F9C88_110A.0"
 },
 {
  "id": "2F9C88_1169.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ひとりで行ったら危ないじゃないか。",
  "en": ""
 },
 {
  "id": "2F9C88_117D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかったよ、エト。",
  "en": "",
  "dup": "2F9C88_1136.0"
 },
 {
  "id": "2F9C88_1191.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "東に向かいますか？",
  "en": ""
 },
 {
  "id": "2F9C88_119C.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "はい",
  "en": ""
 },
 {
  "id": "2F9C88_11A3.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "いいえ",
  "en": ""
 },
 {
  "id": "2F9C88_11B5.0",
  "speaker": "男の声",
  "form": "dlg",
  "nlines": 2,
  "jp": "だれかおらぬか！！ / 私は騎士カロンであるっ！！",
  "en": ""
 },
 {
  "id": "2F9C88_11B5.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だ、だれだ！？",
  "en": ""
 },
 {
  "id": "2F9C88_11E9.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 5,
  "jp": "レイモンド王国からユリシーズヘと続く / 道すがらに、女が倒れておったのだ！！ / 私はこれから、ラビニアにいる / ルシフォンの軍勢をけ散らしに行ってくる。 / だれかこの女を引きとってくれいっ！！",
  "en": ""
 },
 {
  "id": "2F9C88_11E9.1",
  "speaker": "女の子",
  "form": "dlg",
  "nlines": 1,
  "jp": "んんっ……カ、カケル。",
  "en": ""
 },
 {
  "id": "2F9C88_1256.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル！？　……僕の名前だ。",
  "en": ""
 },
 {
  "id": "2F9C88_1269.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "おお、ちょうどよかった。",
  "en": ""
 },
 {
  "id": "2F9C88_127B.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "むう、かわいい顔をした男の子だな……。",
  "en": ""
 },
 {
  "id": "2F9C88_1293.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "はっ！？　い、いかんっ！！ / ……お前はこの女の知り合いだな！？",
  "en": ""
 },
 {
  "id": "2F9C88_1293.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "んん……カ、カケル……。",
  "en": ""
 },
 {
  "id": "2F9C88_12C8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "その顔は……やっぱりナターシャだ！！",
  "en": ""
 },
 {
  "id": "2F9C88_12DD.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "よし、決まった！！ / 女はお前にあずけるぞ！！",
  "en": ""
 },
 {
  "id": "2F9C88_12DD.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……ち、ちょっと待ってよ！！",
  "en": ""
 },
 {
  "id": "2F9C88_1329.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ……。",
  "en": ""
 },
 {
  "id": "2F9C88_133E.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ん……。",
  "en": ""
 },
 {
  "id": "2F9C88_134E.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カ、カケル……。",
  "en": ""
 },
 {
  "id": "2F9C88_135A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "き、気がついたんだね！？",
  "en": ""
 },
 {
  "id": "2F9C88_136C.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "夢じゃないわよね……カケル。",
  "en": ""
 },
 {
  "id": "2F9C88_137E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "大丈夫だ、夢じゃない。",
  "en": ""
 },
 {
  "id": "2F9C88_138D.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……あなたは？",
  "en": ""
 },
 {
  "id": "2F9C88_139A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "この人はエト。 / 僕たちの仲間なんだ。",
  "en": ""
 },
 {
  "id": "2F9C88_139A.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あなたが……私を助けてくれたの？",
  "en": ""
 },
 {
  "id": "2F9C88_13C8.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "いいや、 / カロンという騎士が君を助けてくれたんだ……。",
  "en": ""
 },
 {
  "id": "2F9C88_13C8.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ……どうしてこの大陸にいるの？",
  "en": ""
 },
 {
  "id": "2F9C88_1400.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私……カケルを……。",
  "en": ""
 },
 {
  "id": "2F9C88_140E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕を？",
  "en": ""
 },
 {
  "id": "2F9C88_1417.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、そんなことより……",
  "en": ""
 },
 {
  "id": "2F9C88_1429.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私たちが住んでいた大陸は、 / 黒い霧に包まれてしまったわ。",
  "en": ""
 },
 {
  "id": "2F9C88_144B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……。",
  "en": ""
 },
 {
  "id": "2F9C88_1454.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの黒い霧はいったいなに！？",
  "en": ""
 },
 {
  "id": "2F9C88_1467.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "落ち着いてよ、ナターシャ……",
  "en": ""
 },
 {
  "id": "2F9C88_1479.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕たちはあの黒い霧の正体を暴くためにもね、 / ライムリンの国に行かねばならないんだ。",
  "en": ""
 },
 {
  "id": "2F9C88_14A5.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル。 / あなたのお父さんも、黒い霧に……。",
  "en": ""
 },
 {
  "id": "2F9C88_14A5.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "お父さんは平気だよ…… / もし石になったとしても、絶対に平気だ。",
  "en": ""
 },
 {
  "id": "2F9C88_14A5.2",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうね……カケルのお父さんは強いもの。",
  "en": ""
 },
 {
  "id": "2F9C88_14FB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ねえ、ナターシャ…… / もしかして僕を追いかけてこの大陸にきたとか？",
  "en": ""
 },
 {
  "id": "2F9C88_14FB.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ち、ちがうわよ……",
  "en": ""
 },
 {
  "id": "2F9C88_1530.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私、ママみたいになりたくて、 / 魔導師の修業に……",
  "en": ""
 },
 {
  "id": "2F9C88_1550.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "たまたま旅に出た方向が / カケルといっしょだっただけ。",
  "en": ""
 },
 {
  "id": "2F9C88_156D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、彼女は魔導師だそうだぞ…… / 俺たちの軍隊に入ってもらわないか？",
  "en": ""
 },
 {
  "id": "2F9C88_156D.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンの軍にも魔導師はいるはず。",
  "en": ""
 },
 {
  "id": "2F9C88_15AC.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "剣の力だけでは、 / これからの闘いが苦しくなるだろう。",
  "en": ""
 },
 {
  "id": "2F9C88_15CB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "わかった。 / エトがそう思うなら、僕はかまわないよ。",
  "en": ""
 },
 {
  "id": "2F9C88_15CB.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よし、これで決まりだ。",
  "en": ""
 },
 {
  "id": "2F9C88_15FD.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャが仲間に加わった！！",
  "en": ""
 },
 {
  "id": "2F9C88_1607.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ……。",
  "en": "",
  "dup": "2F9C88_1329.0"
 },
 {
  "id": "2F9C88_1611.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "もう身体は平気なの？",
  "en": ""
 },
 {
  "id": "2F9C88_1621.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "もう平気、すぐにでも出かけられるわ。",
  "en": "",
  "dup": "2F9C88_01FD.0"
 },
 {
  "id": "2F9C88_1639.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "なんか、ちょっと見ないうちに…… / きれいになったなあ。",
  "en": ""
 },
 {
  "id": "2F9C88_1639.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "やだ……いきなり変なことを言わないでよ。",
  "en": ""
 },
 {
  "id": "2F9C88_166F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "はっはっはっ！！ / 女の子っていうのは、変わるのが早いからな。",
  "en": ""
 },
 {
  "id": "2F9C88_166F.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、ナターシャは平気みたいだし……。",
  "en": ""
 },
 {
  "id": "2F9C88_16A7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうだな、黒い霧が迫ってくる…… / そろそろ東に向けて出発するか。",
  "en": ""
 },
 {
  "id": "2F9C88_16A7.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、先に行っててくれ…… / 俺も仲間を集めてすぐに行くからな。",
  "en": ""
 },
 {
  "id": "2F9C88_16F7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "東に向かいますか？",
  "en": "",
  "dup": "2F9C88_1191.0"
 },
 {
  "id": "2F9C88_1702.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "はい",
  "en": "",
  "dup": "2F9C88_119C.0"
 },
 {
  "id": "2F9C88_1709.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "いいえ",
  "en": "",
  "dup": "2F9C88_11A3.0"
 },
 {
  "id": "2F9C88_171B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、みんな集合っ！！",
  "en": ""
 },
 {
  "id": "2F9C88_1732.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……ラビニアの街から、再びルシフォンの軍勢が / この街に向けて出発したといううわさだ！！",
