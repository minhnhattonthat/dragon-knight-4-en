  "id": "2F9C88_1794.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "こんにちは、おにーさん。",
  "en": "",
  "dup": "2FB86E_05A1.0"
 },
 {
  "id": "2F9C88_179B.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "僕は冒険小説家を目指してる、 / ロイドンっていうんだ…… / レイモンド王国で起こったことを / 忘れないようにメモしてたのさ。",
