  "dup": "2FB86E_0622.0"
 },
 {
  "id": "2F9C88_17C2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "僕はレイモンド王国を出て、 / ルシフォンの軍隊と闘って…… / それでこの街にきたんだ。",
