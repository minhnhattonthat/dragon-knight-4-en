  "dup": "2FB86E_06DA.0"
 },
 {
  "id": "2F9C88_1854.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだよ、どうして僕の名前を知ってるの？",
