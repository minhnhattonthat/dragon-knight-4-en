 },
 {
  "id": "2F9C88_178C.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……こんにちは。",
  "en": "",
  "dup": "2FB86E_0599.0"
 },
