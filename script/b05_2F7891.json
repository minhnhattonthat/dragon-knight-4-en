[
 {
  "id": "2F7891_000E.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ハーディス。 / そろそろ貴様に働いてもらおう。",
  "en": ""
 },
 {
  "id": "2F7891_000E.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "はっ、人間の勇者一行の始末……ですね。",
  "en": ""
 },
 {
  "id": "2F7891_0045.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだ。",
  "en": ""
 },
 {
  "id": "2F7891_004F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "この世界で集めた即席の軍隊で / 遊んでやっていたのだが……",
  "en": ""
 },
 {
  "id": "2F7891_0073.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "勇者様のご活躍というのも / そろそろ見飽きてきたので、な。",
  "en": ""
 },
 {
  "id": "2F7891_0097.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2F7891_009F.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "フフフ、私が自ら出てもかまわんが……？",
  "en": ""
 },
 {
  "id": "2F7891_00B8.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "いえっ！",
  "en": ""
 },
 {
  "id": "2F7891_00C2.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "人間ごときを相手にするのに、 / ルシフォン様がわざわざ / 出向くことはありません！",
  "en": ""
 },
 {
  "id": "2F7891_00C2.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 4,
  "jp": "フ、そのとおりだ。 / せいぜい楽しく遊んでくるがいい。 / 貴様が手こずるようなことは / ……まさかあるまいな？",
  "en": ""
 },
 {
  "id": "2F7891_012A.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "もちろんです。 / まあ、見ていてください。",
  "en": ""
 },
 {
  "id": "2F7891_012A.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "フフフ、その言葉、忘れるな。",
  "en": ""
 },
 {
  "id": "2F7891_0159.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "我がために……我が愛するマノのために / 力をつくすのだ！ / 貴様だってマノを救ってやりたいだろう？",
  "en": ""
 },
 {
  "id": "2F7891_0159.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "当然です！",
  "en": ""
 },
 {
  "id": "2F7891_019A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "魔界の王・ミナクス様のご息女ともあろう方を、 / いつまでもあのような苦しい立場に / 置いておくわけにはまいりませんっ！",
  "en": ""
 },
 {
  "id": "2F7891_019A.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ハハハ、おもしろい。 / マノのことになると貴様はいつも熱くなる。",
  "en": ""
 },
 {
  "id": "2F7891_019A.2",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "貴様はマノに特別な感情を持っているのだな？",
  "en": ""
 },
 {
  "id": "2F7891_0224.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……そ、そんなことはけっして！　私は……！！",
  "en": ""
 },
 {
  "id": "2F7891_0240.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "まあ、どうでもいいがな。",
  "en": ""
 },
 {
  "id": "2F7891_0252.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "とにかく人間どもを消し去って未来の魔界ヘ戻り / 私はマノと契りをかわす。 / さすれば私は魔界の王の……後継者だ。",
  "en": ""
 },
 {
  "id": "2F7891_0252.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F7891_0097.0"
 },
 {
  "id": "2F7891_0299.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "みごと任務をはたせば…… / 貴様にも私とマノのことを祝わせてやろう。",
  "en": ""
 },
 {
  "id": "2F7891_0299.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F7891_0097.0"
 },
 {
  "id": "2F7891_02CC.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "では行け、ハーディス！ / 魔界の未来のため……私とマノのために！",
  "en": ""
 },
 {
  "id": "2F7891_02CC.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F7891_0097.0"
 },
 {
  "id": "2F7891_02F7.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "……ハーディス、我がしもべのドラゴン / ヴェルトーと共に……出撃します！",
  "en": ""
 },
 {
  "id": "2F7891_0328.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "みなのもの、聞けぃ！",
  "en": ""
 },
 {
  "id": "2F7891_0339.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "人間の勇者ども一行はラビニアを抜け、 / トリアノンに向かったらしい！",
  "en": ""
 },
 {
  "id": "2F7891_035B.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "我々はこれよりトリアノンの村を急襲し、 / 勇者どもを一気にせんめつする！",
  "en": ""
 },
 {
  "id": "2F7891_035B.1",
  "speaker": "部下一同",
  "form": "dlg",
  "nlines": 1,
  "jp": "……おう！",
  "en": ""
 },
 {
  "id": "2F7891_038D.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F7891_0097.0"
 },
 {
  "id": "2F7891_0395.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……マノ様。",
  "en": ""
 },
 {
  "id": "2F7891_03A6.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ハーディス！",
  "en": ""
 },
 {
  "id": "2F7891_03B1.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 3,
  "jp": "あなたって…… / いつも私の側についていてくれるのですね。 / そしていつも護ってくれる。",
  "en": ""
 },
 {
  "id": "2F7891_03E1.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "はい。",
  "en": ""
 },
 {
  "id": "2F7891_03EA.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "それは……どうして？",
  "en": ""
 },
 {
  "id": "2F7891_03FA.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F7891_0097.0"
 },
 {
  "id": "2F7891_0402.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、それは……。",
  "en": ""
 },
 {
  "id": "2F7891_040F.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "おれ……いや、私は……マノ様を……。",
  "en": ""
 },
 {
  "id": "2F7891_0426.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2F7891_042E.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……私は魔界の王の娘なのですよ。",
  "en": ""
 },
 {
  "id": "2F7891_0445.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 5,
  "jp": "み、身分がちがいすぎるのは / 理解しているつもりです！ / た、ただ私は純粋に貴女に…… / そう、あこがれている……だけです！ / そんなやましいことはけっして……その……っ！",
  "en": ""
 },
 {
  "id": "2F7891_0445.1",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 2,
  "jp": "それに私には心に決めた方が…… / ルシフォン様がいます。",
  "en": ""
 },
 {
  "id": "2F7891_0445.2",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "わ、私は……！",
  "en": ""
 },
 {
  "id": "2F7891_04CF.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふふ、そんなにあわてないで。",
  "en": ""
 },
 {
  "id": "2F7891_04E3.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ごめんなさい、 / ちょっといじわるなことを言ったわね。",
  "en": ""
 },
 {
  "id": "2F7891_04FB.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いえ！",
  "en": ""
 },
 {
  "id": "2F7891_0506.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……しかし魔界の掟はきびしいもの。",
  "en": ""
 },
 {
  "id": "2F7891_051E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あなたのその感情、 / けっして他では見せてはいけません。",
  "en": ""
 },
 {
  "id": "2F7891_053E.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……特にお父様の前では、ね。",
  "en": ""
 },
 {
  "id": "2F7891_0552.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……はい！",
  "en": ""
 },
 {
  "id": "2F7891_055D.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあハーディス、ひとつだけ約束して。",
  "en": ""
 },
 {
  "id": "2F7891_0575.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "あなたはいつ、 / いかなる時でもこの私を護ってくれると。 / 私の騎士となってくれると。",
  "en": ""
 },
 {
  "id": "2F7891_0575.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は、いつ、いかなる時も / あなたを護ることを……誓います。",
  "en": ""
 },
 {
  "id": "2F7891_0575.2",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふふ……。",
  "en": ""
 },
 {
  "id": "2F7891_05CF.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "では、これをあなたに……。",
  "en": ""
 },
 {
  "id": "2F7891_05E1.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "？　これは……ペンダント？",
  "en": ""
 },
 {
  "id": "2F7891_05F6.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 2,
  "jp": "……そう。 / 私の騎士たる証と思ってください。",
  "en": ""
 },
 {
  "id": "2F7891_05F6.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……は、はいっ！",
  "en": ""
 },
 {
  "id": "2F7891_0622.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "このハーディス、命をかけて / あなたをお護りすることを……誓います！",
  "en": ""
 },
 {
  "id": "2F7891_0646.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……あ。",
  "en": ""
 },
 {
  "id": "2F7891_0650.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "は？",
  "en": ""
 },
 {
  "id": "2F7891_0658.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 2,
  "jp": "……ペンダントあげたこと…… / ルシフォン様には内緒よ。",
  "en": ""
 },
 {
  "id": "2F7891_0658.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F7891_0097.0"
 },
 {
  "id": "2F7891_0682.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……はい。",
  "en": ""
 },
 {
  "id": "2F7891_068D.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "それと……。",
  "en": ""
 },
 {
  "id": "2F7891_0698.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あなたの気持ちはとっても……。",
  "en": ""
 },
 {
  "id": "2F7891_06AC.0",
  "speaker": "マノ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……うれしかった。",
  "en": ""
 },
 {
  "id": "2F7891_06C2.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……マノ様……。",
  "en": ""
 },
 {
  "id": "2F7891_06D3.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……必ずっ！",
  "en": ""
 }
]
