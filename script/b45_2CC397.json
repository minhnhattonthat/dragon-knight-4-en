[
 {
  "id": "2CC397_0066.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ん？",
  "en": ""
 },
 {
  "id": "2CC397_0070.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "いつのまにか……寝てしまったようだ。",
  "en": ""
 },
 {
  "id": "2CC397_0092.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕たちって、ここでずっと暮らすのかな？",
  "en": ""
 },
 {
  "id": "2CC397_00AC.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "大丈夫だ、そのうちになんとかなるだろう。",
  "en": ""
 },
 {
  "id": "2CC397_00C5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイル……なにしてるんだ？",
  "en": ""
 },
 {
  "id": "2CC397_00D7.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "聞いてよ、昨日の夜ロザリンドに誘われて…… / ずっと浜辺で話をしていたんだ。",
  "en": ""
 },
 {
  "id": "2CC397_00D7.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "うんうん。",
  "en": ""
 },
 {
  "id": "2CC397_010D.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうしたらさ、いきなり腕を組んできて…… / 僕にキスをしようとするんだよ。",
  "en": ""
 },
 {
  "id": "2CC397_010D.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕は逃げようとしたんだけど、 / 彼女がしっかり腕を組んでて離さないんだ。",
  "en": ""
 },
 {
  "id": "2CC397_010D.2",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……結局、ロザリンドとキスをしちゃった。",
  "en": ""
 },
 {
  "id": "2CC397_017C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか、おめでとう。",
  "en": ""
 },
 {
  "id": "2CC397_0189.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちっともおめでたくないよ……",
  "en": ""
 },
 {
  "id": "2CC397_019C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕はマルレーネさんとはキスしたいけど、 / ロザリンドとはキスなんかしたくないんだ。",
  "en": ""
 },
 {
  "id": "2CC397_01C2.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネともキスすればいいじゃないか。",
  "en": ""
 },
 {
  "id": "2CC397_01D7.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト……一度キスしたら、 / その人としかキスできないんじゃないの？",
  "en": ""
 },
 {
  "id": "2CC397_01D7.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "だれがそんなことを決めたんだ？",
  "en": ""
 },
 {
  "id": "2CC397_0210.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そ、そうだったのか…… / 他の人とキスしてもいいんだ。",
  "en": ""
 },
 {
  "id": "2CC397_0231.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト……僕がここにいることは、 / ロザリンドには内緒だよ。",
  "en": ""
 },
 {
  "id": "2CC397_026B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだカケル、まだ機嫌が悪いのか？",
  "en": ""
 },
 {
  "id": "2CC397_0282.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2CC397_028A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おい、話ぐらいしてもいいだろ？",
  "en": ""
 },
 {
  "id": "2CC397_029F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "し――――――っ！！ / 静かにしてよ、エト。",
  "en": ""
 },
 {
  "id": "2CC397_029F.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ほら……耳をすまして。",
  "en": ""
 },
 {
  "id": "2CC397_02CD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "船だよ、エト！！ / ……こっちに向かってくる！！",
  "en": ""
 },
 {
  "id": "2CC397_02CD.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうか……やっときたか！！",
  "en": ""
 },
 {
  "id": "2CC397_02FC.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルっ！！　浜辺に行こう！！",
  "en": ""
 },
 {
  "id": "2CC397_0312.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うん。",
  "en": "",
  "dup": "2E5EB7_02C0.1"
 },
 {
  "id": "2CC397_031D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お――――いっ！！",
  "en": "",
  "dup": "2E5EB7_02E7.0"
 },
 {
  "id": "2CC397_032C.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "た、助かったんだね！！",
  "en": "",
  "dup": "2E5EB7_02F6.0"
 },
 {
  "id": "2CC397_033D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……ルシフォン軍の船かな？",
  "en": "",
  "dup": "2E5EB7_0307.0"
 },
 {
  "id": "2CC397_034E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "こうなったら、どっちでもいい……",
  "en": "",
  "dup": "2E5EB7_0318.0"
 },
 {
  "id": "2CC397_0364.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍の船でなければ / なんの問題もないし、",
  "en": ""
 },
 {
  "id": "2CC397_037E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "ルシフォン軍の船なら / 乗ってるやつをやっつけて、 / 船を奪ってしまえばいい。",
  "en": ""
 },
 {
  "id": "2CC397_037E.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……そうか。",
  "en": "",
  "dup": "2E5EB7_036D.0"
 },
 {
  "id": "2CC397_03B1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルも手を振るんだ、お――――いっ！！",
  "en": "",
  "dup": "2E5EB7_037A.0"
 },
 {
  "id": "2CC397_03CB.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "俺たちはここだぞ――――っ！！",
  "en": "",
  "dup": "2E5EB7_0394.0"
 },
 {
  "id": "2CC397_03F4.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 4,
  "jp": "わっはっはっはっ！！ / やっぱり生きていやがったかっ！！ / タスタに流れ着かなきゃ、 / あとはここだと思ったんだ。",
  "en": ""
 },
 {
  "id": "2CC397_0429.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれれ！？",
  "en": "",
  "dup": "2E5EB7_03F1.0"
 },
 {
  "id": "2CC397_0433.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 2,
  "jp": "よう、お互いに悪運だけは強いようだな。 / 他の仲間は元気なのか？",
  "en": "",
  "dup": "2E5EB7_03FB.0"
 },
 {
  "id": "2CC397_0433.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うん、みんな元気だよ。",
  "en": ""
 },
 {
  "id": "2CC397_046D.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 2,
  "jp": "へレネとかいう娘も、頭ツルツルのおやじも、 / ライナスとかいうガキもあの船に乗ってるぜ。",
  "en": ""
 },
 {
  "id": "2CC397_046D.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……よかった。",
  "en": "",
  "dup": "2E5EB7_0433.1"
 },
 {
  "id": "2CC397_04AF.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 2,
  "jp": "さあ、立ち話をしてる時間はないぜ…… / みんな急いで船に乗るんだ。",
  "en": "",
  "dup": "2E5EB7_046F.0"
 },
 {
  "id": "2CC397_04AF.1",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 3,
  "jp": "ドラゴンナイトの連中に見つかったら、 / また船を沈められちまう…… / やつらに見つかる前に、とっとと出航しよう。",
  "en": "",
  "dup": "2E5EB7_046F.1"
 },
 {
  "id": "2CC397_0515.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちょっと待ってくれ……あの船の行き先は？",
  "en": "",
  "dup": "2E5EB7_04D5.0"
 },
 {
  "id": "2CC397_052E.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 1,
  "jp": "もちろんドラゴニア大陸さ……",
  "en": "",
  "dup": "2E5EB7_04EE.0"
 },
 {
  "id": "2CC397_053D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "いまさらロンボニ大陸に戻ったって、 / 黒い霧が待ってるだけさ。",
  "en": "",
  "dup": "2E5EB7_04FD.0"
 },
 {
  "id": "2CC397_055C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……俺に話があるんじゃないか？",
  "en": "",
  "dup": "2E5EB7_051C.0"
 },
 {
  "id": "2CC397_0571.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん……もういいんだ。",
  "en": "",
  "dup": "2E5EB7_0531.0"
 },
 {
  "id": "2CC397_0581.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "これからまた闘いの日々が始まるからね…… / つまらないことで悩んでるヒマはないよ。",
  "en": "",
  "dup": "2E5EB7_0541.0"
 },
 {
  "id": "2CC397_0581.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……。",
  "en": "",
  "dup": "2E5EB7_0541.1"
 },
 {
  "id": "2CC397_05BA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……なんだか大人になったな。",
  "en": "",
  "dup": "2E5EB7_057A.0"
 },
 {
  "id": "2CC397_05D0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2CC397_05D8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕がいくら大人になっても…… / きっとエトにはかなわないよ。",
  "en": "",
  "dup": "2E5EB7_0598.0"
 },
 {
  "id": "2CC397_05D8.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてだ？",
  "en": "",
  "dup": "2E5EB7_0598.1"
 },
 {
  "id": "2CC397_0606.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ナターシャは……エトが好きだもの。",
  "en": "",
  "dup": "2E5EB7_05C6.0"
 },
 {
  "id": "2CC397_061C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2CC397_0624.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "さてと、明日の朝には / ドラゴニア大陸に着くんだよね…… / エト、僕はもう寝るよ。",
  "en": "",
  "dup": "2E5EB7_05E4.0"
 },
 {
  "id": "2CC397_0650.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ……。",
  "en": "",
  "dup": "2E5EB7_0610.0"
 },
 {
  "id": "2CC397_0669.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、カケル……今日もいい天気だな。",
  "en": ""
 },
 {
  "id": "2CC397_0683.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕のせいじゃないよ。",
  "en": "",
  "dup": "2E5EB7_0162.1"
 },
 {
  "id": "2CC397_0691.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "あれれ……どうしたんだ、カケル。 / やけに機嫌が悪そうじゃないか。",
  "en": "",
  "dup": "2E5EB7_018B.0"
 },
 {
  "id": "2CC397_0691.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "機嫌は悪くないよ…… / 用がないならあっちに行ってよ。",
  "en": ""
 },
 {
  "id": "2CC397_0691.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2CC397_06DB.0",
  "speaker": "エト",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2CC397_06E4.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "（そ、そうか……思い出したぞ）",
  "en": ""
 },
 {
  "id": "2CC397_06F2.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "（私がカケルだった時も…… / エトとナターシャが抱き合っているを見たんだ）",
  "en": ""
 },
 {
  "id": "2CC397_0719.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "（まあ、誤解するのも無理もないな……）",
  "en": ""
 },
 {
  "id": "2CC397_0730.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、船の姿は見えないな……。",
  "en": "",
  "dup": "2E5EB7_01DA.0"
 },
 {
  "id": "2CC397_0745.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "別に僕のせいじゃないよ。",
  "en": "",
  "dup": "2E5EB7_01EF.0"
 },
 {
  "id": "2CC397_0755.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前のせいだなんて言ってないじゃないか。",
  "en": "",
  "dup": "2E5EB7_01FF.0"
 },
 {
  "id": "2CC397_076D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "用がないならあっちに行ってよ。",
  "en": ""
 },
 {
  "id": "2CC397_0787.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ららららー……。",
  "en": "",
  "dup": "2E5EB7_061F.0"
 },
 {
  "id": "2CC397_0794.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ナターシャ……まさか、私は / いっしょのベッドで寝てしまったのか？",
  "en": ""
 },
 {
  "id": "2CC397_0794.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "心配しないでエト…… / 私が目をさましたら、エトが床で寝ていたから。",
  "en": ""
 },
 {
  "id": "2CC397_0794.2",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私、カケルに会ってくる。",
  "en": ""
 },
 {
  "id": "2CC397_07F2.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルの顔を見て、カケルと話をして、 / カケルといっしょにご飯を食べるの。",
  "en": ""
 },
 {
  "id": "2CC397_0818.0",
  "speaker": "エト",
  "form": "empty",
  "nlines": 0,
  "jp": "",
  "en": ""
 },
 {
  "id": "2CC397_0821.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……カケルもきっと喜ぶだろう。",
  "en": ""
 },
 {
  "id": "2CC397_0835.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いや……ナターシャ。",
  "en": ""
 },
 {
  "id": "2CC397_0841.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしたの？",
  "en": "",
  "dup": "2C0000_0349.0"
 },
 {
  "id": "2CC397_084D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "いや、なんでもないんだ。",
  "en": ""
 },
 {
  "id": "2CC397_085B.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "大丈夫、安心して…… / エトのことはだれにも言わないわ。",
  "en": ""
 },
 {
  "id": "2CC397_087F.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはようございます、エトさん。",
  "en": ""
 },
 {
  "id": "2CC397_0894.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう……マルレーネ。",
  "en": ""
 },
 {
  "id": "2CC397_08A3.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……今日は私に、なにも聞かないんですね。",
  "en": ""
 },
 {
  "id": "2CC397_08BD.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "こんないい天気なんだ…… / 朝から深刻な話をすることもないだろう。",
  "en": ""
 },
 {
  "id": "2CC397_08BD.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "天気のせいかしら？ / ……それとも、昨日の夜のできごとのせい？",
  "en": ""
 },
 {
  "id": "2CC397_08BD.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（ぎくうっ！！）",
  "en": ""
 },
 {
  "id": "2CC397_0917.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "昨日の夜…… / ナターシャさんといっしょにいませんでしたか？",
  "en": ""
 },
 {
  "id": "2CC397_0917.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ど、どうして知ってるんだ？",
  "en": ""
 },
 {
  "id": "2CC397_094C.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "やはりいっしょだったのですね……。",
  "en": ""
 },
 {
  "id": "2CC397_0962.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "誤解をするな……話をしてただけだ。",
  "en": ""
 },
 {
  "id": "2CC397_097A.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 4,
  "jp": "誤解もなにも、 / エトさんがなにをしようと勝手です…… / エトさんこそ誤解しないでくださいね、 / 私は全然気にしてませんから。",
  "en": ""
 },
 {
  "id": "2CC397_09C2.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……。",
  "en": "",
  "dup": "2E5EB7_0541.1"
 },
 {
  "id": "2CC397_09CB.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 3,
  "jp": "でも私…… / なぜか今日はエトさんの顔が見たくありません。 / 他の人と話をしてください。",
  "en": ""
 },
 {
  "id": "2CC397_09FD.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "やっぱり……気にしてるんじゃないか？",
  "en": ""
 },
 {
  "id": "2CC397_0A13.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちっともさわやかな朝じゃないですね…… / 私、こんなにいやな朝を迎えたのは初めてです。",
  "en": ""
 },
 {
  "id": "2CC397_0A46.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはようございます。",
  "en": "",
  "dup": "2E5EB7_0831.0"
 },
 {
  "id": "2CC397_0A56.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、ネレイド。",
  "en": ""
 },
 {
  "id": "2CC397_0A64.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "ずっと……こうやって / 朝のあいさつができたらいいですね。",
  "en": ""
 },
 {
  "id": "2CC397_0A64.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうだな……同感だ。",
  "en": ""
 },
 {
  "id": "2CC397_0A99.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさん……私、 / 昨日の夜……エトさんの夢を見ました。",
  "en": ""
 },
 {
  "id": "2CC397_0A99.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……どんな夢だったんだ？",
  "en": ""
 },
 {
  "id": "2CC397_0ACF.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "恥ずかしくて……言えない夢です。",
  "en": ""
 },
 {
  "id": "2CC397_0AE7.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……夢が本当になればいいのに。",
  "en": ""
 },
 {
  "id": "2CC397_0B01.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ……早くこの島から出たいなあ。",
  "en": "",
  "dup": "2E5EB7_0873.0"
 },
 {
  "id": "2CC397_0B14.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "潮の香りにはもう飽きたよ……。",
  "en": "",
  "dup": "2E5EB7_08BE.0"
 },
 {
  "id": "2CC397_0B2B.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃぶじゃぶじゃぶ……エト殿、おはよう。",
  "en": ""
 },
 {
  "id": "2CC397_0B3E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カロン……どうして自分で洗濯してるんだ？",
  "en": ""
 },
 {
  "id": "2CC397_0B59.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うむ……まあいいではないか。",
  "en": ""
 },
 {
  "id": "2CC397_0B6F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "さては……おねしょをしたな。",
  "en": ""
 },
 {
  "id": "2CC397_0B83.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……まあ、そのようなものだ。",
  "en": ""
 },
 {
  "id": "2CC397_0B97.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト殿……みんなには内緒にしておいてくれ。",
  "en": ""
 },
 {
  "id": "2CC397_0BB4.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト殿……だれにも言わないでくれ、頼む。",
  "en": ""
 },
 {
  "id": "2CC397_0BCF.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネプチューン……なにをしてるんだ？",
  "en": ""
 },
 {
  "id": "2CC397_0BE2.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "朝ご飯を採ってるのよ……",
  "en": ""
 },
 {
  "id": "2CC397_0BF7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カラフルな魚を食べるより、 / 果物の方がマシだもの。",
  "en": ""
 },
 {
  "id": "2CC397_0C17.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト……いつになったら、 / この島から出られるのかしら？",
  "en": ""
 },
 {
  "id": "2CC397_0C17.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "予定ではそろそろのはずなんだが……。",
  "en": ""
 },
 {
  "id": "2CC397_0C50.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "予定って？",
  "en": ""
 },
 {
  "id": "2CC397_0C5D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……いや……なんでもないぞ。",
  "en": ""
 },
 {
  "id": "2CC397_0C6E.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "おおおおっ！！ / こんなにりっぱなバナナが生えてるぞ。",
  "en": "",
  "dup": "2E5EB7_09F1.0"
 },
 {
  "id": "2CC397_0C6E.1",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 3,
  "jp": "おおおおおっ！！ / こ、こんなに長いバナナもある…… / うーん、幸せだなあ。",
  "en": ""
 },
 {
  "id": "2CC397_0CB6.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "バナナに囲まれて生活できたら…… / もうなにも言うことはないな、うんうん。",
  "en": "",
  "dup": "2E5EB7_0A59.0"
 },
 {
  "id": "2CC397_0CE2.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "おはよう、パンドラ…… / 魚でも釣ってるのか？",
  "en": ""
 },
 {
  "id": "2CC397_0CE2.1",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "あはははは、ちがうわよ…… / ロンボニ大陸の方を見てただけ。",
  "en": ""
 },
 {
  "id": "2CC397_0CE2.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "なにか……見えるのか？",
  "en": ""
 },
 {
  "id": "2CC397_0D2C.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ううん、見えるのは海だけ…… / もちろん黒い霧も見えないわよ。",
  "en": ""
 },
 {
  "id": "2CC397_0D4F.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……私たちって、変な関係よね。",
  "en": ""
 },
 {
  "id": "2CC397_0D67.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……そうだな。変な関係だ。",
  "en": ""
 },
 {
  "id": "2CC397_0D7C.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……いっしょに食事でもどうですか？",
  "en": ""
 },
 {
  "id": "2CC397_0D97.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ありがとうメイフェア…… / でも起きたばかりで食欲がないんだ。",
  "en": ""
 },
 {
  "id": "2CC397_0D97.1",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうですか……。",
  "en": ""
 },
 {
  "id": "2CC397_0DC6.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "今度いっしょに食事をしよう……約束するよ。",
  "en": ""
 },
 {
  "id": "2CC397_0DE3.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "はい……楽しみにしてます。",
  "en": ""
 },
 {
  "id": "2CC397_0DF7.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんていい天気なんでしょう……。",
  "en": ""
 },
 {
  "id": "2CC397_0E0D.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、お腹がすいてるだろ？",
  "en": ""
 },
 {
  "id": "2CC397_0E21.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "いや、起きたばかりだからな。",
  "en": ""
 },
 {
  "id": "2CC397_0E35.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちぇっ……エトといっしょに / 朝食でもって思ったんだけどな。",
  "en": "",
  "dup": "2E5EB7_0CBA.0"
 },
 {
  "id": "2CC397_0E35.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ありがとうクラリス…… / 今度いっしょに食事をしよう。",
  "en": ""
 },
 {
  "id": "2CC397_0E35.2",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "今度か……いったいいつになることやら。",
  "en": ""
 },
 {
  "id": "2CC397_0E91.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと……昨日釣ったヒトデでも食べるか。",
  "en": ""
 },
 {
  "id": "2CC397_0EAF.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ようエト……ポカポカしてて気持ちがいいな。",
  "en": ""
 },
 {
  "id": "2CC397_0ECC.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 2,
  "jp": "今日もまた野生の生活が始まるのか…… / はっきり言ってうんざりだぜ。",
  "en": ""
 },
 {
  "id": "2CC397_0ECC.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "そう言うな、サントス…… / そのうちにだれかが助けてくれるさ。",
  "en": ""
 },
 {
  "id": "2CC397_0F17.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと……今日は魚でも釣るかな。",
  "en": "",
  "dup": "2E5EB7_0DBC.0"
 },
 {
  "id": "2CC397_0F2F.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "１００回に１回でいいから牛が釣れないかな。",
  "en": ""
 },
 {
  "id": "2CC397_0F52.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト殿ではないか……今日も暑いぞい。",
  "en": ""
 },
 {
  "id": "2CC397_0F6B.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "暑さだけなら我慢できるが、 / 肌がべとべとしていかんぞい。",
  "en": ""
 },
 {
  "id": "2CC397_0F90.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "たまには、肉が喰いたいぞい…… / この島には、どうして動物がいないんだぞい。",
  "en": ""
 },
 {
  "id": "2CC397_0FBE.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "この世界は…… / ルシフォンのものになってしまうのでしょうか？",
  "en": "",
  "dup": "2E5EB7_0F22.0"
 },
 {
  "id": "2CC397_0FBE.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "そんなことは絶対に許さない…… / ルシフォンなんかに取られてたまるか。",
  "en": ""
 },
 {
  "id": "2CC397_0FBE.2",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "素敵です、エトさん……あなた以外に / ロンボニ王国を継ぐ方は考えられません。",
  "en": ""
 },
 {
  "id": "2CC397_0FBE.3",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ビ、ビアンカ……その話はまたにしよう。",
  "en": ""
 },
 {
  "id": "2CC397_1047.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私、絶対にエトさんをあきらめません。",
  "en": ""
 },
 {
  "id": "2CC397_105F.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "私にはだれもおはようと言わないのだ。",
  "en": ""
 },
 {
  "id": "2CC397_1077.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネクラマンサー、自分から言えばいいんだ。",
  "en": ""
 },
 {
  "id": "2CC397_108C.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "お、お、おは……よう。",
  "en": ""
 },
 {
  "id": "2CC397_109D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてくちごもるんだ？",
  "en": ""
 },
 {
  "id": "2CC397_10AF.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 2,
  "jp": "こんなさわやかな朝におはようと言うなんて、 / 生まれて初めてのことなのだ。",
  "en": ""
 },
 {
  "id": "2CC397_10DC.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "次におはようと言うのは、１０年後だろうか。",
  "en": ""
 },
 {
  "id": "2CC397_10FB.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、エト……今日もいい天気ね。",
  "en": ""
 },
 {
  "id": "2CC397_1114.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイラ、なにをしてるんだ？",
  "en": ""
 },
 {
  "id": "2CC397_1126.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ふふふっ、すらりと伸びた脚を鍛えてたのよ。 / エト、私と競走してみない？",
  "en": ""
 },
 {
  "id": "2CC397_1126.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "いいや、遠庫しておくよ…… / 足の速さでセイラにかなうとは思えないからな。",
  "en": ""
 },
 {
  "id": "2CC397_117A.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、早くルシフォン軍と闘いたいわ。",
  "en": ""
 },
 {
  "id": "2CC397_118E.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "私ね、セイルとキスをしちゃった。",
  "en": ""
 },
 {
  "id": "2CC397_11A1.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "セイルの唇って、すっごく柔らかいの…… / エトは知ってた？",
  "en": ""
 },
 {
  "id": "2CC397_11A1.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "知ってたら大変だろ？",
  "en": ""
 },
 {
  "id": "2CC397_11D4.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……そうか。",
  "en": ""
 },
 {
  "id": "2CC397_11E1.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "セイルはどこに行ったのかなあ…… / 食事の用意はできてるのに。",
  "en": "",
  "dup": "2E5EB7_1209.0"
 },
 {
  "id": "2CC397_1203.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふう……また一日が始まってしまう。",
  "en": ""
 },
 {
  "id": "2CC397_121B.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 5,
  "jp": "なあ、俺たちはいつまで / この島にいればいいんだろう？ / ……カケルの言ってたとおり、 / 泳いでドラゴニア大陸に行った方が / いいんじゃないか？",
  "en": ""
 },
 {
  "id": "2CC397_1262.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "……早く船がとおりかかってくれないかなあ。",
  "en": ""
 },
 {
  "id": "2CC397_127C.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "で、できたあ。",
  "en": ""
 },
 {
  "id": "2CC397_1289.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ジーナ……なにができたんだ？",
  "en": ""
 },
 {
  "id": "2CC397_129C.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "火薬が作れたの……",
  "en": ""
 },
 {
  "id": "2CC397_12AD.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "火をつけてないからまだわからないけど、 / きっとうまくいくわよ。",
  "en": ""
 },
 {
  "id": "2CC397_12D1.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "この火薬を使えば、魚がいっぱい採れるわよ。",
  "en": ""
 },
 {
  "id": "2CC397_12EE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうやって採るんだ？",
  "en": ""
 },
 {
  "id": "2CC397_12FF.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "決まってるじゃない、 / 海の中に爆弾を放り込んでやるの。",
  "en": ""
 },
 {
  "id": "2CC397_12FF.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "けっこう過激なことをするんだな……。",
  "en": ""
 },
 {
  "id": "2CC397_133B.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あとで砂浜に行って、火をつけてみよっと。",
  "en": "",
  "dup": "2E5EB7_1329.0"
 },
 {
  "id": "2CC397_1358.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、おはようにょ。",
  "en": ""
 },
 {
  "id": "2CC397_1368.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、ラビット。",
  "en": ""
 },
 {
  "id": "2CC397_1376.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 2,
  "jp": "今日もいい天気だにょ。 / きっと暑くなるにょ。",
  "en": ""
 },
 {
  "id": "2CC397_1395.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "今日は魚がいっぱい採れる予感がするにょ。",
  "en": ""
 },
 {
  "id": "2CC397_13B0.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト殿、おはようでござる。",
  "en": ""
 },
 {
  "id": "2CC397_13C3.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "パウエル、おはよう。",
  "en": ""
 },
 {
  "id": "2CC397_13D1.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 1,
  "jp": "拙者、新しい小屋を建てるでござる……",
  "en": ""
 },
 {
  "id": "2CC397_13ED.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "みんなが寝れる場所を作った方が / いいでござるからな。",
  "en": ""
 },
 {
  "id": "2CC397_140C.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト殿、この島で暮らすのも / 長くなりそうでござるな。",
  "en": ""
 },
 {
  "id": "2CC397_142E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、レア。",
  "en": ""
 },
 {
  "id": "2CC397_143C.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはようございます……エトさん。",
  "en": ""
 },
 {
  "id": "2CC397_1452.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "何度も言うが…… / 私たちといっしょに闘わないか？",
  "en": ""
 },
 {
  "id": "2CC397_1452.1",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 4,
  "jp": "カケルさんにも言いましたけど、 / この島に閉じ込められているのに / いっしょに闘わないかなんてよく言えますね…… / 魚とでも闘うつもりですか？",
  "en": ""
 },
 {
  "id": "2CC397_14BB.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん……私にかまわないでください。",
  "en": ""
 },
 {
  "id": "2CC397_14D4.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おや？　ウェンディではないか。",
  "en": ""
 },
 {
  "id": "2CC397_14E6.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんとかしてよ、エトっ！！",
  "en": ""
 },
 {
  "id": "2CC397_14F9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "なにを？",
  "en": ""
 },
 {
  "id": "2CC397_1503.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの「母の愛」女のことよっ！",
  "en": "",
  "dup": "2E5EB7_1543.0"
 },
 {
  "id": "2CC397_1518.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ……マリアンのことか。",
  "en": ""
 },
 {
  "id": "2CC397_1529.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 4,
  "jp": "朝からずううぅっと / 追いかけ回されてんのよ、あたしはっ！ / あんたもリーダーなら、 / この状況をなんとかしなさいっ！！",
  "en": ""
 },
 {
  "id": "2CC397_1572.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "別にリーダーになったおばえはないが……。",
  "en": ""
 },
 {
  "id": "2CC397_158C.0",
  "speaker": "マリアンの声",
  "form": "dlg",
  "nlines": 4,
  "jp": "ウェンディさぁん……！ / どこにいったのですかぁ……！？ / あなたに私の母の愛を / 注ぎ込んであげたいのですぅ……！",
  "en": "",
  "dup": "2E5EB7_15C4.0"
 },
 {
  "id": "2CC397_15CA.0",
  "speaker": "マリアンの声",
  "form": "dlg",
  "nlines": 1,
  "jp": "おとなしく姿を見せないとぉ……",
  "en": "",
  "dup": "2E5EB7_1602.0"
 },
 {
  "id": "2CC397_15E0.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私の母の愛をたぁっぷり / 注ぎ込んじゃいますわよぉ……！！",
  "en": "",
  "dup": "2E5EB7_1618.0"
 },
 {
  "id": "2CC397_1601.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ひああああああああぁっ！！",
  "en": "",
  "dup": "2E5EB7_1639.0"
 },
 {
  "id": "2CC397_1614.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……さて、逃げきれるかな？",
  "en": ""
 },
 {
  "id": "2CC397_1627.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "も、もーだめ……。",
  "en": ""
 },
 {
  "id": "2CC397_1639.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ウェンディ、 / 「因果応報」という言葉を知っているか？",
  "en": ""
 },
 {
  "id": "2CC397_1639.1",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2D259F_17C2.1"
 },
 {
  "id": "2CC397_1665.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "知らない。",
  "en": ""
 },
 {
  "id": "2CC397_1670.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "も、もーだめ……。",
  "en": "",
  "dup": "2CC397_1627.0"
 },
 {
  "id": "2CC397_1684.0",
  "speaker": "マリアン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさん……私、母の愛を / 世界中にそそぐためにがんばりますね。",
  "en": ""
 },
 {
  "id": "2CC397_16A9.0",
  "speaker": "マリアン",
  "form": "dlg",
  "nlines": 4,
  "jp": "ウェンディさあぁぁん！ / どこにいるのですかあああっ？ / 母の愛を注いであげますから、 / 出ていらっしゃああああい！",
  "en": ""
 },
 {
  "id": "2CC397_16E6.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "（ウェンディ、見つかったら / 大変なことになるだろうな……）",
  "en": ""
 },
 {
  "id": "2CC397_1712.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、エト君……すがすがしい朝だね。",
  "en": ""
 },
 {
  "id": "2CC397_172C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "こんな朝早くから小説を書いてるのか？",
  "en": ""
 },
 {
  "id": "2CC397_1745.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もちろんさ……小説家になるためには、 / いつも努力をしてないとだめだからね。",
  "en": "",
  "dup": "2E5EB7_173D.0"
 },
 {
  "id": "2CC397_1745.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ロイドンはすばらしい / 小説家になれるな……きっと。",
  "en": ""
 },
 {
  "id": "2CC397_1745.2",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "あはははは、ありがとう…… / 誉めてくれたついでに、今日も話をしてくれよ。",
  "en": ""
 },
 {
  "id": "2CC397_1745.3",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ロイドン、島の生活を小説に書いたって / しかたないじゃないか。",
  "en": ""
 },
 {
  "id": "2CC397_1745.4",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "別に冒険じゃなくてもいいんだよ…… / さあ、今度は何色のノートに書くかな。",
  "en": ""
 },
 {
  "id": "2CC397_1813.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……今度こそ僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_079C.0"
 },
 {
  "id": "2CC397_1829.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2CC397_1832.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "2CC397_1846.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度はどのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07D0.0"
 },
 {
  "id": "2CC397_185F.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "君は何色が好きなんだい？ / 青色のノート",
  "en": "",
  "dup": "2FB86E_07EA.0"
 },
 {
  "id": "2CC397_1874.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "赤色のノート / 緑色のノート | 次の機会にする",
  "en": "",
  "dup": "2FB86E_07FF.0"
 },
 {
  "id": "2CC397_18A5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は青色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_11D8.0"
 },
 {
  "id": "2CC397_18C0.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 青色のノート",
  "en": "",
  "dup": "2FB86E_084F.0"
 },
 {
  "id": "2CC397_18D5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は赤色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_1208.0"
 },
 {
  "id": "2CC397_18F0.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 赤色のノート",
  "en": "",
  "dup": "2FB86E_0883.0"
 },
 {
  "id": "2CC397_1905.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は緑色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_1238.0"
 },
 {
  "id": "2CC397_1920.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 緑色のノート",
  "en": "",
  "dup": "2FB86E_08B8.0"
 },
 {
  "id": "2CC397_1931.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "に君の冒険を書き込もう。",
  "en": "",
  "dup": "2FB86E_08C9.0"
 },
 {
  "id": "2CC397_1931.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやあ、とても楽しかったよ…… / よかったらまた話を聞かせてくれ。",
  "en": "",
  "dup": "2FB86E_08C9.1"
 },
 {
  "id": "2CC397_1967.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "すまないが、やっぱり話をするのはやめよう。",
  "en": "",
  "dup": "2CA4C9_129A.0"
 },
 {
  "id": "2CC397_1982.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……また今度話を聞かせてくれよ。",
  "en": "",
  "dup": "2CA4C9_12B5.0"
 }
]
