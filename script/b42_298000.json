[
 {
  "id": "298000_000E.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "戻ったか、ハーディス。",
  "en": "",
  "dup": "2F72F1_000E.0"
 },
 {
  "id": "298000_001C.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "はっ……。",
  "en": "",
  "dup": "2F72F1_001C.0"
 },
 {
  "id": "298000_0026.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "これでやつらは…… / このドラゴニア大陸に渡る体勢を整えたわけだ。",
  "en": "",
  "dup": "2F72F1_0026.0"
 },
 {
  "id": "298000_0026.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2F7891_0097.0"
 },
 {
  "id": "298000_0052.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 5,
  "jp": "フ、まあよい…… / 楽しみが少し先に伸びただけのことだ。 / ご苦労だったな。 / 貴様は全力をつくしたのだろう？ / 少し休義するがよい。",
  "en": "",
  "dup": "2F72F1_0052.0"
 },
 {
  "id": "298000_0052.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "は、ははっ、ありがとうございます。 / 今度こそはカケルの首を持って帰って……。",
  "en": "",
  "dup": "2F72F1_0052.1"
 },
 {
  "id": "298000_0052.2",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "フ……それにはおよばぬ。",
  "en": "",
  "dup": "2F72F1_0052.2"
 },
 {
  "id": "298000_00E0.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "……は？ / そ、それはどういう……。",
  "en": "",
  "dup": "2F72F1_00E0.0"
 },
 {
  "id": "298000_00E0.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 4,
  "jp": "貴様は全力をつくしてなお、 / カケルを破ることができなかった。 / それは……もはやお前の力では / カケルを殺すことはできない、ということだ。",
  "en": "",
  "dup": "2F72F1_00E0.1"
 },
 {
  "id": "298000_0142.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "今後、カケルと闘う軍の指揮は、 / このリディアに取らせる。",
  "en": "",
  "dup": "2F72F1_0142.0"
 },
 {
  "id": "298000_0142.1",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 1,
  "jp": "はっ……。",
  "en": "",
  "dup": "2F72F1_0142.1"
 },
 {
  "id": "298000_0172.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "お、おのれ……そこまで私をなぶるか！",
  "en": "",
  "dup": "2F72F1_0172.0"
 },
 {
  "id": "298000_018A.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "待て、ハーディス、どこヘ行く。",
  "en": "",
  "dup": "2F72F1_018A.0"
 },
 {
  "id": "298000_019C.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 5,
  "jp": "……軍が敗れたとはいえ、 / 私が敗れたわけではないっ！ / 今度こそカケル一行の息の根を / 止めてごらんにいれる。 / それでいいのでしょう！！",
  "en": "",
  "dup": "2F72F1_019C.0"
 },
 {
  "id": "298000_019C.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ハーディス、私の命にそむくか！",
  "en": "",
  "dup": "2F72F1_019C.1"
 },
 {
  "id": "298000_01FC.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "く……。",
  "en": "",
  "dup": "2F72F1_01FC.0"
 },
 {
  "id": "298000_0205.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 4,
  "jp": "次の作戦ではリディアに協力して / カケルたちを追いつめるのだ。 / リディアはハーディスの戦力を有効に利用して、 / 今度こそやつらにとどめをさす……よいな？",
  "en": "",
  "dup": "2F72F1_0205.0"
 },
 {
  "id": "298000_025F.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "く……はっ！",
  "en": "",
  "dup": "2F72F1_025F.0"
 },
 {
  "id": "298000_026B.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ご命令とあれば。",
  "en": "",
  "dup": "2F72F1_026B.0"
 },
 {
  "id": "298000_028C.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "みんな……寝てしまいましたね。",
  "en": ""
 },
 {
  "id": "298000_02A0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ……そうみたいだな。",
  "en": ""
 },
 {
  "id": "298000_02B0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネの目的は…… / ルシフォンに会うことだって言ったな。",
  "en": ""
 },
 {
  "id": "298000_02B0.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンに会ってどうするつもりだ？ / 私たちがやつを倒そうとするのを邪魔するのか？",
  "en": ""
 },
 {
  "id": "298000_02B0.2",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "と、突然変なことを言わないでくださいっ…… / どうしてそんなことを言うのですか？",
  "en": ""
 },
 {
  "id": "298000_02B0.3",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "さあ……どうしてだろう？",
  "en": ""
 },
 {
  "id": "298000_033A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "君は遠いところからきたと私に教えてくれた。 / 私も君に話さなければならないことがある。",
  "en": ""
 },
 {
  "id": "298000_033A.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "私も遠い世界からきたのだ…… / 君からもらった黒い石でね。",
  "en": ""
 },
 {
  "id": "298000_033A.2",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "え！？",
  "en": ""
 },
 {
  "id": "298000_0399.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ……私はカケルなんだ。",
  "en": ""
 },
 {
  "id": "298000_03AB.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ヘ、変なことを言わないでください……。",
  "en": ""
 },
 {
  "id": "298000_03C3.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "黒い石がなんであるかは私も知らない…… / でも未来の君は、その使い方を知っていた。",
  "en": ""
 },
 {
  "id": "298000_03C3.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そんな……馬鹿なことが。",
  "en": ""
 },
 {
  "id": "298000_0409.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "信じてくれないのかい？",
  "en": ""
 },
 {
  "id": "298000_041B.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、当たり前です。",
  "en": ""
 },
 {
  "id": "298000_042A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ならば教えてあげよう。",
  "en": ""
 },
 {
  "id": "298000_043C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネ、こうして話をしてるのは私ではなく / 本当はカケルのはずだったんだ。",
  "en": ""
 },
 {
  "id": "298000_0460.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はカケルが寝るまでいっしょにいた。 / 過去が変えられるかどうか確認するためにね。",
  "en": ""
 },
 {
  "id": "298000_0460.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "そして今こうやって話をしてるのは、 / カケルではなくて私だ…… / しかし私がカケルの時、 / こうして話をしていたのはエトではないんだ。",
  "en": ""
 },
 {
  "id": "298000_04D8.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさん……なんのことを言ってるのか、 / 私にはわかりません。",
  "en": ""
 },
 {
  "id": "298000_04D8.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "証拠を見せてあげるよマルレーネ…… / この船は沈む。",
  "en": ""
 },
 {
  "id": "298000_04D8.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "カケルの時の私と君が、 / ここでこうやって話をしていた時…… / そう、ちょうど話し初めて / 今ぐらい時間がたった時だ。",
  "en": ""
 },
 {
  "id": "298000_0567.0",
  "speaker": "船長ザム",
  "form": "dlg",
  "nlines": 1,
  "jp": "た、大変だあっ！！",
  "en": ""
 },
 {
  "id": "298000_0576.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ほら……ね。",
  "en": ""
 },
 {
  "id": "298000_0582.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "！？",
  "en": ""
 },
 {
  "id": "298000_058A.0",
  "speaker": "船長ザム",
  "form": "dlg",
  "nlines": 2,
  "jp": "ドラゴンナイトの攻撃だあっ！！ / このままじゃ船を沈められちまうぞっ！！",
  "en": ""
 },
 {
  "id": "298000_05BA.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エ、エトっ！！",
  "en": ""
 },
 {
  "id": "298000_05C8.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルっ！！　海に飛び込めっ！！",
  "en": ""
 },
 {
  "id": "298000_05DF.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いやだあっ！！　僕は泳げないんだ！！",
  "en": ""
 },
 {
  "id": "298000_05FA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "船からできるだけ離れるんだっ！！",
  "en": ""
 },
 {
  "id": "298000_0610.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……そうしないと、 / 船といっしょに沈むことになるぞ！！",
  "en": ""
 },
 {
  "id": "298000_0630.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エ、エト！！　あ、危ないっ！！",
  "en": ""
 },
 {
  "id": "298000_064A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "マ、マルレーネ！？",
  "en": ""
 },
 {
  "id": "298000_0656.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "う……。",
  "en": ""
 },
 {
  "id": "298000_065F.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だ、大丈夫！？　マルレーネ！？",
  "en": ""
 },
 {
  "id": "298000_0670.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ヘ、平気です。",
  "en": ""
 },
 {
  "id": "298000_067D.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕につかまってっ！！ / 早く海に飛び込まないと死んじゃうよ！！",
  "en": ""
 },
 {
  "id": "298000_067D.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネさんを助けるためだったら、 / 泳いでみせるよっ！！",
  "en": ""
 },
 {
  "id": "298000_06C5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "セイルじゃだめだ！！ / ……僕は泳げる、だから僕の腕につかまって！！",
  "en": ""
 },
 {
  "id": "298000_06C5.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前はナターシャの側についていろ！！",
  "en": ""
 },
 {
  "id": "298000_0703.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネ、私といっしょに / 海に飛び込むんだ！！",
  "en": ""
 },
 {
  "id": "298000_071E.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "は、はい……。",
  "en": ""
 },
 {
  "id": "298000_072A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "みんな！！　早く飛び込めっ！！",
  "en": ""
 }
]
