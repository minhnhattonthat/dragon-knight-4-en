 },
 {
  "id": "2E5EB7_03FB.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、みんな元気だよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0433.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 2,
  "jp": "へレネとかいう娘も、訓練所のおやじも、 / ライナスとかいうガキもあの船に乗ってるぜ。",
