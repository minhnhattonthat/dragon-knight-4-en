 },
 {
  "id": "2E5EB7_02F6.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "た、助かったんだね！！",
  "en": ""
 },
 {
  "id": "2E5EB7_0307.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……ルシフォン軍の船かな？",
