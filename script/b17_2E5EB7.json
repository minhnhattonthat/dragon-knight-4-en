 },
 {
  "id": "2E5EB7_0241.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "聞こえるぞ……だれかが叫んでる声だ。",
  "en": ""
 },
 {
  "id": "2E5EB7_029A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "み、見つけたあ！！ / いや、見つけてくれたぞ！！",
  "en": ""
 },
 {
  "id": "2E5EB7_029A.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあ？",
  "en": "",
  "dup": "2FB86E_1E5D.1"
 },
 {
  "id": "2E5EB7_02C0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "船だよ、カケル！！ / こっちに向かってくるぞ！！",
