 },
 {
  "id": "2E5EB7_01FF.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前のせいだなんて言ってないじゃないか。",
  "en": ""
 },
 {
  "id": "2E5EB7_021B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2E5EB7_0223.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだよう……黙っちゃってさ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0239.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
