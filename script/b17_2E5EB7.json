 },
 {
  "id": "2E5EB7_0318.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "こうなったら、どっちでもいい……",
  "en": ""
 },
 {
  "id": "2E5EB7_032E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍の船でなければ / なんの問題もないし……",
