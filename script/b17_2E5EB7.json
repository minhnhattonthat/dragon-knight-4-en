 },
 {
  "id": "2E5EB7_0433.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……よかった。",
  "en": ""
 },
 {
  "id": "2E5EB7_046F.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 2,
  "jp": "さあ、立ち話をしてる時間はないぜ…… / みんな急いで船に乗るんだ。",
  "en": ""
 },
 {
  "id": "2E5EB7_046F.1",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 3,
  "jp": "ドラゴンナイトの連中に見つかったら、 / また船を沈められちまう…… / やつらに見つかる前に、とっとと出航しよう。",
  "en": ""
 },
 {
  "id": "2E5EB7_04D5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちょっと待ってくれ……あの船の行き先は？",
  "en": ""
 },
 {
  "id": "2E5EB7_04EE.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 1,
  "jp": "もちろんドラゴニア大陸さ……",
  "en": ""
 },
 {
  "id": "2E5EB7_04FD.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "いまさらロンボニ大陸に戻ったって、 / 黒い霧が待ってるだけさ。",
  "en": ""
 },
 {
  "id": "2E5EB7_051C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……俺に話があるんじゃないか？",
  "en": ""
 },
 {
  "id": "2E5EB7_0531.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん……もういいんだ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0541.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "これからまた闘いの日々が始まるからね…… / つまらないことで悩んでるヒマはないよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0541.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……。",
  "en": ""
 },
 {
  "id": "2E5EB7_057A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……なんだか大人になったな。",
  "en": ""
 },
 {
  "id": "2E5EB7_0590.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2E5EB7_0598.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕がいくら大人になっても…… / きっとエトにはかなわないよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0598.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてだ？",
  "en": ""
 },
 {
  "id": "2E5EB7_05C6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ナターシャは……エトが好きだもの。",
  "en": ""
 },
 {
  "id": "2E5EB7_05DC.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "2E5EB7_05E4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 3,
  "jp": "さてと、明日の朝には / ドラゴニア大陸に着くんだよね…… / エト、僕はもう寝るよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0610.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ……。",
  "en": ""
 },
 {
  "id": "2E5EB7_061F.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ららららー……。",
  "en": ""
 },
 {
  "id": "2E5EB7_062C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ……ご機嫌だね。",
  "en": ""
 },
 {
  "id": "2E5EB7_063C.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう……いい天気ね。",
  "en": ""
 },
 {
  "id": "2E5EB7_064F.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "お腹すいてない？ / ……なにか作ってあげましょうか？",
  "en": ""
 },
 {
  "id": "2E5EB7_064F.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "すいてない。",
  "en": ""
 },
 {
  "id": "2E5EB7_067B.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、服が汚れてるわよ…… / 洗濯してあげるから脱いでちょうだい。",
  "en": ""
 },
 {
  "id": "2E5EB7_067B.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "別にいいよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_06B2.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあ、じゃあ……。",
  "en": ""
 },
 {
  "id": "2E5EB7_06C1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ、いきなり優しくならないでよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_06D7.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "べ、別に優しくしてるつもりはないわよ……。",
  "en": ""
 },
 {
  "id": "2E5EB7_06F0.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ねえカケル……私、変わった？",
  "en": ""
 },
 {
  "id": "2E5EB7_0705.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "知らないよ、そんなこと。",
  "en": ""
 },
 {
  "id": "2E5EB7_0716.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……機嫌が悪いみたいね。",
  "en": ""
 },
 {
  "id": "2E5EB7_072B.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか……悲しそうな顔をしてますね。",
  "en": ""
 },
 {
  "id": "2E5EB7_0744.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そ、そう？ / 別に悲しいことなんかないよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0744.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私に相談することがあったら…… / いつでも言ってくださいね。",
  "en": ""
 },
 {
  "id": "2E5EB7_0783.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん……少し大人っぽくなってません？",
  "en": ""
 },
 {
  "id": "2E5EB7_079A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そりゃあそうだよ……",
  "en": ""
 },
 {
  "id": "2E5EB7_07AA.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネと最初に会ってから、 / もうだいぶたつもの。",
  "en": ""
 },
 {
  "id": "2E5EB7_07C6.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちがいます……",
  "en": ""
 },
 {
  "id": "2E5EB7_07D3.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "昨日のカケルさんより、今日のカケルさんの方が / ずっと大人っぽいですよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_07FA.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "もしそうだとしたら…… / 僕は大人になんかなりたくない。",
  "en": ""
 },
 {
  "id": "2E5EB7_081C.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "船の姿は……見えないですね。",
  "en": ""
 },
 {
  "id": "2E5EB7_0831.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはようございます。",
  "en": ""
 },
 {
  "id": "2E5EB7_0841.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、ネレイド……。",
  "en": ""
 },
 {
  "id": "2E5EB7_0850.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか……元気ないですよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0863.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん……ちゃんと食べてます？",
  "en": ""
 },
 {
  "id": "2E5EB7_0873.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ……早くこの島から出たいなあ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0886.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、俺にちゃんと挨拶したか？",
  "en": ""
 },
 {
  "id": "2E5EB7_089B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、カルタス。",
  "en": ""
 },
 {
  "id": "2E5EB7_08A9.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "よしよし、カケルはいいやつだな。",
  "en": ""
 },
 {
  "id": "2E5EB7_08BE.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "潮の香りにはもう飽きたよ……。",
  "en": ""
 },
 {
  "id": "2E5EB7_08D5.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿、エト殿はどこにいるのだ？",
  "en": ""
 },
 {
  "id": "2E5EB7_08EB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "知らないよ……エトのことなんか。",
  "en": ""
 },
 {
  "id": "2E5EB7_0900.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしたのだ……カケル殿。",
  "en": ""
 },
 {
  "id": "2E5EB7_0912.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "様子が変だぞ……具合でも悪いのか？",
  "en": ""
 },
 {
  "id": "2E5EB7_092A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕は元気だよ……じゃあね、カロン。",
  "en": ""
 },
 {
  "id": "2E5EB7_0940.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿……元気がないな。",
  "en": ""
 },
 {
  "id": "2E5EB7_0952.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネプチューン……なにをしてるの？",
  "en": ""
 },
 {
  "id": "2E5EB7_0964.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カラフルな魚を食べるよりは…… / 果物のほうがマシだわ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0964.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕が採ってあげようか？",
  "en": ""
 },
 {
  "id": "2E5EB7_099A.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そんなこと言うなんて…… / カケル、熱でもあるんじゃない？",
  "en": ""
 },
 {
  "id": "2E5EB7_099A.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "熱なんかないよっ…… / ネプチューンこそ、変なことを言わないでよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_09DB.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "平気よカケル、自分で採れるから。",
  "en": ""
 },
 {
  "id": "2E5EB7_09F1.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "おおおおっ！！ / こんなにりっぱなバナナが生えてるぞ。",
  "en": ""
 },
 {
  "id": "2E5EB7_09F1.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、ゴロンゴン。",
  "en": ""
 },
 {
  "id": "2E5EB7_0A1E.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "おおおおおおおっ！！ / こ、こんなに太くて長いバナナまであるぞっ！！",
  "en": ""
 },
 {
  "id": "2E5EB7_0A1E.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちぇっ……聞いちゃいない。",
  "en": ""
 },
 {
  "id": "2E5EB7_0A59.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "バナナに囲まれて生活できたら…… / もうなにも言うことはないな、うんうん。",
  "en": ""
 },
 {
  "id": "2E5EB7_0A85.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……私たちって、変な関係よね。",
  "en": ""
 },
 {
  "id": "2E5EB7_0A9D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕とパンドラが？",
  "en": ""
 },
 {
  "id": "2E5EB7_0AA9.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん、みんなって意味よ……",
  "en": ""
 },
 {
  "id": "2E5EB7_0ABD.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "だってそれぞれちがう街で生まれて、 / ちがう街で育って。",
  "en": ""
 },
 {
  "id": "2E5EB7_0ADD.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 3,
  "jp": "それで今、こうやって / いっしょにいるんですもの…… / 不思議な感じがしない？",
  "en": ""
 },
 {
  "id": "2E5EB7_0B0C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕もそう思う……不思議だよね。",
  "en": ""
 },
 {
  "id": "2E5EB7_0B22.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 4,
  "jp": "ヘえ、カケルもこういう話が / できるようになったのね…… / 前のカケルだったら、 / わからないって言ってるわよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0B5D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どういう意味だよう。",
  "en": ""
 },
 {
  "id": "2E5EB7_0B6D.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "誉めてるのよ…… / カケルがそれだけ大人になったってこと。",
  "en": ""
 },
 {
  "id": "2E5EB7_0B90.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル…… / なにもしなくても、時間だけは過ぎていくのよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0B90.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……わかってる。",
  "en": ""
 },
 {
  "id": "2E5EB7_0BC0.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさんは……どこにいるんですか？",
  "en": ""
 },
 {
  "id": "2E5EB7_0BD7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "知らない……エトのことは。",
  "en": ""
 },
 {
  "id": "2E5EB7_0BEA.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうですか……いっしょに / 朝食でもって思ったんですけど。",
  "en": ""
 },
 {
  "id": "2E5EB7_0BEA.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "やめなよ、エトとそんなことをするのは…… / 傷つくのはメイフェアだよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0BEA.2",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "ど、どうしてですか？",
  "en": ""
 },
 {
  "id": "2E5EB7_0C43.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんでもない……気にしないでくれ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0C56.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "元気がないですね…… / なにか拾って食べたんですか？",
  "en": ""
 },
 {
  "id": "2E5EB7_0C77.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれれ……元気がないな。",
  "en": ""
 },
 {
  "id": "2E5EB7_0C86.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そう？",
  "en": ""
 },
 {
  "id": "2E5EB7_0C91.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ところで……エトはどこにいるんだろ？",
  "en": ""
 },
 {
  "id": "2E5EB7_0CA7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "知らないよ……エトのことは。",
  "en": ""
 },
 {
  "id": "2E5EB7_0CBA.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちぇっ……エトといっしょに / 朝食でもって思ったんだけどな。",
  "en": ""
 },
 {
  "id": "2E5EB7_0CBA.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "やめなよ、そんなこと…… / 傷つくのはクラリスだよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0CBA.2",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ど、どうして私が傷つくんだよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0D13.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ごめん……なんでもない。",
  "en": ""
 },
 {
  "id": "2E5EB7_0D21.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、元気がないな…… / ヒトデでも食べたんじゃないか？",
  "en": ""
 },
 {
  "id": "2E5EB7_0D43.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ようカケル、ポカポカしてて気持ちがいいな。",
  "en": ""
 },
 {
  "id": "2E5EB7_0D5F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだね、昨日のキノコはまずかったね。",
  "en": ""
 },
 {
  "id": "2E5EB7_0D7A.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前……俺の話、ぜんぜん聞いてねーな。",
  "en": ""
 },
 {
  "id": "2E5EB7_0D93.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、ご、ごめん……なんて言ったの？",
  "en": ""
 },
 {
  "id": "2E5EB7_0DAA.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちぇっ……もういいよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0DBC.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと……今日は魚でも釣るかな。",
  "en": ""
 },
 {
  "id": "2E5EB7_0DD4.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿ではないか……今日も暑いぞい。",
  "en": ""
 },
 {
  "id": "2E5EB7_0DED.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2E5EB7_0DF5.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ど、どうしたのだ……元気がないではないか。",
  "en": ""
 },
 {
  "id": "2E5EB7_0E10.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "昨日食べたキノコがあたったぞい？",
  "en": ""
 },
 {
  "id": "2E5EB7_0E28.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……。",
  "en": "",
  "dup": "2E8000_13AE.1"
 },
 {
  "id": "2E5EB7_0E31.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やはりそうか……",
  "en": ""
 },
 {
  "id": "2E5EB7_0E3C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "実は私もあれを食べてから、 / ゲロゲロピーピーなのだぞい。",
  "en": ""
 },
 {
  "id": "2E5EB7_0E63.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……いい天気だからね。",
  "en": ""
 },
 {
  "id": "2E5EB7_0E75.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿……私の話を聞いてないぞい。",
  "en": ""
 },
 {
  "id": "2E5EB7_0E8C.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "今日は魚でも釣るかな。 / キノコはもうまっぴらだぞい。",
  "en": ""
 },
 {
  "id": "2E5EB7_0EB1.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あら、カケルさん……おはようございます。",
  "en": ""
 },
 {
  "id": "2E5EB7_0EC6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう。……ここでなにをしてるの？",
  "en": ""
 },
 {
  "id": "2E5EB7_0EDE.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "お父様のことを思い出してました。",
  "en": ""
 },
 {
  "id": "2E5EB7_0EF2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ロンボニの王様のことを？",
  "en": ""
 },
 {
  "id": "2E5EB7_0F07.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "石になってしまったのですね、私のお父様は。",
  "en": ""
 },
 {
  "id": "2E5EB7_0F22.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "この世界は…… / ルシフォンのものになってしまうのでしょうか？",
  "en": ""
 },
 {
  "id": "2E5EB7_0F22.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そんなことは絶対に許さないっ…… / ルシフォンなんかに取られてたまるか。",
  "en": ""
 },
 {
  "id": "2E5EB7_0F22.2",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ぽっ。",
  "en": ""
 },
 {
  "id": "2E5EB7_0F74.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ど、どうしたの？ / 僕のことをじっと見て。",
  "en": ""
 },
 {
  "id": "2E5EB7_0F74.1",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いえ……なんでもありません。",
  "en": ""
 },
 {
  "id": "2E5EB7_0FA4.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私、絶対にライムリンに行きます……。",
  "en": ""
 },
 {
  "id": "2E5EB7_0FB8.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……私にはおはようと言わないのだな。",
  "en": ""
 },
 {
  "id": "2E5EB7_0FD2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、ネクラマンサー。",
  "en": ""
 },
 {
  "id": "2E5EB7_0FE0.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 2,
  "jp": "ふん、私がおはようと言わないのだな、 / と言ったからおはようと言ってくれたのだな。",
  "en": ""
 },
 {
  "id": "2E5EB7_0FE0.1",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 2,
  "jp": "どーせ、私になんかだれも / あいさつしてくれないんだ……ぶつぶつぶつ。",
  "en": ""
 },
 {
  "id": "2E5EB7_1033.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうせ私なんか……ぐっすん。",
  "en": ""
 },
 {
  "id": "2E5EB7_1047.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、カケル……今日もいい天気ね。",
  "en": ""
 },
 {
  "id": "2E5EB7_1060.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "おはよう、セイラ…… / こんなせまい場所でなにをしてるの？",
  "en": ""
 },
 {
  "id": "2E5EB7_1060.1",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ふふふっ、すらりと伸びた脚を鍛えてたのよ。 / 小屋の間を、素早く抜ける練習をしてたの。",
  "en": ""
 },
 {
  "id": "2E5EB7_1060.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふーん……。",
  "en": "",
  "dup": "2FB86E_061B.0"
 },
 {
  "id": "2E5EB7_10B9.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度は知的な顔を洗いに行こうかしら…",
  "en": ""
 },
 {
  "id": "2E5EB7_10D6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "すらりと伸びた脚を鍛えたから / 汗をいっぱいかいちゃった。",
  "en": ""
 },
 {
  "id": "2E5EB7_10EE.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……早くルシフォン軍と闘いたいわ。",
  "en": ""
 },
 {
  "id": "2E5EB7_1103.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイル、みーつけたっ！！",
  "en": ""
 },
 {
  "id": "2E5EB7_1114.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なに！？",
  "en": ""
 },
 {
  "id": "2E5EB7_1120.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだ……カケルかあ。",
  "en": ""
 },
 {
  "id": "2E5EB7_112D.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえねえ、カケル……セイルを知らない？",
  "en": ""
 },
 {
  "id": "2E5EB7_1144.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "えーと……知らない。",
  "en": ""
 },
 {
  "id": "2E5EB7_1154.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 3,
  "jp": "どこに行ったのかしら……今日は / 朝食をいっしょに食べるって約束したのに。 / ……ふふっ。",
  "en": ""
 },
 {
  "id": "2E5EB7_1189.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "な、なんだよいきなり。 / ……気味が悪いな。",
  "en": ""
 },
 {
  "id": "2E5EB7_1189.1",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……私ね……ふふふっ。",
  "en": ""
 },
 {
  "id": "2E5EB7_11B7.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "昨日の夜、セイルとキスしちゃったのよ。 / 私、とーっても幸せ。",
  "en": ""
 },
 {
  "id": "2E5EB7_11B7.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……そうだろうね。",
  "en": ""
 },
 {
  "id": "2E5EB7_11EA.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル…… / もっと喜んでくれるかと思ったのに……。",
  "en": ""
 },
 {
  "id": "2E5EB7_1209.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "セイルはどこに行ったのかなあ…… / 食事の用意はできてるのに。",
  "en": ""
 },
 {
  "id": "2E5EB7_122B.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルっ…… / 今日こそ、黒い霧がやってくるんじゃないか？",
  "en": ""
 },
 {
  "id": "2E5EB7_122B.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして今日だと思うの？",
  "en": ""
 },
 {
  "id": "2E5EB7_125B.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "実は俺、毎日そう思ってたんだ……ははは。",
  "en": ""
 },
 {
  "id": "2E5EB7_1277.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "……早く船が通りかかってくれないかなあ。",
  "en": ""
 },
 {
  "id": "2E5EB7_1291.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、カケル……ねえ、見て見て！！",
  "en": ""
 },
 {
  "id": "2E5EB7_12A9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "黒い粉だね……もしかして火薬？",
  "en": ""
 },
 {
  "id": "2E5EB7_12C2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いったいどうやって作ったんだい？",
  "en": ""
 },
 {
  "id": "2E5EB7_12D8.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトに教えてもらったの…… / あの人、色々なことを知ってるんだから。",
  "en": ""
 },
 {
  "id": "2E5EB7_12D8.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだね……エトにはかなわないよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_1314.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "変な言い方……カケルらしくない。",
  "en": ""
 },
 {
  "id": "2E5EB7_1329.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あとで砂浜に行って、火をつけてみよっと。",
  "en": ""
 },
 {
  "id": "2E5EB7_1346.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、おはようにょ。",
  "en": ""
 },
 {
  "id": "2E5EB7_1356.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、ラビット。",
  "en": ""
 },
 {
  "id": "2E5EB7_1364.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "今日もいい天気だにょ。きっと暑くなるにょ。",
  "en": ""
 },
 {
  "id": "2E5EB7_1381.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだにょ。",
  "en": ""
 },
 {
  "id": "2E5EB7_138D.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕の真似をしないでくれにょ。",
  "en": ""
 },
 {
  "id": "2E5EB7_13A3.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル……どっちがたくさん釣れるか、 / 競争をするにょ。",
  "en": ""
 },
 {
  "id": "2E5EB7_13C7.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿、おはようでござる。",
  "en": ""
 },
 {
  "id": "2E5EB7_13DA.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 1,
  "jp": "拙者、今日も釣りをするでござる……",
  "en": ""
 },
 {
  "id": "2E5EB7_13F3.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "竿を振り回し、魚どもを / 串刺しにしてやるでござる。",
  "en": ""
 },
 {
  "id": "2E5EB7_1416.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "パウエル、それは釣りじゃないよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_1429.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル殿、ようするに魚が手に入れば / いいんでござるよ……。",
  "en": ""
 },
 {
  "id": "2E5EB7_144C.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 2,
  "jp": "拙者、ルシフォンを倒したら…… / 釣り人になるでござる。",
  "en": ""
 },
 {
  "id": "2E5EB7_146D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、レア。",
  "en": ""
 },
 {
  "id": "2E5EB7_147B.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう……。",
  "en": ""
 },
 {
  "id": "2E5EB7_1487.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえ……僕たちといっしょに闘わないか？",
  "en": ""
 },
 {
  "id": "2E5EB7_149C.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "へレネがもういないからですか？",
  "en": ""
 },
 {
  "id": "2E5EB7_14B0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そういう意味じゃないけど。",
  "en": ""
 },
 {
  "id": "2E5EB7_14C1.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 3,
  "jp": "だいたいこの島に閉じ込められているのに、 / いっしょに闘わないかなんてよく言えますね…… / 魚とでも闘うつもりですか？",
  "en": ""
 },
 {
  "id": "2E5EB7_1504.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん……私にかまわないでください。",
  "en": ""
 },
 {
  "id": "2E5EB7_1519.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれ？　ウェンディ！",
  "en": ""
 },
 {
  "id": "2E5EB7_1526.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんとかしてよ、カケルっ！！",
  "en": ""
 },
 {
  "id": "2E5EB7_1539.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なにを？",
  "en": ""
 },
 {
  "id": "2E5EB7_1543.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの「母の愛」女のことよっ！",
  "en": ""
 },
 {
  "id": "2E5EB7_1558.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "マリアンのことかあ。",
  "en": ""
 },
 {
  "id": "2E5EB7_1568.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 4,
  "jp": "朝からずううぅっと / 追いかけ回されてんのよ、あたしはっ！ / あんたも勇者タケルの息子なら、 / この状況をなんとかしなさいっ！！",
  "en": ""
 },
 {
  "id": "2E5EB7_15B5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そう言われても……。",
  "en": ""
 },
 {
  "id": "2E5EB7_15C4.0",
  "speaker": "マリアンの声",
  "form": "dlg",
  "nlines": 4,
  "jp": "ウェンディさぁん……！ / どこにいったのですかぁ……！？ / あなたに私の母の愛を / 注ぎ込んであげたいのですぅ……！",
  "en": ""
 },
 {
  "id": "2E5EB7_1602.0",
  "speaker": "マリアンの声",
  "form": "dlg",
  "nlines": 1,
  "jp": "おとなしく姿を見せないとぉ……",
  "en": ""
 },
 {
  "id": "2E5EB7_1618.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私の母の愛をたぁっぷり / 注ぎ込んじゃいますわよぉ……！！",
  "en": ""
 },
 {
  "id": "2E5EB7_1639.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ひああああああああぁっ！！",
  "en": ""
 },
 {
  "id": "2E5EB7_164C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……僕も逃げよっと。",
  "en": ""
 },
 {
  "id": "2E5EB7_165C.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 2,
  "jp": "はぁ……はぁ…… / こ、こんどこそ逃げ切ったかしら……？",
  "en": ""
 },
 {
  "id": "2E5EB7_1684.0",
  "speaker": "マリアン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさん……私、母の愛を / 世界中にそそぐためにがんばりますね。",
  "en": ""
 },
 {
  "id": "2E5EB7_16A5.0",
  "speaker": "マリアン",
  "form": "dlg",
  "nlines": 4,
  "jp": "ウェンディさあぁぁん！ / どこにいるのですかあああっ？ / 母の愛を注いであげますから、 / でていらっしゃああああい！",
  "en": ""
 },
 {
  "id": "2E5EB7_16E2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "（ウェンディ、見つかったら / 大変なことになるだろうな……）",
  "en": ""
 },
 {
  "id": "2E5EB7_170E.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "おはよう、カケル君……すがすがしい朝だね。",
  "en": ""
 },
 {
  "id": "2E5EB7_1728.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……朝から小説を書いてるの？",
  "en": ""
 },
 {
  "id": "2E5EB7_173D.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もちろんさ……小説家になるためには、 / いつも努力をしてないとだめだからね。",
  "en": ""
 },
 {
  "id": "2E5EB7_173D.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "えらいなあ……ロイドンって。",
  "en": ""
 },
 {
  "id": "2E5EB7_177C.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さあ、今日も話をしてくれるんだろ？",
  "en": ""
 },
 {
  "id": "2E5EB7_178F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "え！？　……だって、 / この島に来てから冒険なんかしてないよ。",
  "en": ""
 },
 {
  "id": "2E5EB7_178F.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "別に冒険じゃなくてもいいんだよ……",
  "en": ""
 },
 {
  "id": "2E5EB7_17D8.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……今度こそ僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_079C.0"
 },
 {
  "id": "2E5EB7_17EE.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2E5EB7_17F8.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "2E5EB7_180C.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度はどのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07D0.0"
 },
 {
  "id": "2E5EB7_1826.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "君は何色が好きなんだい？ / 青色のノート",
  "en": "",
  "dup": "2FB86E_07EA.0"
 },
 {
  "id": "2E5EB7_183B.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "赤色のノート / 緑色のノート | 次の機会にする",
  "en": "",
  "dup": "2FB86E_07FF.0"
 },
 {
  "id": "2E5EB7_186C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、青色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0830.0"
 },
 {
  "id": "2E5EB7_1883.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 青色のノート",
  "en": "",
  "dup": "2FB86E_084F.0"
 },
 {
  "id": "2E5EB7_1898.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、赤色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0864.0"
 },
 {
  "id": "2E5EB7_18AF.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 赤色のノート",
  "en": "",
  "dup": "2FB86E_0883.0"
 },
 {
  "id": "2E5EB7_18C4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、緑色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0898.0"
 },
 {
  "id": "2E5EB7_18DC.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 緑色のノート",
  "en": "",
  "dup": "2FB86E_08B8.0"
 },
 {
  "id": "2E5EB7_18ED.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "に君の冒険を書き込もう。",
  "en": "",
  "dup": "2FB86E_08C9.0"
 },
 {
  "id": "2E5EB7_18ED.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやあ、とても楽しかったよ…… / よかったらまた話を聞かせてくれ。",
  "en": "",
  "dup": "2FB86E_08C9.1"
 },
 {
  "id": "2E5EB7_192B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ごめん、やっぱり話をするのはやめるよ。",
  "en": "",
  "dup": "2FB86E_08FF.0"
 },
 {
  "id": "2E5EB7_1944.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか・・・また今度話を聞かせてくれよ。",
  "en": "",
  "dup": "2FB86E_0918.0"
 }
]
