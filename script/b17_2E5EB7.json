 },
 {
  "id": "2E5EB7_0349.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍の船なら乗ってるやつをやっつけて / 船を奪ってしまえばいい。",
  "en": ""
 },
 {
  "id": "2E5EB7_036D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……そうか。",
  "en": ""
 },
 {
  "id": "2E5EB7_037A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルも手を振るんだ、お――――いっ！！",
  "en": ""
 },
 {
  "id": "2E5EB7_0394.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "俺たちはここだぞ――――っ！！",
  "en": ""
 },
 {
  "id": "2E5EB7_03BD.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 4,
  "jp": "わっはっはっはっ！！ / やっぱり生きていやがったか！！ / タスタに流れ着かなきゃ、 / あとはここだと思ったんだ。",
  "en": ""
 },
 {
  "id": "2E5EB7_03F1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれれ！？",
  "en": ""
 },
 {
  "id": "2E5EB7_03FB.0",
  "speaker": "ザム船長",
  "form": "dlg",
  "nlines": 2,
  "jp": "よう、お互いに悪運だけは強いようだな。 / 他の仲間は元気なのか？",
