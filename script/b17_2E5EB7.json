 },
 {
  "id": "2E5EB7_02C0.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うん。",
  "en": ""
 },
 {
  "id": "2E5EB7_02E7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お――――いっ！！",
