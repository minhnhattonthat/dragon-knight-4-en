[
 {
  "id": "2F0000_000E.0",
  "speaker": "部下",
  "form": "dlg",
  "nlines": 1,
  "jp": "ハーディス様がお戻りになりました。",
  "en": ""
 },
 {
  "id": "2F0000_0021.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ハーディス、ずいぶんと遊びが過ぎているな。 / いつまで人間とたわむれているつもりだ？",
  "en": ""
 },
 {
  "id": "2F0000_0021.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……め、面目ありません。",
  "en": ""
 },
 {
  "id": "2F0000_0062.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 4,
  "jp": "魔界の者が、神の血を引くとはいえ、 / 人間ごときにこうもたびたび遅れをとるとはな。 / それともお前にカケルが倒せると思ったのは…… / この私のまちがいということか？",
  "en": ""
 },
 {
  "id": "2F0000_00BD.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そんなことは決して……。",
  "en": ""
 },
 {
  "id": "2F0000_00D0.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "まさか内通などしておるのではあるまいな？",
  "en": ""
 },
 {
  "id": "2F0000_00EC.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、それはあまりといえばあまりな……！",
  "en": ""
 },
 {
  "id": "2F0000_0105.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私とて、マノを救うためと思えばこそ、 / 全力をつくしてカケルとの闘いにのぞんで……。",
  "en": ""
 },
 {
  "id": "2F0000_0131.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "マノ……？",
  "en": ""
 },
 {
  "id": "2F0000_0146.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "今……なんと言った？",
  "en": ""
 },
 {
  "id": "2F0000_0156.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "マノだと？",
  "en": ""
 },
 {
  "id": "2F0000_015E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "偉大なる魔界の王・ミナクス様のご息女にして、 / 私の未来の妻を貴様ごときが / 呼び捨てにできると思っておるのか？",
  "en": ""
 },
 {
  "id": "2F0000_015E.1",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "お……お許しを……ルシフォン様……。",
  "en": ""
 },
 {
  "id": "2F0000_01B4.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 4,
  "jp": "身の程知らずの罰、 / 本来ならこの程度ではすまぬのだがな。 / 貴様も勇者と闘う大事な身だ、 / これくらいにしておいてやろう。",
  "en": ""
 },
 {
  "id": "2F0000_01FE.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 1,
  "jp": "は、はっ……ご配慮ありがたく……。",
  "en": ""
 },
 {
  "id": "2F0000_0216.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかったらうせろ！",
  "en": ""
 },
 {
  "id": "2F0000_0225.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "今度こそ、カケル一行を / みな殺しにして来るのだ！",
  "en": ""
 },
 {
  "id": "2F0000_0240.0",
  "speaker": "ハーディス",
  "form": "dlg",
  "nlines": 2,
  "jp": "（おのれ……いつまでも / そのえらそうな顔ができると思うなよ……）",
  "en": ""
 }
]
