  "jp": "乙乙乙……乙乙乙……。",
  "en": "",
  "dup": "2DCFE0_0BC0.0"
 },
 {
  "id": "2CDD3F_0BB1.0",
  "speaker": "サイレス",
  "form": "dlg",
  "nlines": 1,
  "jp": "乙乙乙……乙乙乙……。",
  "en": "",
  "dup": "2DCFE0_0BD0.0"
 },
 {
  "id": "2CDD3F_0BC1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "ここを出れば、 / デス・バレーの村に戻ることになる…… / 出発するのは明日の朝で、 / ついでに出口もここではない。",
  "en": ""
 },
 {
  "id": "2CDD3F_0C19.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふう……そろそろ寝るかな。",
