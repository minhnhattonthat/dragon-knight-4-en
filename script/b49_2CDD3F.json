  "nlines": 1,
  "jp": "乙乙乙……乙乙乙……。",
  "en": "",
  "dup": "2F2B41_0DC5.0"
 },
 {
  "id": "2CDD3F_0477.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ジーナ、眠れないのか？",
  "en": ""
 },
 {
  "id": "2CDD3F_0488.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……なんか色々と考えちゃって。",
  "en": ""
 },
 {
  "id": "2CDD3F_049D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "なにを考えてるんだ？ / ……よかったら、私が相談にのろう。",
  "en": ""
 },
 {
  "id": "2CDD3F_049D.1",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ううん、いいの……もう平気だから。",
  "en": ""
 },
 {
  "id": "2CDD3F_04DB.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、私は平気よ……。",
  "en": ""
 },
 {
  "id": "2CDD3F_04F1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あれれ！？）",
  "en": ""
 },
 {
  "id": "2CDD3F_04FC.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん……。",
  "en": "",
  "dup": "2DCFE0_0513.0"
 },
 {
  "id": "2CDD3F_0505.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ん……。",
  "en": "",
  "dup": "2DCFE0_0533.0"
 },
 {
  "id": "2CDD3F_050E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……どう？",
  "en": "",
  "dup": "2DCFE0_055E.0"
 },
 {
  "id": "2CDD3F_0519.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……うん……素敵だった。",
  "en": "",
  "dup": "2DCFE0_0569.0"
 },
 {
  "id": "2CDD3F_052F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（お前たち、いつまでキスしているつもりだ？）",
  "en": ""
 },
 {
  "id": "2CDD3F_054A.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "にょにょにょにょ……にょにょにょにょ。",
  "en": "",
  "dup": "2E34B4_2100.0"
 },
 {
  "id": "2CDD3F_0563.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぐうぐう……ぐうぐう……でござる。",
  "en": "",
  "dup": "2DCFE0_06B1.0"
 },
 {
  "id": "2CDD3F_057A.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 2,
  "jp": "寝ているドラゴンからも / 盗めそうにないにゃん。",
  "en": "",
  "dup": "2DCFE0_06C8.0"
 },
 {
  "id": "2CDD3F_0595.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はあきらめないぞ…… / マルレーネを我がものにするまでは。",
  "en": "",
  "dup": "2DAE44_16D7.0"
 },
 {
  "id": "2CDD3F_05B6.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 1,
  "jp": "おじいちゃん……別れたくないよぉ。",
  "en": "",
  "dup": "2DCFE0_0704.0"
 },
 {
  "id": "2CDD3F_05CC.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすう……すうすう。",
  "en": "",
  "dup": "2DCFE0_071A.0"
 },
 {
  "id": "2CDD3F_05E1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……おや、レアとへレネだ。",
  "en": ""
 },
 {
  "id": "2CDD3F_05F3.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "感動の再会をしたばかりだからな…… / つもる話もあるだろう。",
  "en": ""
 },
 {
  "id": "2CDD3F_0627.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "レア……。",
  "en": ""
 },
 {
  "id": "2CDD3F_0631.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいの、もうなにも言わないで……。",
  "en": ""
 },
 {
  "id": "2CDD3F_0647.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 3,
  "jp": "家にはまだ帰れないけど、 / しばらくはタスタの港街で、 / ふたりで静かに暮らしましょうね……。",
  "en": ""
 },
 {
  "id": "2CDD3F_0688.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 2,
  "jp": "なにを言うの、へレネ！ / 戦場がどんなに恐いところだか知っているの！？",
  "en": ""
 },
 {
  "id": "2CDD3F_0688.1",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "知ってる……私だって、あの人たちについて / ルシフォンの軍隊の中をくぐりぬけてきたのよ。",
  "en": ""
 },
 {
  "id": "2CDD3F_0688.2",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 2,
  "jp": "それでも闘いに参加するっていうの？ / 剣も弓も馬も、なにもできないあなたが……。",
  "en": ""
 },
 {
  "id": "2CDD3F_0688.3",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 4,
  "jp": "……レアの言うとおり、 / 私には闘うことはできないわ。 / でも、傷ついた人を手当したり、闘っている人を / 応援することくらいはできると思うの。",
  "en": ""
 },
 {
  "id": "2CDD3F_075B.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして、そこまでして……？",
  "en": ""
 },
 {
  "id": "2CDD3F_076F.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 3,
  "jp": "レア……私を闘いにまきこみたくないっていう / 気持ちは、とてもうれしいの…… / でも、私はレアに闘ってもらいたいの……。",
  "en": ""
 },
 {
  "id": "2CDD3F_07B0.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 4,
  "jp": "この闘いがはじまってから、 / ルシフォンの軍隊のために / みんなひどい目にあわされてきたわ…… / もちろん、私たちだって。",
  "en": ""
 },
 {
  "id": "2CDD3F_07F0.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 4,
  "jp": "レアはロンボニ王国一の弓使いですもの。 / きっと貴重な戦力になる…… / 私も私のやりかたでがんばるから、 / レアもがんばって！",
  "en": ""
 },
 {
  "id": "2CDD3F_0834.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "へレネ……強くなったわね。",
  "en": ""
 },
 {
  "id": "2CDD3F_0846.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……お姉ちゃん……。",
  "en": ""
 },
 {
  "id": "2CDD3F_0858.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "やあ、ウェンディ。 / あのヘんに温泉の出そうな岩場があったぞ。",
  "en": ""
 },
 {
  "id": "2CDD3F_0858.1",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……カケルになにを吹きこまれてきたのよ。",
  "en": "",
  "dup": "2DAE44_08B8.1"
 },
 {
  "id": "2CDD3F_089B.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあエト君、まだ寝ないのかい？",
  "en": ""
 },
 {
  "id": "2CDD3F_08B0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ロイドンこそ……まだ起きてるのか？",
  "en": ""
 },
 {
  "id": "2CDD3F_08C5.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ははは……僕の場合、夜の方が筆が進むんだ。",
  "en": "",
  "dup": "2DCFE0_0950.1"
 },
 {
  "id": "2CDD3F_08E3.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "机もない岩場で、よく文字が書けるな。",
  "en": ""
 },
 {
  "id": "2CDD3F_08FF.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "ははは、そんなことで文句を言うようじゃ / まだシロウトなのさ。 / ようするに道具じゃないんだ、 / 物書きは腕で書くのさ。",
  "en": ""
 },
 {
