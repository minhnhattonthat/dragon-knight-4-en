 },
 {
  "id": "2CDD3F_0A99.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 青色のノート",
  "en": "",
  "dup": "2FB86E_084F.0"
 },
 {
  "id": "2CDD3F_0AAE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は赤色のノートがいいぞ。",
