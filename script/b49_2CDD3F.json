 },
 {
  "id": "2CDD3F_0E5B.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうこなくっちゃ！！……実は僕、 / 出発したくってうずうずしてたんだ。",
