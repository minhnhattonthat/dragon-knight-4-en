 },
 {
  "id": "2CDD3F_0E5B.3",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……なんかナターシャの匂いがするな。",
  "en": ""
 },
 {
  "id": "2CDD3F_0ED5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "え？",
  "en": "",
  "dup": "2FB86E_14C4.1"
 },
