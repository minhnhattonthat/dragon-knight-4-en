 },
 {
  "id": "2CDD3F_0F0F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕は寝相が悪いから、 / 気がついたらナターシャの横にいただけだい。",
  "en": ""
 },
