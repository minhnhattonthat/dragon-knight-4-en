  "dup": "2CA4C9_1208.0"
 },
 {
  "id": "2CDD3F_0AC9.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 赤色のノート",
  "en": "",
  "dup": "2FB86E_0883.0"
 },
 {
  "id": "2CDD3F_0ADE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は緑色のノートがいいぞ。",
  "en": "",
  "dup": "2CA4C9_1238.0"
 },
 {
  "id": "2CDD3F_0AF9.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 緑色のノート",
  "en": "",
  "dup": "2FB86E_08B8.0"
 },
 {
  "id": "2CDD3F_0B0A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "に君の冒険を書き込もう。",
  "en": "",
  "dup": "2FB86E_08C9.0"
 },
 {
  "id": "2CDD3F_0B0A.1",
  "speaker": "ロイドン",
