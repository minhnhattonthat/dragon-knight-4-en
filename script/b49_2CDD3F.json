  "dup": "2FB86E_079C.0"
 },
 {
  "id": "2CDD3F_0A02.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2CDD3F_0A0B.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "2CDD3F_0A1F.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
