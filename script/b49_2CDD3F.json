[
 {
  "id": "2CDD3F_00A5.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぼ――――――っ。",
  "en": "",
  "dup": "2DCFE0_0083.0"
 },
 {
  "id": "2CDD3F_00B4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "すごいなあ、セイル…… / ドラゴンナイトになれたんだね。",
  "en": "",
  "dup": "2DCFE0_0092.0"
 },
 {
  "id": "2CDD3F_00B4.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぼ――――――っ。",
  "en": "",
  "dup": "2DCFE0_0083.0"
 },
 {
  "id": "2CDD3F_00E0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、セイルは呆然自失状態だ…… / しばらく側についててやったらどうだ？",
  "en": ""
 },
 {
  "id": "2CDD3F_00E0.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、わかったよ。",
  "en": ""
 },
 {
  "id": "2CDD3F_011F.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぼ――――――っ。",
  "en": "",
  "dup": "2DCFE0_0083.0"
 },
 {
  "id": "2CDD3F_012E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "まだ呆然自失状態か……しかたがないな。",
  "en": ""
 },
 {
  "id": "2CDD3F_014C.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぐうぐう……ぐうぐう……。",
  "en": ""
 },
 {
  "id": "2CDD3F_015E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれれ……立ったまま寝てるぞ。",
  "en": ""
 },
 {
  "id": "2CDD3F_0171.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……セイルの様子はどうだ？",
  "en": ""
 },
 {
  "id": "2CDD3F_0185.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "見てのとおりだよエト。",
  "en": ""
 },
 {
  "id": "2CDD3F_0196.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "カケル、しばらくすればセイルも / 元にもどるんじゃないか？ / ……このままそっとしておこう。",
  "en": ""
 },
 {
  "id": "2CDD3F_01CC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ふああ……エト、 / なんだか眠くなっちゃった。",
  "en": ""
 },
 {
  "id": "2CDD3F_01CC.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルもそろそろ寝た方がいいな…… / 明日の朝には出発しなければならないんだ。",
  "en": ""
 },
 {
  "id": "2CDD3F_01CC.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイルはどうするの？",
  "en": ""
 },
 {
  "id": "2CDD3F_0221.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "そのうちに疲れて寝るだろう…… / このままほっておこう。",
  "en": ""
 },
 {
  "id": "2CDD3F_0221.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかったよ、エト……じゃあおやすみ。",
  "en": ""
 },
 {
  "id": "2CDD3F_0256.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ……おやすみ、カケル。",
  "en": ""
 },
 {
  "id": "2CDD3F_027C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、僕はここで寝るよ。",
  "en": ""
 },
 {
  "id": "2CDD3F_028E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "遠慮しないで、ナターシャの横で / 寝ればいいじゃないか。",
  "en": ""
 },
 {
  "id": "2CDD3F_02AE.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふぁぁぁ……明日の朝に出発するんだよね。",
  "en": ""
 },
 {
  "id": "2CDD3F_02C7.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすうすう……うーん、カケルぅ。",
  "en": "",
  "dup": "2DE230_052A.0"
 },
 {
  "id": "2CDD3F_02D6.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか……さびしい気分になるな。",
  "en": ""
 },
 {
  "id": "2CDD3F_02EC.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすうすう……。",
  "en": "",
  "dup": "2E0000_0A22.0"
 },
 {
  "id": "2CDD3F_02F5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネ……君の瞳の色が、あの時の瞳の色に / どんどん近づいているような気がする。",
  "en": ""
 },
 {
  "id": "2CDD3F_02F5.1",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすう……すうすう……。",
  "en": ""
 },
 {
  "id": "2CDD3F_0336.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "君になにか変化があったのか……それとも、 / 君に対する私の感情が変わり始めているのか？",
  "en": ""
 },
 {
  "id": "2CDD3F_0336.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……いくら考えてもわかりそうにない。",
  "en": ""
 },
 {
  "id": "2CDD3F_0385.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすうすう……。",
  "en": "",
  "dup": "2E0000_0A22.0"
 },
 {
  "id": "2CDD3F_038E.0",
