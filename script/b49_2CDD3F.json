  "nlines": 1,
  "jp": "いいえ",
  "en": "",
  "dup": "2F9C88_11A3.0"
 },
 {
  "id": "2CDD3F_0C6C.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトさん、いろいろお世話になりました。",
