 },
 {
  "id": "2CDD3F_0C84.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "私たちはとりあえずタスタの港街に帰ります。",
  "en": ""
 },
 {
  "id": "2CDD3F_0C9D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "そこで……しばらく姉妹ふたりで / 静かに暮らしていこうと思います。",
  "en": ""
 },
 {
  "id": "2CDD3F_0CC5.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさん、 / いろいろと本当にありがとうございました。",
  "en": ""
 },
 {
  "id": "2CDD3F_0CF5.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "待ってください！",
  "en": ""
 },
 {
  "id": "2CDD3F_0D03.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 2,
  "jp": "へレネにはげまされて……決心したんです。 / 私を仲間にしてくれないでしょうか？",
  "en": ""
 },
 {
  "id": "2CDD3F_0D03.1",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 2,
  "jp": "私、へレネと私が受けた屈辱を…… / ルシフォンにも味合わせてやりたいんです。",
  "en": ""
 },
 {
  "id": "2CDD3F_0D03.2",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさん、お願いです…… / 私たちをあなたたちの仲間にしてください。",
  "en": ""
 },
 {
  "id": "2CDD3F_0D03.3",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "その言葉を待っていたよ。もちろん大歓迎さ。",
  "en": ""
 },
 {
  "id": "2CDD3F_0D9D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "レアが仲間に加わった！！",
  "en": ""
 },
 {
  "id": "2CDD3F_0DA7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "へレネが仲間に加わった！！",
  "en": ""
 },
 {
  "id": "2CDD3F_0DB1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "共にがんばろう、レア、へレネ。",
  "en": ""
 },
 {
  "id": "2CDD3F_0E3E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふあああっ……よく寝たな。",
