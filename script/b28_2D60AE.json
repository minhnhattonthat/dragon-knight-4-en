 {
  "id": "2D60AE_082E.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル殿……我々の軍隊の強さには、 / きっとルシフォンだって驚いてるぞ。",
  "en": ""
 },
 {
  "id": "2D60AE_082E.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンが驚いているかはわからないけど / 今まで一度も負けたことがないよね。",
  "en": ""
 },
 {
  "id": "2D60AE_082E.2",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル殿……ルシフォンと私と…… / どっちが好きだ？",
  "en": ""
 },
 {
  "id": "2D60AE_082E.3",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "え！？　変なことを聞かないでよ…… / もちろん、ルシフォンの方が好きだよ。",
  "en": ""
 },
 {
  "id": "2D60AE_082E.4",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "死んでやるぅ。",
  "en": ""
 },
 {
  "id": "2D60AE_08CC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カロンの方が好きだよ、ルシフォンよりも。",
  "en": ""
 },
 {
  "id": "2D60AE_08E2.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿……私は傷ついてしまったぞ。",
  "en": ""
 },
 {
  "id": "2D60AE_08FA.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォン軍ってひどいわねえ……",
  "en": ""
 },
 {
  "id": "2D60AE_090A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "なにもここまで破壊することは / ないんじゃないかしら？",
  "en": ""
 },
 {
  "id": "2D60AE_0927.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "すっごく腹が立つわ。",
  "en": ""
 },
 {
  "id": "2D60AE_0939.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "本当だ……顔が真っ黒だよ、ネプチューン。",
  "en": ""
 },
 {
  "id": "2D60AE_0951.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、それを言うなら真っ赤でしょ？ / たしかに私は色黒だけど。",
  "en": ""
 },
 {
  "id": "2D60AE_0977.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル……男の人ってさ、 / 色黒の女の子なんか好きじゃないわよね。",
  "en": ""
 },
 {
  "id": "2D60AE_0977.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そんなことはないよ……。",
  "en": ""
 },
 {
  "id": "2D60AE_09A9.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちくしょう…… / バナナが身近にないと、どうも落ち着かないな。",
  "en": ""
 },
 {
  "id": "2D60AE_09A9.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ゴロンゴンは、ルシフォンを倒したら…… / たしかバナナのチェーン店をやるんだよね。",
  "en": ""
 },
 {
  "id": "2D60AE_09A9.2",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "おうともさ……",
  "en": ""
 },
 {
  "id": "2D60AE_0A00.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "しかしその前に、ライナスとかいうガキを / しばかないと気が収まらないぜ。",
  "en": ""
 },
 {
  "id": "2D60AE_0A29.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "とっととルシフォンを倒し、 / バナナと共に一生を送ろう。",
  "en": ""
 },
 {
  "id": "2D60AE_0A49.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ねえねえ……さっき、 / エトとナターシャがキスしてるの見ちゃった。",
  "en": ""
 },
 {
  "id": "2D60AE_0A49.1",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトってなかなかやるわねえ……",
  "en": ""
 },
 {
  "id": "2D60AE_0A7B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私の知ってるだけで、 / 何人の女の子としてるのか。",
  "en": ""
 },
 {
  "id": "2D60AE_0A96.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そんなにしてるの？",
  "en": ""
 },
 {
  "id": "2D60AE_0AA7.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "あはははは、 / カケルほどじゃないかも知れないけどね。",
  "en": ""
 },
 {
  "id": "2D60AE_0AA7.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "パンドラ…… / 僕が女の子とキスをしてるの……見たの？",
  "en": ""
 },
 {
  "id": "2D60AE_0AA7.2",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……気になる？",
  "en": ""
 },
 {
  "id": "2D60AE_0AEC.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "大丈夫よ、だれにも言わないから……",
  "en": ""
 },
 {
  "id": "2D60AE_0B02.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は大人の女ですもの、 / そういうことには口がかたいのよ。",
  "en": ""
 },
 {
  "id": "2D60AE_0B23.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルちゃん、がんばって闘いましょうね。",
  "en": ""
 },
 {
  "id": "2D60AE_0B3C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルちゃんはやめてよ、もう。",
  "en": ""
 },
 {
  "id": "2D60AE_0B50.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさん…… / ルシフォンと闘う夢もかないそうですね。",
  "en": ""
 },
 {
  "id": "2D60AE_0B50.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……。",
  "en": "",
  "dup": "2E8000_13AE.1"
 },
 {
  "id": "2D60AE_0B73.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "仲間たちのことを考えると…… / 今でも眠れない時があるんです。",
  "en": ""
 },
 {
  "id": "2D60AE_0B73.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "メイフェア、あまり考えない方がいいよ……",
  "en": ""
 },
 {
  "id": "2D60AE_0BAF.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "残酷な言い方だけど、死んでいった仲間たちは / 二度と戻らないんだから。",
  "en": ""
 },
 {
  "id": "2D60AE_0BD5.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "時間が戻れば……助けてあげられるのに。",
  "en": ""
 },
 {
  "id": "2D60AE_0BEE.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 3,
  "jp": "殺された仲間のためにも、 / そしてクラリスのためにも…… / 私は絶対にルシフォンを倒します。",
  "en": ""
 },
 {
  "id": "2D60AE_0C1D.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル……ルシフォンと一戦を交えるのも、 / 夢物語じゃないようだな。",
  "en": ""
 },
 {
  "id": "2D60AE_0C1D.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん、僕たちはもうライムリン大陸にきてるんだ / ……夢なんかじゃないよ。",
  "en": ""
 },
 {
  "id": "2D60AE_0C1D.2",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "殺された仲間のことを考えるとさ…… / たまに眠れないことがあるんだ。",
  "en": ""
 },
 {
  "id": "2D60AE_0C1D.3",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "気持ちはわかるけど、あまり考えない方がいいよ",
  "en": ""
 },
 {
  "id": "2D60AE_0CA8.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……残酷な言い方だけど、 / 死んでいった仲間たちは生き返らないんだし。",
  "en": ""
 },
 {
  "id": "2D60AE_0CD0.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "そんなことはわかってるよ……。",
  "en": ""
 },
 {
  "id": "2D60AE_0CE4.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 2,
  "jp": "殺された仲間たちのためにも、 / メイフェアのためにも……がんばらないとな。",
  "en": ""
 },
 {
  "id": "2D60AE_0D0C.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん……むにゃむにゃ。",
  "en": "",
  "dup": "2D0000_0E86.0"
 },
 {
  "id": "2D60AE_0D17.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "乙乙乙……乙乙乙……。",
  "en": "",
  "dup": "2F553D_0DCE.0"
 },
 {
  "id": "2D60AE_0D27.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん……むにゃむにゃ。",
  "en": ""
 },
 {
  "id": "2D60AE_0D32.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "乙乙乙……乙乙乙……。",
  "en": "",
  "dup": "2F553D_0DEE.0"
 },
 {
  "id": "2D60AE_0D42.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ビアンカ……ここでなにをしてるの？",
  "en": ""
 },
 {
  "id": "2D60AE_0D57.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ええ、窓から西の方を見ていましたの。",
  "en": ""
 },
 {
  "id": "2D60AE_0D70.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "西の景色はどうなんだろ？",
  "en": ""
 },
 {
  "id": "2D60AE_0D82.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "黒い雲に覆われてますわ…… / 雨でも降ってるのかしら？",
  "en": ""
 },
 {
  "id": "2D60AE_0D82.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、それって……黒い霧じゃない？",
  "en": ""
 },
 {
  "id": "2D60AE_0DB9.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 2,
  "jp": "た、大変ですわ…… / また黒い霧が動き始めたのですね。",
  "en": ""
 },
 {
  "id": "2D60AE_0DD9.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん、早くここを出発しませんと……",
  "en": ""
 },
 {
  "id": "2D60AE_0DF2.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "せっかくライムリン大陸にきたことが / むだになってしまいますわ。",
  "en": ""
 },
 {
  "id": "2D60AE_0E10.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぶつぶつぶつぶつ……。",
  "en": "",
  "dup": "2F2B41_0CEF.0"
 },
 {
  "id": "2D60AE_0E1C.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぶつぶつぶつぶつ……。",
  "en": "",
  "dup": "2F2B41_0CEF.0"
 },
 {
  "id": "2D60AE_0E28.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "……はっ！？",
  "en": ""
 },
 {
  "id": "2D60AE_0E34.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 2,
  "jp": "立ったまま寝てしまったようだ…… / ぶつぶつぶつぶつ。",
  "en": ""
 },
 {
  "id": "2D60AE_0E34.1",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……いつからそこにいたんだ？",
  "en": ""
 },
 {
  "id": "2D60AE_0E67.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "たった今だよ、ネクラマンサー。",
  "en": ""
 },
 {
  "id": "2D60AE_0E77.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "私の寝顔を見なかっただろうな。",
  "en": ""
 },
 {
  "id": "2D60AE_0E8C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "見たよ。",
  "en": ""
 },
 {
  "id": "2D60AE_0E96.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "私の寝顔は……かわいかったか？",
  "en": ""
 },
 {
  "id": "2D60AE_0EAB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うん……とっても。",
  "en": ""
 },
 {
  "id": "2D60AE_0EBA.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……安心したぞ。",
  "en": ""
 },
 {
  "id": "2D60AE_0EC9.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぶつぶつぶつぶつ……。",
  "en": "",
  "dup": "2F2B41_0CEF.0"
 },
 {
  "id": "2D60AE_0ED5.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "らんらんらんっ……カケル、いやらしいわね。",
  "en": ""
 },
 {
  "id": "2D60AE_0EEF.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "すらりと伸びた脚を / 休めるてるんだから……見ないでよ。",
  "en": ""
 },
 {
  "id": "2D60AE_0F09.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、見ないでって言ってるでしょ？",
  "en": ""
 },
 {
  "id": "2D60AE_0F1E.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、セイルにマルレーネの話をしないで。",
  "en": ""
 },
 {
  "id": "2D60AE_0F34.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "いいんだよ、カケル…… / 別にマルレーネさんの話をしたって。",
  "en": ""
 },
 {
  "id": "2D60AE_0F34.1",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "だーめっ！！　そんなことばかり言ってるから、 / うまくいかないのよ。ねえ、カケル？",
  "en": ""
 },
 {
  "id": "2D60AE_0F34.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うん。",
  "en": "",
  "dup": "2E5EB7_02C0.1"
 },
 {
  "id": "2D60AE_0F8B.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだいカケル、ロザリンドの味方なの？",
  "en": ""
 },
 {
  "id": "2D60AE_0FAA.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルは私の味方よね！",
  "en": ""
 },
 {
  "id": "2D60AE_0FBA.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うん。",
  "en": "",
  "dup": "2E5EB7_02C0.1"
 },
 {
  "id": "2D60AE_0FC5.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "聞いたでしょ？　カケルは私の味方なのよ。",
  "en": ""
 },
 {
  "id": "2D60AE_0FDC.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "あーあ……いつになったら、 / マルレーネを忘れてくれるのかしら？",
  "en": ""
 },
 {
  "id": "2D60AE_0FFC.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "まったく……",
  "en": ""
 },
 {
  "id": "2D60AE_1008.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "街や村を解放してもだれに誉められる / 訳でもないし、張り合いがないよなあ。",
  "en": ""
 },
 {
  "id": "2D60AE_1032.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "がんばれば、きっとだれかが / ピエールの伝記を書くよ。",
  "en": ""
 },
 {
  "id": "2D60AE_1032.1",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……それがあったな。",
  "en": ""
 },
 {
  "id": "2D60AE_1062.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 2,
  "jp": "『ピエール、栄光の伝説』か。 / ひっひっひっ、こりゃあいいや。",
  "en": ""
 },
 {
  "id": "2D60AE_108A.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンにとどめを刺すのは俺だぜ…… / そうじゃないと、伝記の結末が格好悪いからな。",
  "en": ""
 },
 {
  "id": "2D60AE_10C2.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "トルルって好きな女の子がいるのかな？",
  "en": ""
 },
 {
  "id": "2D60AE_10D8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "トルルが好きなのは、 / ドラゴンの砦にいるおじいちゃんだよ。",
  "en": ""
 },
 {
  "id": "2D60AE_10D8.1",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "えーっ！？",
  "en": ""
 },
 {
  "id": "2D60AE_1101.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん、ドラゴンの長老。",
  "en": ""
 },
 {
  "id": "2D60AE_1111.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……なーんだ、びっくりさせないでよ。",
  "en": ""
 },
 {
  "id": "2D60AE_1127.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私もドラゴンに乗せてくれないかなあ…… / トルルの横に。",
  "en": ""
 },
 {
  "id": "2D60AE_1144.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……私、ちょっとくたびれちゃった。",
  "en": ""
 },
 {
  "id": "2D60AE_1159.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "せっかくライムリン大陸にこれたんだ…… / がんばろうよ、ジーナ。",
  "en": ""
 },
 {
  "id": "2D60AE_1159.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ジーナががんばれば、エトが喜ぶと思うよ。",
  "en": ""
 },
 {
  "id": "2D60AE_1192.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルは……喜んでくれないの？",
  "en": ""
 },
 {
  "id": "2D60AE_11A7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "もちろん僕だって大喜びだよ。",
  "en": ""
 },
 {
  "id": "2D60AE_11BC.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "もうちょっと……がんばってみようかな。",
  "en": ""
 },
 {
  "id": "2D60AE_11D3.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンを倒したら、デートしてくれる？",
  "en": ""
 },
 {
  "id": "2D60AE_11E9.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "普通の女の子みたいに…… / 手をつないで、野原に行くの。",
  "en": ""
 },
 {
  "id": "2D60AE_11E9.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だったらジーナ、お弁当を作ってね。",
  "en": ""
 },
 {
  "id": "2D60AE_1224.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "もちろん作っちゃうわ……腕によりをかけて。",
  "en": ""
 },
 {
  "id": "2D60AE_1240.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そんな平和な日が……くるといいね。",
  "en": ""
 },
 {
  "id": "2D60AE_1258.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……。",
  "en": ""
 },
 {
  "id": "2D60AE_1261.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "野原ヘ……カケルとふたりでハイキングかあ。",
  "en": ""
 },
 {
  "id": "2D60AE_127F.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、本当にここはライムリン大陸かにょ？",
  "en": ""
 },
 {
  "id": "2D60AE_1294.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ライムレン大陸とか、 / ライムリソ大陸とかじゃないにょ？",
  "en": ""
 },
 {
  "id": "2D60AE_12B6.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンがいるのは、ライムリンだにょ。 / まちがえてたら大変だにょ。",
  "en": ""
 },
 {
  "id": "2D60AE_12D9.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル殿……ホワイトドラゴンが言っておったが / 黒い霧が動き始めたとは本当でござるか？",
  "en": ""
 },
 {
  "id": "2D60AE_12D9.1",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 1,
  "jp": "もし本当だとしたら、大変でござるぞ……。",
  "en": ""
 },
 {
  "id": "2D60AE_131B.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿、早く東に出発するでござる。",
  "en": ""
 },
 {
  "id": "2D60AE_1330.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、この村も荒らされてるにゃん…… / 村の住人がいないと、張り合いがないにゃん。",
  "en": ""
 },
 {
  "id": "2D60AE_1330.1",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 1,
  "jp": "仲間から盗む訳にもいかないにゃん。",
  "en": ""
 },
 {
  "id": "2D60AE_1375.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍から盗んでも、 / ロクな物持ってないにゃん。",
  "en": ""
 },
 {
  "id": "2D60AE_1390.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルから盗んでもいいかにゃん？",
  "en": ""
 },
 {
  "id": "2D60AE_13A5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕から盗んだら、 / またターニャンの身体を調べるからね。",
  "en": ""
 },
 {
  "id": "2D60AE_13C6.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 1,
  "jp": "冗談だにゃん。カケルからは盗まないにゃん。",
  "en": ""
 },
 {
  "id": "2D60AE_13DF.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 1,
  "jp": "もうマルレーネのことはあきらめたぞ。",
  "en": ""
 },
 {
  "id": "2D60AE_13F4.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 2,
  "jp": "いくら話しかけても無視されてしまうのだ！ / これ以上、私にどうすればいいというのだ。",
  "en": ""
 },
 {
  "id": "2D60AE_13F4.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "バルカン……僕はなにも言ってないよ。",
  "en": ""
 },
 {
  "id": "2D60AE_143A.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 2,
  "jp": "なにか言ってくれ……このままでは、 / 私の純なハートが破裂してしまうぞ。",
  "en": ""
 },
 {
  "id": "2D60AE_1468.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンを倒したらもう一度交際を申し込もう / ……もし断られたら、彼女をさらってやるぞ。",
  "en": ""
 },
 {
  "id": "2D60AE_149C.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ドラゴンに乗ってる時に見たんだけど…… / 西の空が妙に黒いんだ。",
  "en": ""
 },
 {
  "id": "2D60AE_149C.1",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれがうわさの黒い霧なのかな？",
  "en": ""
 },
 {
  "id": "2D60AE_14D7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……もしそうだとしたら、ここでゆっくり / 休んでいる場合じゃないと思うけど。",
  "en": ""
 },
 {
  "id": "2D60AE_14FF.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……いつこの村を出発するんだい？",
  "en": ""
 },
 {
  "id": "2D60AE_1515.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……あー……カケル？",
  "en": ""
 },
 {
  "id": "2D60AE_1524.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なあに？",
  "en": "",
  "dup": "2E8000_129C.0"
 },
 {
  "id": "2D60AE_152F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ウェンディが僕に話しかけてくるなんて / めずらしいね。",
  "en": ""
 },
 {
  "id": "2D60AE_154A.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ちょっと相談があんのよ……。",
  "en": ""
 },
 {
  "id": "2D60AE_155E.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "その……好きになっちゃったらしいの。",
  "en": ""
 },
 {
  "id": "2D60AE_1574.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイルのこと……。",
  "en": ""
 },
 {
  "id": "2D60AE_1581.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ええーっ！？　あれだけいぢめておいて、 / いまさら好きもなにもないと思うんだけど……。",
  "en": ""
 },
 {
  "id": "2D60AE_1581.1",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……あ、あれは愛情の裏返しよっ！",
  "en": ""
 },
 {
  "id": "2D60AE_15D3.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "か、かわいい……。",
  "en": ""
 },
 {
  "id": "2D60AE_15E1.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "え？",
  "en": ""
 },
 {
  "id": "2D60AE_15E9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（ウェンディってこんなにかわいかったっけ？）",
  "en": ""
 },
 {
  "id": "2D60AE_1601.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……な、なによ……人の顔を見つめないでよ。",
  "en": ""
 },
 {
  "id": "2D60AE_161A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……気づかなかったなあ。",
  "en": ""
 },
 {
  "id": "2D60AE_162C.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "え……なんのこと？",
  "en": ""
 },
 {
  "id": "2D60AE_163B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、いいのいいの、こっちのことだから。",
  "en": ""
 },
 {
  "id": "2D60AE_1652.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "で、ウェンディはセイルとマルレーネの / どっちが好きなの？",
  "en": ""
 },
 {
  "id": "2D60AE_1652.1",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……むずかしい問題だわ。",
  "en": ""
 },
 {
  "id": "2D60AE_1681.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ああ……ごめんなさい、マルレーネ様！ / あたし、けっして裏切ったわけではっ！",
  "en": ""
 },
 {
  "id": "2D60AE_16B2.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあはあはあはあ。",
  "en": ""
 },
 {
  "id": "2D60AE_16BD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ロイドン……大丈夫？",
  "en": ""
 },
 {
  "id": "2D60AE_16CA.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "や、やあカケル君……",
  "en": ""
 },
 {
  "id": "2D60AE_16D9.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "戦闘があんなに激しいものだなんて、 / 想像もしてなかったよ。",
  "en": ""
 },
 {
  "id": "2D60AE_16FD.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "平気だよ……そのうちに慣れるから。",
  "en": ""
 },
 {
  "id": "2D60AE_1715.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "でも実際に闘ったおかげで、 / すごくいい文章が書けそうだよ…… / カケル君、闘った感覚を忘れないうちに / 話をしてくれないか？",
  "en": ""
 },
 {
  "id": "2D60AE_175C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うん……どうしようかなあ。",
  "en": ""
 },
 {
  "id": "2D60AE_176C.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そんなことを言わないで協力してよ…… / さあ、今日は何色のノートがいい？",
  "en": ""
 },
 {
  "id": "2D60AE_17A5.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……今度こそ僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_079C.0"
 },
 {
  "id": "2D60AE_17BB.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2D60AE_17C5.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "2D60AE_17D9.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度はどのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07D0.0"
 },
 {
  "id": "2D60AE_17F3.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "君は何色が好きなんだい？ / 青色のノート",
  "en": "",
  "dup": "2FB86E_07EA.0"
 },
 {
  "id": "2D60AE_1808.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "赤色のノート / 緑色のノート | 次の機会にする",
  "en": "",
  "dup": "2FB86E_07FF.0"
 },
 {
  "id": "2D60AE_1839.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、青色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0830.0"
 },
 {
  "id": "2D60AE_1850.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 青色のノート",
  "en": "",
  "dup": "2FB86E_084F.0"
 },
 {
  "id": "2D60AE_1865.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、赤色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0864.0"
 },
 {
  "id": "2D60AE_187C.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 赤色のノート",
  "en": "",
  "dup": "2FB86E_0883.0"
 },
 {
  "id": "2D60AE_1891.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、緑色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0898.0"
 },
 {
  "id": "2D60AE_18A9.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 緑色のノート",
  "en": "",
  "dup": "2FB86E_08B8.0"
 },
 {
  "id": "2D60AE_18BA.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "に君の冒険を書き込もう。",
  "en": "",
  "dup": "2FB86E_08C9.0"
 },
 {
  "id": "2D60AE_18BA.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやあ、とても楽しかったよ…… / よかったらまた話を聞かせてくれ。",
  "en": "",
  "dup": "2FB86E_08C9.1"
 },
 {
  "id": "2D60AE_18F8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ごめん、やっぱり話をするのはやめるよ。",
  "en": "",
  "dup": "2FB86E_08FF.0"
 },
 {
  "id": "2D60AE_1911.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか・・・また今度話を聞かせてくれよ。",
  "en": "",
  "dup": "2FB86E_0918.0"
 },
 {
  "id": "2D60AE_193C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "またなんかしようとしてるでしょ？",
  "en": ""
 },
 {
  "id": "2D60AE_1950.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 4,
  "jp": "なんかしようったって、 / だれもいないじゃないか…… / なんかして欲しかったら、 / ここに女を連れてこいっ！！",
  "en": ""
 },
 {
  "id": "2D60AE_1990.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "連れてこいって言って…… / 逃げることはないじゃないか。",
  "en": ""
 },
 {
  "id": "2D60AE_19B0.0",
  "speaker": "ラスカス",
  "form": "dlg",
  "nlines": 3,
  "jp": "人間よ…… / ここでゆっくりしてない方がいいと思うぜ。 / たまには、西の空を見てみるんだな。",
  "en": ""
 },
 {
  "id": "2D60AE_19E7.0",
  "speaker": "ラスカス",
  "form": "dlg",
  "nlines": 2,
  "jp": "人間と話をすると知能が下がりそうだ。 / あっちに行ってくれ。",
  "en": ""
 },
 {
  "id": "2D60AE_1A0D.0",
  "speaker": "サイレス",
  "form": "dlg",
  "nlines": 1,
  "jp": "こら、半径１メートル内に近づくな。",
  "en": ""
 },
 {
  "id": "2D60AE_1A2A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえ……僕も背中に乗っていい？",
  "en": ""
 },
 {
  "id": "2D60AE_1A3E.0",
  "speaker": "サイレス",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめに決まってるだろ！！",
  "en": ""
 },
 {
  "id": "2D60AE_1A50.0",
  "speaker": "サイレス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ、人間といっしょに闘うとは……",
  "en": ""
 },
 {
  "id": "2D60AE_1A67.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ホワイトドラゴン一族の / 汚点とならなければいいが。",
  "en": ""
 },
 {
  "id": "2D60AE_1A81.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちがうってば……僕たちは東に行くんだよ。",
  "en": ""
 },
 {
  "id": "2D60AE_1AA1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふう……まだ出発しないのかなあ。",
  "en": "",
  "dup": "2D4417_1AC8.0"
 },
 {
  "id": "2D60AE_1AB6.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルっ！！",
  "en": ""
 },
 {
  "id": "2D60AE_1ACB.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあはあはあ……ひとりでどこに行くの？",
  "en": ""
 },
 {
  "id": "2D60AE_1ADC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ねえセイル……この村の東には、 / ライムリン王国があるのかな？",
  "en": ""
 },
 {
  "id": "2D60AE_1ADC.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ドラゴンに乗ってる時は、 / お城なんか見えなかったよ。",
  "en": ""
 },
 {
  "id": "2D60AE_1ADC.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ライムリン王国って、お城がないのかな？",
  "en": ""
 },
 {
  "id": "2D60AE_1B2C.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "とにかく、東に行けばわかることだよ…… / でもひとりで行っちゃだめだよ、カケル。",
  "en": ""
 },
 {
  "id": "2D60AE_1B61.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "東に向かいますか？",
  "en": "",
  "dup": "2F9C88_1191.0"
 },
 {
  "id": "2D60AE_1B6C.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "はい",
  "en": "",
  "dup": "2F9C88_119C.0"
 },
 {
  "id": "2D60AE_1B73.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "いいえ",
  "en": "",
  "dup": "2F9C88_11A3.0"
 },
 {
  "id": "2D60AE_1B85.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトおっ！！　エッチなことばかりしてないで、 / 早く東に行こうよお！！",
  "en": ""
 },
 {
  "id": "2D60AE_1B85.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "こらあ、カケルっ！！ / 変なことを言うんじゃない！！ / はあはあ、ぜいぜい。",
  "en": ""
 },
 {
  "id": "2D60AE_1BE3.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "荒い息使いだけが聞こえるけど…… / エトの姿が見えないね。",
  "en": ""
 },
 {
  "id": "2D60AE_1BE3.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "西の空を見てみろ！！ / 再び黒い霧が動き出したぞ！！ / ……みんな、急げえ！！",
  "en": ""
 },
 {
  "id": "2D60AE_1C37.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "なにが急げだよ…… / 自分はあんなことをしておいてさ。",
  "en": ""
 },
 {
  "id": "2D60AE_1C37.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あんなことって？",
  "en": ""
 },
 {
  "id": "2D60AE_1C66.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "説明するな、カケルっ！！ / さあみんな、口紅を落としてから出発だあっ！！",
  "en": ""
 },
 {
  "id": "2D60AE_1C66.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "口紅を落としてからだって、墓穴をほったね。",
  "en": ""
 },
