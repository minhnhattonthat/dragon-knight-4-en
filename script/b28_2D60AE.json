[
 {
  "id": "2D60AE_0075.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、ここがマルクスの村だぞ！！",
  "en": ""
 },
 {
  "id": "2D60AE_0088.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルさん、見てください…… / ディノの港街よりもひどい荒れようです。",
  "en": ""
 },
 {
  "id": "2D60AE_0088.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "たぶん……ルシフォン軍のしわざだろう。",
  "en": ""
 },
 {
  "id": "2D60AE_00C1.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、この村でも休息をとるの？",
  "en": ""
 },
 {
  "id": "2D60AE_00D6.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "もちろんそうだ……",
  "en": ""
 },
 {
  "id": "2D60AE_00E5.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "たとえ切株しかないような村でも、 / 休まないよりはましだろう。",
  "en": ""
 },
 {
  "id": "2D60AE_010D.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……マルレーネさんの様子が変だよ。",
  "en": ""
 },
 {
  "id": "2D60AE_0123.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "最近元気がないんだ……どうしたんだろう。",
  "en": ""
 },
 {
  "id": "2D60AE_013D.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、マルレーネさんと話をしてきたら？",
  "en": ""
 },
 {
  "id": "2D60AE_0153.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "本当はセイルが行きたいんでしょ？",
  "en": ""
 },
 {
  "id": "2D60AE_0166.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめだよ、僕なんかじゃ……役不足だもの。",
  "en": ""
 },
 {
  "id": "2D60AE_0181.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネさんが落ち込んでるとさ…… / 僕まで暗くなってきちゃうよ。",
  "en": ""
 },
 {
  "id": "2D60AE_01A8.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
