[
 {
  "id": "298744_0066.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "やっと着いたぞ……ここがライムリン大陸だ。",
  "en": "",
  "dup": "2D4417_0069.0"
 },
 {
  "id": "298744_007C.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、この港街はなんていう名前なのかしら？",
  "en": ""
 },
 {
  "id": "298744_0097.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "この港街は、ディノというんだ。",
  "en": "",
  "dup": "2D4417_00BD.0"
 },
 {
  "id": "298744_00AC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト、よく知ってるね…… / 前に一度きたことがあるの？",
  "en": "",
  "dup": "2D4417_00D2.0"
 },
 {
  "id": "298744_00AC.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いや……前に聞いたことがあるだけさ。",
  "en": "",
  "dup": "2D4417_00D2.1"
 },
 {
  "id": "298744_00E6.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ディノの東には、マルクスの村があるはずだ。 / もちろん簡単には行かせてくれないだろうがな。",
  "en": "",
  "dup": "2D4417_010C.0"
 },
 {
  "id": "298744_0114.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイルも、最近は大人っぽくなったな。",
  "en": ""
 },
 {
  "id": "298744_012C.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトって……女の子とキスしたことあるよね？",
  "en": ""
 },
 {
  "id": "298744_0146.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わっはっはっ！！　もちろんだぞ。",
  "en": ""
 },
 {
  "id": "298744_015C.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "最初からうまくいった？",
  "en": ""
 },
 {
  "id": "298744_016E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "昔の話だから忘れてしまったが…… / 最初は女性にリードしてもらったおばえがある。",
  "en": ""
 },
 {
  "id": "298744_016E.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうなんだ……エトが最初にキスした / 女の子って、どんな人なの？",
  "en": ""
 },
 {
  "id": "298744_016E.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "きれいな人だったな…… / まぶしいぐらい、美しい人だ。",
  "en": ""
 },
 {
  "id": "298744_016E.3",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うわあ……僕だったら緊張しちゃって / 声もだせないよ、きっと。",
  "en": ""
 },
 {
  "id": "298744_0208.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕も女の子にリードしてもらわないと…… / だめなのかなあ。",
  "en": ""
 },
 {
  "id": "298744_0233.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あのね、エト……僕はマルレーネと……。",
  "en": ""
 },
 {
  "id": "298744_0247.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "その話は聞きたくないな。",
  "en": ""
 },
 {
  "id": "298744_0259.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして？",
  "en": "",
  "dup": "2F9C88_00A9.0"
 },
 {
  "id": "298744_0264.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてもだ。",
  "en": "",
  "dup": "2BBE84_053C.0"
 },
 {
  "id": "298744_0271.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト……変だよ。 / なんかムキになってなあい？",
  "en": ""
 },
 {
  "id": "298744_0271.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "しつこいぞ、カケル。",
  "en": ""
 },
 {
  "id": "298744_029D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネと、ルシフォンについて話をしたのに / ……エトは聞きたくないんだね。",
  "en": ""
 },
 {
  "id": "298744_02C5.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "聞きたい",
  "en": "",
  "dup": "2ED46D_19C1.0"
 },
 {
  "id": "298744_02CE.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "聞きたくない",
  "en": "",
  "dup": "2ED46D_19CA.0"
 },
 {
  "id": "298744_02E1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "聞きたいぞ、カケル。",
  "en": ""
 },
 {
  "id": "298744_02F0.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "もう遅いよ…… / エトと話をしているうちに忘れちゃった。",
  "en": ""
 },
 {
  "id": "298744_02F0.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、あのなあ……。",
  "en": ""
 },
 {
  "id": "298744_0320.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "き、聞きたくないな……だれが聞くものか。",
  "en": ""
 },
 {
  "id": "298744_033A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか変だなあ……エトの態度。",
  "en": ""
 },
 {
  "id": "298744_0350.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……僕になにか用なの？",
  "en": ""
 },
 {
  "id": "298744_0380.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（あれれ！？）",
  "en": "",
  "dup": "2CDD3F_04F1.0"
 },
 {
  "id": "298744_038B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……前に教えてくれた人がいてね……。",
  "en": ""
 },
 {
  "id": "298744_03A3.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "……なにを？",
  "en": ""
 },
 {
  "id": "298744_03AF.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "愛っていうのは、 / 相手になにかを求めるもんじゃないんだって。",
  "en": ""
 },
 {
  "id": "298744_03AF.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ただ一生懸命に、相手の幸せを願う気持ち……",
  "en": ""
 },
 {
  "id": "298744_03EF.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "相手のために一番いいようになることを願うのが / 愛なんだってその人は言ってた。",
  "en": ""
 },
 {
  "id": "298744_041A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うまく言えないんだけど……。",
  "en": ""
 },
 {
  "id": "298744_042D.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "でも、相手を思い続けるのが大事だっていう / ことはなんとなくわかったわ。",
  "en": ""
 },
 {
  "id": "298744_042D.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（うーん……ほほえましい光景だ）",
  "en": ""
 },
 {
  "id": "298744_046B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（セイルがヤキモチをやくかもしれないな）",
  "en": ""
 },
 {
  "id": "298744_0486.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "押しの一手で、セイルにきっと私のことを / 振り返らせて見せるわっ！",
  "en": ""
 },
 {
  "id": "298744_04AF.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "どうしたんだナターシャ、元気がないな…… / またカケルとケンカでもしたのか？",
  "en": ""
 },
 {
  "id": "298744_04AF.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "やっぱりカケルは誤解してるわ……",
  "en": ""
 },
 {
  "id": "298744_04EC.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私がなにか話をしようとすると、 / 必ずエトと話してればって言うんですもの。",
  "en": ""
 },
 {
  "id": "298744_0515.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "このままだと今のカケルも…… / マルレーネさんが好きになってしまうのかしら？",
  "en": ""
 },
 {
  "id": "298744_0515.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "それは、今のカケルにしかわからない。",
  "en": ""
 },
 {
  "id": "298744_0552.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ウソつき……",
  "en": ""
 },
 {
  "id": "298744_055E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "あなたを信じれば平気だって言ったじゃない。",
  "en": ""
 },
 {
  "id": "298744_0575.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだかカケルをだましてるみたいで……",
  "en": ""
 },
 {
  "id": "298744_058D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "私……いやなの！",
  "en": ""
 },
 {
  "id": "298744_0598.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ……我慢してくれ。",
  "en": ""
 },
 {
  "id": "298744_05AA.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやいやっ……カケルが私のことを / 誤解してるなんて、絶対にいや！！",
  "en": ""
 },
 {
  "id": "298744_05DA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ……落ち着くんだ！！",
  "en": "",
  "dup": "2D4417_0304.0"
 },
 {
  "id": "298744_05ED.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトって勝手なのね……",
  "en": ""
 },
 {
  "id": "298744_05FE.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あなたはマルレーネさんが好きだから、 / 私たちのことなんかどうでもいいんでしょ！？",
  "en": ""
 },
 {
  "id": "298744_0627.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ば、バカなことを……。",
  "en": ""
 },
 {
  "id": "298744_0637.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうせ私はバカですよ！！",
  "en": ""
 },
 {
  "id": "298744_0649.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "でもバカなりに誤解を解く方法を / 考えたんだから！！",
  "en": ""
 },
 {
  "id": "298744_0668.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 3,
  "jp": "ちゃんとカケルに話せば、 / 彼だってわかってくれるはず…… / 絶対にわかってくれるわ！！",
  "en": ""
 },
 {
  "id": "298744_0693.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめだ、それをしてはいけない！！",
  "en": ""
 },
 {
  "id": "298744_06A9.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "このままカケルに誤解されてるのはいや…… / 絶対にいやなの！！",
  "en": ""
 },
 {
  "id": "298744_06A9.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ならばみんなの最後を教えてやる！！",
  "en": ""
 },
 {
  "id": "298744_06E5.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "私は見たんだ！ / ……ひとりひとりが、ルシフォンに石にされ / ……生きたまま砕かれていくのを！",
  "en": ""
 },
 {
  "id": "298744_06E5.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ナターシャ、君もだ。",
  "en": ""
 },
 {
  "id": "298744_0723.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そんな……。",
  "en": "",
  "dup": "2AC00D_0727.0"
 },
 {
  "id": "298744_0730.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はナターシャの手をにぎり……絶叫した！ / しかし……どうすることもできなかった！",
  "en": ""
 },
 {
  "id": "298744_0730.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンは……どうなったの？",
  "en": ""
 },
 {
  "id": "298744_076E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "あいつにとって私たちを殺すことは、 / 奴を殺すよりも簡単なんだ。 / やつには強大な魔力がある。",
  "en": ""
 },
 {
  "id": "298744_07A6.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "じ、じゃあ……。",
  "en": ""
 },
 {
  "id": "298744_07B3.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "またそうなることがわかっているのに、どうして / ライムリン大陸にきたのかと聞きたいんだろ？",
  "en": ""
 },
 {
  "id": "298744_07B3.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "みんなが石にされ……砕かれていった時、 / ひとりだけそこにいない人物がいた…… / その人物がいれば、 / 未来は変わるかも知れないのだ。",
  "en": ""
 },
 {
  "id": "298744_0829.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "もしかして……それがマルレーネさん？",
  "en": ""
 },
 {
  "id": "298744_083E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そう……彼女なんだ。",
  "en": ""
 },
 {
  "id": "298744_084C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ナターシャ、理解してほしい…… / 私がいなければ、再び同じことがくり返される。",
  "en": ""
 },
 {
  "id": "298744_084C.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "みんな石にされ砕かれた後、カケルだけが / 魔法をかけられ牢獄に幽閉されるんだ。",
  "en": ""
 },
 {
  "id": "298744_084C.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "どこかで過去を変えなければ、 / 永遠に同じことのくり返しだ…… / あんな悲しい光景を見るのは、 / 今の私で最後にしたいのだ。",
  "en": ""
 },
 {
  "id": "298744_08F7.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ごめんなさい……エト。",
  "en": ""
 },
 {
  "id": "298744_0904.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ、わかってくれたんだな。",
  "en": ""
 },
 {
  "id": "298744_0918.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私、自分のことばかり考えてて……",
  "en": ""
 },
 {
  "id": "298744_092E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あなたがそんな悲しい思いをしてるなんて / 知らなかった。",
  "en": ""
 },
 {
  "id": "298744_094E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "本当は言うべきことではなかったのだが……。",
  "en": ""
 },
 {
  "id": "298744_0968.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "安心して、エト…… / もう二度とカケルに話すなんて言わないわ。",
  "en": ""
 },
 {
  "id": "298744_0990.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 2,
  "jp": "どうしてあなたが悲しい目をしているのか / ……その理由がやっとわかったわ。",
  "en": ""
 },
 {
  "id": "298744_09BE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ……海を見てるのか？",
  "en": ""
 },
 {
  "id": "298744_09D1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "口をきいてくれないんだな……。",
  "en": ""
 },
 {
  "id": "298744_09E6.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私と話す時間があったら、 / ナターシャさんのところにいればいいでしょう。",
  "en": ""
 },
 {
  "id": "298744_09E6.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "私はマルレーネといっしょにいたいのだ。",
  "en": ""
 },
 {
  "id": "298744_0A22.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "よくそんなことが言えますね……",
  "en": ""
 },
 {
  "id": "298744_0A37.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私といっしょにいることは、 / あなたの大事な仲間に対する裏切り行為ですよ。",
  "en": ""
 },
 {
  "id": "298744_0A62.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "前に言ったろう、君のことを信じていると。",
  "en": ""
 },
 {
  "id": "298744_0A7D.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私の瞳の色の話ですか？",
  "en": ""
 },
 {
  "id": "298744_0A8F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あなたに対する視線に、優しさや暖かさなど / あるとは思えませんが。",
  "en": ""
 },
 {
  "id": "298744_0AB7.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "それでも……私は君のことを信じるだろう。",
  "en": ""
 },
 {
  "id": "298744_0AD2.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンは魔界の四天王のひとりなのです……",
  "en": ""
 },
 {
  "id": "298744_0AED.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あなたたち人間がまとめてかかっても、 / 勝てる相手ではありません。",
  "en": ""
 },
 {
  "id": "298744_0B11.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ま、魔界の四天王のひとり！？",
  "en": ""
 },
 {
  "id": "298744_0B27.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ここから引き返すべきです……",
  "en": ""
 },
 {
  "id": "298744_0B3D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "だいじな仲間のためにも、 / それ以外の道はありません。",
  "en": ""
 },
 {
  "id": "298744_0B5E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふ……ふふふ。",
  "en": ""
 },
 {
  "id": "298744_0B6B.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なにがおかしいのですか！？",
  "en": ""
 },
 {
  "id": "298744_0B80.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして私たちを助けようとする……",
  "en": ""
 },
 {
  "id": "298744_0B97.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "君はカケルをルシフォンの前に連れて行き、 / ルシフォンから愛されたいんじゃないのか？",
  "en": ""
 },
 {
  "id": "298744_0BBB.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "そ、それは……カケルさんがいなくても、 / ルシフォンに愛される自信があるからです。",
  "en": ""
 },
 {
  "id": "298744_0BBB.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ウソだ。",
  "en": ""
 },
 {
  "id": "298744_0BF0.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "いいかげんにしてください……もうエトさんと / 話をすることなんかありませんっ！！",
  "en": ""
 },
 {
  "id": "298744_0BF0.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ……。",
  "en": "",
  "dup": "2DE230_0C0A.0"
 },
 {
  "id": "298744_0C27.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_1406.0"
 },
 {
  "id": "298744_0C2F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてそんな悲しそうな顔をする。",
  "en": ""
 },
 {
  "id": "298744_0C47.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "別に悲しくなんかありません…… / もともとこういう顔です。",
  "en": ""
 },
 {
  "id": "298744_0C47.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ならば私が答えてあげよう…… / それは君が優しい女性だからだ。",
  "en": ""
 },
 {
  "id": "298744_0C47.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "優しいからこそ、君は悲しい顔をするんだ。",
  "en": ""
 },
 {
  "id": "298744_0CAD.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "もし君が優しさを持ち合わせていないのなら、 / 微笑みながら芝居を続けているんじゃないか？",
  "en": ""
 },
 {
  "id": "298744_0CE0.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "優しくありませんっ！！",
  "en": ""
 },
 {
  "id": "298744_0CF2.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 4,
  "jp": "ま、魔界の王の娘である私が、 / どうして優しいのですかっ！！ / ……私のことをすべて知っているように / 言わないでくださいっ！！",
  "en": ""
 },
 {
  "id": "298744_0D3A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "魔界の王の娘！？",
  "en": ""
 },
 {
  "id": "298744_0D49.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうです。",
  "en": ""
 },
 {
  "id": "298744_0D54.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私の本当の名は、 / 魔界の王ミナクスの娘……イノ。",
  "en": ""
 },
 {
  "id": "298744_0D72.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうだったのか……。",
  "en": ""
 },
 {
  "id": "298744_0D83.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私のことが大嫌いになりましたでしょ？ / あなたは神の血を引く方ですもの。",
  "en": ""
 },
 {
  "id": "298744_0D83.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "君が魔族だろうが、悪魔だろうが関係ないな。",
  "en": ""
 },
 {
  "id": "298744_0DCA.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "信じるということは、相手の姿や立場で / 変わるものではない。",
  "en": ""
 },
 {
  "id": "298744_0DEE.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "もうやめてください……エトさん。",
  "en": ""
 },
 {
  "id": "298744_0E08.0",
  "speaker": "マルレーネ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はミナクスの娘です…… / 優しいはずがありません。",
  "en": ""
 },
 {
  "id": "298744_0E2B.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ライムリン大陸って……大きいのですか？",
  "en": "",
  "dup": "2D4417_0607.0"
 },
 {
  "id": "298744_0E3C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうだな、ネレイドの胸とおなじくらいかな。",
  "en": ""
 },
 {
  "id": "298744_0E56.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "じゃあ……小さいんですね。",
  "en": ""
 },
 {
  "id": "298744_0E69.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンって、どんな人なのかしら……？",
  "en": "",
  "dup": "2D4417_065F.0"
 },
 {
  "id": "298744_0E7F.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "よう……とうとうライムリン大陸にこれたな。",
  "en": ""
 },
 {
  "id": "298744_0E93.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "しかしまあ、長い船旅だったぜ…… / 陸地に上がった時、脚がふらふらしちまったよ。",
  "en": "",
  "dup": "2D4417_0685.0"
 },
 {
  "id": "298744_0EC4.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンって……どんなやつなんだろうな？",
  "en": "",
  "dup": "2D4417_073A.0"
 },
 {
  "id": "298744_0EDC.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 3,
  "jp": "ライムリン大陸にこれたことはうれしいが、 / これでまた、カケル殿とお別れする日が / 近づいてしまったわけだ。",
  "en": ""
 },
 {
  "id": "298744_0F13.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "私は、ハーディス殿の存在を知るまでは……",
  "en": ""
 },
 {
  "id": "298744_0F2C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル殿とずっといっしょにいたいと / 思っていた。",
  "en": ""
 },
 {
  "id": "298744_0F47.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "いっしょにいて……どうするつもりだ？",
  "en": ""
 },
 {
  "id": "298744_0F5F.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "決まっているではないか…… / ひとつの部屋で暮らすのだ。",
  "en": ""
 },
 {
  "id": "298744_0F84.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お断りだ。",
  "en": ""
 },
 {
  "id": "298744_0F90.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト殿が答えることではないだろう……",
  "en": ""
 },
 {
  "id": "298744_0FA9.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル殿であれば、 / きっと首を縦に振ってくれる。",
  "en": ""
 },
 {
  "id": "298744_0FC5.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "だが今の私の気持ちは……。",
  "en": ""
 },
 {
  "id": "298744_0FD4.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト殿。私はカケル殿とハーディス殿 / ……どちらを愛せばよいのだろう？",
  "en": ""
 },
 {
  "id": "298744_0FD4.1",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_069A.1"
 },
 {
  "id": "298744_1000.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……両方いっぺんに愛するという手もあるな。",
  "en": ""
 },
 {
  "id": "298744_101D.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん……すうすうすう。",
  "en": "",
  "dup": "2D4417_07FD.0"
 },
 {
  "id": "298744_102C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ネプチューンは寝ている……。",
  "en": ""
 },
 {
  "id": "298744_103B.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ひ、ひどい……ひどすぎる。",
  "en": ""
 },
 {
  "id": "298744_104E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ゴロンゴン、 / 地面にバナナの皮を捨てたら危ないぞ。",
  "en": ""
 },
 {
  "id": "298744_104E.1",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺じゃないっ！！ / ライナスとかいう悪ガキがやりやがったんだ！！",
  "en": ""
 },
 {
  "id": "298744_104E.2",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "見つけ出したら、ただじゃおかないぜ！！",
  "en": "",
  "dup": "2D4417_0885.2"
 },
 {
  "id": "298744_10AB.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 4,
  "jp": "おおおうっ、 / 愛しのバナナが皮をひんむかれ、 / あまつさえその皮も / 捨てられちまうなんてぇ……！！",
  "en": ""
 },
 {
  "id": "298744_10E7.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルって…… / ナターシャのことが好きなのかしら？",
  "en": ""
 },
 {
  "id": "298744_10E7.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ、ナターシャもカケルが好きみたいだぞ。",
  "en": ""
 },
 {
  "id": "298744_1118.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あのねエト、女のカンなんだけど……",
  "en": ""
 },
 {
  "id": "298744_112E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケルってエトのことを / すっごく意識してるわよ。",
  "en": ""
 },
 {
  "id": "298744_114A.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "特にナターシャのことになると……ね。",
  "en": ""
 },
 {
  "id": "298744_1160.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あーあ、私も彼氏が欲しいわ……",
  "en": ""
 },
 {
  "id": "298744_1177.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "人様の恋をうんぬん言っているようじゃ、 / つまらないもの。",
  "en": ""
 },
 {
  "id": "298744_1199.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "君だったら、素敵な彼氏ができそうだな。",
  "en": ""
 },
 {
  "id": "298744_11B5.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "やだあ、エトったら…… / どんな彼氏ができると思うのお？",
  "en": ""
 },
 {
  "id": "298744_11D9.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "金持ちハゲ",
  "en": ""
 },
 {
  "id": "298744_11E6.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "二枚目の好男子 / 神経の太いやつ",
  "en": ""
 },
 {
  "id": "298744_120A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そりゃあ……金持ちハゲだろう。",
  "en": ""
 },
 {
  "id": "298744_1222.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "どうしてそうなるのよ…… / 金持ちハゲなんて、大っ嫌い。",
  "en": ""
 },
 {
  "id": "298744_1249.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そりゃあ……二枚目の好男子だろう。",
  "en": ""
 },
 {
  "id": "298744_1262.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "残念でした……私は二枚目って嫌いなの。",
  "en": ""
 },
 {
  "id": "298744_1280.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そりゃあ、とにかく神経の太いやつだろうな。",
  "en": ""
 },
 {
  "id": "298744_129E.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "どういう意味よ…… / わたしが、デリカシーなしだとでも言うの？",
  "en": ""
 },
 {
  "id": "298744_12C5.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 3,
  "jp": "彼氏の話は、ルシフォンを / 倒した後にしましょうよ…… / そうじゃないと、なんとなく現実味がないわ。",
  "en": ""
 },
 {
  "id": "298744_12F9.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすう……すうすう……。",
  "en": "",
  "dup": "2D4417_0A66.0"
 },
 {
  "id": "298744_130B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "メイフェアは寝てるな……。",
  "en": ""
 },
 {
  "id": "298744_131A.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "くうくう……すうすう……。",
  "en": "",
  "dup": "2D4417_0AC9.0"
 },
 {
  "id": "298744_132C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "クラリスは寝てるな……。",
  "en": ""
 },
 {
  "id": "298744_133B.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺がまだロンボニ王国にいる頃から、 / この街では闘いが起こってたんだろう……。",
  "en": ""
 },
 {
  "id": "298744_133B.1",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト、俺たちががんばらないと…… / この世界はルシフォンのものになっちまうぜ。",
  "en": ""
 },
 {
  "id": "298744_138D.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺たちがこの世界を救うんだ…… / うーん、やりがいがあるぜ。",
  "en": "",
  "dup": "2D4417_0B99.0"
 },
 {
  "id": "298744_13B0.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "この街はずいぶんと破壊されてるぞい。",
  "en": ""
 },
 {
  "id": "298744_13CA.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "我々が知り合ってない時から、 / この港街では闘いが起こっていたのだぞい。",
  "en": ""
 },
 {
  "id": "298744_13CA.1",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト殿、がんばらないと……この世界は / ルシフォンに乗っ取られてしまうのだろうぞい。",
  "en": ""
 },
 {
  "id": "298744_1422.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "我々がこの世界を救うのだ…… / 実にやりがいのある仕事だぞい。",
  "en": ""
 },
 {
  "id": "298744_144A.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすう……すうすう……。",
  "en": "",
  "dup": "2F2B41_0CC7.0"
 },
 {
  "id": "298744_145C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ビアンカは……寝てるな。",
  "en": ""
 },
 {
  "id": "298744_146C.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "すうすう……すうすう……。",
  "en": "",
  "dup": "2F2B41_0CC7.0"
 },
 {
  "id": "298744_147E.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 2,
  "jp": "ぶつぶつぶつ……船に乗っている時、 / だれも私に話しかけてくれなかったぞ。",
  "en": "",
  "dup": "2D4417_0C91.0"
 },
 {
  "id": "298744_147E.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "話しかけるって……ネクラマンサーは、 / ずっと甲板でげろげろしてたじゃないか。",
  "en": ""
 },
 {
  "id": "298744_147E.2",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "それでも話しかけて欲しかったのだ……ふん。",
  "en": ""
 },
 {
  "id": "298744_14E7.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぶつぶつぶつ……まだ気持ち悪いぞ。",
  "en": ""
 },
 {
  "id": "298744_14FA.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、ライナスってやつを知ってる？",
  "en": ""
 },
 {
  "id": "298744_1511.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ああ、知ってるぞ…… / 私たちのあとをつけ回している小僧だ。",
  "en": ""
 },
 {
  "id": "298744_1511.1",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 3,
  "jp": "あいつ、私のすらりと伸びた脚をみて、 / 鼻の下をのばしているのよ！？ / ……気味が悪いったらないわ。",
  "en": ""
 },
 {
  "id": "298744_1568.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイラのことが気に入ったんじゃないか？",
  "en": ""
 },
 {
  "id": "298744_157E.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "冗談じゃないわ。",
  "en": ""
 },
 {
  "id": "298744_158C.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "すらりと伸びた脚と知的な顔立ちの私が / 相手にして欲しいのはロイドンだけ。",
  "en": ""
 },
 {
  "id": "298744_15AF.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……そう。",
  "en": "",
  "dup": "2E8000_0356.0"
 },
 {
  "id": "298744_15BB.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ロイドンって、マジメすぎると思わない？",
  "en": ""
 },
 {
  "id": "298744_15D4.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "彼ったら冗談のひとつも言わないの…… / 私と話してても、いつも本の話しかしないし。",
  "en": ""
 },
 {
  "id": "298744_1605.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "もっと刺激的なおつき合いがしたいわあ。",
  "en": ""
 },
 {
  "id": "298744_1621.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト……早くルシフォンをやっつけて、 / 英雄になりたいよなあ。",
  "en": ""
 },
 {
  "id": "298744_1621.1",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 3,
  "jp": "英雄になれば、みんなが / ちやほやしてくれるだろうし…… / 女にも、もてもてだ。",
  "en": ""
 },
 {
  "id": "298744_1671.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……それからどうするんだ？",
  "en": ""
 },
 {
  "id": "298744_1684.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうなれば毎日が楽しく暮らせると / 思ったんだけど……ちがうのかな？",
  "en": ""
 },
 {
  "id": "298744_1684.1",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか、わかったぞ……",
  "en": ""
 },
 {
  "id": "298744_16BC.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "英雄になったら、また冒険の旅に出て…… / もっとすごい英雄になればいいんだ。",
  "en": ""
 },
 {
  "id": "298744_16E9.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 2,
  "jp": "待てよ……そうなると俺は、ずーっと / 冒険の旅を続けなきゃいけないことになるな。",
  "en": ""
 },
 {
  "id": "298744_1718.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト……英雄になんかならない方が、 / 気が楽かも知れないな。",
  "en": ""
 },
 {
  "id": "298744_173F.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あーあ……壁に穴を開けちゃった。",
  "en": ""
 },
 {
  "id": "298744_1756.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ジーナ、爆弾を使ったのか？",
  "en": ""
 },
 {
  "id": "298744_176A.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん、新しい爆弾の実験をしたの…… / でもまた失敗しちゃった。",
  "en": ""
 },
 {
  "id": "298744_1794.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍って……この大陸を支配するために / ずいぶんひどいことをしたみたい。",
  "en": ""
 },
 {
  "id": "298744_17C0.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ひどい目にあった人たちのためにも / ……絶対に負けられないよね。",
  "en": ""
 },
 {
  "id": "298744_17E8.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトにょ…… / またルシフォン軍との闘いが始まるにょ。",
  "en": ""
 },
 {
  "id": "298744_17E8.1",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕はがんばるにょ…… / ルシフォン軍なんか大嫌いだにょ。",
  "en": "",
  "dup": "2D4417_10C4.0"
 },
 {
  "id": "298744_1823.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "次の戦闘では、僕が大活躍する予定だにょ。",
  "en": ""
 },
 {
  "id": "298744_1842.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト殿……また闘いが始まるでござるな。",
  "en": ""
 },
 {
  "id": "298744_185C.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 2,
  "jp": "拙者、がんばるでござる…… / エト殿、見ててくだされ。",
  "en": ""
 },
 {
  "id": "298744_1880.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト、またルシフォン軍と闘うにゃん…… / お互いに気をつけるにゃん。",
  "en": ""
 },
 {
  "id": "298744_18A2.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ……海がきれいだな。",
  "en": ""
 },
 {
  "id": "298744_18B5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "298744_18BD.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネ……潮の香りがするな。",
  "en": ""
 },
 {
  "id": "298744_18D2.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "バルカン、ここから話しかけても…… / マルレーネには聞こえないんじゃないか？",
  "en": ""
 },
 {
  "id": "298744_18D2.1",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ふん、どーせ無視されるのだ / ……どこから話しかけても同じだぞ。",
  "en": ""
 },
 {
  "id": "298744_18D2.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "か、悲しすぎる……。",
  "en": ""
 },
 {
  "id": "298744_192C.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 2,
  "jp": "こうなったらやけだ…… / マルレーネに思いっきり嫌われてやる。",
  "en": ""
 },
 {
  "id": "298744_194E.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……ライムリン王国ってどこにあるの？",
  "en": ""
 },
 {
  "id": "298744_1963.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "たぶん、大陸の東端だろう。",
  "en": ""
 },
 {
  "id": "298744_1978.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 1,
  "jp": "まだ遠いんだね……ちぇっ。",
  "en": ""
 },
 {
  "id": "298744_198D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "トルル、そんなに砦に帰りたいのか？",
  "en": ""
 },
 {
  "id": "298744_19A5.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 2,
  "jp": "当たり前じゃないか……人間なんかより、 / ドラゴンの方がよっぽど優しいんだよ。",
  "en": ""
 },
 {
  "id": "298744_19A5.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "人間は……優しくないのか？",
  "en": ""
 },
 {
  "id": "298744_19E3.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 2,
  "jp": "みんながそうだとは言わないけど…… / 悪い人が多いよ、絶対。",
  "en": ""
 },
 {
  "id": "298744_1A08.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ドラゴンに乗って、偵察してこようかなあ。",
  "en": "",
  "dup": "2D4417_1304.0"
 },
 {
  "id": "298744_1A21.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "トルル、ひとりで行ったら危ないぞ……",
  "en": ""
 },
 {
  "id": "298744_1A37.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォン軍にはドラゴンナイトが / たくさんいるんだ。",
  "en": "",
  "dup": "2D4417_1332.0"
 },
 {
  "id": "298744_1A4F.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ、ウェンディだ。",
  "en": ""
 },
 {
  "id": "298744_1A5B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "最近、あんまりセイルといっしょではないな。",
  "en": ""
 },
 {
  "id": "298744_1A75.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふ、ふん！　あったりまえでしょ！",
  "en": ""
 },
 {
  "id": "298744_1A8B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あたしはあんな軟弱者、 / タイプじゃないんだからっ！",
  "en": ""
 },
 {
  "id": "298744_1AA9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "別にそんなことは聞いていないが？",
  "en": ""
 },
 {
  "id": "298744_1ABF.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "人のお風呂のぞいたりするしさ、",
  "en": ""
 },
 {
  "id": "298744_1AD6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ちょっと美人だとだれにでも / 簡単になびいちゃうしぃ。",
  "en": ""
 },
 {
  "id": "298744_1AF6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あんなの好きになる女の子って / いるものかしらねぇ。",
  "en": ""
 },
 {
  "id": "298744_1B12.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（……おまえがその物好きだろうが……）",
  "en": ""
 },
 {
  "id": "298744_1B2A.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "なによ。その沈黙は。",
  "en": ""
 },
 {
  "id": "298744_1B3C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "いっしょにいないくせに、 / セイルの話題が多いな、ウェンディ。",
  "en": ""
 },
 {
  "id": "298744_1B3C.1",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そんなことはないわよ。",
  "en": "",
  "dup": "2D4417_13F8.0"
 },
 {
  "id": "298744_1B6F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ、愛しのマルレーネ様あ！",
  "en": ""
 },
 {
  "id": "298744_1B7D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "……と、こんなもんでどう？",
  "en": ""
 },
 {
  "id": "298744_1B8D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2E8000_0139.1"
 },
 {
  "id": "298744_1B95.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ、マルレーネ様。",
  "en": "",
  "dup": "2D4417_143E.0"
 },
 {
  "id": "298744_1BA2.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（ウソのヘたなやつだ……）",
  "en": ""
 },
 {
  "id": "298744_1BB4.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 2,
  "jp": "エトさん…… / やっとライムリンにたどり着きましたね。",
  "en": ""
 },
 {
  "id": "298744_1BB4.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ああ。",
  "en": ""
 },
 {
  "id": "298744_1BD9.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 4,
  "jp": "この大陸のどこかに、 / ルシフォンはいるはずです…… / そしてルシフォンと会えば、 / 彼の目的もはっきりするでしょう。",
  "en": ""
 },
 {
  "id": "298744_1C16.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンは、この世界を支配すること以外の / 目的があるはずです……。",
  "en": ""
 },
 {
  "id": "298744_1C40.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、へレネ。なにをしているんだ？",
  "en": ""
 },
 {
  "id": "298744_1C55.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 3,
  "jp": "けがをした人の手当に使う薬や薬草を / 集めてるんですけど…… / なかなかみつかりません。",
  "en": ""
 },
 {
  "id": "298744_1C8B.0",
  "speaker": "へレネ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……見つからないなあ……。",
  "en": ""
 },
 {
  "id": "298744_1CA3.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト……僕は決心したよ。",
  "en": ""
 },
 {
  "id": "298744_1CB5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "決心したって……なにをだ？",
  "en": ""
 },
 {
  "id": "298744_1CC8.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "決まってるじゃないか…… / 僕も君たちといっしょに闘うんだ。",
  "en": "",
  "dup": "2D4417_1489.0"
 },
 {
  "id": "298744_1CC8.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ほ、本気かロイドン！？",
  "en": ""
 },
 {
  "id": "298744_1CFE.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もちろん本気さ……正直言って恐いけど、 / 自分で考えて決めたことなんだ。",
  "en": ""
 },
 {
  "id": "298744_1D2D.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もちろん本気さ……正直言って恐いけど、 / セイラと相談して決めたことなんだ。",
  "en": ""
 },
 {
  "id": "298744_1D5A.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 5,
  "jp": "とにかく僕はもう、 / 見ているだけじゃだめなんだ…… / もっとリアルな文章を書くためには、 / みんなといっしょに闘うしか / 方法がないことに気づいたんだ。",
  "en": ""
 },
 {
  "id": "298744_1D5A.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "しかし、君ひとりじゃ部隊は作れないだろう？",
  "en": ""
 },
 {
  "id": "298744_1DC6.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "この街に隠れてた連中を見つけたよ……",
  "en": ""
 },
 {
  "id": "298744_1DDD.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕と同じように弱そうなやつらだけど、 / だれもいないよりはマシだろう？",
  "en": "",
  "dup": "2D4417_15B2.0"
 },
 {
  "id": "298744_1E04.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "これでさらにリアルな冒険小説が書けるぞ！ / エト君、期待しててくれ！！",
  "en": ""
 },
 {
  "id": "298744_1E31.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "ロイドンが仲間に加わった！！",
  "en": "",
  "dup": "2D4417_1605.0"
 },
 {
  "id": "298744_1E4B.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "さてと、これで僕も仲間になれたわけだな…… / これからもよろしく頼むよ。",
  "en": ""
 },
 {
  "id": "298744_1E4B.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "大丈夫かな……。",
  "en": ""
 },
 {
  "id": "298744_1E81.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト君に迷惑をかけるつもりはないよ…… / 自分の命は、自分で守るつもりさ。",
  "en": ""
 },
 {
  "id": "298744_1E81.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "さあさあエト君、そんな顔をしてないで / 船旅のことを僕に話してくれよ……",
  "en": ""
 },
 {
  "id": "298744_1EE4.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……今度こそ僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_079C.0"
 },
 {
  "id": "298744_1EFA.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "298744_1F03.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "298744_1F17.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度はどのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07D0.0"
 },
 {
  "id": "298744_1F30.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "君は何色が好きなんだい？ / 青色のノート",
