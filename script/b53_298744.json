 },
 {
  "id": "298744_218C.0",
  "speaker": "サイレス",
  "form": "dlg",
  "nlines": 1,
  "jp": "おい……私に近づくな。",
  "en": ""
 },
 {
  "id": "298744_219E.0",
  "speaker": "サイレス",
  "form": "dlg",
  "nlines": 1,
  "jp": "私に近づくなと言っているだろう……",
  "en": ""
 },
 {
  "id": "298744_21B6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "人間の匂いがつくと、 / 砦に戻った時に嫌われるからな。",
  "en": ""
 },
 {
  "id": "298744_21D6.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、ロイドン。",
  "en": ""
 },
 {
  "id": "298744_21E1.0",
  "speaker": "ベンガル",
  "form": "dlg",
  "nlines": 2,
  "jp": "私はロイドンではない……ペンを片手に / ルシフォンと闘う戦士、ベンガル様だ。",
