  "dup": "2CA4C9_12B5.0"
 },
 {
  "id": "298744_207D.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "だれかをいぢめてやりたいなあ。",
  "en": ""
 },
 {
  "id": "298744_2095.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "……あの脚のきれーなねーちゃんは、 / どこに行ったんだろ？",
  "en": ""
 },
 {
  "id": "298744_20B6.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、ライナス。",
  "en": "",
  "dup": "2C315D_17A8.0"
 },
 {
  "id": "298744_20C3.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "げげげっ！！　どうして俺に話しかけるんだ！？",
