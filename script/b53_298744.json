  "dup": "2D4417_1A48.0"
 },
 {
  "id": "298744_2234.0",
  "speaker": "ベンガル",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、仲間を呼んでくるか……。",
  "en": "",
  "dup": "2D4417_1A5E.0"
 },
 {
  "id": "298744_224A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "ロイドンとか言うやつとは話がついているんだ… / お前たちときたらまったく幸運だぜ、 / 俺たちのような強者と知り合えたんだからな！！",
  "en": "",
  "dup": "2D4417_1A74.0"
 },
 {
  "id": "298744_22A6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "東に向かいますか？",
  "en": "",
  "dup": "2F9C88_1191.0"
 },
 {
  "id": "298744_22B1.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "はい",
  "en": "",
  "dup": "2F9C88_119C.0"
 },
 {
  "id": "298744_22B8.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "いいえ",
  "en": "",
  "dup": "2F9C88_11A3.0"
 },
 {
  "id": "298744_22CA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "よーし、みんな！！ / またルシフォン軍と闘う時がきた！！",
