 },
 {
  "id": "298744_20F1.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺がここにいるのは、俺様の勝手だい！！ / お前なんか大嫌いだっ！！",
