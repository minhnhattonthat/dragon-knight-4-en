  "dup": "2CA4C9_129A.0"
 },
 {
  "id": "298744_2053.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……また今度話を聞かせてくれよ。",
