 },
 {
  "id": "298744_22EB.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、出発するのね。",
  "en": ""
 },
 {
  "id": "298744_22F9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ナターシャ、みんなを集めてくれ！！ / マルクスの村に向かって出発するぞ！！",
  "en": ""
 },
 {
  "id": "298744_231E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "まだだ……もう少し、休んでから出発しよう。",
  "en": ""
 },
