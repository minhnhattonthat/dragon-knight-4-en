  "dup": "2FB86E_07EA.0"
 },
 {
  "id": "298744_1F45.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "赤色のノート / 緑色のノート | 次の機会にする",
  "en": "",
