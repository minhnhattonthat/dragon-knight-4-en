 },
 {
  "id": "298744_2118.0",
  "speaker": "ラスカス",
  "form": "dlg",
  "nlines": 1,
  "jp": "ライムリン大陸には初めてきたが……",
  "en": ""
 },
 {
  "id": "298744_212B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "人間の匂いが充満してて、 / 気分が悪くなってくる。",
  "en": ""
 },
 {
  "id": "298744_214A.0",
  "speaker": "ラスカス",
  "form": "dlg",
  "nlines": 2,
  "jp": "早くルシフォンを倒して、 / ドラゴニア大陸に帰りたいものだ……。",
