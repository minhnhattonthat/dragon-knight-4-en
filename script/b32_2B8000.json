[
 {
  "id": "2B8000_0005.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（こ、ここは……！？）",
  "en": ""
 },
 {
  "id": "2B8000_0015.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルっ、どこに行ってたんだよぅ……。",
  "en": "",
  "dup": "2F0269_00A5.0"
 },
 {
  "id": "2B8000_002D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえセイル……",
  "en": "",
  "dup": "2F0269_00BD.0"
 },
 {
  "id": "2B8000_0039.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "黒い霧を見に行くのと、ルシフォンってやつの / 軍隊と闘うのと、どっちがいい？",
  "en": "",
  "dup": "2F0269_00C9.0"
 },
 {
  "id": "2B8000_005E.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どっちもいやだい！！　僕は家に帰るんだ！！",
  "en": "",
  "dup": "2F0269_00EE.0"
 },
 {
  "id": "2B8000_007B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "たぶん無理だよ。",
  "en": "",
  "dup": "2F0269_010B.0"
 },
 {
  "id": "2B8000_008A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "王様が言うには、僕たちの家がある大陸は、 / すでに黒い霧に包まれてるって。",
  "en": "",
  "dup": "2F0269_011A.0"
 },
 {
  "id": "2B8000_00B4.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "じ、じゃあパパはどうなっちゃったの！？",
  "en": "",
  "dup": "2F0269_0144.0"
 },
 {
  "id": "2B8000_00CB.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "きっと元気だよ。",
  "en": "",
  "dup": "2F0269_015B.0"
 },
 {
  "id": "2B8000_00D9.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "だってだって……あの霧に包まれると、 / 石になっちゃうってみんな言ってるよ。",
  "en": "",
  "dup": "2F0269_0169.0"
 },
 {
  "id": "2B8000_00D9.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "バーンおじさんなら、石になっても元気だよ。",
  "en": "",
  "dup": "2F0269_0169.1"
 },
 {
  "id": "2B8000_011E.0",
  "speaker": "レイモンド王国兵士Ａ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ひゃああっ！！ / く、黒い霧が迫ってきたぞお！！",
  "en": "",
  "dup": "2F0269_01AE.0"
 },
 {
  "id": "2B8000_011E.1",
  "speaker": "街の住人たちＡ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ひゃああっ！！ / く、黒い霧に……包まれるう！！",
  "en": "",
  "dup": "2F0269_01AE.1"
 },
 {
  "id": "2B8000_011E.2",
  "speaker": "レイモンド王国兵士Ｂ",
  "form": "dlg",
  "nlines": 2,
  "jp": "た、隊長っ！！ / 我々に指示を与えてください！！",
  "en": "",
  "dup": "2F0269_01AE.2"
 },
 {
  "id": "2B8000_011E.3",
  "speaker": "街の住人たちＢ",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、石になんかなりたくなーい！！",
  "en": "",
  "dup": "2F0269_01AE.3"
 },
 {
  "id": "2B8000_018E.0",
  "speaker": "街の住人たちＣ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ど、どうすればいいんだあっ！！",
  "en": "",
  "dup": "2F0269_0220.0"
 },
 {
  "id": "2B8000_01AE.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "（ゆ、夢じゃないよな…… / も、もうひとりの僕が目の前にいる！？）",
  "en": ""
 },
 {
  "id": "2B8000_01AE.1",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（……）",
  "en": ""
 },
 {
  "id": "2B8000_01DC.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "（エトは僕じゃなくて、私って言ってたな）",
  "en": ""
 },
 {
  "id": "2B8000_01F5.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カ、カケル……どうすればいいの？",
  "en": "",
  "dup": "2F0269_0240.0"
 },
 {
  "id": "2B8000_020A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うーん、黒い霧も見てみたいし…… / ルシフォンの軍隊とも会ってみたいし。",
  "en": "",
  "dup": "2F0269_0255.0"
 },
 {
  "id": "2B8000_020A.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕はどっちもいやだ！！",
  "en": "",
  "dup": "2F0269_0255.1"
 },
 {
  "id": "2B8000_023E.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルっ！！　セイルっっ！！",
  "en": ""
 },
 {
  "id": "2B8000_0257.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "え！？",
  "en": "",
  "dup": "2F0269_02A0.0"
 },
 {
  "id": "2B8000_0260.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "こっちだ！！　東に行くんだ！！",
  "en": ""
 },
 {
  "id": "2B8000_0275.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "お、おじさん……だれ？",
  "en": "",
  "dup": "2F0269_02BE.0"
 },
 {
  "id": "2B8000_0286.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いいから東に逃げるんだっ！！",
  "en": ""
 },
 {
  "id": "2B8000_029A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだよ、えらそうなおじさんだな。",
  "en": "",
  "dup": "2F0269_02E3.0"
 },
 {
  "id": "2B8000_02B1.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "（そ、そうだ……たしかこの国には、 / 軍隊が組織されてたはずだぞ）",
  "en": ""
 },
 {
  "id": "2B8000_02B1.1",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 4,
  "jp": "レイモンド王国の兵士たちよ！！ / 俺の声が聞こえるか！？ / 聞こえた者は、俺たちといっしょにくるんだ！！ / じきに黒い霧がこの街を包み込むっ！！",
  "en": ""
 },
 {
  "id": "2B8000_0324.0",
  "speaker": "レイモンド王国兵士Ａ",
  "form": "dlg",
  "nlines": 2,
  "jp": "だれだか知らないけど、 / 俺たちに命令した人がいるぞ！？",
  "en": "",
  "dup": "2F0269_0345.0"
 },
 {
  "id": "2B8000_0324.1",
  "speaker": "レイモンド王国兵士Ｂ",
  "form": "dlg",
  "nlines": 1,
  "jp": "だ、だれでもいいっ……",
  "en": "",
  "dup": "2F0269_0345.1"
 },
 {
  "id": "2B8000_0357.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺たちに指示を与えた人が、 / 俺たちの隊長だあ！！",
  "en": "",
  "dup": "2F0269_0378.0"
 },
 {
  "id": "2B8000_0376.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルっ！！　セイルっ！！　急げっ！！",
  "en": ""
 },
 {
  "id": "2B8000_038E.0",
  "speaker": "レイモンド王国兵士Ａ",
  "form": "dlg",
  "nlines": 2,
  "jp": "みんなあ！！ / あの黒い鎧を着た剣士についていくんだあ！！",
  "en": "",
  "dup": "2F0269_03AE.0"
 },
 {
  "id": "2B8000_038E.1",
  "speaker": "街の住人Ａ",
  "form": "dlg",
  "nlines": 2,
  "jp": "い、息をすることができない…… / か、身体も動かないっ！！",
  "en": "",
  "dup": "2F0269_03AE.1"
 },
 {
  "id": "2B8000_038E.2",
  "speaker": "街の住人Ｂ",
  "form": "dlg",
  "nlines": 1,
  "jp": "く、苦しい……だ、だれか助けてくれえっ！",
  "en": "",
  "dup": "2F0269_03AE.2"
 },
 {
  "id": "2B8000_03EF.0",
  "speaker": "街の住人Ｃ",
  "form": "dlg",
  "nlines": 2,
  "jp": "わーん、ママあ！！ / 僕の足が石になっちゃったよお！！",
  "en": "",
  "dup": "2F0269_040F.0"
 },
 {
  "id": "2B8000_0410.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "走れっ！！　みんな走るんだっ！！",
  "en": ""
 },
 {
  "id": "2B8000_0428.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あの霧は、街を飲み込んだあと / しばらく動かないはずだ！！",
  "en": "",
  "dup": "2F0269_0448.0"
 },
 {
  "id": "2B8000_044A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ど、どうしてそんなことを知ってるの？ / ……はあはあはあ。",
  "en": "",
  "dup": "2F0269_046A.0"
 },
 {
  "id": "2B8000_044A.1",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "そ、それは……おにーさんは物知りなんだ / ……ぜいぜいぜい。",
  "en": ""
 },
 {
  "id": "2B8000_044A.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか、あやしいなあ……はあはあはあ。",
  "en": "",
  "dup": "2F0269_046A.2"
 },
 {
  "id": "2B8000_04A0.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "う、うるさいっ！！",
  "en": ""
 },
 {
  "id": "2B8000_04AF.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "しゃべってるヒマがあったら、 / 全速力で走れっ！！　とにかく走れっ！！",
  "en": "",
  "dup": "2F0269_04CF.0"
 },
 {
  "id": "2B8000_04E4.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあはあ……も、もう一歩も動けないよお。",
  "en": "",
  "dup": "2F0269_0501.0"
 },
 {
  "id": "2B8000_04FE.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "よ、よし……ここまでくれば、 / とりあえず大丈夫だろう。",
  "en": ""
 },
 {
  "id": "2B8000_04FE.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "はあはあ……ねえ、おじさんはだれ？",
  "en": "",
  "dup": "2F0269_051B.1"
 },
 {
  "id": "2B8000_0535.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "私はおじさんではない、おにーさんだ。",
  "en": ""
 },
 {
  "id": "2B8000_054D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どっちでもいいけど僕は名前を聞いたんだよ。",
  "en": "",
  "dup": "2F0269_056A.0"
 },
 {
  "id": "2B8000_0566.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、名前！？　……えーと。",
  "en": ""
 },
 {
  "id": "2B8000_0579.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふーん、エトっていうんだ。",
  "en": "",
  "dup": "2F0269_0596.0"
 },
 {
  "id": "2B8000_058B.0",
  "speaker": "未来からきたカケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト？　……そ、そう、俺の名前はエトだ。",
  "en": ""
 },
 {
  "id": "2B8000_05A5.0",
  "speaker": "レイモンド王国兵士Ａ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ぜいぜいはあはあ、み、みんな見てみろっ…… / 黒い霧が俺たちの街を包み込んでいくぞ。",
  "en": "",
  "dup": "2F0269_05C2.0"
 },
 {
  "id": "2B8000_05A5.1",
  "speaker": "レイモンド王国兵士Ｂ",
  "form": "dlg",
  "nlines": 1,
  "jp": "俺たちは……これからどうすればいいんだ？",
  "en": "",
  "dup": "2F0269_05C2.1"
 },
 {
  "id": "2B8000_05EE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "みんな聞いてくれ……はっきり言って、 / あの黒い霧が相手では勝負にならない。",
  "en": "",
  "dup": "2F0269_060B.0"
 },
 {
  "id": "2B8000_05EE.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "なぜなら、あいつには / 生命というものがないからだ…… / つまり、俺たちが住んでる世界とはちがう / 空気のようなものだ。",
  "en": "",
  "dup": "2F0269_060B.1"
 },
 {
  "id": "2B8000_065D.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ねえねえ、何度も聞くけど…… / どうして色々と知ってるの？",
  "en": "",
  "dup": "2F0269_067A.0"
 },
 {
  "id": "2B8000_065D.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル、いちいち説明してる時間はないのだ。 / みんなも俺の言うことをよく聞いてくれ。",
  "en": "",
  "dup": "2F0269_067A.1"
 },
 {
  "id": "2B8000_065D.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "西の空からは黒い霧が迫り、 / 東からはルシフォンの軍隊が迫ってくる…… / つまり俺たち、いや、すべての人間たちは / はさみ打ちにされてるんだ。",
  "en": "",
  "dup": "2F0269_067A.2"
 },
 {
  "id": "2B8000_06FC.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "なかには命乞いをして、ルシフォンの軍勢に / 加わったやつもいるだろう…… / しかし、俺たちはそんなことはしない。",
  "en": "",
  "dup": "2F0269_0719.0"
 },
 {
  "id": "2B8000_073A.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ねえ、おじさん。",
  "en": "",
  "dup": "2F0269_0757.0"
 },
 {
  "id": "2B8000_0748.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "おにーさんだ。",
  "en": "",
  "dup": "2F0269_0765.0"
 },
 {
  "id": "2B8000_0755.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "おにーさん…… / あの黒い霧って、どこから出てきたの？",
  "en": "",
  "dup": "2F0269_0772.0"
 },
 {
  "id": "2B8000_0755.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "それを説明してもなんの解決にもならないぞ。",
  "en": "",
  "dup": "2F0269_0772.1"
 },
 {
  "id": "2B8000_0790.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "わかっていることは、ここから西の大陸はすべて / 黒い霧に包まれてしまったということだけだ。",
  "en": "",
  "dup": "2F0269_07AD.0"
 },
 {
  "id": "2B8000_07C2.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "じ、じゃあ……やっぱり僕のパパも！？",
  "en": "",
  "dup": "2F0269_07DF.0"
 },
 {
  "id": "2B8000_07DA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "かわいそうだが……たぶん。",
  "en": "",
  "dup": "2F0269_07F7.0"
 },
 {
  "id": "2B8000_07ED.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うわわわわわあああああんっ！！ / パパが、パパが死んじゃったあ！！",
  "en": "",
  "dup": "2F0269_080A.0"
 },
 {
  "id": "2B8000_07ED.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイル、泣くなよ。",
  "en": "",
  "dup": "2F0269_080A.1"
 },
 {
  "id": "2B8000_0822.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うわわわわわわわんんんんんんっ！！",
  "en": "",
  "dup": "2F0269_083F.0"
 },
 {
  "id": "2B8000_0839.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "泣くなって言ってるだろ？",
  "en": "",
  "dup": "2F0269_0856.0"
 },
 {
  "id": "2B8000_084C.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わわわわわわわわわわ―――んっ！！",
  "en": "",
  "dup": "2F0269_0869.0"
 },
 {
  "id": "2B8000_086E.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぶぎゃああああああああっ！！",
  "en": "",
  "dup": "2F0269_0887.0"
 },
 {
  "id": "2B8000_087B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "こ、こら……殴ることはないだろ？",
  "en": "",
  "dup": "2F0269_0894.0"
 },
 {
  "id": "2B8000_0892.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だってこいつ、弱虫なんだもん。",
  "en": "",
  "dup": "2F0269_08AB.0"
 },
 {
  "id": "2B8000_08A9.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "強い男は、優しくないといけないぞ…… / それとも君は弱い男なのかい？",
  "en": "",
  "dup": "2F0269_08C2.0"
 },
 {
  "id": "2B8000_08A9.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぼ、僕は……強い男だい！！",
  "en": "",
  "dup": "2F0269_08C2.1"
 },
 {
  "id": "2B8000_08E5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイルも泣くのはやめるんだ……",
  "en": "",
  "dup": "2F0269_08FE.0"
 },
 {
  "id": "2B8000_08FA.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "肉親が石になってしまったのは、 / 君だけじゃない。",
  "en": "",
  "dup": "2F0269_0913.0"
 },
 {
  "id": "2B8000_091E.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だって……ひっく、ひっく。",
  "en": "",
  "dup": "2F0269_0933.0"
 },
 {
  "id": "2B8000_092E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 4,
  "jp": "いいかみんな、 / この森の東にユリシーズという街がある…… / 残念ながら、その街はルシフォンの軍勢に / 占拠されてる状態だ。",
  "en": "",
  "dup": "2F0269_0943.0"
 },
 {
  "id": "2B8000_0973.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "しかし幸いなことに、占拠してるのは先鋒隊…… / つまりたいしたやつらじゃない可能性が高い。",
  "en": "",
  "dup": "2F0269_0988.0"
 },
 {
  "id": "2B8000_0973.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "このままここにいても、やがて黒い霧が動きだし / 俺たちは結局、石の塊となりはてるだろう。",
  "en": "",
  "dup": "2F0269_0988.1"
 },
 {
  "id": "2B8000_0973.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "どうだろうみんなっ！　俺たちで力を合わせ、 / ユリシーズの街を奪い返さないか？",
  "en": "",
  "dup": "2F0269_0988.2"
 },
 {
  "id": "2B8000_0973.3",
  "speaker": "レイモンド王国兵士Ａ",
  "form": "dlg",
  "nlines": 2,
  "jp": "しかし……情けない話だけどよ、 / 俺たちは即席の軍隊なんだぜ。",
  "en": "",
  "dup": "2F0269_0988.3"
 },
 {
  "id": "2B8000_0973.4",
  "speaker": "レイモンド王国兵士Ｂ",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうだとも、いくら相手が先鋒隊だったとして / ……勝てる見込みはないよ。",
  "en": "",
  "dup": "2F0269_0988.4"
 },
 {
  "id": "2B8000_0973.5",
  "speaker": "レイモンド王国兵士Ｃ",
  "form": "dlg",
  "nlines": 1,
  "jp": "まともなのはあんたぐらいだぜ……",
  "en": "",
  "dup": "2F0269_0988.5"
 },
 {
  "id": "2B8000_0A6D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "あとは俺たち寄せ集めの兵士と / 子供ふたりじゃないか。",
  "en": "",
  "dup": "2F0269_0A82.0"
 },
 {
  "id": "2B8000_0A8D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "なあに、レイモンド王国の衛兵に聞いたんだが… / ……こいつらはただの子供じゃないらしいぞ / ……そうだろ、カケル？",
  "en": ""
 },
 {
  "id": "2B8000_0AC7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "あったりまえだい！！ / 僕はただの子供じゃない……強い子供だ！！",
  "en": "",
  "dup": "2F0269_0ADB.0"
 },
 {
  "id": "2B8000_0AC7.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぼ、僕はいやだ……パパに怒られる。",
  "en": "",
  "dup": "2F0269_0ADB.1"
 },
 {
  "id": "2B8000_0B04.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "平気だよ、バーンおじさんは石なんだから。",
  "en": "",
  "dup": "2F0269_0B18.0"
 },
 {
  "id": "2B8000_0B1C.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、石！？　……ひ、ひっく、ひっく。",
  "en": "",
  "dup": "2F0269_0B30.0"
 },
 {
  "id": "2B8000_0B34.0",
  "speaker": "レイモンド王国兵士Ａ",
  "form": "dlg",
  "nlines": 1,
  "jp": "バーンおじさん！？",
  "en": "",
  "dup": "2F0269_0B48.0"
 },
 {
  "id": "2B8000_0B43.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうさ、この泣き虫はバーンの息子……",
  "en": "",
  "dup": "2F0269_0B57.0"
 },
 {
  "id": "2B8000_0B5D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "そして見るからになまいきそうなこいつは、 / 「ヤマト・タケル」の息子なのさ。",
  "en": "",
  "dup": "2F0269_0B71.0"
 },
 {
  "id": "2B8000_0B8A.0",
  "speaker": "レイモンド王国兵士Ｂ",
  "form": "dlg",
  "nlines": 1,
  "jp": "タケル様に、バーン様の息子お！？",
  "en": "",
  "dup": "2F0269_0B9E.0"
 },
 {
  "id": "2B8000_0BA0.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "私とカケル、そしてセイルが / それぞれの部隊の指揮をとる……いいな？",
  "en": "",
  "dup": "2F0269_0BB4.0"
 },
 {
  "id": "2B8000_0BA0.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぼ、僕が！？",
  "en": "",
  "dup": "2F0269_0BB4.1"
 },
 {
  "id": "2B8000_0BD3.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 4,
  "jp": "そういえば、王様が僕たちに軍隊を / あずけるって言ってたよ…… / それにしても楽しみすぎるなあ…… / わくわく、わくわく。",
  "en": ""
 },
 {
  "id": "2B8000_0C17.0",
  "speaker": "レイモンド王国兵士Ｃ",
  "form": "dlg",
  "nlines": 2,
  "jp": "タケル様とバーン様の御子息なら…… / 俺は文句はない、たとえ子供でもだ。",
  "en": "",
  "dup": "2F0269_0C2A.0"
 },
 {
  "id": "2B8000_0C17.1",
  "speaker": "レイモンド王国兵士Ａ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうせここにいても、黒い霧に包まれるんだ。",
  "en": "",
  "dup": "2F0269_0C2A.1"
 },
 {
  "id": "2B8000_0C5F.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "いや、その前にルシフォンの / 先鋒隊がやってくるかな？",
  "en": "",
  "dup": "2F0269_0C72.0"
 },
 {
  "id": "2B8000_0C7C.0",
  "speaker": "レイモンド王国兵士Ｂ",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうせなら、俺たちの方から行ってやろうぜ！！",
  "en": "",
  "dup": "2F0269_0C8F.0"
 },
 {
  "id": "2B8000_0C98.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よし、これで決まった！！",
  "en": "",
  "dup": "2F0269_0CAB.0"
 },
 {
  "id": "2B8000_0CAA.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "……ユリシーズの街を解放して、 / 俺たちといっしょに闘ってくれる / 仲間を集めるんだ！！",
  "en": "",
  "dup": "2F0269_0CBD.0"
 },
 {
  "id": "2B8000_0CAA.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "わーい！！　行くよっ！！ / 僕たちは闘うんだっ！！",
  "en": "",
  "dup": "2F0269_0CBD.1"
 },
 {
  "id": "2B8000_0CAA.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "仲間たちよ！！　私のあとに続けえっ！！",
  "en": "",
  "dup": "2F0269_0CBD.2"
 }
]
