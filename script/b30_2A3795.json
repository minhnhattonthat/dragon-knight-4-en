  "en": ""
 },
 {
  "id": "2A3795_0B90.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "強がりを言ってもだめだよ。",
  "en": ""
 },
 {
  "id": "2A3795_0BA1.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふっ。私はね……余裕なんだよ、カケル君。",
  "en": ""
 },
 {
  "id": "2A3795_0BBC.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "私の言っている意味がわかるかい？",
  "en": ""
 },
 {
  "id": "2A3795_0BD2.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……こうやって君がここにくるのも、 / 私にとっては予定どおりのことだ。",
  "en": ""
 },
 {
  "id": "2A3795_0BFA.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "もっとも、息子の君が来るとは意外だったが。 / 本当は君の父親がくると思っていたのだよ。",
  "en": ""
 },
 {
  "id": "2A3795_0BFA.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 3,
  "jp": "しかし困った……君の父親ならまだしも、 / カケル君のような小僧を殺したとあっては、 / 私のプライドに傷がついてしまうな。",
  "en": ""
 },
 {
  "id": "2A3795_0C72.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "安心していいよ……プライドどころか、 / お前の全身を傷だらけにしてやる。",
  "en": ""
 },
 {
  "id": "2A3795_0C72.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ふふん、本気でそう言ってるのか？",
  "en": ""
 },
 {
  "id": "2A3795_0CB4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "もちろんさ……",
  "en": ""
 },
 {
  "id": "2A3795_0CC1.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "ひとりじゃ無理かも知れないけど、 / 僕には今までいっしょに闘ってきた / 仲間がいるんだい！！",
  "en": ""
 },
 {
  "id": "2A3795_0CF3.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "仲間だと……？",
  "en": ""
 },
 {
  "id": "2A3795_0D00.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 4,
  "jp": "そうさ……僕たちは仲間としてお互いに / 助け合って、ここまでやってきたんだっ！ / 仲間の命をなんとも思ってないお前なんかに、 / 僕たちが負けるはずはない！",
  "en": ""
 },
 {
  "id": "2A3795_0D55.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 5,
  "jp": "フ……なるほど、 / ハーディスのことを言っているのか。 / あれは単なる持ちゴマだ。 / 私が自分の持ちゴマをどう使おうと私の勝手…… / そうは思わないかね？　カケル君。",
  "en": ""
 },
 {
  "id": "2A3795_0D55.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "そんなことを平然と言い捨てるようなやつに、 / 仲間がいつまでもついてくると思うのか？",
  "en": ""
 },
 {
  "id": "2A3795_0D55.2",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "フン、今度はこのリディアのことかね。",
  "en": ""
 },
 {
  "id": "2A3795_0DF7.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "せっかくだが、君たちの言い分が / あやまっていることを証明してあげよう…… / こっちにこい、リディア。",
  "en": ""
 },
 {
  "id": "2A3795_0DF7.1",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 1,
  "jp": "はい、ルシフォン様。",
  "en": ""
 },
 {
  "id": "2A3795_0E45.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "リディアは私を裏切ることはない…… / 私がこれを裏切ろうと殺そうと、ね。",
  "en": ""
 },
 {
  "id": "2A3795_0E45.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "リディアには魂なんてものがないのだよ。 / 生きている人形だ。",
  "en": ""
 },
 {
  "id": "2A3795_0E45.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なんだってっ！？",
  "en": ""
 },
 {
  "id": "2A3795_0EAB.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "その証拠を見せてあげよう。",
  "en": ""
 },
 {
  "id": "2A3795_0EC0.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "リディアが私に反抗しない証 / ……楽しい余興を、ね。",
  "en": ""
 },
 {
  "id": "2A3795_0EE9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……！！",
  "en": ""
 },
 {
  "id": "2A3795_0EF3.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうだリディア。",
  "en": ""
 },
 {
  "id": "2A3795_0F03.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "仲間とやらである私にこんなことをされて…… / にくいか？　悲しいか？",
  "en": ""
 },
 {
  "id": "2A3795_0F29.0",
  "speaker": "リディア",
  "form": "dlg",
  "nlines": 1,
  "jp": "いえ、ルシフォン様。",
  "en": ""
 },
 {
  "id": "2A3795_0F36.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 4,
  "jp": "かつてリディアは、神界のなかでも / 最も優秀な戦士のひとりだったのだ。 / 神話の時代、神界と魔界が闘いを / くり返していたことは知っているだろう？",
  "en": ""
 },
 {
  "id": "2A3795_0F8E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "ある時、私は幸運のおかげで / 彼女を捕らえることに成功してね。",
  "en": ""
 },
 {
  "id": "2A3795_0FB5.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "せっかく手に入れた最上のえものだ。",
  "en": ""
 },
 {
  "id": "2A3795_0FCC.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "だから魂だけをつぶして、 / 私のいうがままに動く人形にしたてた…… / というわけだ。",
  "en": ""
 },
 {
  "id": "2A3795_0FCC.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "き、貴様……！",
  "en": ""
 },
 {
  "id": "2A3795_1008.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル君も私にとっては / 最高のえもののひとつなのだよ。",
  "en": ""
 },
 {
  "id": "2A3795_1008.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うるさいっ！！ / もうお前と話すことはないっ！！",
  "en": ""
 },
 {
  "id": "2A3795_1008.2",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンはここにいるよ！！",
  "en": ""
 },
 {
  "id": "2A3795_1057.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……みんなで力を合わせて、 / ルシフォンをやっつけるんだ！！",
  "en": ""
 },
 {
  "id": "2A3795_1075.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カ、カケルっ……早まるなっ！！",
  "en": ""
 },
 {
  "id": "2A3795_116A.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そのクズどもが、カケル君の仲間なのかね？",
  "en": ""
 },
 {
  "id": "2A3795_1184.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "クズかどうかは、闘ってみればわかるさ！",
  "en": ""
 },
 {
  "id": "2A3795_119E.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル君、私をあまり失望させないでくれ。",
  "en": ""
 },
 {
  "id": "2A3795_11B9.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "君のように思い上がりが強いと、 / 私たち魔族の未来をおびやかす / 存在だとは思えなくなるからね。",
  "en": ""
 },
 {
  "id": "2A3795_11B9.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "魔族の……未来？",
  "en": ""
 },
 {
  "id": "2A3795_11FF.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "……まぁ、いい。",
  "en": ""
 },
 {
  "id": "2A3795_120D.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 3,
  "jp": "君の仲間がどれだけクズか、 / そしてクズどものたどる運命がどうなるのか…… / この私が教えてあげよう。",
  "en": ""
 },
 {
  "id": "2A3795_120D.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……え？",
  "en": "",
  "dup": "2F2B41_1FD8.0"
 },
 {
  "id": "2A3795_1250.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "フフフ……とてもわかりやすく、ね。",
  "en": ""
 },
 {
  "id": "2A3795_126A.0",
  "speaker": "みんなの声",
  "form": "dlg",
  "nlines": 1,
  "jp": "うわああああああぁぁぁぁああぁっ！？",
  "en": ""
 },
 {
  "id": "2A3795_1290.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "きゃあああっ！！　身体が石にいっ！！",
  "en": ""
 },
 {
  "id": "2A3795_12B5.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "うわわわっ！！　し、死にたくないっ！！",
  "en": ""
 },
 {
  "id": "2A3795_12DB.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル殿ぉ！！",
  "en": ""
 },
 {
  "id": "2A3795_12F4.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "きゃああああっ！！　た、助けてっ！！",
  "en": ""
 },
 {
  "id": "2A3795_1319.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 1,
  "jp": "バ、バナナ屋さんの夢があぁぁぁ。",
  "en": ""
 },
 {
  "id": "2A3795_133D.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "きゃあああああっ！！",
  "en": ""
 },
 {
  "id": "2A3795_135A.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 1,
  "jp": "きゃあああっ！！　た、たすけてぇっ！！",
  "en": ""
 },
 {
  "id": "2A3795_1381.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "うわわわわっ！！",
  "en": ""
 },
 {
  "id": "2A3795_139C.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 1,
  "jp": "こ、ここまでかぁ！！",
  "en": ""
 },
 {
  "id": "2A3795_13B9.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 1,
  "jp": "わわわわっ！！　か、固まっちまうぞいっ！！",
  "en": ""
 },
 {
  "id": "2A3795_13E2.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "きゃあああっ！！　お父様っ、ごめんなさい！！",
  "en": ""
 },
 {
  "id": "2A3795_1406.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "石化解除の魔法を覚えておけばよかったぁぁ。",
  "en": ""
 },
 {
  "id": "2A3795_1432.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 1,
  "jp": "わ、私のすらりと伸びた脚がぁぁぁぁ。",
  "en": ""
 },
 {
  "id": "2A3795_1451.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイルぅっ！！　助けてえっ！！",
  "en": ""
 },
 {
  "id": "2A3795_1473.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "うわ――っ！！　身体がっ！！　石にっ！！",
  "en": ""
 },
 {
  "id": "2A3795_149A.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あーんっ！！　助けてっ！！",
  "en": ""
 },
 {
  "id": "2A3795_14BA.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "にょにょにょょょょょょ。",
  "en": ""
 },
 {
  "id": "2A3795_14D9.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 1,
  "jp": "せ、拙者の命もここまででござるぅぅぅ。",
  "en": ""
 },
 {
  "id": "2A3795_1503.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 1,
  "jp": "にゃにゃにゃにゃにゃにゃ！？",
  "en": ""
 },
 {
  "id": "2A3795_1524.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 1,
  "jp": "マルレーネに愛を告白できずに石にいぃぃっ！",
  "en": ""
 },
 {
  "id": "2A3795_154D.0",
  "speaker": "レア",
  "form": "dlg",
  "nlines": 1,
  "jp": "あああっ……ぁぁぁ。",
  "en": ""
 },
 {
  "id": "2A3795_156A.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 1,
  "jp": "きゃーいやああぁっ！　おかぁさああぁんっ！！",
  "en": ""
 },
 {
  "id": "2A3795_1589.0",
  "speaker": "マリアン",
  "form": "dlg",
  "nlines": 1,
  "jp": "私には使命があるのにぃぃっ！",
  "en": ""
 },
 {
  "id": "2A3795_15AC.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぼ、僕の小説は未完で終るのかぁぁぁ……。",
  "en": ""
 },
 {
  "id": "2A3795_15D5.0",
  "speaker": "トルル",
  "form": "dlg",
  "nlines": 1,
  "jp": "サイレスっ！！　飛ぶんだっ！！",
  "en": ""
 },
 {
  "id": "2A3795_15F0.0",
  "speaker": "サイレス",
  "form": "dlg",
  "nlines": 1,
  "jp": "トルル、羽が石に……動かないのだ……！！",
  "en": ""
 },
 {
  "id": "2A3795_160D.0",
  "speaker": "ライナス",
  "form": "dlg",
  "nlines": 1,
  "jp": "わああああぁっ！！",
  "en": ""
 },
 {
  "id": "2A3795_162B.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カ、カケル、ナターシャを、みんなを頼むっ！！",
  "en": ""
 },
 {
  "id": "2A3795_1647.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "身体が石になっちゃうよお！！",
  "en": ""
 },
 {
  "id": "2A3795_165E.0",
  "speaker": "ラスカス",
  "form": "dlg",
  "nlines": 1,
  "jp": "は、羽が動かないっ！！",
  "en": ""
 },
 {
  "id": "2A3795_1673.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "きゃああっ！！",
  "en": "",
  "dup": "2F72F1_04F1.0"
 },
 {
  "id": "2A3795_1680.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナ、ナターシャ！！",
  "en": ""
 },
 {
  "id": "2A3795_168C.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルっ！！",
  "en": ""
 },
 {
  "id": "2A3795_16A0.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "もう身体が動かないわ……。",
  "en": ""
 },
 {
  "id": "2A3795_16B2.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ！　しっかりして、ナターシャ！！",
  "en": ""
 },
 {
  "id": "2A3795_16C7.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめよ……カケル……無理だわ。",
  "en": ""
 },
 {
  "id": "2A3795_16DC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめだ！　最後まであきらめちゃだめだっ！！",
  "en": ""
 },
 {
  "id": "2A3795_16FF.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……お願い……手をにぎっていて……。",
  "en": ""
 },
 {
  "id": "2A3795_1718.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかった……だから、だからがんばってよ！",
  "en": ""
 },
 {
  "id": "2A3795_1732.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……もういいの……ありがとう。",
  "en": ""
 },
 {
  "id": "2A3795_1749.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だめだっ！　だめだよ、ナターシャ！！",
  "en": ""
 },
 {
  "id": "2A3795_175C.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……カケル……。",
  "en": ""
 },
 {
  "id": "2A3795_1768.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "大好きよ。",
  "en": ""
 },
 {
  "id": "2A3795_178F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナ……っ。",
  "en": ""
 },
 {
  "id": "2A3795_179A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャあああああああああぁぁっっ！！",
  "en": ""
 },
 {
  "id": "2A3795_17B9.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あっ……あああああぁぁっ……！！",
  "en": ""
 },
 {
  "id": "2A3795_17D7.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル君、今のもなかなか感動的だったよ。",
  "en": ""
 },
 {
  "id": "2A3795_17F1.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ル、ルシフォンっ！！",
  "en": ""
 },
 {
  "id": "2A3795_17FE.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "せっかくの趣向だ……もう少しこってみよう。",
  "en": ""
 },
 {
  "id": "2A3795_181A.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さて、まずは……。",
  "en": ""
 },
 {
  "id": "2A3795_1828.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カ……ケル……。",
  "en": ""
 },
 {
  "id": "2A3795_1835.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エトっ！？",
  "en": ""
 },
 {
  "id": "2A3795_1840.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ほう？　まだしゃべることができるのか。",
  "en": ""
 },
 {
  "id": "2A3795_1858.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "わ、私は失…敗した…が……お、まえなら…… / わ、たしは自分の…欲望……に負け…たの…だ。",
  "en": ""
 },
 {
  "id": "2A3795_1858.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カ、ケル……実は、わ、わたし……は……。",
  "en": ""
 },
 {
  "id": "2A3795_18A9.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "めざわりだ。消えろ。",
  "en": ""
 },
 {
  "id": "2A3795_18CC.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エ、エトおおおおおおおぉぉぉっ！？",
  "en": ""
 },
 {
  "id": "2A3795_195B.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "フ、フフフ……。",
  "en": ""
 },
 {
  "id": "2A3795_1968.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイルっ……みんなっ！！",
  "en": ""
 },
 {
  "id": "2A3795_1979.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "や、やめろぉぉぉぉルシフォぉぉン……っ！！",
  "en": ""
 },
 {
  "id": "2A3795_1996.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さて、最後は……。",
  "en": ""
 },
 {
  "id": "2A3795_19A4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "や、やめろ……ナターシャにさわるなあ！",
  "en": ""
 },
 {
  "id": "2A3795_19C4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "か、身体が……動かないっ！！",
  "en": ""
 },
 {
  "id": "2A3795_19D8.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 4,
  "jp": "君は愛する者が目の前で / 殺されようとしているというのに…… / 助けるどころか、指一本、動かすことができず、 / ただ見ているしかないのだ。",
  "en": ""
 },
 {
  "id": "2A3795_1A24.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "や、やめ……。",
  "en": ""
 },
 {
  "id": "2A3795_1A3A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "がぁああああああぁあああああぁぁ……っ！？",
  "en": ""
 },
 {
  "id": "2A3795_1A59.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "よ、よくもナターシャを……。",
  "en": ""
 },
 {
  "id": "2A3795_1A69.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 3,
  "jp": "私が惜いか？　……もっと惜むがいい。 / おのれが無力ゆえに愛する者も守れぬ……。 / 私ならマノをそんな目にはあわせることはない。",
  "en": ""
 },
 {
  "id": "2A3795_1AB2.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "さあ、私を八つ裂きにしたいと思うほど惜むのだ / ……もっと恐ろしい目で私をにらめ！！",
  "en": ""
 },
 {
  "id": "2A3795_1AB2.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャを返せっ！！",
  "en": ""
 },
 {
  "id": "2A3795_1AF3.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そう、その目だ…… / もっと惜しみのこもった目で私を見ろ！！",
  "en": ""
 },
 {
  "id": "2A3795_1AF3.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "こ、殺してやるっ！！",
  "en": ""
 },
 {
  "id": "2A3795_1B27.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "人間ごときが……思い上がるな。",
  "en": ""
 },
 {
  "id": "2A3795_1B3F.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ぎゃああああっ！！",
  "en": ""
 },
 {
  "id": "2A3795_1B56.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "なかなかいい目をしていたね…… / でも、今の君では役不足のようだ。",
  "en": ""
 },
 {
  "id": "2A3795_1B56.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "安心したまえ、私は逃げることなどしない。",
  "en": ""
 },
 {
  "id": "2A3795_1B9A.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私は人間界にしばらくとどまり、 / 閉ざされた魔界の扉を開けようではないか。",
  "en": ""
 },
 {
  "id": "2A3795_1BC5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ま、魔界……。",
  "en": ""
 },
 {
  "id": "2A3795_1BD1.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル君はしばらく寝ているがいい……",
  "en": ""
 },
 {
  "id": "2A3795_1BE8.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "君が目を覚ました時、地上には魔族の者が / あふれかえっていることだろう。",
  "en": ""
 },
 {
  "id": "2A3795_1C11.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ル、ルシフォン……。",
  "en": ""
 },
 {
  "id": "2A3795_1C1D.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 1,
  "jp": "くっくっくっ……",
  "en": ""
 },
 {
  "id": "2A3795_1C2B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "これで君の父親がしたことは / すべてむだになったわけだ。",
  "en": ""
 },
 {
  "id": "2A3795_1C4B.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 2,
  "jp": "君は魔族のあふれかえる人間界を見て、 / そして死んでいくのだ……。",
  "en": ""
 },
 {
  "id": "2A3795_1C4B.1",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 4,
  "jp": "神の血を引く者が、愛する者も守れず、 / 自分の完全なる敗北を知って死んでいく…… / これぞ四天王の頂点である / 私にふさわしい殺し方なのだ。",
  "en": ""
 },
 {
  "id": "2A3795_1CC7.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": "",
  "dup": "2FB86E_204B.0"
 },
 {
  "id": "2A3795_1CCF.0",
  "speaker": "ルシフォン",
  "form": "dlg",
  "nlines": 3,
  "jp": "そうそう、目が覚めた時も私ヘの惜しみを / 忘れてはいけないよ……。 / ……それではおやすみ、カケル君。",
  "en": ""
 },
 {
  "id": "2A3795_1D07.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "……ル……フォン……。",
  "en": ""
 },
 {
  "id": "2A3795_1D1B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "……。",
  "en": ""
 },
 {
  "id": "2A3795_1D20.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "………………。",
  "en": ""
 },
 {
  "id": "2A3795_1D29.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "…………………………。",
  "en": ""
 },
 {
  "id": "2A3795_1D36.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "……………………………………。",
  "en": ""
 },
 {
  "id": "2A3795_1D77.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "いや……まだ入らない。",
  "en": ""
 },
 {
  "id": "2A3795_1D88.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルでも緊張することがあるんだな。",
  "en": ""
 },
 {
  "id": "2A3795_1DA1.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……緊張してるの？",
  "en": ""
 },
 {
  "id": "2A3795_1DB4.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "別に緊張なんかしてないよ…… / ただ、ちょっとだけいやな予感がするんだ。",
  "en": ""
 },
 {
  "id": "2A3795_1DDE.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "私の魔法ではかなわないかもしれませんが、 / 精一杯闘ってみます。",
  "en": ""
 },
 {
  "id": "2A3795_1E07.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルよう、心臓が破裂しそうだぜ。",
  "en": ""
 },
 {
  "id": "2A3795_1E20.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "たとえルシフォンに破れたとしても…… / 私はカケル殿のことを忘れんぞ。",
  "en": ""
 },
 {
  "id": "2A3795_1E46.0",
  "speaker": "ネプチューン",
  "form": "dlg",
  "nlines": 1,
  "jp": "ルシフォンの顔を、じっくり拝んでやるわ。",
  "en": ""
 },
 {
  "id": "2A3795_1E5E.0",
  "speaker": "ゴロンゴン",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺はルシフォンを倒して、 / 世界一のバナナ屋さんになってやるんだ。",
  "en": ""
 },
 {
  "id": "2A3795_1E82.0",
  "speaker": "パンドラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンを倒したら、 / また踊り子でもしようかしら？",
  "en": ""
 },
 {
  "id": "2A3795_1EA0.0",
  "speaker": "メイフェア",
  "form": "dlg",
  "nlines": 2,
  "jp": "殺された仲間たちの恨みを、 / やっとはらすことができそうです。",
  "en": ""
 },
 {
  "id": "2A3795_1EC6.0",
  "speaker": "クラリス",
  "form": "dlg",
  "nlines": 1,
  "jp": "……心臓がどきどきするぜ。",
  "en": ""
 },
 {
  "id": "2A3795_1EDA.0",
  "speaker": "サントス",
  "form": "dlg",
  "nlines": 3,
  "jp": "カケルよう、 / ルシフォンを倒して軍隊を解散しても…… / 俺のことを忘れるんじゃねーぞ。",
  "en": ""
 },
 {
  "id": "2A3795_1F09.0",
  "speaker": "ガリバン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ここで待ってる場合ではないぞい…… / 早く城の中に入ろうではないか。",
  "en": ""
 },
 {
  "id": "2A3795_1F32.0",
  "speaker": "ビアンカ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケルさん……がんばりましょう。",
  "en": ""
 },
 {
  "id": "2A3795_1F43.0",
  "speaker": "ネクラマンサー",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……色々とありがとうな。",
  "en": ""
 },
 {
  "id": "2A3795_1F57.0",
  "speaker": "セイラ",
  "form": "dlg",
  "nlines": 2,
  "jp": "私のすらりと伸びた脚が / 大活躍する時がきたようね……。",
  "en": ""
 },
 {
  "id": "2A3795_1F74.0",
  "speaker": "ロザリンド",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンを倒したら…… / 私、セイルと結婚するの。",
  "en": ""
 },
 {
  "id": "2A3795_1F92.0",
  "speaker": "ピエール",
  "form": "dlg",
  "nlines": 1,
  "jp": "なあ、マルレーネはどこに行ったんだい？",
  "en": ""
 },
 {
  "id": "2A3795_1FA8.0",
  "speaker": "ジーナ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私……カケルのこと、絶対に忘れないからね。",
  "en": ""
 },
 {
  "id": "2A3795_1FC2.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 1,
  "jp": "にょにょにょ……やっと落ち着いたにょ。",
  "en": ""
 },
 {
  "id": "2A3795_1FDC.0",
  "speaker": "ラビット",
  "form": "dlg",
  "nlines": 2,
  "jp": "もう脚も震えないにょ…… / これで思いっきり闘うことができるにょ。",
  "en": ""
 },
 {
  "id": "2A3795_2004.0",
  "speaker": "パウエル",
  "form": "dlg",
  "nlines": 2,
  "jp": "マルレーネ殿の姿が見えないでござるな…… / 心配でござる。",
  "en": ""
 },
 {
  "id": "2A3795_2026.0",
  "speaker": "ターニャン",
  "form": "dlg",
  "nlines": 2,
  "jp": "ルシフォンから色々と盗んでやるにゃん…… / 楽しみだにゃん。",
  "en": ""
 },
 {
  "id": "2A3795_2046.0",
  "speaker": "バルカン",
  "form": "dlg",
  "nlines": 1,
  "jp": "みんなビビっているようだな……。",
  "en": ""
 },
 {
  "id": "2A3795_205D.0",
  "speaker": "ウェンディ",
  "form": "dlg",
  "nlines": 2,
  "jp": "とっとと出てきてやられてくれれば、 / 早く帰れるのになあ。",
  "en": ""
 },
 {
  "id": "2A3795_2080.0",
  "speaker": "マリアン",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしたんでしょう？",
  "en": ""
 },
 {
  "id": "2A3795_2090.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "このお城に入ってから心の中の声が / ぷっつり聞こえなくなって……？",
  "en": ""
 },
 {
  "id": "2A3795_20B7.0",
  "speaker": "マリアン",
  "form": "dlg",
  "nlines": 2,
  "jp": "……なにか大切なことを忘れているような…… / そんな気持ちです。",
  "en": ""
 },
 {
  "id": "2A3795_20EA.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 4,
  "jp": "これでやっと、冒険小説を / 書き終ることができるんだ…… / カケル君、決戦の前にもう一度 / 話を聞かせてもらえないかい？",
  "en": ""
 },
 {
  "id": "2A3795_2134.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……今度こそ僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_079C.0"
 },
 {
  "id": "2A3795_214A.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、どのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07B2.0"
 },
 {
  "id": "2A3795_2154.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ……また僕に話をしてくれるんだね。",
  "en": "",
  "dup": "2FB86E_07BC.0"
 },
 {
  "id": "2A3795_2168.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "さてと、今度はどのノートに書くかな……",
  "en": "",
  "dup": "2FB86E_07D0.0"
 },
 {
  "id": "2A3795_2182.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "君は何色が好きなんだい？ / 青色のノート",
  "en": "",
  "dup": "2FB86E_07EA.0"
 },
 {
  "id": "2A3795_2197.0",
  "speaker": "",
  "form": "choice",
  "nlines": 2,
  "jp": "赤色のノート / 緑色のノート | 次の機会にする",
  "en": "",
  "dup": "2FB86E_07FF.0"
 },
 {
  "id": "2A3795_21C8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕、青色のノートがいいな。",
  "en": "",
  "dup": "2FB86E_0830.0"
 },
 {
  "id": "2A3795_21DF.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、じゃあ / 青色のノート",
  "en": "",
  "dup": "2FB86E_084F.0"
 },
 {
  "id": "2A3795_21F4.0",
