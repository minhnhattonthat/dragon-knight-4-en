  "dup": "2F9C88_093E.0"
 },
 {
  "id": "2CA4C9_1557.1",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "こいつらにするかい？",
  "en": "",
  "dup": "2F9C88_08BA.1"
 },
 {
