 },
 {
  "id": "2CA4C9_1367.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "いいや、まだだよ。 / 話を聞くだけ聞いて、とっとと行っちまった。",
  "en": ""
 },
 {
  "id": "2CA4C9_1367.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……",
  "en": ""
 },
 {
  "id": "2CA4C9_1394.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "前の私は、昔の私にまかせたのが / 失敗だったのかもしれない。",
  "en": ""
 },
 {
  "id": "2CA4C9_13B8.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前……文法がおかしいぞ。",
  "en": ""
 },
 {
  "id": "2CA4C9_13CD.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わっはっはっはっ！！",
  "en": ""
 },
 {
  "id": "2CA4C9_13D5.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "……そんなことより / いったいだれが登録してるのだ？",
  "en": ""
 },
 {
  "id": "2CA4C9_13F4.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "その前に言っておくことがある。",
  "en": ""
 },
 {
  "id": "2CA4C9_1409.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "わかってるさ、 / 選べる部隊はひとつだけだって言うんだろ？",
  "en": ""
 },
 {
  "id": "2CA4C9_1409.1",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 3,
  "jp": "なんだ、あのカケルとかいう / 小僧に聞いたんだな…… / それじゃあ、部隊を紹介してやろう。",
  "en": ""
 },
 {
  "id": "2CA4C9_1465.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "よう、またきたな。選ぶ部隊を決めたのか？",
