  "dup": "2F9C88_066B.0"
 },
 {
  "id": "2CA4C9_0F7C.0",
  "speaker": "カルタス",
  "form": "dlg",
  "nlines": 2,
  "jp": "早く出発しないと、 / ルシフォン軍がまた攻めにやってくるぜ。",
