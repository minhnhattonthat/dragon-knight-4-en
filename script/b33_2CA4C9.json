 },
 {
  "id": "2CA4C9_0DF4.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "やあ、じゃありません……。",
  "en": ""
 },
 {
  "id": "2CA4C9_0E05.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "お願いです、 / 今度こそ助けて下さい。",
