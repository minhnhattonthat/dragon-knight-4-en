  "dup": "2F9C88_0909.0"
 },
 {
  "id": "2CA4C9_152F.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんだ……カルタス隊にしないのか？",
