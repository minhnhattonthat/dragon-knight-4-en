  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "私が助けなくても、 / カケルが助けてくれると思うが……。",
  "en": ""
 },
 {
  "id": "2CA4C9_0E4C.0",
  "speaker": "エト",
  "form": "dlg",
