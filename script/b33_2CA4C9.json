  "dup": "2F9C88_0916.0"
 },
 {
  "id": "2CA4C9_153B.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 1,
  "jp": "選ぶやつを決めたら、またきてくれ。",
  "en": "",
  "dup": "2F9C88_0922.0"
 },
 {
  "id": "2CA4C9_1557.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ネレイド隊は魔導師の集団だ。 / 彼女はかわいい女の子だったぞ。",
