  "dup": "2F9C88_08E4.0"
 },
 {
  "id": "2CA4C9_1501.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "やめる",
  "en": "",
  "dup": "2F9C88_088C.0"
 },
 {
  "id": "2CA4C9_150F.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうか、カルタス隊に決めるんだな…… / やつには俺から連絡しておくぜ！！",
