  "id": "2CA4C9_0BC7.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "だ、だめ……",
  "en": ""
 },
 {
  "id": "2CA4C9_0BD3.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "鎖を解く魔法なんて、 / 学校で教わらなかったもの。",
  "en": ""
 },
