 },
 {
  "id": "2CA4C9_0FD5.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……い、いや。",
  "en": ""
 },
 {
  "id": "2CA4C9_0FE3.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうして……僕の名前を知ってるんだい？",
