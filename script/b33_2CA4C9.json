[
 {
  "id": "2CA4C9_005A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "よーし、ここで解散！！",
  "en": "",
  "dup": "2F9C88_0067.0"
 },
 {
  "id": "2CA4C9_006C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（って、よくエトも言ってたよな）",
  "en": ""
 },
 {
  "id": "2CA4C9_0081.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（……そうか……今は俺がエトなんだ）",
  "en": ""
 },
 {
  "id": "2CA4C9_0095.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "セイル、大丈夫か？",
  "en": ""
 },
 {
  "id": "2CA4C9_00A2.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 2,
  "jp": "はあはあ…… / こ、こんな生活、もういやだあ！！",
  "en": ""
 },
 {
  "id": "2CA4C9_00A2.1",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 3,
  "jp": "牧師の息子である僕が、 / あんなことをするなんて…… / 信じられないよ。",
  "en": ""
 },
 {
  "id": "2CA4C9_00EC.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前はたしかに牧師の息子だが、",
  "en": ""
 },
 {
  "id": "2CA4C9_0103.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "その前にドラゴンナイトの血を / 引く者でもあるんだぞ。",
  "en": ""
 },
 {
  "id": "2CA4C9_0121.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ドラゴンナイトなんてどうでもいいよ！！",
  "en": ""
 },
 {
  "id": "2CA4C9_0138.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "僕はミネルバ大陸に戻って、 / パパといっしょに暮らしたいんだ。",
  "en": ""
 },
 {
  "id": "2CA4C9_015E.0",
  "speaker": "セイル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてこんなことになっちゃったんだろ？",
  "en": ""
 },
 {
  "id": "2CA4C9_0186.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、ひとりで外に出たらだめだぞ。",
  "en": ""
 },
 {
  "id": "2CA4C9_019C.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "身体を休めて、次の戦闘に備えるんだ。",
  "en": ""
 },
 {
  "id": "2CA4C9_01B6.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかったよエト……大人しくしてるよ。",
  "en": ""
 },
 {
  "id": "2CA4C9_01DE.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "あれれ……カケル、なにをやってるんだ？",
  "en": ""
 },
 {
  "id": "2CA4C9_01F3.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、見てよ……変わった女の子だよね。",
  "en": ""
 },
 {
  "id": "2CA4C9_0213.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "あーんっ！！　助けてっ！！",
  "en": ""
 },
 {
  "id": "2CA4C9_0226.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 3,
  "jp": "彼女は好きで、 / こういう状態になってる訳じゃなさそうだぞ。 / 助けてやったらどうだ？",
  "en": ""
 },
 {
  "id": "2CA4C9_025A.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "うーん、どうしようかなあ。",
  "en": ""
 },
 {
  "id": "2CA4C9_0274.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "カケル……もしかしたら、 / 彼女は仲間になってくれるかも知れないぞ。",
  "en": ""
 },
 {
  "id": "2CA4C9_0274.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "どうしてわかるの？",
  "en": ""
 },
 {
  "id": "2CA4C9_02B1.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（しまった……部隊は選び終ってたんだ）",
  "en": ""
 },
 {
  "id": "2CA4C9_02CA.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ねえねえ…… / どうして仲間になってくれるってわかるの？",
  "en": ""
 },
 {
  "id": "2CA4C9_02CA.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "な、なんとなく……そんな気がしたんだ。",
  "en": ""
 },
 {
  "id": "2CA4C9_02FE.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "み、見てないで早く助けてくださいっ！！",
  "en": ""
 },
 {
  "id": "2CA4C9_0317.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "わかったよ、助けてあげよっと。",
  "en": ""
 },
 {
  "id": "2CA4C9_032F.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "た、助かりました……どうもありがとう。",
  "en": ""
 },
 {
  "id": "2CA4C9_0347.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん、特にお礼はいらないけど、 / あえていうなら現金がいいかな。",
  "en": "",
  "dup": "2F9C88_03CF.2"
 },
 {
  "id": "2CA4C9_0347.1",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんか言いました？",
  "en": "",
  "dup": "2F9C88_03CF.3"
 },
 {
  "id": "2CA4C9_037E.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "なんにも言ってないよ。",
  "en": ""
 },
 {
  "id": "2CA4C9_038E.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "……そうですよね。 / とにかく本当にありがとうございました。",
  "en": "",
  "dup": "2F9C88_0446.0"
 },
 {
  "id": "2CA4C9_038E.1",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "私、魔導師の卵なんです……",
  "en": ""
 },
 {
  "id": "2CA4C9_03C5.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "近くの森にある魔導師学校から、 / 遊びにきてたんですけど、",
  "en": "",
  "dup": "2F9C88_047C.0"
 },
 {
  "id": "2CA4C9_03EB.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "いきなりルシフォンの軍隊が / この街にやってきて……。",
  "en": "",
  "dup": "2F9C88_04A2.0"
 },
 {
  "id": "2CA4C9_0403.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "私に仲間になれって強制するんです。",
  "en": "",
  "dup": "2F9C88_04BA.0"
 },
 {
  "id": "2CA4C9_041B.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "仲間にならないと / こんなことをしちゃうぞって……。",
  "en": "",
  "dup": "2F9C88_04D2.0"
 },
 {
  "id": "2CA4C9_0437.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 2,
  "jp": "私、魔導師学校に戻って仲間を呼んできます。 / そして、あの悪いやつらと闘うつもりです。",
  "en": "",
  "dup": "2F9C88_04EE.0"
 },
 {
  "id": "2CA4C9_0437.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "うん、お礼はあとでいいから…… / ちゃんと現金で払ってね。",
  "en": "",
  "dup": "2F9C88_04EE.1"
 },
 {
  "id": "2CA4C9_0437.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前なあ……。",
  "en": ""
 },
 {
  "id": "2CA4C9_049C.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "冗談だってば……じゃあね、エト。",
  "en": ""
 },
 {
  "id": "2CA4C9_04C6.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル……馬に乗った男がこなかったか？",
  "en": ""
 },
 {
  "id": "2CA4C9_04DF.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "馬に乗った男？ / ……ううん、こないよ。",
  "en": ""
 },
 {
  "id": "2CA4C9_04DF.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……。",
  "en": "",
  "dup": "2E5EB7_0541.1"
 },
 {
  "id": "2CA4C9_0503.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "エト、そろそろ東に行こうよ…… / ぐずぐずしてると、黒い霧がきちゃうよ。",
  "en": ""
 },
 {
  "id": "2CA4C9_052E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 1,
  "jp": "東に向かいますか？",
  "en": "",
  "dup": "2F9C88_1191.0"
 },
 {
  "id": "2CA4C9_0539.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "はい",
  "en": "",
  "dup": "2F9C88_119C.0"
 },
 {
  "id": "2CA4C9_0540.0",
  "speaker": "",
  "form": "choice",
  "nlines": 1,
  "jp": "いいえ",
  "en": "",
  "dup": "2F9C88_11A3.0"
 },
 {
  "id": "2CA4C9_0552.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "（しかたがない……カケルの言うとおり、 / この街にいると黒い霧がきてしまう）",
  "en": ""
 },
 {
  "id": "2CA4C9_0552.1",
  "speaker": "男の声",
  "form": "dlg",
  "nlines": 2,
  "jp": "だれかおらぬか！！ / 私は騎士カロンであるっ！！",
  "en": "",
  "dup": "2F9C88_11B5.0"
 },
 {
  "id": "2CA4C9_0552.2",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（き、きたあ！！）",
  "en": ""
 },
 {
  "id": "2CA4C9_05AD.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 5,
  "jp": "レイモンド王国からユリシーズヘと続く / 道すがらに、女が倒れておったのだ！！ / 私はこれから、ラビニアにいる / ルシフォンの軍勢をけ散らしに行ってくる。 / だれかこの女を引きとってくれいっ！！",
  "en": "",
  "dup": "2F9C88_11E9.0"
 },
 {
  "id": "2CA4C9_05AD.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "わ、私が引き取るぞ！！",
  "en": ""
 },
 {
  "id": "2CA4C9_061D.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "お前はこの女の知り合いか？",
  "en": ""
 },
 {
  "id": "2CA4C9_0630.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "い、いや……。",
  "en": ""
 },
 {
  "id": "2CA4C9_063C.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "むう、顔を見せてみろ……",
  "en": ""
 },
 {
  "id": "2CA4C9_064E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "もしかして、この女性に / 変なことをしようとしてるのではないか？",
  "en": ""
 },
 {
  "id": "2CA4C9_0670.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "んん……ん……カケルぅ。",
  "en": ""
 },
 {
  "id": "2CA4C9_0682.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "カ、カケル……お前の名前を呼んでるぞ。",
  "en": ""
 },
 {
  "id": "2CA4C9_069B.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 1,
  "jp": "むう、かわいい顔をした男の子だな……。",
  "en": "",
  "dup": "2F9C88_127B.0"
 },
 {
  "id": "2CA4C9_06B3.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "はっ、い、いかん！！ / ……お前はこの女の知り合いだな！？",
  "en": ""
 },
 {
  "id": "2CA4C9_06B3.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "んん……カ、カケル……。",
  "en": "",
  "dup": "2F9C88_1293.1"
 },
 {
  "id": "2CA4C9_06E5.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "その顔は……やっぱりナターシャだ！！",
  "en": "",
  "dup": "2F9C88_12C8.0"
 },
 {
  "id": "2CA4C9_06FA.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "たしかに知り合いだ……そうだろカケル？",
  "en": ""
 },
 {
  "id": "2CA4C9_0712.0",
  "speaker": "カロン",
  "form": "dlg",
  "nlines": 2,
  "jp": "よし、決まった！！ / 女はお前にあずけるぞ！！",
  "en": "",
  "dup": "2F9C88_12DD.0"
 },
 {
  "id": "2CA4C9_0712.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "あ……ち、ちょっと待ってよ！！",
  "en": "",
  "dup": "2F9C88_12DD.1"
 },
 {
  "id": "2CA4C9_075E.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "（ナターシャ……）",
  "en": ""
 },
 {
  "id": "2CA4C9_0769.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "だ、大丈夫かなあ。",
  "en": ""
 },
 {
  "id": "2CA4C9_0776.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "平気だろう…… / 見たところ、ケガはしてないみたいだし。",
  "en": ""
 },
 {
  "id": "2CA4C9_0776.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ん……。",
  "en": "",
  "dup": "2F9C88_133E.0"
 },
 {
  "id": "2CA4C9_07AC.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "ん……。",
  "en": "",
  "dup": "2F9C88_133E.0"
 },
 {
  "id": "2CA4C9_07BC.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カ、カケル……。",
  "en": "",
  "dup": "2F9C88_134E.0"
 },
 {
  "id": "2CA4C9_07C8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "き、気がついたんだね！？",
  "en": "",
  "dup": "2F9C88_135A.0"
 },
 {
  "id": "2CA4C9_07DA.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "夢じゃないわよね……カケル。",
  "en": "",
  "dup": "2F9C88_136C.0"
 },
 {
  "id": "2CA4C9_07EC.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "大丈夫だ、夢じゃない。",
  "en": "",
  "dup": "2F9C88_137E.0"
 },
 {
  "id": "2CA4C9_07FB.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "……あなたは？",
  "en": "",
  "dup": "2F9C88_138D.0"
 },
 {
  "id": "2CA4C9_0808.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "この人はエト。僕たちの仲間なんだ。",
  "en": ""
 },
 {
  "id": "2CA4C9_081F.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あなたが……私を助けてくれたの？",
  "en": "",
  "dup": "2F9C88_139A.1"
 },
 {
  "id": "2CA4C9_0835.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "いいや、 / カロンという騎士が君を助けてくれたんだ……。",
  "en": "",
  "dup": "2F9C88_13C8.0"
 },
 {
  "id": "2CA4C9_0835.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "ナターシャ……どうしてこの大陸にいるの？",
  "en": "",
  "dup": "2F9C88_13C8.1"
 },
 {
  "id": "2CA4C9_086D.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "私……カケルを……。",
  "en": "",
  "dup": "2F9C88_1400.0"
 },
 {
  "id": "2CA4C9_087B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "僕を？",
  "en": "",
  "dup": "2F9C88_140E.0"
 },
 {
  "id": "2CA4C9_0884.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、そんなことより……",
  "en": "",
  "dup": "2F9C88_1417.0"
 },
 {
  "id": "2CA4C9_0896.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "私たちが住んでいた大陸は、 / 黒い霧に包まれてしまったわ。",
  "en": "",
  "dup": "2F9C88_1429.0"
 },
 {
  "id": "2CA4C9_08B8.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……。",
  "en": "",
  "dup": "2F9C88_144B.0"
 },
 {
  "id": "2CA4C9_08C1.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "あの黒い霧はいったいなに！？",
  "en": "",
  "dup": "2F9C88_1454.0"
 },
 {
  "id": "2CA4C9_08D4.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "落ち着くんだ、ナターシャ……",
  "en": ""
 },
 {
  "id": "2CA4C9_08E6.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "俺たちはあの黒い霧の正体を暴くためにも、 / ライムリンの国に行かねばならないんだ。",
  "en": ""
 },
 {
  "id": "2CA4C9_0911.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "カケル、あなたのお父さんも、黒い霧に……。",
  "en": ""
 },
 {
  "id": "2CA4C9_0929.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "お父さんは平気だよ…… / もし石になったとしても、絶対に平気だ。",
  "en": "",
  "dup": "2F9C88_14A5.1"
 },
 {
  "id": "2CA4C9_0929.1",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうね……カケルのお父さんは強いもの。",
  "en": "",
  "dup": "2F9C88_14A5.2"
 },
 {
  "id": "2CA4C9_0966.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 2,
  "jp": "ねえ、ナターシャ…… / もしかして僕を追いかけてこの大陸にきたとか？",
