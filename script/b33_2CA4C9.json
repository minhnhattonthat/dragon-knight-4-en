  "dup": "2FB86E_08C9.0"
 },
 {
  "id": "2CA4C9_1264.1",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 2,
  "jp": "いやあ、とても楽しかったよ…… / よかったらまた話を聞かせてくれ。",
  "en": "",
  "dup": "2FB86E_08C9.1"
 },
 {
  "id": "2CA4C9_129A.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "すまないが、やっぱり話をするのはやめよう。",
  "en": ""
 },
 {
  "id": "2CA4C9_12B5.0",
  "speaker": "ロイドン",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……また今度話を聞かせてくれよ。",
  "en": ""
 },
 {
  "id": "2CA4C9_12DE.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 2,
  "jp": "ここは勇敢な兵士の訓練所だ。 / お前も兵士として応募しにきたんだな？",
  "en": "",
  "dup": "2F9C88_06BA.0"
 },
 {
  "id": "2CA4C9_12DE.1",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ちがうぜ、私は仲間をさがしにきたんだ……。",
  "en": ""
 },
 {
  "id": "2CA4C9_1320.0",
  "speaker": "トルへス",
  "form": "dlg",
  "nlines": 3,
  "jp": "お前の仲間のカケルとかいうやつは、 / 使えそうな仲間より、 / きれーな女の子がいいとさ。",
  "en": ""
 },
 {
  "id": "2CA4C9_1350.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "ま、まさかもう選んでしまったとか？",
