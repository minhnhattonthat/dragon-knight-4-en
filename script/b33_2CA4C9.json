  "dup": "2F9C88_166F.0"
 },
 {
  "id": "2CA4C9_0ADA.1",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、ナターシャは平気みたいだし……。",
  "en": "",
  "dup": "2F9C88_166F.1"
 },
 {
  "id": "2CA4C9_0B12.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "そうだな、黒い霧が迫ってくる…… / そろそろ東に向けて出発するか。",
  "en": "",
  "dup": "2F9C88_16A7.0"
 },
 {
  "id": "2CA4C9_0B3B.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、ナターシャの側には僕がついてるよ。",
  "en": ""
 },
 {
  "id": "2CA4C9_0B53.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そ、そうか……わかった。",
  "en": ""
 },
 {
  "id": "2CA4C9_0B62.0",
  "speaker": "カケル",
  "form": "dlg",
  "nlines": 1,
  "jp": "エト、ナターシャは僕の幼剛染みなんだ……。",
  "en": ""
 },
 {
  "id": "2CA4C9_0B7A.0",
  "speaker": "ナターシャ",
  "form": "dlg",
  "nlines": 1,
  "jp": "もう平気、すぐにでも出かけられるわ。",
  "en": "",
  "dup": "2F9C88_01FD.0"
 },
 {
  "id": "2CA4C9_0B92.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 1,
  "jp": "そうか……よかった。",
  "en": "",
  "dup": "2E5EB7_0433.1"
 },
 {
  "id": "2CA4C9_0BB1.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
