  "id": "2CA4C9_0BF4.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "お、お願いです……助けてください。",
  "en": ""
 },
 {
  "id": "2CA4C9_0C0D.0",
  "speaker": "エト",
  "form": "dlg",
  "nlines": 2,
  "jp": "ネレイドじゃないか…… / こんなところでなにをしてるんだ！？",
  "en": ""
 },
 {
  "id": "2CA4C9_0C0D.1",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "えいっ！！　鎖よ、解けてっ！！",
  "en": "",
  "dup": "2CA4C9_0BB1.0"
 },
 {
  "id": "2CA4C9_0C42.0",
  "speaker": "ネレイド",
  "form": "dlg",
  "nlines": 1,
  "jp": "だ、だめ……",
  "en": "",
  "dup": "2CA4C9_0BC7.0"
 },
 {
  "id": "2CA4C9_0C4E.0",
  "speaker": "",
  "form": "dlg",
  "nlines": 2,
  "jp": "鎖を解く魔法なんて、 / 学校で教わらなかったもの。",
